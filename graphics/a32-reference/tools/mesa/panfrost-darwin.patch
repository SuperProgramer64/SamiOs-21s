+/*
+ * The tiler heap, made at its first use: a heap of 32 MB instead of 128 MB, and none for the
+ * processes that open the device and never draw (PAN_TILER_HEAP_MB sets another size).
+ */
+struct panfrost_bo *
+panfrost_device_tiler_heap(struct panfrost_device *dev)
+{
+   struct panfrost_bo *heap = dev->tiler_heap;
+
+   if (heap)
+      return heap;
+   pthread_mutex_lock(&dev->tiler_heap_lock);
+   if (!dev->tiler_heap) {
+      const char *env = getenv("PAN_TILER_HEAP_MB");
+      unsigned mb = env ? (unsigned)atoi(env) : 32;
+
+      if (mb < 4 || mb > 128)
+         mb = 32;
+      heap = panfrost_bo_create(dev, (size_t)mb * 1024 * 1024,
+                                PAN_BO_INVISIBLE | PAN_BO_GROWABLE, "Tiler heap");
+      if (!heap)
+         mesa_loge("panfrost: no memory for a %u MB tiler heap", mb);
+      dev->tiler_heap = heap;
+   }
+   heap = dev->tiler_heap;
+   pthread_mutex_unlock(&dev->tiler_heap_lock);
+   return heap;
+}
