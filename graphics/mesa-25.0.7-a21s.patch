diff --git a/src/compiler/air/air2nir.c b/src/compiler/air/air2nir.c
new file mode 100644
index 0000000..f719cf4
--- /dev/null
+++ b/src/compiler/air/air2nir.c
@@ -0,0 +1,788 @@
+/*
+ * Copyright © 2026 Darwin on redwood contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * air2nir: the frontend from the command line, as spirv2nir is for SPIR-V.
+ *
+ *   air2nir FILE [FUNCTION]          translate and print the NIR
+ *   air2nir --ll FILE [FUNCTION]     print what the bitcode reader read, as LLVM assembly
+ *   air2nir --list FILE.metallib     the functions of a container
+ *   air2nir --report FILE...         one line per module, for tools/air/corpus.py
+ *   air2nir --interface FILE [FUNC]  what the shader expects of the runtime
+ *                                    (air_shader_info), key=value per line
+ *
+ * FILE is a .metallib (then FUNCTION picks one; without it, every function)
+ * or one module's bitcode, wrapped or not. --report forks for every module,
+ * so that an assertion in one is a line in the report and not the end of it.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <inttypes.h>
+
+#include "nir.h"
+#include "nir_builder.h"
+#include "nir_air.h"
+#include "air_module.h"
+#include "util/ralloc.h"
+
+/* --library: translate an air.visible library function inside a generated
+ * entry point (nir_air.h). Off by default, because a wrapped function is not
+ * an entry point of the corpus and must not be counted as one.
+ */
+static bool library_wrapper = false;
+
+static const nir_shader_compiler_options default_options = {
+   .lower_fdiv = false,
+};
+
+static void *
+map_file(const char *path, size_t *size)
+{
+   int fd = open(path, O_RDONLY);
+   if (fd < 0) {
+      fprintf(stderr, "air2nir: %s: %s\n", path, strerror(errno));
+      return NULL;
+   }
+   struct stat st;
+   fstat(fd, &st);
+   *size = st.st_size;
+   void *p = mmap(NULL, st.st_size ? st.st_size : 1, PROT_READ, MAP_PRIVATE, fd, 0);
+   close(fd);
+   return p == MAP_FAILED ? NULL : p;
+}
+
+struct module_ref {
+   const char *name;
+   int container_type;
+   const void *bitcode;
+   size_t size;
+};
+
+/* every module of FILE (one, unless it is a container) */
+static unsigned
+modules_of(void *ctx, const char *path, const char *only, struct module_ref **out)
+{
+   size_t size;
+   const uint8_t *data = map_file(path, &size);
+   if (!data)
+      return 0;
+   if (size >= 4 && !memcmp(data, "MTLB", 4)) {
+      struct air_metallib lib;
+      const char *err;
+      if (!air_metallib_parse(ctx, data, size, &lib, &err)) {
+         fprintf(stderr, "air2nir: %s: %s\n", path, err);
+         return 0;
+      }
+      *out = rzalloc_array(ctx, struct module_ref, lib.num_functions ? lib.num_functions : 1);
+      unsigned n = 0;
+      for (unsigned i = 0; i < lib.num_functions; i++) {
+         if (only && strcmp(only, lib.functions[i].name))
+            continue;
+         (*out)[n++] = (struct module_ref) {
+            lib.functions[i].name, lib.functions[i].type,
+            lib.functions[i].bitcode, lib.functions[i].bitcode_size,
+         };
+      }
+      return n;
+   }
+   *out = rzalloc(ctx, struct module_ref);
+   (*out)[0] = (struct module_ref) { path, -1, data, size };
+   return 1;
+}
+
+static const char *
+stage_name(int stage)
+{
+   switch (stage) {
+   case MESA_SHADER_VERTEX: return "vertex";
+   case MESA_SHADER_FRAGMENT: return "fragment";
+   case MESA_SHADER_COMPUTE: return "kernel";
+   case MESA_SHADER_NONE: return "visible";
+   default: return "unknown";
+   }
+}
+
+/* --stitch: a graph of air.visible functions compiled into one entry point.
+ *
+ * The graph is Metal's own (MTLFunctionStitchingGraph and its nodes) and is
+ * typed on the command line the way air_stitch_parse reads it:
+ *
+ *   "_pf_invertRed(in0); _pf_redContour(n0); _pf_textureDiff(n0, n1)"
+ *
+ * The functions it names are looked up in the container by name, because the
+ * nodes of one graph live in different modules of one .metallib.
+ */
+static const struct air_stitch_graph *stitch = NULL;
+static struct air_stitch_function *stitch_fns = NULL;
+static unsigned num_stitch_fns = 0;
+
+/* -- evaluating a shader by folding it -------------------------------------
+ *
+ * For the class of shader that only reads buffers and computes -- 256 of the
+ * corpus's 271 fragment shaders -- the whole thing folds to constants once the
+ * buffer loads are replaced by the bytes actually in the buffers. No
+ * interpreter is needed: NIR's own constant folding is the interpreter, and
+ * what comes out can be compared against LLVM's answer for the same bytes
+ * (tools/air/cpuref.py). This is the check docs/air.md section 4 calls the
+ * strongest one, and it needs no GPU.
+ */
+
+/* The argument buffer of a wrapped library function holds floats, not the byte
+ * pattern.
+ *
+ * Every one of these functions is compiled with no-nans-fp-math and
+ * no-infs-fp-math: the module promises its inputs are finite. Arbitrary bytes
+ * are mostly not -- they are infinities, NaNs and denormals -- so the inputs
+ * would land outside the contract the shader was compiled under, where
+ * 0 * inf may legally be either NaN or inf and a disagreement means nothing.
+ * One case did disagree exactly there (folded NaN, softpipe +inf) and said
+ * nothing about either side.
+ *
+ * Word w is ((w * 13) % 29 - 14) / 4: finite, exactly representable in
+ * binary32, and different for 29 words running -- so a harness that mixed up
+ * two slots, or two lanes of one slot, would get a different answer. cpuref.py
+ * fills the same words.
+ */
+static uint8_t
+library_byte(unsigned i)
+{
+   float f = (float)((int)((i / 4 * 13) % 29) - 14) / 4.0f;
+   uint32_t u;
+   memcpy(&u, &f, sizeof(u));
+   return (u >> (8 * (i % 4))) & 0xff;
+}
+
+/* the same pattern cpuref.py fills its buffers with */
+static uint8_t
+pattern_byte(unsigned i)
+{
+   /* A stitched graph reads the wrapper's argument slots, so it is filled the
+    * wrapper's way. Not a detail: with the byte pattern a one-node graph gave
+    * `1 0 0 1` where the wrapper gave `4.5 0 0 1` for the same function, which
+    * reads exactly like a mistranslation and was two harnesses handing the
+    * same shader different numbers.
+    */
+   return (library_wrapper || stitch) ? library_byte(i) : (i * 7 + 13) & 0xff;
+}
+
+struct eval_state {
+   struct air_shader_info *info;
+   bool folded_a_load;
+};
+
+static bool
+fold_buffer_loads(struct nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   struct eval_state *st = data;
+   if (intr->intrinsic != nir_intrinsic_load_ubo && intr->intrinsic != nir_intrinsic_load_ssbo)
+      return false;
+
+   unsigned isrc = 0, osrc = 1;
+   if (!nir_src_is_const(intr->src[isrc]) || !nir_src_is_const(intr->src[osrc]))
+      return false;
+   unsigned index = nir_src_as_uint(intr->src[isrc]);
+   unsigned offset = nir_src_as_uint(intr->src[osrc]);
+
+   /* only a buffer the interface actually declared, and only within its size */
+   unsigned size = 0;
+   bool found = false;
+   for (unsigned i = 0; i < st->info->num_resources; i++) {
+      const struct air_resource *r = &st->info->resources[i];
+      bool want = intr->intrinsic == nir_intrinsic_load_ubo
+                     ? r->kind == AIR_RESOURCE_CONSTANT_BUFFER
+                     : r->kind == AIR_RESOURCE_DEVICE_BUFFER;
+      if (want && r->index == index) {
+         size = r->size ? r->size : 256;
+         found = true;
+         break;
+      }
+   }
+   if (!found)
+      return false;
+
+   unsigned bytes = intr->def.num_components * intr->def.bit_size / 8;
+   if (offset + bytes > size)
+      return false;
+
+   nir_const_value v[NIR_MAX_VEC_COMPONENTS] = { 0 };
+   for (unsigned c = 0; c < intr->def.num_components; c++) {
+      uint64_t bits = 0;
+      unsigned nb = intr->def.bit_size / 8;
+      for (unsigned k = 0; k < nb; k++)
+         bits |= (uint64_t)pattern_byte(offset + c * nb + k) << (8 * k);
+      v[c].u64 = bits;
+   }
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *imm = nir_build_imm(b, intr->def.num_components, intr->def.bit_size, v);
+   nir_def_replace(&intr->def, imm);
+   st->folded_a_load = true;
+   return true;
+}
+
+/* print one stored output value, if it folded to a constant */
+static void
+print_output(nir_variable *var, nir_def *value)
+{
+   printf("  %-24s ", var->name ? var->name : "?");
+   if (!nir_src_is_const(nir_src_for_ssa(value))) {
+      printf("did not fold to a constant\n");
+      return;
+   }
+   const struct glsl_type *t = glsl_without_array(var->type);
+   bool is_float = glsl_get_base_type(t) == GLSL_TYPE_FLOAT ||
+                   glsl_get_base_type(t) == GLSL_TYPE_FLOAT16;
+   for (unsigned c = 0; c < value->num_components; c++) {
+      uint64_t bits = nir_src_comp_as_uint(nir_src_for_ssa(value), c);
+      if (is_float && value->bit_size == 32) {
+         float f;
+         uint32_t u = bits;
+         memcpy(&f, &u, 4);
+         printf("%s%.9g", c ? " " : "", (double)f);
+      } else if (is_float && value->bit_size == 16) {
+         printf("%s0x%04" PRIx64, c ? " " : "", bits);
+      } else {
+         printf("%s%" PRIu64, c ? " " : "", bits);
+      }
+   }
+   printf("\n");
+}
+
+/* A wrapped library function returns its value by storing it to a buffer, not
+ * to a shader output, so --eval has to read it from there. The type name comes
+ * from Apple's own air.visible_output metadata, carried on the resource: how
+ * to print the bytes is not something this can infer from a store.
+ */
+static unsigned
+print_buffer_stores(nir_shader *nir, const struct air_shader_info *info)
+{
+   unsigned printed = 0;
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic != nir_intrinsic_store_ssbo)
+               continue;
+            if (!nir_src_is_const(intr->src[1]))
+               continue;
+            unsigned index = nir_src_as_uint(intr->src[1]);
+            const char *type_name = NULL;
+            for (unsigned i = 0; i < info->num_resources; i++) {
+               const struct air_resource *r = &info->resources[i];
+               if (r->kind == AIR_RESOURCE_DEVICE_BUFFER && r->index == index && r->write)
+                  type_name = r->type_name;
+            }
+            nir_def *value = intr->src[0].ssa;
+            printf("  buffer%u%*s", index, 18, "");
+            if (!nir_src_is_const(nir_src_for_ssa(value))) {
+               printf("did not fold to a constant\n");
+               printed++;
+               continue;
+            }
+            bool is_float = !type_name || strstr(type_name, "float") ||
+                            strstr(type_name, "half");
+            for (unsigned c = 0; c < value->num_components; c++) {
+               uint64_t bits = nir_src_comp_as_uint(nir_src_for_ssa(value), c);
+               if (is_float && value->bit_size == 32) {
+                  float f;
+                  uint32_t u = bits;
+                  memcpy(&f, &u, 4);
+                  printf("%s%.9g", c ? " " : "", (double)f);
+               } else if (is_float && value->bit_size == 16) {
+                  printf("%s0x%04" PRIx64, c ? " " : "", bits);
+               } else {
+                  printf("%s%" PRIu64, c ? " " : "", bits);
+               }
+            }
+            printf("\n");
+            printed++;
+         }
+      }
+   }
+   return printed;
+}
+
+/* THE CONSTANTS A PIPELINE WOULD HAVE SUPPLIED, for `--fc INDEX=VALUE`.
+ *
+ * Without this the only constant set this tool can translate against is the
+ * one air_module_function_constants builds -- every declared constant, value
+ * zero, `supplied` false -- and that is not any pipeline's. It matters because
+ * which blocks a shader even HAS now depends on them (plan_global_folding in
+ * air_to_nir.c), so "does this module translate" is a question about a
+ * configuration and not about the module alone: fixed_frag_lph_cph stops in
+ * three different places under three different constant sets.
+ *
+ * air_run has had this option for a while and is the wrong place to reproduce
+ * a translation from: it runs the shader, so a module softpipe cannot execute
+ * -- which this one cannot -- aborts in the Gallium driver before anything is
+ * printed, and the translation's own verdict is lost with the buffer.
+ *
+ * 64 and not 32 because fixed_frag_lph_cph declares 58 (the same bound as
+ * fc_set in air_run.c and RW_MAX_CONSTANTS in air_metal.h).
+ */
+static struct {
+   unsigned index;
+   uint64_t bits;
+} fc_set[64];
+static unsigned num_fc_set;
+
+/* An index the module does not declare is refused rather than ignored: an
+ * option that silently sets nothing would make every run agree with every
+ * other one for the wrong reason. Mirrors air_run's apply_fc_values.
+ */
+static bool
+apply_fc_set(struct air_constant_value *fc, unsigned num_fc)
+{
+   for (unsigned i = 0; i < num_fc_set; i++) {
+      unsigned j;
+      for (j = 0; j < num_fc; j++) {
+         if (fc[j].index == fc_set[i].index) {
+            fc[j].bits = fc_set[i].bits;
+            fc[j].supplied = true;
+            break;
+         }
+      }
+      if (j == num_fc) {
+         fprintf(stderr, "air2nir: this module declares no function constant %u "
+                         "(it declares %u)\n", fc_set[i].index, num_fc);
+         return false;
+      }
+   }
+   return true;
+}
+
+static int
+eval_module(const struct module_ref *mod)
+{
+   void *ctx = ralloc_context(NULL);
+   const char *err = NULL;
+   struct air_constant_value *fc;
+   unsigned num_fc = air_module_function_constants(ctx, mod->bitcode, mod->size, &fc);
+   if (!apply_fc_set(fc, num_fc))
+      return false;
+   struct air_to_nir_options options = { .constants = fc, .num_constants = num_fc,
+                                        .library_wrapper = library_wrapper,
+                                        .stitch = stitch,
+                                        .stitch_functions = stitch_fns,
+                                        .num_stitch_functions = num_stitch_fns };
+   struct air_shader_info info;
+   nir_shader *nir = air_to_nir(ctx, mod->bitcode, mod->size, NULL, &options,
+                                &default_options, &info, &err);
+   if (!nir) {
+      fprintf(stderr, "air2nir: %s: %s\n", mod->name, err);
+      ralloc_free(ctx);
+      return 1;
+   }
+
+   printf("eval: %s (%s), buffers filled with (i * 7 + 13) & 0xff\n", info.entry_point,
+          gl_shader_stage_name(info.stage));
+   for (unsigned i = 0; i < info.num_resources; i++) {
+      const struct air_resource *r = &info.resources[i];
+      if (r->kind == AIR_RESOURCE_CONSTANT_BUFFER || r->kind == AIR_RESOURCE_DEVICE_BUFFER)
+         printf("  %s buffer at index %u, %u bytes\n",
+                r->kind == AIR_RESOURCE_CONSTANT_BUFFER ? "constant" : "device",
+                r->index, r->size);
+   }
+
+   struct eval_state st = { .info = &info };
+   nir_shader_intrinsics_pass(nir, fold_buffer_loads, nir_metadata_control_flow, &st);
+
+   /* Fold what the loads made foldable, and nothing else: no algebraic
+    * rewriting, so the arithmetic is IEEE and comparable with LLVM's.
+    *
+    * Control flow is simplified, though, and that is not a rewriting of any
+    * arithmetic: once a comparison has folded, the branch under it is dead and
+    * the phi below it has one live source. Without this, 20 of the corpus's
+    * library functions had no folded value at all -- every one of them is
+    * straight-line arithmetic behind one `if` -- and a shader with a branch
+    * could never be compared against LLVM, which has no such trouble.
+    *
+    * Dead vector components are dropped for the same reason, and it is the
+    * same kind of reason: an `insertelement undef, x, 0` arrives as
+    * `vec3 x, undef.y, undef.z`, and a vector with one undefined component in
+    * it is not a constant, so the fold stopped there and took everything
+    * downstream with it -- although nothing ever reads that component.
+    * nir_opt_shrink_vectors removes exactly the components nothing reads and
+    * rewrites the swizzles; the lanes that remain are computed by the same
+    * instruction over the same bits, so no arithmetic is touched. Four more of
+    * the library functions reduce to a value with it: the LLVM comparison of
+    * the exactly-defined ones went from 54 of 57 to 57 of 57 (and the three
+    * missing sides were ours, not LLVM's), and the softpipe comparison from
+    * 120 to 124 -- with the 255 entry points that already agreed with LLVM
+    * still agreeing, bit for bit, which is what says the pass changed no
+    * number anywhere.
+    */
+   bool progress;
+   unsigned rounds = 0;
+   do {
+      progress = false;
+      NIR_PASS(progress, nir, nir_copy_prop);
+      NIR_PASS(progress, nir, nir_opt_constant_folding);
+      NIR_PASS(progress, nir, nir_opt_dce);
+      NIR_PASS(progress, nir, nir_lower_vars_to_ssa);
+      NIR_PASS(progress, nir, nir_opt_dead_cf);
+      NIR_PASS(progress, nir, nir_opt_if, nir_opt_if_optimize_phi_true_false);
+      NIR_PASS(progress, nir, nir_opt_shrink_vectors, false);
+   } while (progress && ++rounds < 16);
+
+   printf("eval: the outputs this shader stores:\n");
+   unsigned printed = 0;
+   printed += print_buffer_stores(nir, &info);
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic != nir_intrinsic_store_deref)
+               continue;
+            nir_deref_instr *deref = nir_src_as_deref(intr->src[0]);
+            if (!deref || deref->deref_type != nir_deref_type_var)
+               continue;
+            print_output(deref->var, intr->src[1].ssa);
+            printed++;
+         }
+      }
+   }
+   if (!printed)
+      printf("  (none: every store was removed, or none folded)\n");
+   ralloc_free(ctx);
+   return 0;
+}
+
+static void
+one_line(const char *s, FILE *fp)
+{
+   for (; *s; s++)
+      fputc(*s == '\n' || *s == '\t' ? ' ' : *s, fp);
+}
+
+/* --interface: what air_shader_info says the shader expects of the runtime,
+ * which nir_print_shader cannot show because it is not in the NIR. Its own
+ * mode rather than a line added to the others: the report's lines are parsed
+ * by tools/air/corpus.py and the translated NIR by tools/air/fbfetchcheck.py,
+ * and a field added to either would move numbers that are a baseline.
+ *
+ * One `key=value` per line, tab-separated, so a check can read it.
+ */
+static int
+interface_module(const struct module_ref *mod)
+{
+   void *ctx = ralloc_context(NULL);
+   const char *err = NULL;
+   struct air_constant_value *fc;
+   unsigned num_fc = air_module_function_constants(ctx, mod->bitcode, mod->size, &fc);
+   if (!apply_fc_set(fc, num_fc))
+      return false;
+   struct air_to_nir_options options = { .constants = fc, .num_constants = num_fc,
+                                        .library_wrapper = library_wrapper,
+                                        .stitch = stitch,
+                                        .stitch_functions = stitch_fns,
+                                        .num_stitch_functions = num_stitch_fns };
+   struct air_shader_info info;
+   nir_shader *nir = air_to_nir(ctx, mod->bitcode, mod->size, NULL, &options,
+                                &default_options, &info, &err);
+   if (!nir) {
+      fprintf(stderr, "air2nir: %s: %s\n", mod->name, err);
+      ralloc_free(ctx);
+      return 1;
+   }
+
+   printf("entry=%s\tstage=%s\n", info.entry_point, gl_shader_stage_name(info.stage));
+   printf("inputs_read=0x%" PRIx64 "\n", (uint64_t)nir->info.inputs_read);
+   printf("vertex_attributes=%u\tvertex_attributes_read=0x%x\n",
+          info.num_vertex_attributes, info.vertex_attributes_read);
+   for (unsigned i = 0; i < info.num_vertex_attributes; i++) {
+      const struct air_vertex_attribute *a = &info.vertex_attributes[i];
+      printf("attribute\tindex=%u\tlocation=%s\tdriver_location=%d\tcomponents=%u"
+             "\tbits=%u\ttype=%s\tname=%s\tdecl=%s\tused=%s\tfc=%s\n",
+             a->index, gl_vert_attrib_name((gl_vert_attrib)a->location),
+             a->driver_location == ~0u ? -1 : (int)a->driver_location, a->components,
+             a->bit_size,
+             a->base_type == AIR_ATTRIB_FLOAT ? "float" :
+             a->base_type == AIR_ATTRIB_UINT ? "uint" : "int",
+             a->name ? a->name : "-", a->type_name ? a->type_name : "-",
+             a->used ? "yes" : "no",
+             a->function_constant ? a->function_constant : "-");
+   }
+   for (unsigned i = 0; i < info.num_varyings; i++)
+      printf("varying\tslot=%u\tcomponents=%u\tname=%s\n", info.varyings[i].slot,
+             info.varyings[i].components,
+             info.varyings[i].name ? info.varyings[i].name : "-");
+   for (unsigned i = 0; i < info.num_resources; i++) {
+      const struct air_resource *r = &info.resources[i];
+      /* set and id are the Metal name of an argument-buffer member, which is
+       * the one case where index is this frontend's number and not Metal's --
+       * so a check can see both halves of the mapping and not just the one it
+       * would have guessed (tools/air/argbufcheck.py)
+       *
+       * write and ir_write are two readings of one fact and are printed apart
+       * for the same reason: write is what Metal declares the shader may do to
+       * the buffer, ir_write is what the translated IR does to it, and a
+       * runtime that serves an unaligned `device` buffer by uploading a copy
+       * needs the second one with the first beside it as a cross-check.
+       */
+      printf("resource\tkind=%d\tindex=%u\tsize=%u\tname=%s\tset=%d\tid=%d"
+             "\tread=%d\twrite=%d\tir_write=%d\n",
+             r->kind, r->index, r->size, r->name ? r->name : "-",
+             r->argbuf_set == ~0u ? -1 : (int)r->argbuf_set,
+             r->argbuf_id == ~0u ? -1 : (int)r->argbuf_id, r->read, r->write,
+             r->ir_write);
+   }
+   for (unsigned i = 0; i < info.num_notes; i++) {
+      fputs("note\t", stdout);
+      one_line(info.notes[i], stdout);
+      fputc('\n', stdout);
+   }
+   ralloc_free(ctx);
+   return 0;
+}
+
+/* tools/air/corpus.py reads these lines: tab-separated key=value */
+static void
+report_one(const struct module_ref *mod)
+{
+   void *ctx = ralloc_context(NULL);
+   const char *err = NULL, *calls = NULL;
+
+   printf("module=%s\tcontainer=%s", mod->name,
+          mod->container_type >= 0 ? air_metallib_type_name(mod->container_type) : "-");
+
+   struct air_module *m = air_module_read(ctx, mod->bitcode, mod->size, &err);
+   if (!m) {
+      printf("\treader=fail\terror=");
+      one_line(err, stdout);
+      printf("\n");
+      ralloc_free(ctx);
+      return;
+   }
+   printf("\treader=ok");
+
+   int stage = air_module_stage(ctx, mod->bitcode, mod->size, &calls, &err);
+   printf("\tstage=%s\tcalls=", stage_name(stage));
+   for (const char *c = calls; c && *c; c += strlen(c) + 1)
+      printf("%s%s", c == calls ? "" : ",", c);
+
+   /* Function constants are values the API supplies at pipeline creation. The
+    * report has no API, so it compiles with every one set to zero and says so:
+    * a module that needs values is not a module the translator cannot handle.
+    */
+   struct air_constant_value *fc;
+   unsigned num_fc = air_module_function_constants(ctx, mod->bitcode, mod->size, &fc);
+   if (!apply_fc_set(fc, num_fc))
+      return;
+   struct air_to_nir_options options = { .constants = fc, .num_constants = num_fc,
+                                        .library_wrapper = library_wrapper,
+                                        .stitch = stitch,
+                                        .stitch_functions = stitch_fns,
+                                        .num_stitch_functions = num_stitch_fns };
+   if (num_fc)
+      printf("\tfc=%u", num_fc);
+
+   struct air_shader_info info;
+   nir_shader *nir = air_to_nir(ctx, mod->bitcode, mod->size, NULL, &options, &default_options,
+                                &info, &err);
+   if (!nir) {
+      printf("\ttranslate=fail\terror=");
+      one_line(err, stdout);
+      printf("\n");
+      ralloc_free(ctx);
+      return;
+   }
+   nir_validate_shader(nir, "after air_to_nir");
+   unsigned instrs = 0;
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block)
+            instrs++;
+      }
+   }
+   printf("\ttranslate=ok\tnir_instrs=%u", instrs);
+   /* What was translated with a caveat: the shader was accepted and something
+    * other than exactly what it asked for was done (air_shader_info.notes).
+    * On the report line rather than on stderr, because the report is the only
+    * output anything parses, and a caveat nobody can count is the silence this
+    * channel exists to end.
+    */
+   for (unsigned i = 0; i < info.num_notes; i++) {
+      fputs(i ? ";" : "\tnotes=", stdout);
+      one_line(info.notes[i], stdout);
+   }
+   printf("\n");
+   ralloc_free(nir);
+   ralloc_free(ctx);
+}
+
+int
+main(int argc, char **argv)
+{
+   enum { TRANSLATE, LL, LIST, REPORT, EVAL, INTERFACE } mode = TRANSLATE;
+   int i = 1;
+   const char *stitch_text = NULL;
+   while (i < argc && (!strcmp(argv[i], "--library") ||
+                       (!strcmp(argv[i], "--fc") && i + 1 < argc) ||
+                       (!strcmp(argv[i], "--stitch") && i + 1 < argc))) {
+      if (!strcmp(argv[i], "--library")) {
+         library_wrapper = true, i++;
+      } else if (!strcmp(argv[i], "--fc")) {
+         unsigned idx = 0;
+         unsigned long long val = 0;
+         if (sscanf(argv[i + 1], "%u=0x%llx", &idx, &val) != 2 &&
+             sscanf(argv[i + 1], "%u=%llu", &idx, &val) != 2) {
+            fprintf(stderr, "air2nir: --fc wants INDEX=VALUE, decimal or 0x\n");
+            return 2;
+         }
+         if (num_fc_set >= ARRAY_SIZE(fc_set)) {
+            fprintf(stderr, "air2nir: more than %u function constants\n",
+                    (unsigned)ARRAY_SIZE(fc_set));
+            return 2;
+         }
+         fc_set[num_fc_set].index = idx;
+         fc_set[num_fc_set].bits = val;
+         num_fc_set++;
+         i += 2;
+      } else {
+         stitch_text = argv[i + 1], i += 2;
+      }
+   }
+   if (i < argc && !strcmp(argv[i], "--ll"))
+      mode = LL, i++;
+   else if (i < argc && !strcmp(argv[i], "--list"))
+      mode = LIST, i++;
+   else if (i < argc && !strcmp(argv[i], "--report"))
+      mode = REPORT, i++;
+   else if (i < argc && !strcmp(argv[i], "--eval"))
+      mode = EVAL, i++;
+   else if (i < argc && !strcmp(argv[i], "--interface"))
+      mode = INTERFACE, i++;
+   if (i >= argc) {
+      fprintf(stderr,
+              "usage: air2nir [--library] [--stitch GRAPH] "
+              "[--ll | --list | --report | --eval | --interface] "
+              "FILE [FUNCTION]\n"
+              "       GRAPH is \"f(in0); g(n0)\": one node per `;', arguments inN, nN, "
+              "texN, sampN, bufN\n");
+      return 2;
+   }
+
+   glsl_type_singleton_init_or_ref();
+   void *ctx = ralloc_context(NULL);
+   int status = 0;
+
+   /* The module translated is the OUTPUT node's: a stitched graph is still
+    * handed to air_to_nir as one module plus a graph, and that module has to
+    * be one of the graph's own functions.
+    */
+   const char *only = NULL;
+   if (stitch_text) {
+      char why[256] = { 0 };
+      size_t size = 0;
+      const uint8_t *data = map_file(argv[i], &size);
+      stitch = air_stitch_parse(ctx, stitch_text, why, sizeof(why));
+      if (stitch && data)
+         num_stitch_fns = air_stitch_functions_of(ctx, stitch, data, size, &stitch_fns,
+                                                  why, sizeof(why));
+      if (!stitch || !data || !num_stitch_fns) {
+         fprintf(stderr, "air2nir: --stitch: %s\n", why[0] ? why : "no functions");
+         ralloc_free(ctx);
+         glsl_type_singleton_decref();
+         return 2;
+      }
+      only = stitch->nodes[stitch->output_node].function;
+   }
+
+   if (mode == REPORT) {
+      setvbuf(stdout, NULL, _IOLBF, 0);
+      for (; i < argc; i++) {
+         struct module_ref *mods;
+         unsigned n = modules_of(ctx, argv[i], NULL, &mods);
+         for (unsigned k = 0; k < n; k++) {
+            fflush(stdout);
+            pid_t pid = fork();
+            if (pid == 0) {
+               alarm(60);
+               report_one(&mods[k]);
+               fflush(stdout);
+               _exit(0);
+            }
+            int ws;
+            waitpid(pid, &ws, 0);
+            if (!WIFEXITED(ws) || WEXITSTATUS(ws) != 0)
+               printf("module=%s\tcrash=%s %d\n", mods[k].name,
+                      WIFSIGNALED(ws) ? "signal" : "exit",
+                      WIFSIGNALED(ws) ? WTERMSIG(ws) : WEXITSTATUS(ws));
+         }
+      }
+      ralloc_free(ctx);
+      glsl_type_singleton_decref();
+      return 0;
+   }
+
+   struct module_ref *mods;
+   unsigned n = modules_of(ctx, argv[i],
+                           only ? only : i + 1 < argc ? argv[i + 1] : NULL, &mods);
+   if (n == 0)
+      return 1;
+
+   for (unsigned k = 0; k < n; k++) {
+      const char *err = NULL;
+      if (mode == EVAL) {
+         status |= eval_module(&mods[k]);
+         continue;
+      }
+      if (mode == INTERFACE) {
+         status |= interface_module(&mods[k]);
+         continue;
+      }
+      if (mode == LIST) {
+         printf("%-60s %-12s %zu\n", mods[k].name,
+                air_metallib_type_name(mods[k].container_type), mods[k].size);
+         continue;
+      }
+      if (mode == LL) {
+         struct air_module *m = air_module_read(ctx, mods[k].bitcode, mods[k].size, &err);
+         if (!m) {
+            fprintf(stderr, "air2nir: %s: %s\n", mods[k].name, err);
+            status = 1;
+            continue;
+         }
+         air_module_print(m, stdout);
+         continue;
+      }
+      struct air_constant_value *fc;
+      unsigned num_fc = air_module_function_constants(ctx, mods[k].bitcode, mods[k].size, &fc);
+      if (!apply_fc_set(fc, num_fc))
+         return 1;
+      struct air_to_nir_options options = { .constants = fc, .num_constants = num_fc,
+                                            .library_wrapper = library_wrapper,
+                                            .stitch = stitch,
+                                            .stitch_functions = stitch_fns,
+                                            .num_stitch_functions = num_stitch_fns };
+      struct air_shader_info info;
+      nir_shader *nir = air_to_nir(ctx, mods[k].bitcode, mods[k].size, NULL, &options,
+                                   &default_options, &info, &err);
+      if (!nir) {
+         fprintf(stderr, "air2nir: %s: %s\n", mods[k].name, err);
+         status = 1;
+         continue;
+      }
+      nir_print_shader(nir, stdout);
+   }
+
+   ralloc_free(ctx);
+   glsl_type_singleton_decref();
+   return status;
+}
diff --git a/src/compiler/air/air_bitcode.c b/src/compiler/air/air_bitcode.c
new file mode 100644
index 0000000..da092c9
--- /dev/null
+++ b/src/compiler/air/air_bitcode.c
@@ -0,0 +1,421 @@
+/*
+ * Copyright © 2026 Darwin on redwood contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "air_bitcode.h"
+
+#include <inttypes.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "util/macros.h"
+#include "util/ralloc.h"
+
+enum {
+   ABBREV_ID_END_BLOCK = 0,
+   ABBREV_ID_ENTER_SUBBLOCK = 1,
+   ABBREV_ID_DEFINE_ABBREV = 2,
+   ABBREV_ID_UNABBREV_RECORD = 3,
+   ABBREV_ID_FIRST = 4,
+};
+
+enum {
+   BLOCKINFO_BLOCK_ID = 0,
+   BLOCKINFO_CODE_SETBID = 1,
+};
+
+static void
+bs_fail(struct air_bitstream *bs, const char *fmt, ...)
+{
+   if (bs->error[0])
+      return; /* the first error is the one that explains */
+   va_list ap;
+   va_start(ap, fmt);
+   vsnprintf(bs->error, sizeof(bs->error), fmt, ap);
+   va_end(ap);
+   bs->pos = bs->size_bits;
+}
+
+static uint64_t
+read_fixed(struct air_bitstream *bs, unsigned width)
+{
+   if (width == 0)
+      return 0;
+   if (width > 64 || bs->pos + width > bs->size_bits) {
+      bs_fail(bs, "read of %u bits past the end at bit %" PRIu64, width, bs->pos);
+      return 0;
+   }
+
+   uint64_t v = 0;
+   unsigned got = 0;
+   while (got < width) {
+      unsigned bit = bs->pos & 7;
+      unsigned take = MIN2(8 - bit, width - got);
+      uint64_t chunk = (bs->data[bs->pos >> 3] >> bit) & ((1u << take) - 1);
+      v |= chunk << got;
+      got += take;
+      bs->pos += take;
+   }
+   return v;
+}
+
+static uint64_t
+read_vbr(struct air_bitstream *bs, unsigned width)
+{
+   if (width < 2 || width > 32) {
+      bs_fail(bs, "VBR width %u", width);
+      return 0;
+   }
+   const uint64_t hi = 1ull << (width - 1);
+   uint64_t v = 0;
+   unsigned shift = 0;
+   for (;;) {
+      uint64_t chunk = read_fixed(bs, width);
+      if (shift < 64)
+         v |= (chunk & (hi - 1)) << shift;
+      else if (chunk & (hi - 1))
+         bs_fail(bs, "VBR value wider than 64 bits");
+      if (!(chunk & hi) || bs->error[0])
+         return v;
+      shift += width - 1;
+   }
+}
+
+static void
+align32(struct air_bitstream *bs)
+{
+   bs->pos = MIN2(ALIGN_POT(bs->pos, 32), bs->size_bits);
+}
+
+static void
+list_add(void *mem_ctx, struct air_abbrev_list *l, struct air_abbrev *a)
+{
+   if (l->num == l->cap) {
+      l->cap = MAX2(8, l->cap * 2);
+      l->abbrevs = reralloc(mem_ctx, l->abbrevs, struct air_abbrev *, l->cap);
+   }
+   l->abbrevs[l->num++] = a;
+}
+
+static struct air_abbrev_list *
+blockinfo_for(struct air_bitstream *bs, unsigned block_id, bool create)
+{
+   for (unsigned i = 0; i < bs->num_blockinfo; i++) {
+      if (bs->blockinfo[i].block_id == block_id)
+         return &bs->blockinfo[i].abbrevs;
+   }
+   if (!create)
+      return NULL;
+   bs->blockinfo = reralloc(bs->mem_ctx, bs->blockinfo, __typeof__(*bs->blockinfo),
+                            bs->num_blockinfo + 1);
+   bs->blockinfo[bs->num_blockinfo].block_id = block_id;
+   memset(&bs->blockinfo[bs->num_blockinfo].abbrevs, 0, sizeof(struct air_abbrev_list));
+   return &bs->blockinfo[bs->num_blockinfo++].abbrevs;
+}
+
+static struct air_abbrev *
+read_abbrev(struct air_bitstream *bs)
+{
+   unsigned n = read_vbr(bs, 5);
+   struct air_abbrev *a = rzalloc(bs->mem_ctx, struct air_abbrev);
+   a->ops = rzalloc_array(bs->mem_ctx, struct air_abbrev_op, MAX2(n, 1));
+   for (unsigned i = 0; i < n && !bs->error[0]; i++) {
+      struct air_abbrev_op *op = &a->ops[a->num_ops++];
+      if (read_fixed(bs, 1)) {
+         op->kind = AIR_ABBREV_LITERAL;
+         op->value = read_vbr(bs, 8);
+         continue;
+      }
+      switch (read_fixed(bs, 3)) {
+      case 1:
+         op->kind = AIR_ABBREV_FIXED;
+         op->value = read_vbr(bs, 5);
+         break;
+      case 2:
+         op->kind = AIR_ABBREV_VBR;
+         op->value = read_vbr(bs, 5);
+         break;
+      case 3:
+         op->kind = AIR_ABBREV_ARRAY;
+         break;
+      case 4:
+         op->kind = AIR_ABBREV_CHAR6;
+         break;
+      case 5:
+         op->kind = AIR_ABBREV_BLOB;
+         break;
+      default:
+         bs_fail(bs, "unknown abbreviation encoding");
+         return a;
+      }
+      /* a zero-width fixed or VBR field reads nothing: it is the literal 0 */
+      if ((op->kind == AIR_ABBREV_FIXED || op->kind == AIR_ABBREV_VBR) && op->value == 0) {
+         op->kind = AIR_ABBREV_LITERAL;
+         op->value = 0;
+      }
+   }
+   return a;
+}
+
+static void
+push_op(struct air_bitstream *bs, unsigned *n, uint64_t v)
+{
+   if (*n == bs->ops_cap) {
+      bs->ops_cap = MAX2(64, bs->ops_cap * 2);
+      bs->ops = reralloc(bs->mem_ctx, bs->ops, uint64_t, bs->ops_cap);
+   }
+   bs->ops[(*n)++] = v;
+}
+
+static uint64_t
+read_scalar(struct air_bitstream *bs, const struct air_abbrev_op *op)
+{
+   static const char char6[] =
+      "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._";
+   switch (op->kind) {
+   case AIR_ABBREV_LITERAL:
+      return op->value;
+   case AIR_ABBREV_FIXED:
+      return read_fixed(bs, op->value);
+   case AIR_ABBREV_VBR:
+      return read_vbr(bs, op->value);
+   case AIR_ABBREV_CHAR6:
+      return char6[read_fixed(bs, 6)];
+   default:
+      bs_fail(bs, "array or blob where a scalar belongs");
+      return 0;
+   }
+}
+
+static struct air_bs_entry
+read_abbreviated(struct air_bitstream *bs, const struct air_abbrev *a)
+{
+   struct air_bs_entry e = { .kind = AIR_BS_RECORD };
+   unsigned n = 0;
+
+   if (a->num_ops == 0 || a->ops[0].kind == AIR_ABBREV_ARRAY || a->ops[0].kind == AIR_ABBREV_BLOB) {
+      bs_fail(bs, "abbreviation without a record code");
+      e.kind = AIR_BS_ERROR;
+      return e;
+   }
+   e.id = read_scalar(bs, &a->ops[0]);
+
+   for (unsigned i = 1; i < a->num_ops && !bs->error[0]; i++) {
+      const struct air_abbrev_op *op = &a->ops[i];
+      if (op->kind == AIR_ABBREV_ARRAY) {
+         if (i + 2 != a->num_ops) {
+            bs_fail(bs, "array not second to last in its abbreviation");
+            break;
+         }
+         unsigned len = read_vbr(bs, 6);
+         for (unsigned j = 0; j < len && !bs->error[0]; j++)
+            push_op(bs, &n, read_scalar(bs, &a->ops[i + 1]));
+         break;
+      } else if (op->kind == AIR_ABBREV_BLOB) {
+         uint64_t len = read_vbr(bs, 6);
+         align32(bs);
+         if (bs->pos + len * 8 > bs->size_bits) {
+            bs_fail(bs, "blob past the end");
+            break;
+         }
+         e.blob = bs->data + bs->pos / 8;
+         e.blob_size = len;
+         bs->pos += len * 8;
+         align32(bs);
+      } else {
+         push_op(bs, &n, read_scalar(bs, op));
+      }
+   }
+
+   e.num_ops = n;
+   e.ops = bs->ops;
+   if (bs->error[0])
+      e.kind = AIR_BS_ERROR;
+   return e;
+}
+
+static struct air_bs_scope *
+cur(struct air_bitstream *bs)
+{
+   return &bs->scopes[bs->depth];
+}
+
+bool
+air_bs_init(struct air_bitstream *bs, void *mem_ctx, const void *data, size_t size)
+{
+   memset(bs, 0, sizeof(*bs));
+   bs->mem_ctx = mem_ctx;
+   bs->data = data;
+   bs->size_bits = (uint64_t)size * 8;
+   bs->scope_cap = 16;
+   bs->scopes = rzalloc_array(mem_ctx, struct air_bs_scope, bs->scope_cap);
+   bs->scopes[0].block_id = ~0u;
+   bs->scopes[0].abbrev_width = 2;
+   bs->scopes[0].end_bit = bs->size_bits;
+
+   const uint8_t *b = data;
+   if (size < 4 || b[0] != 'B' || b[1] != 'C' || b[2] != 0xc0 || b[3] != 0xde) {
+      bs_fail(bs, "not LLVM bitcode (no 'BC' 0xC0DE magic)");
+      return false;
+   }
+   bs->pos = 32;
+   return true;
+}
+
+static bool
+read_blockinfo(struct air_bitstream *bs, unsigned width, uint64_t end)
+{
+   struct air_abbrev_list *target = NULL;
+   for (;;) {
+      if (bs->error[0] || bs->pos >= end)
+         return false;
+      unsigned id = read_fixed(bs, width);
+      if (id == ABBREV_ID_END_BLOCK) {
+         align32(bs);
+         return true;
+      } else if (id == ABBREV_ID_DEFINE_ABBREV) {
+         struct air_abbrev *a = read_abbrev(bs);
+         if (!target) {
+            bs_fail(bs, "BLOCKINFO abbreviation before SETBID");
+            return false;
+         }
+         list_add(bs->mem_ctx, target, a);
+      } else if (id == ABBREV_ID_UNABBREV_RECORD) {
+         unsigned code = read_vbr(bs, 6);
+         unsigned n = read_vbr(bs, 6);
+         uint64_t first = 0;
+         for (unsigned i = 0; i < n; i++) {
+            uint64_t v = read_vbr(bs, 6);
+            if (i == 0)
+               first = v;
+         }
+         if (code == BLOCKINFO_CODE_SETBID)
+            target = blockinfo_for(bs, first, true);
+         /* BLOCKNAME and SETRECORDNAME only name things for dumpers */
+      } else if (id == ABBREV_ID_ENTER_SUBBLOCK) {
+         bs_fail(bs, "a block inside BLOCKINFO");
+         return false;
+      } else {
+         bs_fail(bs, "an abbreviated record in BLOCKINFO");
+         return false;
+      }
+   }
+}
+
+struct air_bs_entry
+air_bs_next(struct air_bitstream *bs)
+{
+   for (;;) {
+      struct air_bs_entry e = { .kind = AIR_BS_ERROR };
+      struct air_bs_scope *s = cur(bs);
+
+      if (bs->error[0])
+         return e;
+      if (bs->depth == 0 && bs->pos + 32 > bs->size_bits) {
+         e.kind = AIR_BS_END;
+         return e;
+      }
+      if (bs->pos >= s->end_bit) {
+         bs_fail(bs, "block %u runs past its length", s->block_id);
+         return e;
+      }
+
+      unsigned id = read_fixed(bs, s->abbrev_width);
+      switch (id) {
+      case ABBREV_ID_END_BLOCK:
+         align32(bs);
+         if (bs->depth == 0) {
+            bs_fail(bs, "END_BLOCK at the top level");
+            return e;
+         }
+         bs->depth--;
+         e.kind = AIR_BS_END_BLOCK;
+         return e;
+
+      case ABBREV_ID_ENTER_SUBBLOCK: {
+         unsigned block_id = read_vbr(bs, 8);
+         bs->pending_width = read_vbr(bs, 4);
+         align32(bs);
+         uint64_t words = read_fixed(bs, 32);
+         bs->pending_end = bs->pos + words * 32;
+         if (bs->pending_end > bs->size_bits) {
+            bs_fail(bs, "block %u longer than the stream", block_id);
+            return e;
+         }
+         if (block_id == BLOCKINFO_BLOCK_ID) {
+            if (!read_blockinfo(bs, bs->pending_width, bs->pending_end))
+               return e;
+            continue;
+         }
+         e.kind = AIR_BS_ENTER_BLOCK;
+         e.id = block_id;
+         return e;
+      }
+
+      case ABBREV_ID_DEFINE_ABBREV:
+         list_add(bs->mem_ctx, &s->abbrevs, read_abbrev(bs));
+         continue;
+
+      case ABBREV_ID_UNABBREV_RECORD: {
+         unsigned n = 0;
+         e.kind = AIR_BS_RECORD;
+         e.id = read_vbr(bs, 6);
+         unsigned count = read_vbr(bs, 6);
+         for (unsigned i = 0; i < count && !bs->error[0]; i++)
+            push_op(bs, &n, read_vbr(bs, 6));
+         e.num_ops = n;
+         e.ops = bs->ops;
+         if (bs->error[0])
+            e.kind = AIR_BS_ERROR;
+         return e;
+      }
+
+      default:
+         if (id - ABBREV_ID_FIRST >= s->abbrevs.num) {
+            bs_fail(bs, "undefined abbreviation %u in block %u", id, s->block_id);
+            return e;
+         }
+         return read_abbreviated(bs, s->abbrevs.abbrevs[id - ABBREV_ID_FIRST]);
+      }
+   }
+}
+
+bool
+air_bs_enter(struct air_bitstream *bs, unsigned block_id)
+{
+   if (bs->depth + 1 == bs->scope_cap) {
+      bs->scope_cap *= 2;
+      bs->scopes = reralloc(bs->mem_ctx, bs->scopes, struct air_bs_scope, bs->scope_cap);
+   }
+   struct air_bs_scope *s = &bs->scopes[++bs->depth];
+   memset(s, 0, sizeof(*s));
+   s->block_id = block_id;
+   s->abbrev_width = bs->pending_width;
+   s->end_bit = bs->pending_end;
+
+   struct air_abbrev_list *info = blockinfo_for(bs, block_id, false);
+   if (info) {
+      for (unsigned i = 0; i < info->num; i++)
+         list_add(bs->mem_ctx, &s->abbrevs, info->abbrevs[i]);
+   }
+   return true;
+}
+
+bool
+air_bs_skip_block(struct air_bitstream *bs)
+{
+   bs->pos = bs->pending_end;
+   return true;
+}
+
+char *
+air_bs_ops_to_string(void *mem_ctx, const uint64_t *ops, unsigned n)
+{
+   char *s = ralloc_size(mem_ctx, n + 1);
+   for (unsigned i = 0; i < n; i++)
+      s[i] = (char)ops[i];
+   s[n] = 0;
+   return s;
+}
diff --git a/src/compiler/air/air_bitcode.h b/src/compiler/air/air_bitcode.h
new file mode 100644
index 0000000..2707c13
--- /dev/null
+++ b/src/compiler/air/air_bitcode.h
@@ -0,0 +1,129 @@
+/*
+ * Copyright © 2026 Darwin on redwood contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The LLVM bitstream: the container format below LLVM IR bitcode. It knows
+ * blocks, abbreviations and records, and nothing of what they mean; that is
+ * air_module.c's business. Written from the "LLVM Bitcode File Format"
+ * document, not from LLVM's sources, so that the frontend links no LLVM.
+ */
+
+#ifndef AIR_BITCODE_H
+#define AIR_BITCODE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum air_abbrev_op_kind {
+   AIR_ABBREV_LITERAL,
+   AIR_ABBREV_FIXED,
+   AIR_ABBREV_VBR,
+   AIR_ABBREV_ARRAY,
+   AIR_ABBREV_CHAR6,
+   AIR_ABBREV_BLOB,
+};
+
+struct air_abbrev_op {
+   enum air_abbrev_op_kind kind;
+   uint64_t value; /* the literal, or the width of FIXED/VBR */
+};
+
+struct air_abbrev {
+   unsigned num_ops;
+   struct air_abbrev_op *ops;
+};
+
+struct air_abbrev_list {
+   unsigned num, cap;
+   struct air_abbrev **abbrevs;
+};
+
+struct air_bs_scope {
+   unsigned block_id;
+   unsigned abbrev_width;
+   uint64_t end_bit;
+   struct air_abbrev_list abbrevs;
+};
+
+enum air_bs_entry_kind {
+   AIR_BS_ERROR,
+   AIR_BS_END,          /* end of the stream */
+   AIR_BS_ENTER_BLOCK,  /* .id; the caller enters it or skips it */
+   AIR_BS_END_BLOCK,
+   AIR_BS_RECORD,       /* .id is the record code, ops/blob below */
+};
+
+struct air_bs_entry {
+   enum air_bs_entry_kind kind;
+   unsigned id;
+   unsigned num_ops;
+   const uint64_t *ops;
+   const uint8_t *blob;
+   size_t blob_size;
+};
+
+struct air_bitstream {
+   void *mem_ctx;
+   const uint8_t *data;
+   uint64_t size_bits;
+   uint64_t pos;
+
+   unsigned depth, scope_cap;
+   struct air_bs_scope *scopes;
+
+   /* BLOCKINFO: the abbreviations that every block of an id starts with */
+   unsigned num_blockinfo;
+   struct {
+      unsigned block_id;
+      struct air_abbrev_list abbrevs;
+   } *blockinfo;
+
+   /* an ENTER_SUBBLOCK header, read but not yet entered or skipped */
+   unsigned pending_width;
+   uint64_t pending_end;
+
+   /* the current record's operands */
+   unsigned ops_cap;
+   uint64_t *ops;
+
+   char error[160];
+};
+
+/* data must be the bitstream itself: after the 0x0B17C0DE wrapper, starting
+ * with the 'BC' 0xC0DE magic, which this checks and skips.
+ */
+bool air_bs_init(struct air_bitstream *bs, void *mem_ctx,
+                 const void *data, size_t size);
+
+/* The next thing at the current level. Records of BLOCKINFO are taken in
+ * here and never returned; an ENTER_BLOCK must be followed by
+ * air_bs_enter() or air_bs_skip_block().
+ */
+struct air_bs_entry air_bs_next(struct air_bitstream *bs);
+bool air_bs_enter(struct air_bitstream *bs, unsigned block_id);
+bool air_bs_skip_block(struct air_bitstream *bs);
+
+/* Word offset (32-bit units) of the current position, for VSTOFFSET and
+ * function-entry offsets.
+ */
+static inline uint64_t
+air_bs_word_offset(const struct air_bitstream *bs)
+{
+   return bs->pos / 32;
+}
+
+/* Copies the operands of a record into a NUL-terminated string. */
+char *air_bs_ops_to_string(void *mem_ctx, const uint64_t *ops, unsigned n);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* AIR_BITCODE_H */
diff --git a/src/compiler/air/air_intrinsics.c b/src/compiler/air/air_intrinsics.c
new file mode 100644
index 0000000..11e26ce
--- /dev/null
+++ b/src/compiler/air/air_intrinsics.c
@@ -0,0 +1,2716 @@
+/*
+ * Copyright © 2026 Darwin on redwood contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The air.* functions. There are 125 distinct declarations in the corpus but
+ * their names are <operation>.<type suffix>, so this is a table of about 50
+ * operations in four families (docs/metal.md 9.2). The suffix is not trusted
+ * for anything: the types come from the call's own LLVM types, and the suffix
+ * is only what picks the handler.
+ *
+ * What each name means is not guessed: it is read off Apple's own compiler.
+ * AGXCompilerCore carries the whole vocabulary as a table of names at
+ * 0x16d082..0x16d400 of the library in this device's shared cache (the list is
+ * in docs/air.md section 3.2), and that table distinguishes exactly the
+ * functions the Metal Shading Language Specification defines -- round from
+ * rint, exp from exp2, fmod from mod, pow from powr. Two of this file's
+ * handlers were guesses before that table was read; one of them was wrong.
+ */
+
+#include "air_private.h"
+
+#include <string.h>
+
+#include "nir_builtin_builder.h"
+#include "util/u_math.h"
+
+/* the dot-separated parts of an air.* name, after "air." */
+#define AIR_MAX_PARTS 8
+/* 48 and not 32: air.normalize_function_constant_predicate's first part is 37
+ * characters, and at 32 split_name refused the whole name rather than the
+ * operation -- "a name this cannot take apart", which reads like a malformed
+ * module and was a buffer. It is the longest part in Apple's own vocabulary
+ * list (section 3.2); the longest multi-part name there,
+ * air.next_intersection_query.instancing.triangle_data, has no part over 14.
+ */
+struct air_name {
+   unsigned num;
+   char part[AIR_MAX_PARTS][48];
+};
+
+static bool
+split_name(const char *name, struct air_name *out)
+{
+   out->num = 0;
+   out->part[0][0] = 0;
+   const char *p = name + 4; /* past "air." */
+   /* "air." with nothing after it names no operation. Without this the loop
+    * below never runs, split_name returns true all the same, and the
+    * dispatcher compares a part[0] nothing wrote -- which gcc points out as
+    * soon as the first comparison is made unconditionally.
+    */
+   if (!*p)
+      return false;
+   while (*p && out->num < AIR_MAX_PARTS) {
+      const char *dot = strchr(p, '.');
+      size_t len = dot ? (size_t)(dot - p) : strlen(p);
+      if (len >= sizeof(out->part[0]))
+         return false;
+      memcpy(out->part[out->num], p, len);
+      out->part[out->num][len] = 0;
+      out->num++;
+      if (!dot)
+         return true;
+      p = dot + 1;
+   }
+   return out->num < AIR_MAX_PARTS;
+}
+
+static bool
+is_signed_part(const char *s)
+{
+   return !strcmp(s, "s");
+}
+
+/* Metal's fmod: the remainder of x/y, with the SIGN OF x, correctly rounded.
+ *
+ * nir_frem is not that function. Its constant expression is, literally,
+ *
+ *     src0 - src1 * truncf(src0 / src1)                (nir_opcodes.py)
+ *
+ * and ir3 lowers it to the same three instructions (ir3_compiler.c sets
+ * .lower_fmod). Two things are wrong with the formula, and
+ * tools/air/intrincheck.py counted both: of 264 cases of air.fmod.f32 it
+ * reported 47 wrong, 25 of them a sign and 22 of them a number.
+ *
+ *   - THE SIGN OF A ZERO IS LOST. fmod(-0, 5) is -0 and fmod(-1.5, 0.5) is
+ *     -0, and the subtraction gives +0 for both: -0 - (0.5 * -0) is -0 - -0,
+ *     which is +0. This is the shape of the air.sign bug recorded further
+ *     down this file -- a sign of zero that a formula does not carry -- and
+ *     it is the half of this that is not about precision at all.
+ *   - THE PRODUCT IS ROUNDED BEFORE THE SUBTRACTION. y * trunc(x/y) needs up
+ *     to 48 significant bits and a float has 24, so the subtraction is exact
+ *     but of the wrong product: fmod(1.5, 0x1.fffffep-2) came out 1.19e-07
+ *     against 8.94e-08, one whole ulp of the dividend, and fmod(1e8, 3) came
+ *     out 0 where the answer is 1. A number, not a sign.
+ *
+ * Whose definition is followed here, and why it is Metal's: the Metal Shading
+ * Language Specification's table entry for fmod gives the same subtraction
+ * formula, but it inherits OpenCL's accuracy table along with it, where fmod
+ * is 0 ULP -- an exactly specified function, not a licensed approximation --
+ * and OpenCL's edge cases are C99 Annex F's, which say fmod(+-0, y) is +-0.
+ * Two references on this machine agree with that reading and none with the
+ * formula: this machine's libm answers -0 for fmodf(-0, 0.5) and for
+ * fmodf(-1.5, 0.5), and LLVM's own `frem` -- JIT-executed by lli, which is
+ * the second engine and not a reading of a document -- answers -0 for both
+ * and for frem(-2.5, -0.5). The corpus itself says nothing either way: not
+ * one of its 128 libraries contains a single `frem` instruction, because
+ * Apple's compiler always emits the call.
+ *
+ * So:
+ *
+ *   q = trunc(x / y)
+ *   r = fma(-y, q, x)        one rounding, not two
+ *   if (|r| >= |y|)   r -= copysign(|y|, r)      q was one too small
+ *   if (sign r != sign x) r += copysign(|y|, x)  q was one too large
+ *   if (r == 0)       r  = copysign(0, x)        a zero keeps x's sign
+ *
+ * The fma is the whole of the precision argument: when q is an exact integer
+ * the true remainder x - q*y is itself exactly representable (that is why
+ * IEEE 754 can require `remainder` to be exact), so ONE rounding of it is no
+ * rounding at all. The two corrections are there because fl(x/y) can round
+ * across an integer and move trunc by one either way, and because ir3 does
+ * not divide: it lowers fdiv to fmul(a, frcp(b)) and frcp is approximate, so
+ * a quotient off by one has to be survivable rather than assumed away.
+ *
+ * WHAT THIS STILL DOES NOT DO, measured and not guessed: q must be exactly
+ * representable, which means |x/y| < 2^24 for a float and 2^11 for a half.
+ * Above that no correction of a bounded size can help -- fmod(1e8, 1e-8)
+ * wants a quotient of 1e16 -- and the exact answer needs an iterated
+ * reduction: scale y up by 2^k so the partial quotient stays under 2^23,
+ * subtract, repeat. Each pass removes only 23 - 1 bits of the exponent
+ * difference, that difference reaches 253 for two normal floats, so twelve
+ * passes of about ten instructions each would be the price, and its exactness
+ * ON THE ADRENO could not be established from this machine at all for the
+ * frcp reason above. It is not done here; section 4 of docs/air.md carries
+ * the condition and the measurement.
+ *
+ * Over the reference pool this leaves 7 of 264 cases differing, every one of
+ * them with |x/y| >= 2^24; over 195 906 random pairs of normal floats every
+ * single disagreement with this machine's libm has |x/y| >= 2^24, and over
+ * 376 438 random pairs whose quotient IS representable there is none.
+ */
+static nir_def *
+air_fmod(nir_builder *b, nir_def *x, nir_def *y)
+{
+   uint64_t sign_bit = 1ull << (x->bit_size - 1);
+   /* The sign of a float is taken and planted with integer bit operations and
+    * never with a multiply by zero or a copysign built out of one: this
+    * builder runs with exact off (Metal's fast library), and
+    * nir_opt_algebraic's inexact rule (('~fmul', a, 0.0), 0.0) would throw
+    * away exactly the bit being carried. iand and ior cannot be rewritten by
+    * a float rule because they are not float operations.
+    */
+   nir_def *sx = nir_iand_imm(b, x, sign_bit);
+   nir_def *ay = nir_fabs(b, y);
+   nir_def *y_as_x = nir_ior(b, ay, sx);              /* copysign(|y|, x) */
+
+   nir_def *q = nir_ftrunc(b, nir_fdiv(b, x, y));
+   nir_def *r = nir_ffma(b, nir_fneg(b, y), q, x);
+
+   /* |r| >= |y|: the quotient was one too small. A NaN fails this comparison
+    * (an ordered fge is false for one) and fails the feq against zero at the
+    * end; the middle correction may well fire for a NaN, and adding to a NaN
+    * gives a NaN, so a NaN comes out of all three unchanged.
+    */
+   nir_def *y_as_r = nir_ior(b, ay, nir_iand_imm(b, r, sign_bit));
+   r = nir_bcsel(b, nir_fge(b, nir_fabs(b, r), ay), nir_fsub(b, r, y_as_r), r);
+
+   /* r's sign is not x's: the quotient was one too large */
+   nir_def *wrong_sign = nir_ine(b, nir_iand_imm(b, r, sign_bit), sx);
+   r = nir_bcsel(b, nir_iand(b, wrong_sign, nir_fneu_imm(b, r, 0.0)),
+                 nir_fadd(b, r, y_as_x), r);
+
+   /* and a zero result is the dividend's zero */
+   return nir_bcsel(b, nir_feq_imm(b, r, 0.0), sx, r);
+}
+
+/* -- the families ------------------------------------------------------- */
+
+static bool
+math_op(struct air_ctx *c, const struct air_inst *in, const struct air_name *n, bool *handled)
+{
+   const char *op = n->part[0];
+   unsigned argc = in->num_operands - 1;
+
+   /* the families this file does not handle are named before the arguments
+    * are touched, so that their error says so rather than complaining about
+    * a texture handle used as a number
+    */
+   if (strstr(op, "texture") || strstr(op, "_depth_") || !strncmp(op, "sample", 6) ||
+       !strncmp(op, "gather", 6) || !strncmp(op, "read_", 5) || !strncmp(op, "write_", 6) ||
+       strstr(op, "_lod_")) {
+      *handled = false;
+      return true;
+   }
+
+   nir_def *a[4] = { 0 };
+   for (unsigned i = 0; i < argc && i < 4; i++)
+      if (!(a[i] = air_get_ssa(c, in->operands[1 + i])))
+         return false;
+
+   bool is_float = air_type_is_float(air_type_scalar(in->base.type));
+   /* the sign of an integer operation is the last-but-one part: air.min.s.i32 */
+   bool is_signed = n->num >= 3 ? is_signed_part(n->part[1]) : true;
+   nir_def *r = NULL;
+   *handled = true;
+
+   /* fast math is what every one of these means: Metal's "fast" library */
+   bool was_exact = c->b.exact;
+   c->b.exact = false;
+
+   if (!strcmp(op, "fast_fabs") || !strcmp(op, "fabs")) {
+      r = nir_fabs(&c->b, a[0]);
+   } else if (!strcmp(op, "fast_sqrt") || !strcmp(op, "sqrt")) {
+      r = nir_fsqrt(&c->b, a[0]);
+   } else if (!strcmp(op, "fast_rsqrt") || !strcmp(op, "rsqrt")) {
+      r = nir_frsq(&c->b, a[0]);
+   } else if (!strcmp(op, "fast_floor") || !strcmp(op, "floor")) {
+      r = nir_ffloor(&c->b, a[0]);
+   } else if (!strcmp(op, "fast_ceil") || !strcmp(op, "ceil")) {
+      r = nir_fceil(&c->b, a[0]);
+   } else if (!strcmp(op, "fast_round") || !strcmp(op, "round")) {
+      /* round() takes a half away from zero; rint() takes it to even, and
+       * Apple's compiler has both air.fast_round and air.fast_rint, so this
+       * one is not the even one. (It was nir_fround_even here until the
+       * vocabulary table said otherwise.)
+       *
+       * Truncate, then step one away from zero if the remainder reaches a
+       * half. Not trunc(x + copysign(0.5, x)): that addition rounds for an x
+       * just under a half and answers 1 where the answer is 0. x - trunc(x)
+       * is exact for every float, so this needs no magnitude guard, and it
+       * keeps the sign of a negative zero. Checked bit-exact against C's
+       * roundf over the halves, the sub-halves, both zeros and 2^24.
+       */
+      nir_def *t = nir_ftrunc(&c->b, a[0]);
+      nir_def *d = nir_fabs(&c->b, nir_fsub(&c->b, a[0], t));
+      r = nir_bcsel(&c->b, nir_fge_imm(&c->b, d, 0.5),
+                    nir_fadd(&c->b, t, nir_fsign(&c->b, a[0])), t);
+   } else if (!strcmp(op, "fast_rint") || !strcmp(op, "rint")) {
+      r = nir_fround_even(&c->b, a[0]);
+   } else if (!strcmp(op, "fast_trunc") || !strcmp(op, "trunc")) {
+      r = nir_ftrunc(&c->b, a[0]);
+   } else if (!strcmp(op, "fast_fract") || !strcmp(op, "fract")) {
+      r = nir_ffract(&c->b, a[0]);
+   } else if (!strcmp(op, "fast_sin") || !strcmp(op, "sin")) {
+      r = nir_fsin(&c->b, a[0]);
+   } else if (!strcmp(op, "fast_cos") || !strcmp(op, "cos")) {
+      r = nir_fcos(&c->b, a[0]);
+   } else if (!strcmp(op, "fast_cospi") || !strcmp(op, "cospi") ||
+              !strcmp(op, "fast_sinpi") || !strcmp(op, "sinpi")) {
+      /* cos(pi*x) and sin(pi*x), which are their own operations in Apple's
+       * vocabulary because multiplying by pi is where the accuracy goes.
+       *
+       * APPLE'S OWN NAMES, and not the 137 of section 3.2: `air.cospi`,
+       * `air.sinpi`, `air.tanpi`, their three `air.fast_*` forms and
+       * `air.acospi`, `air.asinpi`, `air.atanpi`, `air.atan2pi` are C strings
+       * in the device's shared cache, in the AIR front end's own builtin table
+       * (dyld_shared_cache_arm64.17, `air.cospi` at file offset 95 195 301 --
+       * the same region carries AIRNTEmitDylibImage and Air.DylibScript). That
+       * table spells the whole name, prefix and all, which is why it holds 911
+       * single-segment entries where AGXCompilerCore's holds 137 suffixes.
+       * `tanpi` and the four inverse ones are deliberately NOT here: a
+       * declaration scan over every .metallib of the image finds only
+       * cospi.{f16,f32}, fast_cospi.f32 and sinpi.{f16,f32}, and tanpi's poles
+       * and zero signs are four more places to be silently wrong for no
+       * customer.
+       *
+       * STEP ONE, AND IT IS EXACT: r = x - 2*rint(x/2) lies in [-1, 1] and is
+       * exactly representable for EVERY x, which is why this is not fmul(x, pi)
+       * followed by a cosine. Above 2^(p+1) every float is an even integer, so
+       * r is zero; below it x and 2*rint(x/2) are within a factor of two of
+       * each other, where a subtraction is exact. An infinity reduces to
+       * inf - inf = NaN, which is what cospi(inf) is, so there is no edge case
+       * to add and none is added.
+       *
+       * STEP TWO IS A QUARTER AND NOT A HALF, and that is the part worth the
+       * instructions. Both functions are near a zero somewhere in [-1, 1], and
+       * a cosine evaluated near its own zero has no relative accuracy left:
+       * r*pi carries about 1e-7 of absolute error from pi's own rounding, which
+       * is nothing beside 1 and everything beside cospi(0.49999997). Measured,
+       * on the pool this suite already runs: the half-period form answers
+       * 7.55e-08 where the host libm's cospi says 9.36e-08 -- 2 551 410 f32 ulp,
+       * on the one input class the operation exists for. So |r| is folded into
+       * [0, 1/4], where neither function is near a zero, and which of sin and
+       * cos answers is chosen by the quarter it came from. Both are evaluated,
+       * because a bcsel is not a branch; the ARGUMENTS are selected first, so
+       * the cost is one sine and one cosine and not three.
+       *
+       * A HALF IS WIDENED TO f32 FIRST, measured and not assumed. pi rounded to
+       * f16 is 3.140625, a relative error of 3e-4, and near the zeros that is
+       * the whole answer: computed entirely at f16 the half-period form is
