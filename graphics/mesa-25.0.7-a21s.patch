+                                            nir_u2u32(&c->b, a[2]));
+   } else if (!strcmp(op, "insert_bits")) {
+      r = nir_bitfield_insert(&c->b, a[0], a[1], nir_u2u32(&c->b, a[2]),
+                              nir_u2u32(&c->b, a[3]));
+   } else if (!strcmp(op, "dfdx")) {
+      r = nir_ddx(&c->b, a[0]);
+   } else if (!strcmp(op, "dfdy")) {
+      r = nir_ddy(&c->b, a[0]);
+   } else if (!strcmp(op, "fwidth")) {
+      r = nir_fadd(&c->b, nir_fabs(&c->b, nir_ddx(&c->b, a[0])),
+                   nir_fabs(&c->b, nir_ddy(&c->b, a[0])));
+   } else if (!strcmp(op, "get_simd_width") || !strcmp(op, "get_thread_execution_width")) {
+      r = nir_load_subgroup_size(&c->b);
+   } else if (!strcmp(op, "all")) {
+      r = nir_ball(&c->b, a[0]);
+   } else if (!strcmp(op, "any")) {
+      r = nir_bany(&c->b, a[0]);
+   } else if (!strcmp(op, "simd_sum") || !strcmp(op, "simd_min") ||
+              !strcmp(op, "simd_max") || !strcmp(op, "simd_prefix_exclusive_sum")) {
+      /* A REDUCTION OVER THE SIMD GROUP, given to every lane. NIR's reduce with
+       * cluster_size 0 is that, and ir3 has it (nir_intrinsic_reduce in
+       * ir3_compiler_nir.c, emit_intrinsic_reduce) and splits a vector into
+       * scalars on the way (nir_lower_subgroups with lower_to_scalar). The
+       * prefix scan is nir_exclusive_scan, which the same ir3 function emits
+       * from the same `scan` instruction's third destination.
+       *
+       * FOUR OF APPLE'S SEVENTEEN, and the four are the ones with a customer.
+       * This used to read "only the sum, because only the sum occurs", which
+       * was true of the corpus and never checked against the image: of the
+       * image's 10 242 modules, 9 call air.simd_sum, 4 air.simd_max, 3
+       * air.simd_min and 2 air.simd_prefix_exclusive_sum, and the last three
+       * names were the FIRST wall of 4 of them (Portrait.framework and
+       * MPSImage). The thirteen still missing -- product, and, or, xor, ballot,
+       * the inclusive scans, the prefix products -- are called by nothing in
+       * either, so each would still be code with no case behind it.
+       *
+       * What no amount of this can be checked against: a float reduction has no
+       * defined order in Metal or in NIR, so a sum over the group is not a
+       * number any reference can predict bit-exactly, on the phone or
+       * anywhere. Min and max are better off -- they are order-independent for
+       * every input that is not a NaN -- and the prefix sum is worse, because
+       * it is an order written into the operation's name over a group whose
+       * width is the hardware's.
+       */
+      nir_op rop = is_float ? nir_op_fadd : nir_op_iadd;
+      if (!strcmp(op, "simd_min"))
+         rop = is_float ? nir_op_fmin : is_signed ? nir_op_imin : nir_op_umin;
+      else if (!strcmp(op, "simd_max"))
+         rop = is_float ? nir_op_fmax : is_signed ? nir_op_imax : nir_op_umax;
+      air_note(c, "air.%s is taken over the SIMD group this implementation has, which "
+                  "is not Metal's 32 lanes: ir3 runs 64 or 128 of them on this "
+                  "hardware, so the result is a reduction over more lanes than the "
+                  "shader was compiled for", op);
+      r = !strcmp(op, "simd_prefix_exclusive_sum")
+             ? nir_exclusive_scan(&c->b, a[0], .reduction_op = rop)
+             : nir_reduce(&c->b, a[0], .reduction_op = rop);
+   } else if (!strcmp(op, "normalize_function_constant_predicate")) {
+      /* Metal's compiler stores the predicates that say whether a dependent
+       * function constant applies in `__metal_implicit_fc_pred_N` bytes, and
+       * puts every one through this before storing it. The name is in Apple's
+       * own vocabulary (it sits between air.nextafter and air.pack.snorm1x8 in
+       * AGXCompilerCore's list of operation names, section 3.2), but no string
+       * or symbol in that binary says what it computes, so the reading here is
+       * C's: a byte is a predicate if it is not zero.
+       *
+       * THE CORPUS CANNOT TELL THAT APART FROM THE IDENTITY, and saying so is
+       * the point: every argument it is given in these modules is a
+       * `zext i1 ... to i8`, already 0 or 1, and any function that agrees with
+       * the identity on {0, 1} gives the same answer. A byte of 2 would
+       * discriminate, and nothing produces one here -- so this is a reading
+       * that no measurement available on this machine can confirm or refute,
+       * and a shader that fed it a wider byte would be the first test of it.
+       */
+      r = nir_b2iN(&c->b, nir_ine_imm(&c->b, a[0], 0),
+                   air_nir_bit_size(c, in->base.type));
+   } else if (!strcmp(op, "unpack") && n->num >= 2 &&
+              !strcmp(n->part[1], "unorm4x8")) {
+      /* four unsigned bytes of a word, each divided by 255. Component 0 is the
+       * LOW byte, which is both GLSL's unpackUnorm4x8 and Metal's
+       * unpack_unorm4x8_to_float, so NIR's opcode is the operation and not an
+       * approximation of it. ir3 has no instruction for it and does not need
+       * one: it sets lower_unpack_unorm_4x8, and nir_opt_algebraic turns it
+       * into four extract_u8 and a divide.
+       */
+      r = nir_unpack_unorm_4x8(&c->b, a[0]);
+      if (air_nir_bit_size(c, in->base.type) == 16)
+         r = nir_f2f16(&c->b, r);
+   } else if (!strcmp(op, "pack") && n->num >= 3 &&
+              !strcmp(n->part[1], "unorm") && !strcmp(n->part[2], "rgb565")) {
+      /* COMPONENT 0 IS AT BIT 0, and that is Apple's own answer rather than a
+       * reading of the name. The module and its metadata fix the widths and
+       * that the 6-bit field is in the middle; which end component 0 is at is
+       * in neither, and the two readings exchange red and blue. A draw through
+       * air_run cannot separate them either: the pack and the number read back
+       * would both be ours. (docs/air.md 5e has what a draw on the DEVICE
+       * could and could not say, which is not what the refusal here used to
+       * claim.) What settles it is the lowering in AGXCompilerCore -- this
+       * device's own, ios165/20F66__iPhone10,3_6 -- read as instructions:
+       *
+       *   AGCLLVMAirBuiltins::initializePackUnpackMap  0x1bbe5c0cc
+       *     maps the name suffix "unorm.rgb565.v3f" to kind 2
+       *   AGCLLVMAirBuiltins::buildPack                0x1bbe5be08
+       *     kind 2 -> buildPackFormat(PackedType 0, normalized, unsigned)
+       *   AGCLLVMTargetLowerer::buildPackFormat        0x1bbed0934
+       *     PackedType 0..3 -> buildPackFloatFormat, which keeps the type
+       *   AGCLLVMTargetLowerer::buildPackFloatFormat   0x1bbed3204
+       *     indexes a 9-byte row of `formats` (0x1bbf1977f) by PackedType:
+       *     one count byte, then four WIDTHS, then four SHIFTS. Row 0 is
+       *     count 3, widths {5, 6, 5}, shifts {0, 5, 11}, and the loop is
+       *     `acc |= packFromFloat(extractelement(v, i), width[i], shift[i])`
+       *     from a constant 0, then truncateToSmall to the declared i16.
+       *   AGCLLVMTargetLowerer::buildPackFromFloat     0x1bbed2e38
+       *     fpext to f32; buildFClamp(0.0, 1.0), which for exactly those two
+       *     bounds dispatches to buildSaturate (0x1bbe0e428); fmul by
+       *     (1 << width) - 1; llvm.agx{1,2}.pack.rne.s32, whose prefix is the
+       *     GPU generation's (Gen2's constructor stores agx1 and Gen3's agx2,
+       *     both round to nearest even); shl by `shift`.
+       *
+       * THE SHIFTS ARE THE RUNNING SUM OF THE WIDTHS in all seven rows of that
+       * table -- 565 {0,5,11}, 4444 {0,4,8,12}, 1555 {0,1,6,11},
+       * 5551 {0,5,10,15}, rgb10 {0,10,20}, rgb10a2 {0,10,20,30} and a second
+       * copy of that last layout, rows 5 and 6 being the float and the uint
+       * variants of 1010102 -- so the fields are laid out from bit 0
+       * upward in component order and the 565 row cannot be read the other way
+       * round without breaking the six beside it. Each row's widths also sum
+       * to its word: 16 for the four 16-bit ones, 30 and 32 for the others.
+       *
+       * The inverse lowering is the second witness, and it reads the same row
+       * through the opposite argument order: buildUnpackFloatFormat
+       * (0x1bbe001ec) hands buildUnpackToFloat (0x1bbed2c10) the SHIFT first
+       * and the width second, where the pack side passes them the other way
+       * round, and that callee begins with `lshr` by its first argument and
+       * masks with (1 << width) - 1. A misreading of which byte-run of the row
+       * is widths and which is shifts would have to survive both call sites.
+       *
+       * So, for i in 0..2 with width {5,6,5} and shift {0,5,11}:
+       *    acc |= rne(saturate(f32(v[i])) * ((1 << width[i]) - 1)) << shift[i]
+       *
+       * In f32 and not in f16, because Apple extends first, and that is
+       * measured and not asserted: 61 half values round differently if the
+       * product is computed at f16, two of them are in intrincheck.py's pool
+       * for this operation, and removing the extension here duly makes 2 of
+       * its 24 cases differ. nir_fsat IS saturate and nir_fround_even IS
+       * Apple's rne, so neither step here is an approximation of the one it
+       * stands for.
+       *
+       * ROUND-TO-NEAREST-EVEN IS NOT OBSERVABLE at this width, which is worth
+       * knowing rather than relying on: over all 65 536 half bit patterns the
+       * only exactly half-way products are 0.5*31 = 15.5 and 0.5*63 = 31.5,
+       * and nearest-even and half-away-from-zero both answer 16 and 32 there.
+       * So no input this operation can be given separates Apple's rounding
+       * mode from the other one, and it is spelled rne because that is what
+       * Apple's code names. Truncation does differ, on 7 551 of them, and that
+       * is the mistake the check can catch (tools/air/intrincheck.py, and
+       * tools/air/pack565.ll for four colours readable by eye).
+       */
+      static const unsigned pack565_width[3] = { 5, 6, 5 };
+      static const unsigned pack565_shift[3] = { 0, 5, 11 };
+      /* exact: a pack is a bit pattern, not a shader's arithmetic, and the
+       * fast-math this function turns on for everything else has no business
+       * reassociating the one multiply it contains
+       */
+      c->b.exact = true;
+      nir_def *acc = nir_imm_int(&c->b, 0);
+      for (unsigned k = 0; k < 3; k++) {
+         nir_def *x = nir_channel(&c->b, a[0], k);
+         if (x->bit_size != 32)
+            x = nir_f2f32(&c->b, x);
+         x = nir_fmul_imm(&c->b, nir_fsat(&c->b, x),
+                          (double)((1u << pack565_width[k]) - 1));
+         nir_def *f = nir_f2u32(&c->b, nir_fround_even(&c->b, x));
+         acc = nir_ior(&c->b, acc, nir_ishl_imm(&c->b, f, pack565_shift[k]));
+      }
+      r = nir_u2uN(&c->b, acc, air_nir_bit_size(c, in->base.type));
+   } else if (!strcmp(op, "convert")) {
+      /* air.convert.<dst sign>.<dst type>.<src sign>.<src type> */
+      if (n->num < 5) {
+         c->b.exact = was_exact;
+         return air_error(c, "intrinsic: %s (a convert without both types)", op);
+      }
+      const struct air_type *dt = in->base.type;
+      const struct air_type *st = in->operands[1]->type;
+      unsigned bits = air_nir_bit_size(c, dt);
+      bool dst_float = n->part[1][0] == 'f';
+      bool src_float = n->part[3][0] == 'f';
+      bool src_signed = n->part[3][0] == 's';
+      nir_def *x = a[0];
+      if (!src_float && air_type_bit_size(air_type_scalar(st)) == 1)
+         x = src_signed ? nir_ineg(&c->b, nir_b2i32(&c->b, x)) : nir_b2i32(&c->b, x);
+      /* A BOOL DESTINATION IS NOT A CONVERSION. C's rule, which MSL inherits,
+       * is `x != 0`, and in NIR a boolean is a 1-bit def -- so asking
+       * nir_f2uN for one bit produces f2u1, an opcode ir3 has no instruction
+       * for and no lowering of. That is the whole of why
+       * variable_blur_frag_{lpf,lph} were the only two modules of QuartzCore's
+       * library to reach the backend and die there: "Unhandled ALU op: f2u1",
+       * from air.convert.u.i1.f.f32. The comparison is also the right answer
+       * rather than a way round the backend: a conversion would have a
+       * rounding mode, and bool(0.5) is true, not false.
+       */
+      if (bits == 1)
+         r = src_float ? nir_fneu_imm(&c->b, x, 0.0) : nir_ine_imm(&c->b, x, 0);
+      else if (dst_float && src_float)
+         r = nir_f2fN(&c->b, x, bits);
+      else if (dst_float)
+         r = src_signed ? nir_i2fN(&c->b, x, bits) : nir_u2fN(&c->b, x, bits);
+      else if (src_float)
+         r = n->part[1][0] == 's' ? nir_f2iN(&c->b, x, bits) : nir_f2uN(&c->b, x, bits);
+      else
+         r = src_signed ? nir_i2iN(&c->b, x, bits) : nir_u2uN(&c->b, x, bits);
+   } else {
+      *handled = false;
+   }
+
+   c->b.exact = was_exact;
+   if (!*handled)
+      return true;
+   if (!r)
+      return false;
+   air_set(c, &in->base, air_val_ssa(c, r));
+   return true;
+}
+
+/* -- function constants ------------------------------------------------- */
+
+/* air.is_function_constant_defined(ptr to the constant's global)
+ *
+ * Metal's companion to `[[function_constant(n)]]`: a shader may ask whether
+ * the pipeline supplied a value for a constant, and guard the code that reads
+ * it. The answer is known at translation time -- it is exactly whether the
+ * caller passed a value for that index in air_to_nir_options -- so this folds
+ * to a constant and the guarded branch folds away with it.
+ *
+ * It is handled here, before math_op, because its argument is a POINTER and
+ * math_op resolves every argument as a number: the four fixed_vert_* modules
+ * stopped at "a pointer where a number belongs" with no instruction named,
+ * because the failure was in reading the arguments and not in the operation.
+ */
+static bool
+fc_defined_op(struct air_ctx *c, const struct air_inst *in)
+{
+   if (in->num_operands != 2)
+      return air_error(c, "intrinsic: air.is_function_constant_defined of %u arguments",
+                       in->num_operands - 1);
+   struct air_val *p = air_get(c, in->operands[1]);
+   if (!p)
+      return false;
+   if (p->kind != AIR_VAL_PTR || p->ptr.class != AIR_PTR_FUNCTION_CONSTANT)
+      return air_error(c, "intrinsic: air.is_function_constant_defined of something "
+                          "that is not a function constant");
+   /*
+    * Defined means SUPPLIED BY THE PIPELINE, not "declared by the module".
+    *
+    * This loop used to answer true whenever the index was in the array, and the array is
+    * every constant the module declares -- so the answer was always true, and the value
+    * handed over with it was the zero nobody had filled in. The question these 80
+    * constants of the corpus ask is exactly the one that was being answered wrongly:
+    * each is guarded by this intrinsic and has a branch for not having been supplied.
+    */
+   bool defined = false;
+   for (unsigned i = 0; c->options && i < c->options->num_constants; i++) {
+      if (c->options->constants[i].index == p->ptr.binding) {
+         defined = c->options->constants[i].supplied;
+         break;
+      }
+   }
+   air_set(c, &in->base, air_val_ssa(c, nir_imm_bool(&c->b, defined)));
+   return true;
+}
+
+/* -- atomics ------------------------------------------------------------ */
+
+static bool
+atomic_op(struct air_ctx *c, const struct air_inst *in, const struct air_name *n)
+{
+   /* air.atomic.{global,local}.<op>[.<sign>].<type>(ptr, value?, order,
+    * scope, volatile)
+    */
+   if (n->num < 3)
+      return air_error(c, "intrinsic: an atomic without a name");
+   const char *where = n->part[1];
+   const char *op = n->part[2];
+   bool is_signed = n->num >= 5 ? is_signed_part(n->part[3]) : true;
+
+   struct air_val *pv = air_get(c, in->operands[1]);
+   if (!pv)
+      return false;
+   if (pv->kind != AIR_VAL_PTR)
+      return air_error(c, "intrinsic: an atomic on something that is not a pointer");
+   struct air_ptr p = pv->ptr;
+
+   bool shared = !strcmp(where, "local");
+   if (shared != (p.class == AIR_PTR_SHARED))
+      return air_error(c, "intrinsic: air.atomic.%s on %s memory", where,
+                       p.class == AIR_PTR_SHARED ? "threadgroup" : "device");
+
+   nir_def *off = p.offset ? p.offset : nir_imm_int(&c->b, 0);
+
+   /* Compare-exchange, refused before the memory order is read -- because its
+    * arguments are in different places and reading them as the others' gave a
+    * sentence about the wrong thing. Its signature, decoded from the call
+    * sites so that implementing it needs no second reading:
+    *
+    *   i32 air.atomic.<global|local>.cmpxchg.weak.i32(
+    *          ptr object, ptr expected, i32 desired,
+    *          i32 success_order, i32 failure_order, i32 scope, i1 volatile)
+    *
+    * so the order this used to read as argument 3 is the DESIRED VALUE, which
+    * is not a constant, and 4 modules of Resident Evil 4 were told "with a
+    * memory order that is not a constant" about an operation this does not
+    * implement at all.
+    *
+    * THE RESULT IS THE OBJECT'S OLD VALUE and not a boolean, which is read off
+    * what the callers do with it rather than from the name: Metal's
+    * atomic_compare_exchange_weak_explicit returns bool, and every call site
+    * here instead feeds the result to `icmp ne i32 %expected, %result` and
+    * then re-loads *expected -- the weak-CAS retry loop HLSL's
+    * InterlockedCompareExchange compiles to. A lowering is three operations
+    * (load *expected, nir_atomic_op_cmpxchg, store the old value back through
+    * `expected`, whose conditional-on-failure store may be unconditional
+    * because on success it writes the value already there), and what stops it
+    * is not the operation but the check: nothing in tools/air/atomiccheck.py
+    * can make a wrong compare-exchange show, and an atomic that is only
+    * compiled is the one kind this project will not claim.
+    */
+   if (!strcmp(op, "cmpxchg"))
+      return air_error(c, "intrinsic: air.atomic.%s.cmpxchg -- compare-exchange, whose "
+                          "result is the old value and whose `expected` is a pointer "
+                          "this does not write back yet", where);
+
+   /* The memory order, which this lowering is right for exactly one value of.
+    * That argument is Metal's memory_order, and every atomic in the corpus
+    * passes 0 -- memory_order_relaxed. A relaxed load or store of an aligned
+    * 32-bit word is a plain load or store, which is what happens below, and a
+    * relaxed read-modify-write needs no barrier either. A stronger order would
+    * need one that is not emitted, so rather than ignore the argument and be
+    * quietly wrong on a shader that asks for more, refuse it by name. Read
+    * through air_const_uint because a zero arrives as CST_CODE_NULL about as
+    * often as as an integer.
+    */
+   unsigned iorder = !strcmp(op, "load") ? 2 : 3;
+   uint64_t order;
+   if (in->num_operands <= iorder ||
+       !air_const_uint(in->operands[iorder], &order))
+      return air_error(c, "intrinsic: air.atomic.%s.%s with a memory order that is "
+                          "not a constant", where, op);
+   if (order != 0)
+      return air_error(c, "intrinsic: air.atomic.%s.%s with memory_order %u; only "
+                          "relaxed (0) is translated, and a stronger one needs a "
+                          "barrier this does not emit", where, op, (unsigned)order);
+
+   if (!strcmp(op, "load")) {
+      nir_def *r = air_load_ptr(c, p, in->base.type, 0);
+      if (!r)
+         return false;
+      air_set(c, &in->base, air_val_ssa(c, r));
+      return true;
+   }
+   if (!strcmp(op, "store")) {
+      nir_def *v = air_get_ssa(c, in->operands[2]);
+      return v && air_store_ptr(c, p, v, 0);
+   }
+
+   nir_atomic_op aop;
+   if (!strcmp(op, "add")) aop = nir_atomic_op_iadd;
+   else if (!strcmp(op, "min")) aop = is_signed ? nir_atomic_op_imin : nir_atomic_op_umin;
+   else if (!strcmp(op, "max")) aop = is_signed ? nir_atomic_op_imax : nir_atomic_op_umax;
+   else if (!strcmp(op, "and")) aop = nir_atomic_op_iand;
+   else if (!strcmp(op, "or")) aop = nir_atomic_op_ior;
+   else if (!strcmp(op, "xor")) aop = nir_atomic_op_ixor;
+   else if (!strcmp(op, "xchg")) aop = nir_atomic_op_xchg;
+   else return air_error(c, "intrinsic: atomic %s", op);
+
+   nir_def *v = air_get_ssa(c, in->operands[2]);
+   if (!v)
+      return false;
+   nir_def *r;
+   if (shared) {
+      r = nir_shared_atomic(&c->b, v->bit_size, off, v, .atomic_op = aop);
+   } else if (p.class == AIR_PTR_SSBO) {
+      r = nir_ssbo_atomic(&c->b, v->bit_size, nir_imm_int(&c->b, p.binding), off, v,
+                          .atomic_op = aop);
+   } else {
+      return air_error(c, "intrinsic: an atomic on a pointer that is not a buffer");
+   }
+   if (in->base.type && in->base.type->kind != AIR_TYPE_VOID)
+      air_set(c, &in->base, air_val_ssa(c, r));
+   return true;
+}
+
+/* -- barriers ----------------------------------------------------------- */
+
+static bool
+barrier_op(struct air_ctx *c, const struct air_inst *in, bool simdgroup)
+{
+   /* air.wg.barrier(i32 flags, i32 scope) and air.simdgroup.barrier(i32 flags,
+    * i32 scope). BOTH ARGUMENTS ARE NOW APPLE'S OWN WORDS rather than a
+    * census: the Metal headers shipped with this device's own shader compiler
+    * (GPUCompiler.framework/.../include/metal/metal_compute) define the two
+    * library functions as
+    *
+    *    threadgroup_barrier(mem_flags f) { __metal_wg_barrier(int(f),
+    *                                          __METAL_MEMORY_SCOPE_THREADGROUP__); }
+    *    simdgroup_barrier(mem_flags f)   { __metal_simdgroup_barrier(int(f),
+    *                                          __METAL_MEMORY_SCOPE_THREADGROUP__); }
+    *
+    * so the second argument is the MEMORY scope and is the threadgroup in
+    * both -- the 1 the corpus passes, now sourced rather than observed -- and
+    * the only difference between the two operations is the EXECUTION scope:
+    * the threadgroup for one, the SIMD-group for the other. That is the whole
+    * of what `simdgroup` selects below.
+    *
+    * The flags are `enum class mem_flags` of the same header: mem_none,
+    * mem_device, mem_threadgroup, mem_threadgroup_imageblock, mem_texture,
+    * mem_object_data. The numbers are compiler built-ins and not in the
+    * header, so 1 = device, 2 = threadgroup, 4 = texture, 8 = imageblock stays
+    * a reading of the calls -- but `mem_threadgroup_imageblock` NAMES flag 8's
+    * memory as threadgroup memory, which is the thing the fallback below used
+    * to be guessing.
+    *
+    * The flag census of the corpus, kept because it is what a reader can
+    * check: 46 of the 852 modules call air.wg.barrier at all, and they pass 1
+    * in 3 of them (6 calls), 2 in 25 (43 calls) and 8 in 15 (15 calls). The
+    * fifteen are exactly the fifteen CMImaging modules with an explicit
+    * imageblock, which stop at the interface (air_to_nir.c) and so never
+    * arrive here. No module of the corpus calls air.simdgroup.barrier; 509 of
+    * the image's 10 242 do, and 106 of those stop here (docs/air.md 10).
+    */
+   uint64_t flags = 2;
+   if (in->num_operands > 1)
+      air_const_uint(in->operands[1], &flags); /* left alone when not readable */
+
+   nir_variable_mode modes = 0;
+   if (flags & 1)
+      modes |= nir_var_mem_ssbo | nir_var_mem_global;
+   if (flags & 2)
+      modes |= nir_var_mem_shared;
+   if (flags & 4)
+      modes |= nir_var_image;
+   /* Flag 8 is mem_threadgroup_imageblock, and the header's name for it is why
+    * it gets threadgroup memory rather than the old catch-all fallback: an
+    * explicit imageblock is per-threadgroup storage and Apple calls it that.
+    * It still cannot reach this function -- an imageblock input is refused at
+    * the interface -- so this is a mode for a case that does not arrive, which
+    * is better than a default that answers for it silently.
+    */
+   if (flags & 8)
+      modes |= nir_var_mem_shared;
+
+   /* mem_none == 0 ORDERS NO MEMORY, and that is the one place the old code
+    * said something Apple's header contradicts. It read `if (!modes) modes =
+    * nir_var_mem_shared;` and called that right-for-the-wrong-reason about
+    * flag 8; but 0 is `mem_none`, a value the enumeration defines, and six
+    * calls in the image pass it (five in MLCompute, one in
+    * CameraColorProcessing, all of them to simdgroup.barrier). For those the
+    * fallback invented a threadgroup-memory fence the shader did not ask for.
+    * It was conservative and therefore not a wrong answer, but it was an
+    * answer to a question nobody asked, and a barrier that orders nothing is
+    * exactly what an execution-only barrier is.
+    */
+   nir_barrier(&c->b,
+               .execution_scope = simdgroup ? SCOPE_SUBGROUP : SCOPE_WORKGROUP,
+               .memory_scope = modes ? SCOPE_WORKGROUP : SCOPE_NONE,
+               .memory_semantics = modes ? NIR_MEMORY_ACQ_REL : 0,
+               .memory_modes = modes);
+
+   /* The SIMD-group's width is the hardware's and not Metal's 32 (simd_op
+    * below has the whole argument). For a barrier that costs less than it does
+    * for a shuffle -- a barrier over MORE lanes than the shader expects still
+    * orders the ones it expects -- but a shader that uses a simdgroup barrier
+    * INSTEAD of a threadgroup one because it knows its threadgroup is one
+    * 32-lane SIMD-group is relying on the width, and on this hardware the
+    * group is 64 or 128, so a threadgroup of 64 that Apple's compiler would
+    * have split into two SIMD-groups is one here. That changes which lanes the
+    * barrier covers, in the safe direction.
+    */
+   if (simdgroup)
+      air_note(c, "air.simdgroup.barrier is taken over the SIMD group this "
+                  "implementation has, which is not Metal's 32 lanes: ir3 runs 64 or "
+                  "128 of them on this hardware, so the barrier covers at least the "
+                  "lanes the shader expects and possibly more");
+   return true;
+}
+
+/* -- fragment flow control ---------------------------------------------- */
+
+/* air.discard_fragment()
+ *
+ * NIR'S `demote` AND NOT NIR'S `terminate`, and that choice is the whole of
+ * this function. The two differ in what the thread does afterwards: terminate
+ * ends the invocation, so the lane stops contributing to its quad's
+ * derivatives and performs no further memory writes, while demote turns it
+ * into a HELPER invocation -- it keeps executing, its framebuffer and memory
+ * writes are dropped, and it still supplies the neighbour values that a
+ * derivative or an implicit-level-of-detail sample in the OTHER three lanes
+ * of the quad needs.
+ *
+ * It is a real distinction in NIR and in every backend that has one: ir3
+ * keeps the two apart in its own IR (ir3_compiler_nir.c emits ir3_DEMOTE
+ * against ir3_KILL, and they carry different scheduling barriers), and
+ * nir_to_tgsi sends them to TGSI's DEMOTE and KILL, which are separate
+ * opcodes. ONE PLACE COLLAPSES THEM, AND IT IS WORTH KNOWING ABOUT: the a6xx
+ * instruction encoder maps DEMOTE onto the hardware's KILL --
+ * `} else if (instr->opc == OPC_DEMOTE) { return OPC_KILL; }` in
+ * src/freedreno/isa/encode.c -- and the ISA description has no demote bitset
+ * at all (ir3-cat0.xml carries `kill` and nothing beside it). So on this GPU,
+ * with this Mesa, both come out as one instruction and the helper lanes Metal
+ * promises are not delivered by the hardware path today. That is a gap to
+ * name, not a reason to translate this as `terminate`: terminate would lose
+ * the same lanes and would be wrong on a backend that does tell them apart.
+ * What it costs is measurable only on the phone -- a shader that discards and
+ * then takes a derivative -- and that is written as a job rather than assumed.
+ *
+ * ONE THING IS NOT A DIFFERENCE BETWEEN THE TWO, and saying so is the
+ * correction of a sentence that used to stand here: stores. NIR's own
+ * definition of demote (nir_intrinsics.py) is "Any stores to memory after
+ * this instruction are suppressed and the fragment does not write outputs to
+ * the framebuffer. Unlike discard, demote needs to ensure that derivatives
+ * will still work for invocations that were not demoted." So demote drops the
+ * lane's later writes as well -- it differs from terminate in the derivatives
+ * and in the lane going on executing, not in the memory. Whether METAL drops
+ * them is a third question, and nothing on this machine answers it: no header
+ * on the device says, and a corpus cannot show it. If Metal keeps them, both
+ * of NIR's intrinsics are wrong about it by the same amount.
+ *
+ * Nothing in a corpus COUNT can decide it -- both translate, both validate,
+ * both compile -- so it is decided from two independent readings of what
+ * Metal means, and both say the thread lives:
+ *
+ *  1. The shaders themselves. Resident Evil 4's `PS_DrawByTiles` calls
+ *     air.discard_fragment at the ninth instruction of a 1 800-line function
+ *     and then calls `air.simd_is_helper_thread()` EIGHT TIMES further down
+ *     it. A terminated thread cannot be asked whether it is a helper thread;
+ *     a demoted one answers yes, which is the only reading under which that
+ *     shader means anything. 24 of the library's 1 288 discard-calling modules
+ *     call that function.
+ *  2. Apple's own declaration of it. `llvm-dis` of that module reads
+ *     `declare void @air.discard_fragment() local_unnamed_addr #8` with
+ *     `attributes #8 = { nounwind }` -- and NOT `noreturn`. LLVM is entitled
+ *     to delete everything after a call it is told does not return, and
+ *     Apple's compiler kept the rest of the function; the call is followed by
+ *     `br` and not `unreachable` in 73 of 85 call sites sampled. A discard
+ *     that killed the thread would be a noreturn call.
+ *
+ * And the cost of getting it wrong is not hypothetical here: of 85 sampled
+ * call sites, 45 are followed in the same function by an air.sample_* with an
+ * implicit level of detail and 6 by air.dfdx, both of which read the other
+ * lanes of the quad. Under `terminate` those neighbours would read a dead
+ * lane.
+ *
+ * uses_discard is set by hand because nir_shader_gather_info does not run on
+ * this path (ir3 calls it only for a binning variant), exactly as the
+ * framebuffer-fetch flags are set in air_to_nir.c. It is not bookkeeping: it
+ * is what nir_to_tgsi_info turns into `uses_kill`, which is what a Gallium
+ * driver reads before it allows an early depth test, and what freedreno reads
+ * before it writes LRZ. A discarding shader whose interface says it discards
+ * nothing gets its depth written for pixels it threw away.
+ */
+static bool
+discard_op(struct air_ctx *c, const struct air_inst *in)
+{
+   if (c->nir->info.stage != MESA_SHADER_FRAGMENT)
+      return air_error(c, "intrinsic: air.discard_fragment in a %s shader",
+                       gl_shader_stage_name(c->nir->info.stage));
+   nir_demote(&c->b);
+   c->nir->info.fs.uses_discard = true;
+   return true;
+}
+
+/* -- SIMD groups and quads ----------------------------------------------- */
+
+/* air.simd_* and air.quad_*: Metal's cross-lane operations.
+ *
+ * THE SIMD-GROUP HERE IS THE IMPLEMENTATION'S, NOT A 32-LANE ONE, and that is
+ * the only way these can be translated honestly. Metal does not fix the width
+ * -- a shader asks for it with air.get_simd_width (this file answers with
+ * nir_load_subgroup_size) and a host asks MTLComputePipelineState for
+ * threadExecutionWidth -- and it is 32 on every Apple GPU, which is why a
+ * shader compiled for one may have the number built into it. This hardware's
+ * is 64 or 128: `threadsize_base` is 64 for the A635 this port targets and ir3
+ * doubles it per variant in the compute and fragment stages
+ * (ir3_shader_get_subgroup_size, IR3_SINGLE_OR_DOUBLE).
+ *
+ * So the width a translated shader is TOLD and the width its votes are taken
+ * over are the same number, whatever that number is: a shader that reads
+ * air.get_simd_width and works from it is right, and a shader with 32 written
+ * into it is wrong -- as it would be on any Metal implementation whose
+ * SIMD-group is not 32 wide. Each of these leaves a note saying so, because it
+ * is a thing the hardware cannot do exactly rather than a thing this frontend
+ * chose.
+ *
+ * One more thing decides whether that consistency holds, and it is a property
+ * of the GPU and not of this file: ir3 declares a fragment or vertex
+ * subgroup to be ONE LANE and lowers a vote to its own argument on a device
+ * without `has_getfiberid` (ir3_nir.c: `options.subgroup_size = 1`,
+ * `lower_vote_trivial`). The A635 has it -- it is an a6xx gen4, and
+ * freedreno_devices.py sets the flag for gen4 and above -- so the votes here
+ * are real in every stage, and air.get_simd_width answers with the real width
+ * in the same stages. On an a6xx below gen4 both would read 1, which is still
+ * self-consistent and still not Metal's 32.
+ *
+ * air.simd_ballot is a 64-bit mask with one bit per lane, and it is exact
+ * only while a group has at most 64 lanes. That is the driver's to promise,
+ * not this frontend's: hakios-metal builds every variant with zeroed
+ * shader_options, IR3_SINGLE_ONLY, so ir3 never doubles the threadsize and a
+ * group is threadsize_base, 64 lanes, in every stage -- the execution width
+ * the device reports. A driver that lets ir3 run 128 would get the low half
+ * of the mask; the note below says so where it is emitted.
+ *
+ * The QUAD operations are a different matter and are exact: a quad is four
+ * consecutive lanes on both machines -- it is what a fragment derivative is
+ * computed over -- so a swap inside one has the same meaning whatever the
+ * SIMD-group's width is, and nir_lower_subgroups leaves the quad intrinsics
+ * alone for ir3 (no lower_quad, and lower_vote_trivial does not reach them).
+ */
+static bool
+simd_op(struct air_ctx *c, const struct air_inst *in, const struct air_name *n,
+        bool *handled)
+{
+   const char *op = n->part[0];
+
+   /* THE NAME IS DECIDED BEFORE AN ARGUMENT IS TOUCHED, which is the same rule
+    * math_op states above it and fc_defined_op exists for -- and getting it
+    * wrong here cost 46 modules of the 456 for the length of one commit. This
+    * function used to resolve its first argument before asking whether the
+    * name was one of its own, and every texture operation passes a texture
+    * HANDLE as that argument: air.sample_texture_2d came back "instruction: a
+    * pointer where a number belongs", which reads like a broken module and
+    * names no operation at all. The count was the only visible symptom and it
+    * was briefly attributed to somebody else's commit.
+    */
+   if (strncmp(op, "simd_", 5) && strncmp(op, "quad_", 5) &&
+       strcmp(op, "get_sample_position") && strcmp(op, "is_uniform")) {
+      *handled = false;
+      return true;
+   }
+   *handled = true;
+
+   if (!strcmp(op, "simd_is_helper_thread")) {
+      /* Exact, and width-independent: a helper thread is one whose results
+       * are discarded, which is a property of the thread and not of a group.
+       * ir3 runs nir_lower_is_helper_invocation itself, and this is the other
+       * half of the discard above -- a demoted lane must answer yes here.
+       */
+      if (c->nir->info.stage != MESA_SHADER_FRAGMENT)
+         return air_error(c, "intrinsic: air.simd_is_helper_thread in a %s shader "
+                             "(there are no helper threads outside the fragment "
+                             "stage)", gl_shader_stage_name(c->nir->info.stage));
+      air_set(c, &in->base, air_val_ssa(c, nir_is_helper_invocation(&c->b, 1)));
+      return true;
+   }
+
+   nir_def *a0 = in->num_operands > 1 ? air_get_ssa(c, in->operands[1]) : NULL;
+   if (in->num_operands > 1 && !a0)
+      return false;
+
+   if (!strcmp(op, "simd_ballot")) {
+      /* Resident Evil 4's culling passes elect a lane with it (a ballot of the
+       * live lanes, then a popcount of the ones below this lane) */
+      if (!a0 || a0->bit_size != 1 || in->base.type->kind != AIR_TYPE_INT ||
+          in->base.type->bits != 64)
+         return air_error(c, "intrinsic: air.simd_ballot of something other than a "
+                             "bool into a 64-bit mask");
+      air_note(c, "air.simd_ballot is a mask of the SIMD group this implementation "
+                  "has, 64 lanes when the driver keeps ir3 to its single threadsize "
+                  "(hakios-metal does), not Metal's 32: a shader that truncates it to "
+                  "32 bits and indexes it by lane & 31 sees two groups of 32 in it");
+      air_set(c, &in->base, air_val_ssa(c, nir_ballot(&c->b, 1, 64, a0)));
+      return true;
+   }
+
+   if (!strcmp(op, "simd_all") || !strcmp(op, "simd_any")) {
+      bool all = !strcmp(op, "simd_all");
+      air_note(c, "air.%s is taken over the SIMD group this implementation has, "
+                  "which is not Metal's 32 lanes: ir3 runs 64 or 128 of them on this "
+                  "hardware. air.get_simd_width answers with the same number, so a "
+                  "shader that reads it is right and one with 32 built into it is not",
+               n->part[0]);
+      air_set(c, &in->base,
+              air_val_ssa(c, all ? nir_vote_all(&c->b, 1, a0)
+                                 : nir_vote_any(&c->b, 1, a0)));
+      return true;
+   }
+
+   /* air.is_uniform (Metal's simd_is_uniform, mediaserverd's CNN kernels): whether
+    * every active lane holds the same value -- NIR's vote_ieq / vote_feq, over the
+    * group this hardware has (the note above). A 16-bit value is widened first,
+    * which keeps equality as it was.
+    */
+   if (!strcmp(op, "is_uniform")) {
+      if (!a0)
+         return air_error(c, "intrinsic: air.is_uniform with no value");
+      const bool fl = n->num > 1 && n->part[1][0] == 'f';
+      nir_def *v = a0->bit_size < 32 ? (fl ? nir_f2f32(&c->b, a0) : nir_u2u32(&c->b, a0)) : a0;
+      air_set(c, &in->base, air_val_ssa(c, fl ? nir_vote_feq(&c->b, 1, v) : nir_vote_ieq(&c->b, 1, v)));
+      return true;
+   }
+
+   if (!strcmp(op, "simd_broadcast_first")) {
+      air_note(c, "air.%s reads the first active lane of the SIMD group this "
+                  "implementation has, which is not Metal's 32 lanes -- the value is "
+                  "the same one Metal would give wherever it is uniform across the "
+                  "group, and another lane's where it is not", n->part[0]);
+      air_set(c, &in->base, air_val_ssa(c, nir_read_first_invocation(&c->b, a0)));
+      return true;
+   }
+
+   if (!strcmp(op, "simd_shuffle")) {
+      nir_def *lane = air_get_ssa(c, in->operands[2]);
+      if (!lane)
+         return false;
+      air_note(c, "air.%s takes its lane number in the SIMD group this "
+                  "implementation has, which is not Metal's 32 lanes", n->part[0]);
+      air_set(c, &in->base,
+              air_val_ssa(c, nir_shuffle(&c->b, a0, nir_u2u32(&c->b, lane))));
+      return true;
+   }
+
+   if (!strcmp(op, "simd_is_first")) {
+      /* simd_is_first(): true in exactly one lane of the SIMD group, the
+       * lowest-numbered ACTIVE one. NIR's `elect` is that operation and
+       * nothing else -- it is SPIR-V's OpGroupNonUniformElect -- and ir3 emits
+       * it directly (nir_intrinsic_elect in ir3_compiler_nir.c), with no
+       * lowering in between to disagree with.
+       *
+       * This is one of the few cross-lane operations whose MEANING does not
+       * depend on the group's width: "the first active lane" is the first
+       * active lane at 32, 64 or 128. What does depend on the width is what
+       * the shader then does with it, and in the two corpus modules that call
+       * this the dependence is total: CMISharpnessScore::sumScoreStep{1,2}
+       * elect one lane per SIMD-group to write that group's air.simd_sum into
+       * `simdGroupSums`, a threadgroup array declared `[32 x float]` and
+       * indexed by the SIMD-group's index in the threadgroup, and then read
+       * back at `simd_lane_id`. At 64 lanes that read is past the end of the
+       * array. So translating this operation makes those two modules COMPILE
+       * and does not make them right, and the note says which.
+       *
+       * The reading "lane 0" would agree with `elect` on every case those two
+       * modules can produce, because both calls sit in reconvergent control
+       * flow where lane 0 is active -- which is exactly the kind of test that
+       * passes for the wrong reason. The reason to prefer `elect` is not the
+       * corpus: it is that Apple's own header gates the function on
+       * __HAVE_SIMDGROUP_IS_FIRST__ beside simd_is_helper_thread, whose whole
+       * subject is which lanes are live, and that a lane-0 reading would need
+       * air.get_simd_lane_id, which the operation does not take.
+       */
+      /* NO SEMICOLON IN A NOTE. air2nir's --report joins the notes of a module
+       * with `;` and corpus.py splits them on it, so a note with one in it
+       * arrives in the report as two rows, the second of them starting
+       * mid-sentence. Found by reading the report after adding this one.
+       */
+      air_note(c, "air.simd_is_first elects one lane of the SIMD group this "
+                  "implementation has, which is not Metal's 32 lanes: ir3 runs 64 or "
+                  "128 of them on this hardware. The election itself is exact at any "
+                  "width, but a shader that sizes a per-SIMD-group array at 32, or "
+                  "indexes one by air.get_simd_lane_id, is relying on the width and is "
+                  "wrong here however this operation is translated");
+      air_set(c, &in->base, air_val_ssa(c, nir_elect(&c->b, 1)));
+      return true;
+   }
+
+   if (!strcmp(op, "simd_broadcast")) {
+      /* simd_broadcast(data, lane): the value held by one named lane, given to
+       * every lane. NIR's read_invocation, which is the same operation; ir3
+       * lowers it to read_invocation_cond_ir3 (lower_read_invocation_to_cond)
+       * rather than refusing it.
+       */
+      nir_def *lane = air_get_ssa(c, in->operands[2]);
+      if (!lane)
+         return false;
+      air_note(c, "air.%s takes its lane number in the SIMD group this "
+                  "implementation has, which is not Metal's 32 lanes", n->part[0]);
+      air_set(c, &in->base,
+              air_val_ssa(c, nir_read_invocation(&c->b, a0,
+                                                 nir_u2u32(&c->b, lane))));
+      return true;
+   }
+
+   if (!strcmp(op, "simd_shuffle_up") || !strcmp(op, "simd_shuffle_down") ||
+       !strcmp(op, "simd_shuffle_xor")) {
+      /* simd_shuffle_{up,down,xor}(data, delta): the value held by the lane
+       * `lane - delta`, `lane + delta` or `lane ^ delta`. NIR has all three
+       * with the same definition, and in both languages the result is
+       * UNDEFINED when the computed lane is outside the group -- SPIR-V's
+       * OpGroupNonUniformShuffle{Up,Down,Xor} say so and Metal says so -- so
+       * the pair agrees on the defined cases and neither promises anything
+       * about the rest. That is why these three are translated and
+       * air.simd_shuffle_and_fill_* below is not.
+       *
+       * THE WIDTH IS WORSE HERE THAN FOR A VOTE, and the note says so. A
+       * reduction written as a shuffle ladder -- deltas 16, 8, 4, 2, 1 -- puts
+       * the sum of lanes 0..31 in lane 0 whatever the group's width is, because
+       * lane 0 never reads above lane 31; but every OTHER lane of a 64- or
+       * 128-wide group reads across the 32-lane window the shader believes in,
+       * so a shader that uses more than lane 0's answer gets a different number
+       * here than on an Apple GPU. Which of the two it is cannot be decided by
+       * this function: it is a property of the shader.
+       */
+      nir_def *delta = air_get_ssa(c, in->operands[2]);
+      if (!delta)
+         return false;
+      delta = nir_u2u32(&c->b, delta);
+      air_note(c, "air.%s steps by lanes of the SIMD group this implementation has, "
+                  "which is not Metal's 32 lanes: ir3 runs 64 or 128 of them on this "
+                  "hardware, so a lane whose source is outside Apple's 32-lane window "
+                  "reads a real neighbour here where Metal leaves it undefined",
+               n->part[0]);
+      nir_def *r = !strcmp(op, "simd_shuffle_up")
+                      ? nir_shuffle_up(&c->b, a0, delta)
+                      : !strcmp(op, "simd_shuffle_down")
+                           ? nir_shuffle_down(&c->b, a0, delta)
+                           : nir_shuffle_xor(&c->b, a0, delta);
+      air_set(c, &in->base, air_val_ssa(c, r));
+      return true;
+   }
+
+   if (!strcmp(op, "simd_shuffle_and_fill_down") ||
+       !strcmp(op, "simd_shuffle_and_fill_up")) {
+      /* REFUSED BY NAME, and the refusal says where the answer is rather than
+       * that there is none -- which is the difference between a wall and a
+       * shrug, and this one has an address.
+       *
+       * The signature is Apple's: metal_simdgroup on this device declares
+       * `simd_shuffle_and_fill_down(T data, T filling_data, ushort delta,
+       * ushort modulo)` and a two-argument overload that passes
+       * `__metal_get_simdgroup_size()` as the modulo. So `modulo` is a WINDOW
+       * width, and the operation shuffles within a window of that many lanes
+       * and takes `filling_data` where the source lane would leave it. What the
+       * header does not state is which lane of `filling_data` it takes, and the
+       * two readings -- the lane `delta` from the window's start, or the same
+       * lane the shuffle would have had, counted on past the window -- give
+       * different answers for every call.
+       *
+       * And the modulo is not a formality that could be ignored: Apple's own
+       * calls pass a LITERAL. CMISharpnessScore::sharpnessScoreCalculatorFloat
+       * passes 32 twice and 4 once; FRC's modules pass 4, 8 and a runtime
+       * value. A literal 32 is Apple's group width written into the shader, and
+       * on a 64- or 128-lane group a plain shuffle crosses that window instead
+       * of filling at it, which is a wrong value and not an undefined one. A
+       * literal 4 is not the group width at all and would be wrong on an Apple
+       * GPU too if it were read as one.
+       *
+       * WHERE THE ANSWER IS: AGXCompilerCore in this device's own cache lowers
+       * it, and the symbols are not hidden --
+       * `AGCLLVMGen::TargetLowerer::buildShuffleAndFill` (`0x1bbefa8a4`),
+       * `...::buildShuffleAndFillCore` (`0x1bbefaa1c`) and
+       * `...::buildShuffleAndFillIfModuloIsAlpha` (`0x1bbefaf74`). The first
+       * reads one byte at offset 0x10 of the `modulo` operand -- where
+       * `llvm::Value` keeps its SubclassID -- and takes `...Core` for one value
+       * of it and `...IfModuloIsAlpha` for the rest, so a constant modulo has a
+       * path of its own, which is the path every call in this image takes. That
+       * binary also carries the string `AGC_SIMD_ROTATE_AS_SHUFFLE_AND_FILL`,
+       * which is why the rotate refusal below is this same wall and not another
+       * one. Reading `...Core` out is what would settle the fill's source lane;
+       * it has not been read, and inventing the formula instead is the thing
+       * this frontend does not do (docs/air.md 10.3).
+       */
+      /* INSIDE air_error's 255 BYTES, counted rather than hoped: the name is 30
+       * of them and the tail is 198, so the whole sentence arrives. The detail
+       * that does not fit is the comment above and docs/air.md 10.3.
+       */
+      return air_error(c, "intrinsic: air.%s -- the `modulo` lane window (Apple passes "
+                          "32, 4 and 8). Which lane of `filling_data` fills is settled "
+                          "by AGXCompilerCore buildShuffleAndFillCore 0x1bbefaa1c, "
+                          "unread: docs/air.md 10.3", n->part[0]);
+   }
+
+   if (!strcmp(op, "simd_shuffle_rotate_down") || !strcmp(op, "simd_shuffle_rotate_up")) {
+      /* A rotation inside the SIMD group: `(lane + delta) mod modulo`, which
+       * names a different lane at 32 than at 64 in EVERY lane rather than only
+       * near the edge. NIR has nir_rotate and ir3 lowers it
+       * (lower_rotate_clustered_to_shuffle), so the operation exists on both
+       * sides; what does not exist here is the window to rotate within.
+       *
+       * It is the fill's wall and not a second one, which Apple's own compiler
+       * says rather than this file inferring it: AGXCompilerCore carries
+       * `AGC_SIMD_ROTATE_AS_SHUFFLE_AND_FILL`, so the rotate is built out of
+       * the operation above. No module of either the corpus or the image calls
+       * one, so this is a refusal with no customer rather than a gap in reach.
+       */
+      return air_error(c, "intrinsic: air.%s -- a rotation in the SIMD group, which "
+                          "AGXCompilerCore builds out of shuffle-and-fill "
+                          "(AGC_SIMD_ROTATE_AS_SHUFFLE_AND_FILL), so it is that "
+                          "operation's wall: docs/air.md 10.3", n->part[0]);
+   }
+
+   if (!strcmp(op, "quad_shuffle") || !strcmp(op, "quad_broadcast")) {
+      /* Apple's two names for one operation, and the header says so:
+       * metal_quadgroup declares `quad_shuffle(T data, ushort quad_lane_id)`
+       * and `quad_broadcast(T data, ushort broadcast_lane_id)` -- an absolute
+       * lane WITHIN the quad in both cases. NIR's quad_broadcast is that, and
+       * it is exact at any SIMD-group width because a quad is four consecutive
+       * lanes on both machines.
+       *
+       * NIR inherits SPIR-V's requirement that the index be uniform across the
+       * quad, and so does Metal's own quad_broadcast; `quad_shuffle` is the
+       * name for the non-uniform reading, which is why both are here and only
+       * a constant or a quad-uniform index is honest. Nothing enforces that:
+       * the index is not inspected, because a value this frontend cannot prove
+       * uniform is not a value it can prove non-uniform either, and refusing
+       * every non-constant index would refuse the uniform ones with it.
+       */
+      nir_def *lane = air_get_ssa(c, in->operands[2]);
+      if (!lane)
+         return false;
+      air_set(c, &in->base,
+              air_val_ssa(c, nir_quad_broadcast(&c->b, a0, nir_u2u32(&c->b, lane))));
+      return true;
+   }
+
+   if (!strcmp(op, "quad_shuffle_down") || !strcmp(op, "quad_shuffle_up")) {
+      /* quad_shuffle_{down,up}(data, delta): the lane `delta` along inside the
+       * quad, undefined when that leaves the quad. NIR has no quad-restricted
+       * shuffle, so this is nir_shuffle_{down,up} over the SIMD group -- which
+       * gives the same lane for every case the quad contains, and reads the
+       * neighbouring quad for the cases Metal leaves undefined.
+       *
+       * That substitution is sound in exactly the way the `and_fill` one above
+       * is not: there, the out-of-window case has a DEFINED result that this
+       * would get wrong; here it has none, so a real neighbour's value is as
+       * conforming as anything else. What it is not is identical to Apple's
+       * hardware, and a shader written against that hardware's actual
+       * behaviour out of range would differ -- which no reading of the bitcode
+       * can detect, so it is a note and not a check.
+       */
+      nir_def *delta = air_get_ssa(c, in->operands[2]);
+      if (!delta)
+         return false;
+      delta = nir_u2u32(&c->b, delta);
+      air_note(c, "air.%s is emitted as a SIMD-group shuffle, which agrees with it "
+                  "inside the quad and reads the neighbouring quad where Metal leaves "
+                  "the result undefined", n->part[0]);
+      air_set(c, &in->base,
+              air_val_ssa(c, !strcmp(op, "quad_shuffle_down")
+                                ? nir_shuffle_down(&c->b, a0, delta)
+                                : nir_shuffle_up(&c->b, a0, delta)));
+      return true;
+   }
+
+   if (!strcmp(op, "quad_shuffle_xor")) {
+      /* quad_shuffle_xor(data, mask) hands each lane the value of the lane
+       * whose number is its own exclusive-ored with the mask. Within a quad
+       * that is one of three fixed swaps, which is exactly the three NIR has:
+       * 1 swaps the two columns, 2 the two rows, 3 the diagonal. A mask of 0
+       * is the identity.
+       *
+       * A mask that is not a constant, or is 4 or more, is refused rather
+       * than translated: the first would need a selection over the three
+       * swaps, and the second leaves the quad, where Metal's own definition
+       * stops. Every call in Resident Evil 4's three modules passes a
+       * constant.
+       */
+      nir_def *mask = air_get_ssa(c, in->operands[2]);
+      if (!mask)
+         return false;
+      if (!nir_src_is_const(nir_src_for_ssa(mask)))
+         return air_error(c, "intrinsic: air.%s with a mask that is not a constant",
+                          n->part[0]);
+      uint64_t m = nir_src_as_uint(nir_src_for_ssa(mask));
+      switch (m) {
+      case 0: air_set(c, &in->base, air_val_ssa(c, a0)); return true;
+      case 1: air_set(c, &in->base,
+                      air_val_ssa(c, nir_quad_swap_horizontal(&c->b, a0)));
+              return true;
+      case 2: air_set(c, &in->base,
+                      air_val_ssa(c, nir_quad_swap_vertical(&c->b, a0)));
+              return true;
+      case 3: air_set(c, &in->base,
+                      air_val_ssa(c, nir_quad_swap_diagonal(&c->b, a0)));
+              return true;
+      default:
+         return air_error(c, "intrinsic: air.%s with mask %u, which leaves the quad",
+                          n->part[0], (unsigned)m);
+      }
+   }
+
+   /* air.get_sample_position(index, 0): the position of one sample within the
+    * pixel, which the hardware's sample pattern decides.
+    *
+    * REFUSED BY NAME, and the reason is half a pixel. NIR has the operation
+    * and the Adreno has the instruction -- nir_load_sample_pos_from_id, which
+    * ir3 emits as RGETPOS -- but that intrinsic's convention is an OFFSET
+    * from the pixel's centre, in [-0.5, 0.5]: ir3's own lowering of
+    * gl_SamplePosition adds (0.5, 0.5) to it and cites the dEQP case that
+    * fixes the difference (ir3_nir_lower_load_barycentric_at_sample.c).
+    * Metal's convention is not stated by anything on this machine -- not by
+    * the metal_graphics header on the device, which only names the function
+    * and its MSL section, and not by any string in the compiler libraries --
+    * and the two readings differ by exactly half a pixel, which is the kind
+    * of wrongness that looks like a slightly soft image rather than like a
+    * bug. 4 of Resident Evil 4's 7 879 modules call it, and the way to settle
+    * it is a measurement on the phone (draw one multisampled pixel, read the
+    * positions back) rather than a choice made here.
+    */
+   if (!strcmp(op, "get_sample_position"))
+      return air_error(c, "intrinsic: air.%s -- NIR's sample position is an offset "
+                          "from the pixel centre and Metal's convention is not "
+                          "attested anywhere on this machine; the two differ by half "
+                          "a pixel, so this is left to a measurement", n->part[0]);
+
+   *handled = false;
+   return true;
+}
+
+/* -- llvm.* ------------------------------------------------------------- */
+
+static bool
+llvm_op(struct air_ctx *c, const struct air_inst *in, const char *name)
+{
+   if (!strncmp(name, "llvm.lifetime.", 14))
+      return true; /* scope markers: nothing to emit */
+   /* a promise to the optimizer that its condition holds (MPS's CNN kernels
+    * carry them): it changes nothing a shader computes, so nothing either */
+   if (!strcmp(name, "llvm.assume"))
+      return true;
+   if (!strncmp(name, "llvm.memcpy.", 12)) {
+      /* a copy between two of our pointers, of a constant length */
+      struct air_val *dst = air_get(c, in->operands[1]);
+      struct air_val *src = air_get(c, in->operands[2]);
+      if (!dst || !src)
+         return false;
+      if (dst->kind != AIR_VAL_PTR || src->kind != AIR_VAL_PTR)
+         return air_error(c, "intrinsic: memcpy that is not between pointers");
+      uint64_t bytes;
+      if (!air_const_uint(in->operands[3], &bytes))
+         return air_error(c, "intrinsic: memcpy of a run-time length");
+      /* in 4-byte pieces, which is what every memcpy in the corpus is a
+       * multiple of (they copy float vectors out of constant buffers)
+       */
+      if (bytes % 4)
+         return air_error(c, "intrinsic: memcpy of %u bytes", (unsigned)bytes);
+      for (uint64_t off = 0; off < bytes; off += 4) {
+         struct air_ptr s = air_ptr_add(c, src->ptr, nir_imm_int(&c->b, off));
+         struct air_ptr d = air_ptr_add(c, dst->ptr, nir_imm_int(&c->b, off));
+         static const struct air_type u32 = { .kind = AIR_TYPE_INT, .bits = 32 };
+         nir_def *v = air_load_ptr(c, s, &u32, 4);
+         if (!v || !air_store_ptr(c, d, v, 4))
+            return false;
+      }
+      return true;
+   }
+   if (!strncmp(name, "llvm.memset.", 12)) {
+      struct air_val *dst = air_get(c, in->operands[1]);
+      nir_def *byte = air_get_ssa(c, in->operands[2]);
+      if (!dst || !byte)
+         return false;
+      if (dst->kind != AIR_VAL_PTR)
+         return air_error(c, "intrinsic: memset of something that is not a pointer");
+      uint64_t bytes;
+      if (!air_const_uint(in->operands[3], &bytes))
+         return air_error(c, "intrinsic: memset of a run-time length");
+      if (!nir_src_is_const(nir_src_for_ssa(byte)))
+         return air_error(c, "intrinsic: memset of a run-time byte");
+      uint32_t b = nir_src_as_uint(nir_src_for_ssa(byte)) & 0xff;
+      uint32_t word = b | b << 8 | b << 16 | b << 24;
+      /* WHOLE WORDS, THEN WHATEVER IS LEFT. The length used to have to be a
+       * multiple of four, and the one llvm.memset in all 852 modules of the
+       * corpus is not: DepthProcessorV1's `kernelComputeStage1` zeroes EIGHTEEN
+       * bytes of a `device` buffer, which is four words and a short. So that
+       * rule never once applied to anything it allowed. There is nothing to
+       * decide here -- a memset's meaning is LLVM's own and the bytes it writes
+       * are not open to interpretation -- so the tail is written at the width it
+       * is, 16 bits and then 8, which air_store_ptr carries because a store is a
+       * store of whatever bit size the value has.
+       *
+       * Three stores and not a byte loop, because the length is a constant and
+       * a byte loop would emit eighteen of them. `llvm.memcpy` keeps its
+       * multiple-of-four refusal: a tail there needs a LOAD of the same odd
+       * width as well, nothing in the image asks for one, and a lowering with
+       * no customer is a lowering with no test.
+       */
+      uint64_t off = 0;
+      for (; off + 4 <= bytes; off += 4) {
+         struct air_ptr d = air_ptr_add(c, dst->ptr, nir_imm_int(&c->b, off));
+         if (!air_store_ptr(c, d, nir_imm_int(&c->b, word), 4))
+            return false;
+      }
+      if (bytes - off >= 2) {
+         struct air_ptr d = air_ptr_add(c, dst->ptr, nir_imm_int(&c->b, off));
+         if (!air_store_ptr(c, d, nir_imm_intN_t(&c->b, word & 0xffff, 16), 2))
+            return false;
+         off += 2;
+      }
+      if (bytes - off >= 1) {
+         struct air_ptr d = air_ptr_add(c, dst->ptr, nir_imm_int(&c->b, off));
+         if (!air_store_ptr(c, d, nir_imm_intN_t(&c->b, b, 8), 1))
+            return false;
+      }
+      return true;
+   }
+   /* llvm.fmuladd(a, b, c): a multiply-add that MAY be fused.
+    *
+    * Translated as a fused one -- nir_ffma, a single rounding -- and the
+    * licence for that is the intrinsic's own definition rather than the
+    * module's fast-math flag. LLVM's Language Reference says of llvm.fmuladd
+    * that the expression "is equivalent to a * b + c, except that it is
+    * unspecified whether rounding will be performed between the
+    * multiplication and addition steps", and that a caller who needs the
+    * fusion guaranteed must use llvm.fma instead. A producer that emitted
+    * llvm.fmuladd rather than `fmul` + `fadd` therefore accepted both answers
+    * when it chose the name, and the choice between them is the back end's.
+    *
+    * SO THE ABSENCE OF air.compile.fast_math_enable CHANGES NOTHING HERE, and
+    * that is worth saying because the measurement invites the opposite
+    * reading: 383 of a 394-module sample of Resident Evil 4 carry the flag, so
+    * contraction is permitted under the stricter reading too -- but the eleven
+    * that do not are not a different case for THIS intrinsic. A module that
+    * wanted two roundings would carry two instructions.
+    *
+    * Which answer the Adreno gives is then ir3's: nir_ffma is one rounding,
+    * and a backend that has no fused multiply-add would lower it. softpipe
+    * does not have one -- TGSI's own specification lets MAD round the product
+    * first and its interpreter does -- which is why tools/air/intrincheck.py
+    * sets air.fma aside on softpipe and leaves it to the phone. The same
+    * applies to every llvm.fmuladd this translates.
+    */
+   if (!strncmp(name, "llvm.fmuladd.", 13)) {
+      nir_def *a = air_get_ssa(c, in->operands[1]);
+      nir_def *b = air_get_ssa(c, in->operands[2]);
+      nir_def *d = air_get_ssa(c, in->operands[3]);
+      if (!a || !b || !d)
+         return false;
+      air_set(c, &in->base, air_val_ssa(c, nir_ffma(&c->b, a, b, d)));
+      return true;
+   }
+   if (!strncmp(name, "llvm.fabs.", 10)) {
+      nir_def *a = air_get_ssa(c, in->operands[1]);
+      if (!a)
+         return false;
+      air_set(c, &in->base, air_val_ssa(c, nir_fabs(&c->b, a)));
+      return true;
+   }
+   if (!strcmp(name, "llvm.trap"))
+      return air_error(c, "intrinsic: llvm.trap");
+   return air_error(c, "intrinsic: %s", name);
+}
+
+/* -- textures ------------------------------------------------------------
+ *
+ * The largest family and the one with the long tail. Its vocabulary is
+ * Apple's, read off AGXCompilerCore the same way the arithmetic was
+ * (docs/air.md section 3.2): the names there end in an underscore --
+ * air.sample_texture_, air.gather_compare_depth_, air.get_num_mip_levels_texture_
+ * -- because the dimensionality is appended to them. That is why the earlier
+ * survey counted "about 117 get_*_texture_* variants": it is some twenty
+ * operations crossed with nine dimensionalities, not a hundred separate
+ * things.
+ *
+ * The signatures are measured from the corpus, not guessed:
+ *
+ *   sample_<kind>_<dim> (tex, samp, [plane,] coord, [i32 array,]
+ *                        [i1 has_offset, offset,]
+ *                        i1 lod_is_level, float lod_or_bias, float min_lod,
+ *                        i32 flags)                  -> { <4 x T>, i8 }
+ *   sample_<kind>_<dim>_grad
+ *                       (tex, samp, [plane,] coord, [i32 array,]
+ *                        dPdx, dPdy, float min_lod,
+ *                        [i1 has_offset, offset,] i32 flags)
+ *   gather_<kind>_<dim> (tex, samp, coord, [i32 array,]
+ *                        [i1 has_offset, offset,]
+ *                        i32 component, i32 flags)   -> { <4 x T>, i8 }
+ *   read_<kind>_<dim>   (tex, [plane,] coord, [i32 array,]
+ *                        i32 lod_or_sample, i32 flags)
+ *   write_<kind>_<dim>  (tex, coord, [i32 array,] value, i32 lod, i32 flags)
+ *   get_<what>_<kind>_<dim> (tex[, i32 lod])         -> i32
+ *
+ * Three things in those brackets, and none of them is a guess. They are read
+ * off Apple's own metal_stdlib on this device --
+ * GPUCompiler.framework/.../include/metal/metal_texture, where every
+ * `texture2d_array<T>::sample` and its fifty neighbours are one-line
+ * forwarders to the builtin, so the header states the argument ORDER for all
+ * nine dimensionalities and six operations -- and then confirmed against the
+ * LLVM declaration in the modules that call them. The two agree everywhere:
+ *
+ *   AN ARRAY INDEX IS ITS OWN ARGUMENT, straight after the coordinate, in
+ *   every one of sample, gather, read and write. It is not inside the
+ *   coordinate vector, which is what this file used to require of it:
+ *   air.sample_texture_2d_array takes a <2 x float> and an i32, and the
+ *   refusal it used to earn said "with a 2-component coordinate, wanting 3".
+ *
+ *   THE GRADIENT FORM REORDERS WHAT FOLLOWS. dPdx, dPdy and the minimum level
+ *   come before the offset pair, where the plain form has the offset pair
+ *   first and the level last. A reader that assumed one order for both would
+ *   take a gradient for an offset flag.
+ *
+ *   A CUBE HAS NO OFFSET PAIR AT ALL -- Metal defines no offset for cube
+ *   sampling -- so air.sample_texture_cube goes from the coordinate straight
+ *   to the level flag. Reading the 2d shape there is what made 621 modules
+ *   stop at "argument 5 is not a constant": the float minimum level was being
+ *   read as the i1 that says whether the next float is a level.
+ *
+ * The i1 before the level is read as "the float is a level, not a bias", so
+ * (false, 0.0) is a plain sample -- which is what every one of the system
+ * corpus's sample calls passes. Resident Evil 4 exercises both: 23 823
+ * level-form calls against 5 961 bias-form.
+ *
+ * The second field of the returned struct is Metal's sparse-residency byte.
+ * No module in the corpus reads it (every extractvalue of a texture result
+ * takes field 0), so it is produced as zero rather than invented.
+ */
+
+struct air_tex_name {
+   const char *op;        /* "sample", "gather", "read", "write", "get", "lod" */
+   const char *query;     /* for "get": width, height, depth, array_size, ... */
+   bool compare;          /* sample_compare / gather_compare */
+   bool depth;            /* a depth texture rather than a colour one */
+   enum glsl_sampler_dim dim;
+   bool is_array, is_ms, is_buffer;
+   bool grad;             /* the _grad form: explicit dPdx and dPdy */
+   bool no_offset;        /* this dimensionality takes no offset argument */
+};
+
+static bool
+eat(const char **s, const char *prefix)
+{
+   size_t n = strlen(prefix);
+   if (strncmp(*s, prefix, n))
+      return false;
+   *s += n;
+   return true;
+}
+
+/* air.<op>_<kind>_<dim> -> the pieces, or false when it is not a texture name */
+static bool
+parse_tex_name(const char *name, struct air_tex_name *t)
+{
+   memset(t, 0, sizeof(*t));
+   const char *s = name;
+
+   if (eat(&s, "sample_compare_")) {
+      t->op = "sample";
+      t->compare = true;
+   } else if (eat(&s, "sample_")) {
+      t->op = "sample";
+   } else if (eat(&s, "gather_compare_")) {
+      t->op = "gather";
+      t->compare = true;
+   } else if (eat(&s, "gather_")) {
+      t->op = "gather";
+   } else if (eat(&s, "read_")) {
+      t->op = "read";
+   } else if (eat(&s, "write_")) {
+      t->op = "write";
+   } else if (eat(&s, "calculate_clamped_lod_") || eat(&s, "calculate_unclamped_lod_")) {
+      t->op = "lod";
+   } else if (eat(&s, "get_")) {
+      t->op = "get";
+      static const char *queries[] = {
+         "num_mip_levels_", "num_samples_", "array_size_", "width_", "height_", "depth_",
+      };
+      static const char *names[] = {
+         "num_mip_levels", "num_samples", "array_size", "width", "height", "depth",
+      };
+      for (unsigned i = 0; i < ARRAY_SIZE(queries); i++) {
+         if (eat(&s, queries[i])) {
+            t->query = names[i];
+            break;
+         }
+      }
+      if (!t->query)
+         return false;
+   } else {
+      return false;
+   }
+
+   if (eat(&s, "texture_buffer_1d")) {
+      t->dim = GLSL_SAMPLER_DIM_BUF;
+      t->is_buffer = true;
+      return *s == 0;
+   }
+   if (eat(&s, "depth_"))
+      t->depth = true;
+   else if (!eat(&s, "texture_"))
+      return false;
+
+   /* The gradient form appends _grad to the DIMENSIONALITY and not to the
+    * operation: Apple's builtin is __metal_sample_texture_2d_array_t_grad, so
+    * the air.* name is air.sample_texture_2d_array_grad. Taking it off here
+    * rather than giving the table nine more rows is what keeps one name for
+    * one dimensionality -- and the exact comparison below is why 858 modules
+    * used to stop at "a texture name this cannot take apart".
+    */
+   size_t len = strlen(s);
+   if (len > 5 && !strcmp(s + len - 5, "_grad")) {
+      t->grad = true;
+      len -= 5;
+   }
+
+   /* the dimensionality, and whether it has an offset argument at all */
+   static const struct {
+      const char *suffix;
+      enum glsl_sampler_dim dim;
+      bool array, ms, no_offset;
+   } dims[] = {
+      { "cube_array", GLSL_SAMPLER_DIM_CUBE, true, false, true },
+      { "2d_ms_array", GLSL_SAMPLER_DIM_MS, true, true, false },
+      { "2d_array", GLSL_SAMPLER_DIM_2D, true, false, false },
+      { "1d_array", GLSL_SAMPLER_DIM_1D, true, false, false },
+      { "2d_ms", GLSL_SAMPLER_DIM_MS, false, true, false },
+      { "cube", GLSL_SAMPLER_DIM_CUBE, false, false, true },
+      { "1d", GLSL_SAMPLER_DIM_1D, false, false, false },
+      { "2d", GLSL_SAMPLER_DIM_2D, false, false, false },
+      { "3d", GLSL_SAMPLER_DIM_3D, false, false, false },
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(dims); i++) {
+      if (strlen(dims[i].suffix) == len && !strncmp(s, dims[i].suffix, len)) {
+         t->dim = dims[i].dim;
+         t->is_array = dims[i].array;
+         t->is_ms = dims[i].ms;
+         t->no_offset = dims[i].no_offset;
+         return true;
+      }
+   }
+   return false;
+}
+
+static unsigned
+coord_components_of(const struct air_tex_name *t)
+{
+   unsigned n = t->dim == GLSL_SAMPLER_DIM_1D ? 1 :
+                t->dim == GLSL_SAMPLER_DIM_3D ? 3 :
+                t->dim == GLSL_SAMPLER_DIM_CUBE ? 3 :
+                t->dim == GLSL_SAMPLER_DIM_BUF ? 1 : 2;
+   return n + (t->is_array ? 1 : 0);
+}
+
+/* the result type of a texture operation, from the LLVM type it returns */
+static nir_alu_type
+tex_dest_type(struct air_ctx *c, const struct air_type *ret, const struct air_name *n)
+{
+   const struct air_type *t = ret;
+   if (t->kind == AIR_TYPE_STRUCT && t->num_members)
+      t = t->members[0];
+   const struct air_type *scalar = air_type_scalar(t);
+   unsigned bits = air_type_bit_size(scalar);
+   if (air_type_is_float(scalar))
+      return nir_type_float | bits;
+   /* the signedness is in the name, not in the type: .s or .u */
+   for (unsigned i = 1; i < n->num; i++) {
+      if (!strcmp(n->part[i], "s"))
+         return nir_type_int | bits;
+      if (!strcmp(n->part[i], "u"))
+         return nir_type_uint | bits;
+   }
+   return nir_type_uint | bits;
+}
+
+/* The pointer a texture or sampler argument carries. */
+static bool
+tex_handle(struct air_ctx *c, const struct air_inst *in, unsigned operand,
+           enum air_ptr_class want, struct air_ptr *out)
+{
+   struct air_val *v = air_get(c, in->operands[operand]);
+   if (!v)
+      return false;
+   if (v->kind != AIR_VAL_PTR || v->ptr.class != want)
+      return air_error(c, "intrinsic: argument %u is not a %s", operand - 1,
+                       want == AIR_PTR_TEXTURE ? "texture" : "sampler");
+   *out = v->ptr;
+   return true;
+}
+
+/* a constant i1/i32 argument, which these intrinsics use as flags */
+static bool
+tex_flag(struct air_ctx *c, const struct air_inst *in, unsigned operand, uint64_t *out)
+{
+   if (!air_const_uint(in->operands[operand], out))
+      return air_error(c, "intrinsic: argument %u is not a constant", operand - 1);
+   return true;
+}
+
+/* the { value, residency } struct these return */
+static void
+set_tex_result(struct air_ctx *c, const struct air_inst *in, nir_def *value)
+{
+   const struct air_type *ret = in->base.type;
+   if (ret->kind != AIR_TYPE_STRUCT) {
+      air_set(c, &in->base, air_val_ssa(c, value));
+      return;
+    }
+   struct air_val *agg = rzalloc(c->mem_ctx, struct air_val);
+   agg->kind = AIR_VAL_AGG;
+   agg->num_elems = ret->num_members;
+   agg->elems = rzalloc_array(c->mem_ctx, struct air_val *, MAX2(ret->num_members, 1));
+   agg->elems[0] = air_val_ssa(c, value);
+   for (unsigned i = 1; i < ret->num_members; i++) {
+      /* the sparse-residency byte: nothing in the corpus reads it */
+      unsigned bits = air_nir_bit_size(c, ret->members[i]);
+      agg->elems[i] = air_val_ssa(c, nir_imm_intN_t(&c->b, 0, bits));
+   }
+   air_set(c, &in->base, agg);
+}
+
+
+/* A query: a size, a level count or a sample count, of a texture or an image. */
+static nir_def *
+query_texture(struct air_ctx *c, const struct air_ptr *tex, const struct air_tex_name *t,
+              nir_texop op, nir_def *lod, unsigned comps)
+{
+   if (tex->is_image) {
+      nir_def *index = nir_imm_int(&c->b, tex->binding);
+      switch (op) {
+      case nir_texop_txs: {
+         /* an image size has as many components as the image has dimensions;
+          * the caller passes 0 for "as many as there are"
+          */
+         unsigned n = comps ? comps :
+            (t->dim == GLSL_SAMPLER_DIM_1D || t->dim == GLSL_SAMPLER_DIM_BUF ? 1 :
+             t->dim == GLSL_SAMPLER_DIM_3D ? 3 : 2) + (t->is_array ? 1 : 0);
+         return nir_image_size(&c->b, n, 32, index, lod ? lod : nir_imm_int(&c->b, 0),
+                               .image_dim = t->dim, .image_array = t->is_array);
+      }
+      case nir_texop_query_levels:
+         return nir_image_levels(&c->b, 32, index, .image_dim = t->dim,
+                                 .image_array = t->is_array);
+      default:
+         return nir_image_samples(&c->b, 32, index, .image_dim = t->dim,
+                                  .image_array = t->is_array);
+      }
+   }
+
+   nir_tex_instr *q = nir_tex_instr_create(c->nir, lod ? 1 : 0);
+   q->op = op;
+   q->sampler_dim = t->dim;
+   q->is_array = t->is_array;
+   q->dest_type = nir_type_int32;
+   q->texture_index = tex->binding;
+   q->sampler_index = 0;
+   if (lod)
+      q->src[0] = (nir_tex_src){ .src_type = nir_tex_src_lod, .src = nir_src_for_ssa(lod) };
+   /* NIR fixes the size of a query's result itself -- txs is two components
+    * for a 2D texture whatever the caller asks one of them for -- so it is
+    * asked here and the component picked afterwards.
+    */
+   if (comps == 0)
+      comps = nir_tex_instr_dest_size(q);
+   nir_def_init(&q->instr, &q->def, comps, 32);
+   nir_builder_instr_insert(&c->b, &q->instr);
+   return &q->def;
+}
+
+/* is every component of this value a constant zero? */
+static bool
+all_zero(nir_def *def)
+{
+   if (!nir_src_is_const(nir_src_for_ssa(def)))
+      return false;
+   for (unsigned i = 0; i < def->num_components; i++)
+      if (nir_src_comp_as_int(nir_src_for_ssa(def), i) != 0)
+         return false;
+   return true;
+}
+
+/* The coordinate, with the array index that follows it folded into it.
+ *
+ * NIR wants one coordinate with the layer as its last component; AIR passes
+ * the two separately (see the signatures above). Which way the layer is
+ * converted follows the coordinate's own type, which is also the only place
+ * the answer can come from: a sample's coordinate is floating point and NIR's
+ * array layer is then a float like the rest of it, while a read's is an
+ * integer and the layer stays one.
+ *
+ * The float conversion is exact and not a rounding to be worried about. Metal
+ * hands over an integer layer; u2f of an integer below 2^24 is exact in a
+ * float, and 2^24 layers is 16 million slices of a texture array whose limit
+ * on this hardware is 2 048. What a backend does with a *fractional* layer --
+ * Vulkan says round to even, GLSL says nearest -- therefore never arises
+ * here, because the value handed to it is always a whole number.
+ *
+ * An integer coordinate is widened to 32 bits first so that the layer, which
+ * arrives as i32, does not have to be narrowed to meet it: air.read_texture_2d
+ * has a 16-bit coordinate variant and the layer in those signatures is 32-bit
+ * all the same.
+ */
+static nir_def *
+tex_coord_and_layer(struct air_ctx *c, const struct air_inst *in,
+                    const struct air_tex_name *t, const struct air_name *n,
+                    unsigned *arg, unsigned ncoord)
+{
+   if (in->num_operands <= *arg) {
+      air_error(c, "intrinsic: air.%s without a coordinate", n->part[0]);
+      return NULL;
+   }
+   const struct air_value *cv = in->operands[*arg];
+   nir_def *coord = air_get_ssa(c, cv);
+   if (!coord)
+      return NULL;
+   (*arg)++;
+   bool is_float = air_type_is_float(air_type_scalar(cv->type));
+   if (!is_float)
+      coord = nir_u2u32(&c->b, coord);
+
+   if (t->is_array) {
+      if (in->num_operands <= *arg) {
+         air_error(c, "intrinsic: air.%s without the array index its signature has",
+                   n->part[0]);
+         return NULL;
+      }
+      nir_def *layer = air_get_ssa(c, in->operands[(*arg)++]);
+      if (!layer)
+         return NULL;
+      if (layer->num_components != 1) {
+         air_error(c, "intrinsic: air.%s with a %u-component array index",
+                   n->part[0], layer->num_components);
+         return NULL;
+      }
+      layer = is_float ? nir_u2fN(&c->b, layer, coord->bit_size)
+                       : nir_u2u32(&c->b, layer);
+
+      nir_def *comps[4];
+      unsigned nc = MIN2(coord->num_components, 3);
+      for (unsigned i = 0; i < nc; i++)
+         comps[i] = nir_channel(&c->b, coord, i);
+      comps[nc] = layer;
+      coord = nir_vec(&c->b, comps, nc + 1);
+   }
+
+   if (coord->num_components != ncoord) {
+      air_error(c, "intrinsic: air.%s with a %u-component coordinate, wanting %u",
+                n->part[0], coord->num_components, ncoord);
+      return NULL;
+   }
+   return coord;
+}
+
+static bool
+texture_op(struct air_ctx *c, const struct air_inst *in, const struct air_name *n)
+{
+   /* THE NULL TEXTURE, named before the parser gets to shrug at it. 26 calls of
+    * air.get_null_texture_2d and 8 of air.get_null_texture_3d in the system
+    * corpus, all of them in QuartzCore's two YCbCr uber shaders -- and
+    * fixed_frag_lph_cph is the module this driver is asked for more than any
+    * other (104 of 105 pipeline refusals in one boot), so this is the last
+    * thing between it and a pipeline.
+    *
+    * WHAT APPLE'S COMPILER DOES WITH IT, read rather than remembered.
+    * AGCLLVMUserObject::replaceTexturesAndSamplers (0x1bbde9754) walks the
+    * module's function list (body 0x1bbde9ed8, latch 0x1bbdea168) and looks
+    * each name up with llvm::StringMapImpl::FindKey (0x1bbde9f04, libLLVM
+    * 0x1bd5ddba0) in getGetNullTextureFunctionSet (0x1bbdf34a0, object
+    * 0x1e29980c0), whose 16 names are "air.get_null_" (0x1bbf4867f) joined to
+    * each suffix of the table at 0x1d9274398 -- texture_buffer_1d, texture_1d,
+    * texture_1d_array, texture_2d, texture_2d_array, texture_3d, texture_cube,
+    * texture_cube_array, texture_2d_ms, texture_2d_ms_array, depth_2d,
+    * depth_2d_array, depth_cube, depth_cube_array, depth_2d_ms,
+    * depth_2d_ms_array. On a hit it takes the function's return type and
+    * replaces every call of it with a CONSTANT:
+    *
+    *   with a texture heap  ConstantInt::get(intTy, [this+0x84c], false)
+    *                        (0x1bbde9f70, libLLVM 0x1bce62ec8) then
+    *                        ConstantExpr::getIntToPtr(.., retTy, false)
+    *                        (0x1bbde9f7c, libLLVM 0x1bce63694)
+    *   without one          Constant::getNullValue(retTy)
+    *                        (0x1bbdea178, libLLVM 0x1bce62bf4)
+    *
+    * and [this+0x84c] is written at 0x1bbe988b4 in
+    * createTextureHeapIndexArray, from the SmallVector's own Size -- so the
+    * heap index is ONE PAST THE LAST real texture.
+    *
+    * SO THERE IS NO RULE HERE FOR WHAT SAMPLING ONE YIELDS. Apple's compiler
+    * substitutes a handle and leaves the answer to the descriptor that handle
+    * names; the behaviour is the hardware's. Folding the sample to a value at
+    * translation time therefore cannot be justified out of this -- it would
+    * need the MSL specification or a measurement on an Apple GPU, and neither
+    * is in reach, so it is NOT the road and that is a reading and not a
+    * shrug.
+    *
+    * What the read does give is the other road's precedent, in Apple's own
+    * structure: where textures are indices into a table, a null texture is a
+    * RESERVED INDEX in that table. This frontend's textures are indices too
+    * (Metal's own `[[texture(n)]]`, resolved while translating), so the
+    * analogue is exact -- a zero-filled 1x1 texture the runtime binds at an
+    * index past the module's last. docs/air.md 3 costs it: for
+    * fixed_frag_lph_cph that index is 15, because it declares 0..14, and
+    * RWA_MAX_TEXTURES is 16, so it fits with nothing to spare. The frontend's
+    * half is small and the runtime's is not this file's.
+    */
+   if (!strncmp(n->part[0], "get_null_texture", 16)) {
+      /* ROAD B, and the frontend's whole half of it: a reserved slot, flagged,
+       * for the runtime to bind a 1x1 texture of zeros at. The sample through
+       * it is an ordinary sample at an ordinary index, which is why nothing
+       * else in this file changes -- and the shape the runtime must make it is
+       * derived from that sample like any other slot's (slot_shapes), so a
+       * `get_null_texture_3d` reaches the driver as a 3D slot without this
+       * function saying so.
+       */
+      int slot = air_null_texture_slot(c);
+      if (slot < 0)
+         return false;      /* null_texture_slot has said why */
+      struct air_ptr p = { .class = AIR_PTR_TEXTURE, .binding = (unsigned)slot };
+      air_set(c, &in->base, air_val_ptr(c, p));
+      return true;
+   }
+   if (!strncmp(n->part[0], "is_null_texture", 15)) {
+      /* Exact, and a constant, because the question is one this frontend has
+       * already answered: a texture is resolved to an index while translating,
+       * so "is this the null one" is "is this the reserved slot". Folding it
+       * here is not an optimisation -- an argument that did not resolve to a
+       * texture never reaches this line, because tex_handle refuses it first.
+       */
+      struct air_val *t = air_get(c, in->operands[1]);
+      if (!t)
+         return false;
+      if (t->kind != AIR_VAL_PTR || t->ptr.class != AIR_PTR_TEXTURE)
+         return air_error(c, "intrinsic: air.%s of something this frontend did not "
+                             "resolve to a texture", n->part[0]);
+      bool is_null = c->null_texture_index >= 0 &&
+                     t->ptr.binding == (unsigned)c->null_texture_index;
+      air_set(c, &in->base, air_val_ssa(c, nir_imm_bool(&c->b, is_null)));
+      return true;
+   }
+
+   struct air_tex_name t;
+   if (!parse_tex_name(n->part[0], &t))
+      return air_error(c, "intrinsic: air.%s (a texture name this cannot take apart)",
+                       n->part[0]);
+   if (t.is_buffer)
+      return air_error(c, "intrinsic: air.%s (texture buffers, not yet)", n->part[0]);
+   /* A comparison belongs to a depth texture and to a sample: Apple's header declares
+    * sample_compare and gather_compare on depth2d and depth2d_array and on nothing
+    * else, so a name claiming either of the other two shapes is a misparse and not a
+    * gap. Said by name rather than translated into a plausible instruction.
+    */
+   if (t.compare && !t.depth)
+      return air_error(c, "intrinsic: air.%s (a comparison of a colour texture, which "
+                          "Metal declares on depth textures only)", n->part[0]);
+   if (t.compare && !strcmp(t.op, "gather"))
+      return air_error(c, "intrinsic: air.%s (gather_compare: four comparisons in one "
+                          "instruction, which nothing measured here attests -- no module "
+                          "of the 456 and none of Resident Evil 4's 7 879 calls one -- so "
+                          "there is nothing to check an answer against)", n->part[0]);
+   /* Only a sample has a gradient form -- Apple's header has
+    * __metal_sample_*_t_grad and no gather, read or write counterpart -- and a
+    * name that claimed one would be read by the sample branch's rules below,
+    * which is the kind of silent misparse this file refuses instead.
+    */
+   if (t.grad && strcmp(t.op, "sample"))
+      return air_error(c, "intrinsic: air.%s (a gradient form of %s, which Metal has no "
+                          "signature for)", n->part[0], t.op);
+
+   struct air_ptr tex;
+   if (!tex_handle(c, in, 1, AIR_PTR_TEXTURE, &tex))
+      return false;
+
+   unsigned arg = 2;   /* operands[0] is the callee, [1] the texture */
+   struct air_ptr samp = { 0 };
+   bool have_sampler = !strcmp(t.op, "sample") || !strcmp(t.op, "gather") ||
+                       !strcmp(t.op, "lod");
+   if (have_sampler) {
+      if (!tex_handle(c, in, arg, AIR_PTR_SAMPLER, &samp))
+         return false;
+      arg++;
+   }
+
+   /* A depth texture takes a plane or aspect selector before the coordinate,
+    * and every call in the corpus passes 1. What else it can be is not known
+    * from the data, so anything else is refused rather than assumed.
+    */
+   if (t.depth) {
+      uint64_t plane;
+      if (!tex_flag(c, in, arg, &plane))
+         return false;
+      if (plane != 1)
+         return air_error(c, "intrinsic: air.%s with aspect %u (only 1 is understood)",
+                          n->part[0], (unsigned)plane);
+      arg++;
+   }
+
+   unsigned ncoord = coord_components_of(&t);
+   nir_alu_type dest_type = tex_dest_type(c, in->base.type, n);
+   unsigned dest_bits = nir_alu_type_get_type_size(dest_type);
+
+   if (!strcmp(t.op, "get")) {
+      /* the queries: a size, a level count or a sample count */
+      nir_def *res;
+      if (!strcmp(t.query, "num_samples")) {
+         res = query_texture(c, &tex, &t, nir_texop_texture_samples, NULL, 1);
+      } else if (!strcmp(t.query, "num_mip_levels")) {
+         res = query_texture(c, &tex, &t, nir_texop_query_levels, NULL, 1);
+      } else {
+         nir_def *lod = nir_imm_int(&c->b, 0);
+         if (in->num_operands > arg) {
+            nir_def *given = air_get_ssa(c, in->operands[arg]);
+            if (!given)
+               return false;
+            lod = nir_u2u32(&c->b, given);
+         }
+         nir_def *size = query_texture(c, &tex, &t, nir_texop_txs, lod, 0);
+         unsigned comp = !strcmp(t.query, "width") ? 0 :
+                         !strcmp(t.query, "height") ? 1 :
+                         !strcmp(t.query, "depth") ? 2 : size->num_components - 1;
+         if (!strcmp(t.query, "array_size") && !t.is_array)
+            return air_error(c, "intrinsic: air.%s on a texture that is not an array",
+                             n->part[0]);
+         if (comp >= size->num_components)
+            return air_error(c, "intrinsic: air.%s asks for component %u of %u",
+                             n->part[0], comp, size->num_components);
+         res = nir_channel(&c->b, size, comp);
+      }
+      air_set(c, &in->base, air_val_ssa(c, nir_u2uN(&c->b, res, dest_bits)));
+      return true;
+   }
+
+   if (!strcmp(t.op, "write")) {
+      nir_def *coord = tex_coord_and_layer(c, in, &t, n, &arg, ncoord);
+      if (!coord)
+         return false;
+      /* The store's type is the VALUE's, not the call's: a write returns void,
+       * so dest_type above (from the return type) can only say "uint", and ir3
+       * would then emit stib.b.typed.*.u16/u32 for a half or float value --
+       * a typed store converts its source as the type says, so the texture
+       * would receive the bit pattern of 1.0h read as the integer 15360 (that
+       * much is the ISA's rule, not a measurement: hakios-metal's dispatch
+       * refuses a uint-typed kernel over a float format before it runs, and
+       * that refusal is what the old typing hit on the phone with Apple's
+       * MetalFaceMask_Clear, a texture2d<half, write>). With the store typed
+       * by its value, hakios-metal's tex_fill_h.ll landed 2048 of 2048 exact
+       * half bit patterns in an RGBA16Float image on 29 October (hakios
+       * logs/012127-run.log). Signedness still comes from the name (.u/.s). */
+      unsigned value_arg = arg;
+      nir_def *value = air_get_ssa(c, in->operands[arg++]);
+      if (!value)
+         return false;
+      nir_alu_type src_type = tex_dest_type(c, in->operands[value_arg]->type, n);
+      uint64_t lod;
+      if (!tex_flag(c, in, arg, &lod))
+         return false;
+      if (lod != 0)
+         return air_error(c, "intrinsic: air.%s to mip level %u (only 0 is handled)",
+                          n->part[0], (unsigned)lod);
+      if (!tex.is_image)
+         return air_error(c, "intrinsic: air.%s to a texture the interface says is not "
+                             "written", n->part[0]);
+      nir_image_store(&c->b, nir_imm_int(&c->b, tex.binding),
+                      nir_pad_vector(&c->b, nir_u2u32(&c->b, coord), 4),
+                      nir_imm_int(&c->b, 0), nir_pad_vector(&c->b, value, 4),
+                      nir_imm_int(&c->b, 0),
+                      .image_dim = t.dim, .image_array = t.is_array,
+                      .src_type = src_type);
+      return true;
+   }
+
+   /* sample, gather, read: a texture instruction, or an image load */
+   nir_def *coord = tex_coord_and_layer(c, in, &t, n, &arg, ncoord);
+   if (!coord)
+      return false;
+
+   if (!strcmp(t.op, "read") && tex.is_image) {
+      uint64_t extra;
+      if (!tex_flag(c, in, arg, &extra))
+         return false;
+      nir_def *res = nir_image_load(&c->b, 4, dest_bits, nir_imm_int(&c->b, tex.binding),
+                                    nir_pad_vector(&c->b, nir_u2u32(&c->b, coord), 4),
+                                    nir_imm_int(&c->b, t.is_ms ? extra : 0),
+                                    nir_imm_int(&c->b, t.is_ms ? 0 : extra),
+                                    .image_dim = t.dim, .image_array = t.is_array,
+                                    .dest_type = dest_type);
+      set_tex_result(c, in, res);
+      return true;
+   }
+
+   /* The value a depth texel is compared against, which Metal passes straight after
+    * the coordinate AND AFTER THE ARRAY INDEX -- __metal_sample_compare_depth_2d_t
+    * takes (tex, samp, coord, compare_value, ...) and the _2d_array form takes (tex,
+    * samp, coord, array, compare_value, ...), so the layer comes first in exactly the
+    * place tex_coord_and_layer has already consumed it. Read here and not in the
+    * branches below because it is before the offset pair in the plain form and before
+    * the gradients in the _grad one: one position, not two.
+    *
+    * At the AIR level there is also the aspect selector the depth branch above ate, as
+    * there is in air.sample_depth_2d -- Apple's header has no such argument and the
+    * declaration in texturedFragment2DDepth does:
+    *   { float, i8 } air.sample_depth_2d.f32(ptr as(1), ptr as(2), i32, <2 x float>,
+    *                                         i1, <2 x i32>, i1, float, float, i32)
+    * which is where the `i32` between the sampler and the coordinate comes from, and
+    * the only reason the compare form's shape could be read off the header at all.
+    */
+   nir_def *compare = NULL;
+   if (t.compare) {
+      if (in->num_operands <= arg)
+         return air_error(c, "intrinsic: air.%s without the value its signature compares "
+                             "against", n->part[0]);
+      if (!(compare = air_get_ssa(c, in->operands[arg++])))
+         return false;
+      if (compare->num_components != 1)
+         return air_error(c, "intrinsic: air.%s compares against %u components, and a "
+                             "depth comparison takes one", n->part[0],
+                          compare->num_components);
+      /* The texel and the value compared with it go into one register tuple on the
+       * Adreno -- ir3 puts the comparison straight after the coordinates in src0 --
+       * so a 16-bit comparison value beside 32-bit coordinates is a half register in a
+       * full tuple. Metal's own signature is `float`, so this never fires on anything
+       * Apple's compiler emits; it is here so that if something does, it is widened
+       * and not mixed.
+       */
+      if (compare->bit_size != coord->bit_size)
+         compare = nir_f2fN(&c->b, compare, coord->bit_size);
+   }
+
+   /* Seven and not six: a compare sample in the gradient form carries a coordinate, a
+    * comparison value, an offset, two derivatives and a minimum level at once, which is
+    * exactly six, and the next source anyone adds should not be the one that overflows
+    * this silently.
+    */
+   nir_tex_src srcs[7];
+   unsigned nsrc = 0;
+   srcs[nsrc++] = (nir_tex_src){ .src_type = nir_tex_src_coord,
+                                 .src = nir_src_for_ssa(coord) };
+   if (compare)
+      srcs[nsrc++] = (nir_tex_src){ .src_type = nir_tex_src_comparator,
+                                    .src = nir_src_for_ssa(compare) };
+
+   nir_texop op;
+   if (!strcmp(t.op, "sample")) {
+      /* The offset pair, for the dimensionalities that have one. A cube does
+       * not, and reading one there consumed the level flag and the level and
+       * left the minimum level to be read as the flags word -- which is the
+       * refusal 621 of Resident Evil 4's modules used to earn, "argument 5 is
+       * not a constant", from a float that indeed is not an integer constant.
+       *
+       * In the gradient form this pair comes AFTER the gradients, so the
+       * reading is a small state machine over the signature rather than one
+       * fixed order: see the table at the head of this section.
+       */
+      uint64_t has_offset = 0, is_level = 0;
+      nir_def *offset = NULL, *ddx = NULL, *ddy = NULL, *min_lod = NULL, *level = NULL;
+
+      if (t.grad) {
+         ddx = air_get_ssa(c, in->operands[arg++]);
+         ddy = air_get_ssa(c, in->operands[arg++]);
+         min_lod = air_get_ssa(c, in->operands[arg++]);
+         if (!ddx || !ddy || !min_lod)
+            return false;
+         if (!t.no_offset) {
+            if (!tex_flag(c, in, arg, &has_offset))
+               return false;
+            arg++;
+            if (!(offset = air_get_ssa(c, in->operands[arg++])))
+               return false;
+         }
+      } else {
+         if (!t.no_offset) {
+            if (!tex_flag(c, in, arg, &has_offset))
+               return false;
+            arg++;
+            if (!(offset = air_get_ssa(c, in->operands[arg++])))
+               return false;
+         }
+         if (!tex_flag(c, in, arg, &is_level))
+            return false;
+         arg++;
+         level = air_get_ssa(c, in->operands[arg++]);
+         min_lod = air_get_ssa(c, in->operands[arg++]);
+         if (!level || !min_lod)
+            return false;
+      }
+
+      if (offset && has_offset && !all_zero(offset))
+         srcs[nsrc++] = (nir_tex_src){ .src_type = nir_tex_src_offset,
+                                       .src = nir_src_for_ssa(nir_u2u32(&c->b, offset)) };
+
+      if (t.grad) {
+         /* An explicit pair of derivatives of the coordinate, which is what
+          * Metal's sample(..., gradient2d(dPdx, dPdy)) is for: a shader that
+          * knows better than the quad's own differences -- a ray-marched or
+          * reprojected coordinate, or one sampled inside a branch the quad
+          * does not take together. NIR has the operation (txd) and so does
+          * the Adreno; ir3 emits it and softpipe's interpreter has TXD, so
+          * unlike most of this family it can be both compiled and run here.
+          *
+          * The gradients carry the coordinate's components WITHOUT the array
+          * layer, which is what NIR asks for too (nir_tex_instr_src_size:
+          * coord_components minus is_array for ddx and ddy) and what AIR
+          * passes -- <2 x float> for a 2d_array whose coordinate is also
+          * <2 x float>. So nothing is added or dropped here, and that
+          * agreement is the reason this needs no reshaping.
+          */
+         op = nir_texop_txd;
+         srcs[nsrc++] = (nir_tex_src){ .src_type = nir_tex_src_ddx,
+                                       .src = nir_src_for_ssa(ddx) };
+         srcs[nsrc++] = (nir_tex_src){ .src_type = nir_tex_src_ddy,
+                                       .src = nir_src_for_ssa(ddy) };
+      } else {
+         bool level_is_zero = nir_src_is_const(nir_src_for_ssa(level)) &&
+                              nir_src_as_float(nir_src_for_ssa(level)) == 0.0;
+         if (is_level) {
+            op = nir_texop_txl;
+            srcs[nsrc++] = (nir_tex_src){ .src_type = nir_tex_src_lod,
+                                          .src = nir_src_for_ssa(level) };
+         } else if (!level_is_zero) {
+            op = nir_texop_txb;
+            srcs[nsrc++] = (nir_tex_src){ .src_type = nir_tex_src_bias,
+                                          .src = nir_src_for_ssa(level) };
+         } else {
+            op = nir_texop_tex;
+         }
+      }
+
+      if (!(nir_src_is_const(nir_src_for_ssa(min_lod)) &&
+            nir_src_as_float(nir_src_for_ssa(min_lod)) == 0.0))
+         srcs[nsrc++] = (nir_tex_src){ .src_type = nir_tex_src_min_lod,
+                                       .src = nir_src_for_ssa(min_lod) };
+   } else if (!strcmp(t.op, "gather")) {
+      uint64_t has_offset = 0;
+      nir_def *offset = NULL;
+      if (!t.no_offset) {
+         if (!tex_flag(c, in, arg, &has_offset))
+            return false;
+         arg++;
+         if (!(offset = air_get_ssa(c, in->operands[arg++])))
+            return false;
+      }
+      if (offset && has_offset && !all_zero(offset))
+         srcs[nsrc++] = (nir_tex_src){ .src_type = nir_tex_src_offset,
+                                       .src = nir_src_for_ssa(nir_u2u32(&c->b, offset)) };
+      op = nir_texop_tg4;
+   } else {
+      /* read: a fetch by integer coordinate, with a level or a sample. Neither
+       * has to be a constant -- read_texture_2d_ms is called with a computed
+       * sample index throughout AppleMetalGLRenderer.
+       */
+      nir_def *which = air_get_ssa(c, in->operands[arg++]);
+      if (!which)
+         return false;
+      which = nir_u2u32(&c->b, which);
+      op = t.is_ms ? nir_texop_txf_ms : nir_texop_txf;
+      srcs[nsrc++] = (nir_tex_src){
+         .src_type = t.is_ms ? nir_tex_src_ms_index : nir_tex_src_lod,
+         .src = nir_src_for_ssa(which),
+      };
+   }
+
+   nir_tex_instr *tex_instr = nir_tex_instr_create(c->nir, nsrc);
+   tex_instr->op = op;
+   tex_instr->sampler_dim = t.dim;
+   tex_instr->is_array = t.is_array;
+   /* is_new_style_shadow because Metal's sample_compare returns ONE value, which the
+    * declaration says too -- air.sample_compare_depth_2d.f32 returns { float, i8 }, not
+    * { <4 x float>, i8 } the way a colour sample does. NIR's old-style shadow
+    * replicates the comparison into four components and would leave the shader reading
+    * component 0 of four where the signature has one, which is the same answer by
+    * accident; this says what the operation is.
+    */
+   tex_instr->is_shadow = t.compare;
+   tex_instr->is_new_style_shadow = t.compare;
+   tex_instr->dest_type = dest_type;
+   tex_instr->coord_components = ncoord;
+   tex_instr->texture_index = tex.binding;
+   tex_instr->sampler_index = have_sampler ? samp.binding : 0;
+   if (op == nir_texop_tg4) {
+      uint64_t component;
+      if (!tex_flag(c, in, arg, &component))
+         return false;
+      tex_instr->component = component;
+   }
+   for (unsigned i = 0; i < nsrc; i++)
+      tex_instr->src[i] = srcs[i];
+
+   const struct air_type *value_type = in->base.type;
+   if (value_type->kind == AIR_TYPE_STRUCT && value_type->num_members)
+      value_type = value_type->members[0];
+
+   /* The width of the result is NIR's to decide: a sample is four components
+    * whatever the shader does with them. Metal's depth2d.sample() returns one
+    * float, which is channel 0 of those four -- the same thing GLSL gets from
+    * a depth texture read without a comparison.
+    */
+   unsigned nir_comps = nir_tex_instr_dest_size(tex_instr);
+   nir_def_init(&tex_instr->instr, &tex_instr->def, nir_comps, dest_bits);
+   nir_builder_instr_insert(&c->b, &tex_instr->instr);
+
+   nir_def *res = &tex_instr->def;
+   unsigned want = air_nir_components(value_type);
+   if (want < nir_comps)
+      res = nir_trim_vector(&c->b, res, want);
+   else if (want > nir_comps)
+      return air_error(c, "intrinsic: air.%s gives %u components, the shader wants %u",
+                       n->part[0], nir_comps, want);
+   set_tex_result(c, in, res);
+   return true;
+}
+
+/* -- the dispatcher ----------------------------------------------------- */
+
+bool
+air_translate_call(struct air_ctx *c, const struct air_inst *in, const char *name)
+{
+   if (!strncmp(name, "llvm.", 5))
+      return llvm_op(c, in, name);
+
+   if (strncmp(name, "air.", 4))
+      return air_call_in_module(c, in, name);
+
+   struct air_name n;
+   if (!split_name(name, &n))
+      return air_error(c, "intrinsic: %s (a name this cannot take apart)", name);
+
+   if (!strcmp(n.part[0], "is_function_constant_defined"))
+      return fc_defined_op(c, in);
+   if (n.num >= 2 && !strcmp(n.part[0], "wg") && !strcmp(n.part[1], "barrier"))
+      return barrier_op(c, in, false);
+   if (n.num >= 2 && !strcmp(n.part[0], "simdgroup") && !strcmp(n.part[1], "barrier"))
+      return barrier_op(c, in, true);
+   if (!strcmp(n.part[0], "atomic"))
+      return atomic_op(c, in, &n);
+   if (!strcmp(n.part[0], "discard_fragment"))
+      return discard_op(c, in);
+
+   bool handled = false;
+   /* before math_op, which resolves every argument as a number: these take a
+    * lane number or nothing at all, and air.simd_sum falls through to it
+    */
+   if (!simd_op(c, in, &n, &handled))
+      return false;
+   if (handled)
+      return true;
+
+   if (!math_op(c, in, &n, &handled))
+      return false;
+   if (handled)
+      return true;
+
+   const char *op = n.part[0];
+   if (strstr(op, "texture") || strstr(op, "_depth_") || !strncmp(op, "sample", 6) ||
+       !strncmp(op, "gather", 6) || !strncmp(op, "read_", 5) || !strncmp(op, "write_", 6) ||
+       strstr(op, "_lod_"))
+      return texture_op(c, in, &n);
+
+   /* The rest of Apple's pack family, named as absent rather than as undecided.
+    *
+    * air.pack.unorm.rgb565 is translated above, off AGXCompilerCore's lowering.
+    * The same reading gave the whole of that binary's `formats` table, so the
+    * field layout of air.pack.{s,u}norm.rgb10a2, air.pack.unorm.rgb10 and the
+    * 4444/1555/5551 rows the driver's own blit shaders use is known too -- but
+    * no module of either corpus calls one. The rest take a different path in
+    * that binary and it has not been read: the {s,u}norm NxM family that
+    * initializePackUnpackMap builds out of its own component-count and width
+    * tables (air.pack.unorm4x8.v4f32 and its relatives) goes to buildPackNorm,
+    * and air.pack.unorm4x8.srgb, air.pack.unorm.rg11b10f and
+    * air.pack.unorm.rgb9e5 go to buildPackSRGB, buildPack111110 and
+    * buildPack9995. So this is "not implemented", with the places to read
+    * named, and not "cannot be decided".
+    */
+   /* air.pack.{u,s}norm{4x8,2x16}.v<N>f{16,32} and air.unpack the other way:
+    * Metal's pack_float_to_unorm4x8 and its kin, which are GLSL's packUnorm4x8
+    * and its kin -- clamp, scale, round to nearest, component 0 in the low
+    * bits -- and so NIR's pack_unorm_4x8 and the rest, over 32-bit floats (a
+    * half vector is widened first, exactly). VideoToolbox's scaler
+    * (VTMTSComputeFunction, the live wallpaper's) writes its pixels so.
+    */
+   if ((!strcmp(op, "pack") || !strcmp(op, "unpack")) && n.num >= 2) {
+      const char *f = n.part[1];
+      const bool un = !strcmp(f, "unorm4x8") || !strcmp(f, "unorm2x16");
+      const bool sn = !strcmp(f, "snorm4x8") || !strcmp(f, "snorm2x16");
+      if (un || sn) {
+         const bool x8 = strstr(f, "4x8") != NULL;
+         if (!strcmp(op, "pack")) {
+            nir_def *v = in->num_operands > 1 ? air_get_ssa(c, in->operands[1]) : NULL;
+            if (!v)
+               return false;
+            if (v->bit_size != 32)
+               v = nir_f2f32(&c->b, v);
+            nir_def *r = x8 ? (un ? nir_pack_unorm_4x8(&c->b, v) : nir_pack_snorm_4x8(&c->b, v))
+                            : (un ? nir_pack_unorm_2x16(&c->b, v) : nir_pack_snorm_2x16(&c->b, v));
+            air_set(c, &in->base, air_val_ssa(c, r));
+            return true;
+         }
+         nir_def *w = in->num_operands > 1 ? air_get_ssa(c, in->operands[1]) : NULL;
+         if (!w)
+            return false;
+         nir_def *r = x8 ? (un ? nir_unpack_unorm_4x8(&c->b, w) : nir_unpack_snorm_4x8(&c->b, w))
+                         : (un ? nir_unpack_unorm_2x16(&c->b, w) : nir_unpack_snorm_2x16(&c->b, w));
+         const unsigned want = air_nir_bit_size(c, in->base.type);
+         if (want == 16)
+            r = nir_f2f16(&c->b, r);
+         air_set(c, &in->base, air_val_ssa(c, r));
+         return true;
+      }
+   }
+
+   if (!strcmp(op, "pack"))
+      return air_error(c, "intrinsic: %s -- of Apple's pack family only "
+                          "unorm.rgb565 is translated, because only it occurs; "
+                          "the rest are unread lowerings, not undecided ones", name);
+
+   return air_error(c, "intrinsic: %s", name);
+}
diff --git a/src/compiler/air/air_layout.c b/src/compiler/air/air_layout.c
new file mode 100644
index 0000000..60e194c
--- /dev/null
+++ b/src/compiler/air/air_layout.c
@@ -0,0 +1,164 @@
+/*
+ * Copyright © 2026 Darwin on redwood contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * Sizes and alignments from the module's datalayout string, by LLVM's rules
+ * (LangRef, "Data Layout"). Every AIR module of iOS 16.5 has the same layout,
+ * but it is read rather than assumed: GEP offsets are computed from it, and
+ * a wrong offset is a wrong read.
+ */
+
+#include "air_module.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/macros.h"
+#include "util/u_math.h"
+
+struct layout_entry {
+   char kind;           /* 'i', 'f', 'v' */
+   unsigned bits;
+   unsigned abi_bits;
+};
+
+static unsigned
+layout_lookup(const struct air_module *m, char kind, unsigned bits, bool *found)
+{
+   /* parsed on every call: the string is short and this is not hot */
+   const char *s = m->datalayout ? m->datalayout : "";
+   unsigned best_bigger = 0, best_bigger_bits = ~0u, largest = 0, largest_bits = 0;
+   *found = false;
+   while (*s) {
+      const char *end = strchr(s, '-');
+      size_t len = end ? (size_t)(end - s) : strlen(s);
+      if (len > 1 && s[0] == kind && s[1] >= '0' && s[1] <= '9') {
+         char *q;
+         unsigned b = strtoul(s + 1, &q, 10);
+         unsigned abi = (*q == ':') ? strtoul(q + 1, NULL, 10) : b;
+         if (b == bits) {
+            *found = true;
+            return abi;
+         }
+         if (b > bits && b < best_bigger_bits) {
+            best_bigger_bits = b;
+            best_bigger = abi;
+         }
+         if (b > largest_bits) {
+            largest_bits = b;
+            largest = abi;
+         }
+      }
+      s += len + (end != NULL);
+   }
+   if (kind == 'i') {
+      /* the smallest wider integer's, or failing that the widest */
+      if (best_bigger_bits != ~0u)
+         return best_bigger;
+      if (largest_bits)
+         return largest;
+   }
+   return 0;
+}
+
+unsigned
+air_type_bit_size(const struct air_type *t)
+{
+   switch (t->kind) {
+   case AIR_TYPE_INT: return t->bits;
+   case AIR_TYPE_HALF:
+   case AIR_TYPE_BFLOAT: return 16;
+   case AIR_TYPE_FLOAT: return 32;
+   case AIR_TYPE_DOUBLE: return 64;
+   case AIR_TYPE_POINTER: return 64;
+   case AIR_TYPE_VECTOR: return air_type_bit_size(t->elem);
+   default: return 0;
+   }
+}
+
+static uint64_t
+store_size(const struct air_module *m, const struct air_type *t)
+{
+   switch (t->kind) {
+   case AIR_TYPE_VECTOR:
+      return DIV_ROUND_UP(t->count * air_type_bit_size(t->elem), 8);
+   case AIR_TYPE_ARRAY:
+   case AIR_TYPE_STRUCT:
+      return air_type_alloc_size(m, t);
+   default:
+      return DIV_ROUND_UP(air_type_bit_size(t), 8);
+   }
+}
+
+unsigned
+air_type_abi_align(const struct air_module *m, const struct air_type *t)
+{
+   bool found;
+   switch (t->kind) {
+   case AIR_TYPE_INT: {
+      unsigned a = layout_lookup(m, 'i', t->bits, &found);
+      return a ? a / 8 : MAX2(1, util_next_power_of_two(DIV_ROUND_UP(t->bits, 8)));
+   }
+   case AIR_TYPE_HALF:
+   case AIR_TYPE_BFLOAT:
+   case AIR_TYPE_FLOAT:
+   case AIR_TYPE_DOUBLE: {
+      unsigned bits = air_type_bit_size(t);
+      unsigned a = layout_lookup(m, 'f', bits, &found);
+      return found ? a / 8 : bits / 8;
+   }
+   case AIR_TYPE_POINTER:
+      return 8; /* p:64:64:64 */
+   case AIR_TYPE_VECTOR: {
+      unsigned bits = t->count * air_type_bit_size(t->elem);
+      unsigned a = layout_lookup(m, 'v', bits, &found);
+      if (found)
+         return a / 8;
+      return MAX2(1, util_next_power_of_two64(store_size(m, t)));
+   }
+   case AIR_TYPE_ARRAY:
+      return air_type_abi_align(m, t->elem);
+   case AIR_TYPE_STRUCT: {
+      if (t->packed)
+         return 1;
+      unsigned a = 1;
+      for (unsigned i = 0; i < t->num_members; i++)
+         a = MAX2(a, air_type_abi_align(m, t->members[i]));
+      return a;
+   }
+   default:
+      return 1;
+   }
+}
+
+uint64_t
+air_struct_member_offset(const struct air_module *m, const struct air_type *t, unsigned n)
+{
+   uint64_t off = 0;
+   for (unsigned i = 0; i < t->num_members; i++) {
+      const struct air_type *mt = t->members[i];
+      if (!t->packed)
+         off = ALIGN_NPOT(off, air_type_abi_align(m, mt));
+      if (i == n)
+         return off;
+      off += air_type_alloc_size(m, mt);
+   }
+   return off;
+}
+
+uint64_t
+air_type_alloc_size(const struct air_module *m, const struct air_type *t)
+{
+   switch (t->kind) {
+   case AIR_TYPE_ARRAY:
+      return t->count * air_type_alloc_size(m, t->elem);
+   case AIR_TYPE_STRUCT: {
+      uint64_t end = air_struct_member_offset(m, t, t->num_members);
+      return ALIGN_NPOT(end, air_type_abi_align(m, t));
+   }
+   default:
+      return ALIGN_NPOT(store_size(m, t), air_type_abi_align(m, t));
+   }
+}
diff --git a/src/compiler/air/air_metallib.c b/src/compiler/air/air_metallib.c
new file mode 100644
index 0000000..f94492e
--- /dev/null
+++ b/src/compiler/air/air_metallib.c
@@ -0,0 +1,132 @@
+/*
+ * Copyright © 2026 Darwin on redwood contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The MTLB container of a .metallib: a header, a function list of tagged
+ * fields, and one LLVM module per function. Worked out against the files of
+ * iOS 16.5 (docs/metal.md, section 9.1; tools/metallib.py is the same in
+ * Python).
+ */
+
+#include "nir_air.h"
+
+#include <string.h>
+
+#include "util/ralloc.h"
+
+static uint64_t
+rd64(const uint8_t *p)
+{
+   uint64_t v = 0;
+   for (int i = 7; i >= 0; i--)
+      v = v << 8 | p[i];
+   return v;
+}
+
+static uint32_t
+rd32(const uint8_t *p)
+{
+   return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint16_t
+rd16(const uint8_t *p)
+{
+   return p[0] | p[1] << 8;
+}
+
+bool
+air_metallib_parse(void *mem_ctx, const void *data, size_t size, struct air_metallib *lib,
+                   const char **error)
+{
+   const uint8_t *b = data;
+   memset(lib, 0, sizeof(*lib));
+   *error = NULL;
+
+   if (size < 0x58 || memcmp(b, "MTLB", 4) != 0) {
+      *error = "not an MTLB container";
+      return false;
+   }
+   lib->version_major = rd16(b + 4);
+   lib->version_minor = rd16(b + 6);
+   uint64_t total = rd64(b + 0x10);
+   uint64_t funcs = rd64(b + 0x18);
+   uint64_t bc_off = rd64(b + 0x48);
+   uint64_t bc_len = rd64(b + 0x50);
+   if (total > size || funcs + 4 > size || bc_off + bc_len > size) {
+      *error = "MTLB header points past the file";
+      return false;
+   }
+
+   const uint8_t *p = b + funcs;
+   uint32_t count = rd32(p);
+   p += 4;
+   lib->functions = rzalloc_array(mem_ctx, struct air_metallib_function, count ? count : 1);
+   for (uint32_t i = 0; i < count; i++) {
+      if (p + 4 > b + size) {
+         *error = "function list runs past the file";
+         return false;
+      }
+      uint32_t len = rd32(p);
+      const uint8_t *q = p + 4, *end = p + len;
+      if (len < 4 || end > b + size) {
+         *error = "function entry runs past the file";
+         return false;
+      }
+      struct air_metallib_function *f = &lib->functions[lib->num_functions++];
+      f->type = -1;
+      uint64_t module_off = 0, module_size = 0;
+      bool have_off = false;
+      while (q + 6 <= end && memcmp(q, "ENDT", 4) != 0) {
+         uint16_t vlen = rd16(q + 4);
+         const uint8_t *v = q + 6;
+         if (v + vlen > end) {
+            *error = "function field runs past its entry";
+            return false;
+         }
+         if (!memcmp(q, "NAME", 4)) {
+            f->name = ralloc_strndup(mem_ctx, (const char *)v, vlen);
+         } else if (!memcmp(q, "TYPE", 4) && vlen >= 1) {
+            f->type = v[0];
+         } else if (!memcmp(q, "OFFT", 4) && vlen >= 24) {
+            module_off = rd64(v + 16);
+            have_off = true;
+         } else if (!memcmp(q, "MDSZ", 4) && vlen >= 8) {
+            module_size = rd64(v);
+         }
+         q = v + vlen;
+      }
+      if (!f->name || !have_off || !module_size) {
+         *error = "function entry without NAME, OFFT or MDSZ";
+         return false;
+      }
+      if (module_off + module_size > bc_len) {
+         *error = "function module outside the bitcode section";
+         return false;
+      }
+      f->bitcode = b + bc_off + module_off;
+      f->bitcode_size = module_size;
+      p = end;
+   }
+   return true;
+}
+
+const char *
+air_metallib_type_name(int type)
+{
+   /* the container's TYPE tag; 4 is what the 135 stitchable functions of
+    * PortraitFilters carry, whose metadata says air.visible
+    */
+   switch (type) {
+   case 0: return "vertex";
+   case 1: return "fragment";
+   case 2: return "kernel";
+   case 3: return "unqualified";
+   case 4: return "visible";
+   case 5: return "extern";
+   case 6: return "intersection";
+   default: return "unknown";
+   }
+}
diff --git a/src/compiler/air/air_module.c b/src/compiler/air/air_module.c
new file mode 100644
index 0000000..534c80a
--- /dev/null
+++ b/src/compiler/air/air_module.c
@@ -0,0 +1,2005 @@
+/*
+ * Copyright © 2026 Darwin on redwood contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * Bitcode records -> struct air_module. The record layouts are those LLVM
+ * has written since the 4.0/5.0 days (string table, relative value ids,
+ * explicit types on loads, GEPs and calls), which is what Apple's
+ * metalfe-31001 emits: typed pointers, MODULE_CODE_VERSION 2.
+ */
+
+#include "air_module.h"
+#include "air_bitcode.h"
+
+#include <inttypes.h>
+#include <stdarg.h>
+#include <string.h>
+
+#include "util/macros.h"
+#include "util/ralloc.h"
+
+/* block ids */
+enum {
+   MODULE_BLOCK_ID = 8,
+   PARAMATTR_BLOCK_ID = 9,
+   PARAMATTR_GROUP_BLOCK_ID = 10,
+   CONSTANTS_BLOCK_ID = 11,
+   FUNCTION_BLOCK_ID = 12,
+   IDENTIFICATION_BLOCK_ID = 13,
+   VALUE_SYMTAB_BLOCK_ID = 14,
+   METADATA_BLOCK_ID = 15,
+   METADATA_ATTACHMENT_ID = 16,
+   TYPE_BLOCK_ID_NEW = 17,
+   USELIST_BLOCK_ID = 18,
+   OPERAND_BUNDLE_TAGS_BLOCK_ID = 21,
+   METADATA_KIND_BLOCK_ID = 22,
+   STRTAB_BLOCK_ID = 23,
+   SYMTAB_BLOCK_ID = 25,
+   SYNC_SCOPE_NAMES_BLOCK_ID = 26,
+};
+
+/* module records */
+enum {
+   MODULE_CODE_VERSION = 1,
+   MODULE_CODE_TRIPLE = 2,
+   MODULE_CODE_DATALAYOUT = 3,
+   MODULE_CODE_SECTIONNAME = 5,
+   MODULE_CODE_GLOBALVAR = 7,
+   MODULE_CODE_FUNCTION = 8,
+   MODULE_CODE_GCNAME = 11,
+   MODULE_CODE_VSTOFFSET = 13,
+   MODULE_CODE_SOURCE_FILENAME = 16,
+   MODULE_CODE_HASH = 17,
+};
+
+/* type records */
+enum {
+   TYPE_CODE_NUMENTRY = 1,
+   TYPE_CODE_VOID = 2,
+   TYPE_CODE_FLOAT = 3,
+   TYPE_CODE_DOUBLE = 4,
+   TYPE_CODE_LABEL = 5,
+   TYPE_CODE_OPAQUE = 6,
+   TYPE_CODE_INTEGER = 7,
+   TYPE_CODE_POINTER = 8,
+   TYPE_CODE_HALF = 10,
+   TYPE_CODE_ARRAY = 11,
+   TYPE_CODE_VECTOR = 12,
+   TYPE_CODE_X86_FP80 = 13,
+   TYPE_CODE_FP128 = 14,
+   TYPE_CODE_PPC_FP128 = 15,
+   TYPE_CODE_METADATA = 16,
+   TYPE_CODE_X86_MMX = 17,
+   TYPE_CODE_STRUCT_ANON = 18,
+   TYPE_CODE_STRUCT_NAME = 19,
+   TYPE_CODE_STRUCT_NAMED = 20,
+   TYPE_CODE_FUNCTION = 21,
+   TYPE_CODE_TOKEN = 22,
+   TYPE_CODE_BFLOAT = 23,
+   TYPE_CODE_OPAQUE_POINTER = 25,
+};
+
+/* constants records */
+enum {
+   CST_CODE_SETTYPE = 1,
+   CST_CODE_NULL = 2,
+   CST_CODE_UNDEF = 3,
+   CST_CODE_INTEGER = 4,
+   CST_CODE_WIDE_INTEGER = 5,
+   CST_CODE_FLOAT = 6,
+   CST_CODE_AGGREGATE = 7,
+   CST_CODE_STRING = 8,
+   CST_CODE_CSTRING = 9,
+   CST_CODE_CE_BINOP = 10,
+   CST_CODE_CE_CAST = 11,
+   CST_CODE_CE_GEP_OLD = 12,
+   CST_CODE_CE_SELECT = 13,
+   CST_CODE_CE_EXTRACTELT = 14,
+   CST_CODE_CE_INSERTELT = 15,
+   CST_CODE_CE_SHUFFLEVEC = 16,
+   CST_CODE_CE_CMP = 17,
+   CST_CODE_CE_INBOUNDS_GEP = 20,
+   CST_CODE_DATA = 22,
+   CST_CODE_CE_GEP_WITH_INRANGE_INDEX = 24,
+   CST_CODE_CE_UNOP = 25,
+   CST_CODE_POISON = 26,
+};
+
+/* function records */
+enum {
+   FUNC_CODE_DECLAREBLOCKS = 1,
+   FUNC_CODE_INST_BINOP = 2,
+   FUNC_CODE_INST_CAST = 3,
+   FUNC_CODE_INST_SELECT = 5,
+   FUNC_CODE_INST_EXTRACTELT = 6,
+   FUNC_CODE_INST_INSERTELT = 7,
+   FUNC_CODE_INST_SHUFFLEVEC = 8,
+   FUNC_CODE_INST_CMP = 9,
+   FUNC_CODE_INST_RET = 10,
+   FUNC_CODE_INST_BR = 11,
+   FUNC_CODE_INST_SWITCH = 12,
+   FUNC_CODE_INST_UNREACHABLE = 15,
+   FUNC_CODE_INST_PHI = 16,
+   FUNC_CODE_INST_ALLOCA = 19,
+   FUNC_CODE_INST_LOAD = 20,
+   FUNC_CODE_INST_EXTRACTVAL = 26,
+   FUNC_CODE_INST_INSERTVAL = 27,
+   FUNC_CODE_INST_CMP2 = 28,
+   FUNC_CODE_INST_VSELECT = 29,
+   FUNC_CODE_DEBUG_LOC_AGAIN = 33,
+   FUNC_CODE_INST_CALL = 34,
+   FUNC_CODE_DEBUG_LOC = 35,
+   FUNC_CODE_INST_FENCE = 36,
+   FUNC_CODE_INST_GEP = 43,
+   FUNC_CODE_INST_STORE = 44,
+   FUNC_CODE_INST_CMPXCHG = 46,
+   FUNC_CODE_OPERAND_BUNDLE = 55,
+   FUNC_CODE_INST_UNOP = 56,
+   FUNC_CODE_INST_FREEZE = 58,
+   FUNC_CODE_INST_ATOMICRMW = 59,
+};
+
+/* metadata records */
+enum {
+   METADATA_STRING_OLD = 1,
+   METADATA_VALUE = 2,
+   METADATA_NODE = 3,
+   METADATA_NAME = 4,
+   METADATA_DISTINCT_NODE = 5,
+   METADATA_KIND = 6,
+   METADATA_LOCATION = 7,
+   METADATA_OLD_NODE = 8,
+   METADATA_OLD_FN_NODE = 9,
+   METADATA_NAMED_NODE = 10,
+   METADATA_ATTACHMENT = 11,
+   METADATA_STRINGS = 35,
+   METADATA_GLOBAL_DECL_ATTACHMENT = 36,
+   METADATA_INDEX_OFFSET = 38,
+   METADATA_INDEX = 39,
+   METADATA_ARG_LIST = 46,
+};
+
+enum { VST_CODE_ENTRY = 1, VST_CODE_BBENTRY = 2, VST_CODE_FNENTRY = 3 };
+
+/* call record CC field */
+#define CALL_TAIL_BIT 0
+#define CALL_CCONV_SHIFT 1
+#define CALL_EXPLICIT_TYPE_BIT 15
+#define CALL_FMF_BIT 17
+
+struct reader {
+   struct air_module *m;
+   struct air_bitstream bs;
+
+   /* values of the function being read, after the module's */
+   unsigned num_values, cap_values;
+   struct air_value **values;
+
+   /* the types the record gave for operands not yet defined, by value id */
+   unsigned cap_fwd;
+   const struct air_type **fwd;
+
+   /* metadata ids: the module's, then the current function's */
+   unsigned num_md, cap_md;
+   struct air_md **md;
+
+   const uint8_t *strtab;
+   size_t strtab_size;
+
+   unsigned num_bodies_read;
+   struct air_function *cur_fn;
+   unsigned cur_inst_id;     /* all instructions, for attachments */
+   unsigned num_fn_insts, cap_fn_insts;
+   struct air_inst **fn_insts;
+
+   const char *pending_md_name;
+};
+
+static bool
+fail(struct reader *r, const char *fmt, ...)
+{
+   if (r->m->error[0])
+      return false;
+   va_list ap;
+   va_start(ap, fmt);
+   vsnprintf(r->m->error, sizeof(r->m->error), fmt, ap);
+   va_end(ap);
+   return false;
+}
+
+static bool
+check_bs(struct reader *r)
+{
+   if (r->bs.error[0])
+      return fail(r, "bitstream: %s", r->bs.error);
+   return true;
+}
+
+/* -- types -------------------------------------------------------------- */
+
+static const struct air_type *
+type_by_id(struct reader *r, uint64_t id)
+{
+   if (id >= r->m->num_types) {
+      fail(r, "type id %" PRIu64 " out of range (%u types)", id, r->m->num_types);
+      return NULL;
+   }
+   return &r->m->types[id];
+}
+
+/* pointers that the bitcode does not list (to functions, to globals with an
+ * explicit type), made on the side
+ */
+static const struct air_type *
+pointer_to(struct reader *r, const struct air_type *elem, unsigned as)
+{
+   for (unsigned i = 0; i < r->m->num_types; i++) {
+      const struct air_type *t = &r->m->types[i];
+      if (t->kind == AIR_TYPE_POINTER && t->elem == elem && t->addrspace == as)
+         return t;
+   }
+   struct air_type *t = rzalloc(r->m, struct air_type);
+   t->kind = AIR_TYPE_POINTER;
+   t->id = ~0u;
+   t->elem = elem;
+   t->addrspace = as;
+   return t;
+}
+
+static bool
+read_type_block(struct reader *r)
+{
+   struct air_module *m = r->m;
+   unsigned next = 0;
+   const char *pending_name = NULL;
+
+   for (;;) {
+      struct air_bs_entry e = air_bs_next(&r->bs);
+      if (e.kind == AIR_BS_END_BLOCK)
+         return true;
+      if (e.kind == AIR_BS_ENTER_BLOCK) {
+         air_bs_skip_block(&r->bs);
+         continue;
+      }
+      if (e.kind != AIR_BS_RECORD)
+         return check_bs(r) && fail(r, "type block ends early");
+
+      if (e.id == TYPE_CODE_NUMENTRY) {
+         if (e.num_ops < 1)
+            return fail(r, "NUMENTRY without a count");
+         m->num_types = e.ops[0];
+         m->types = rzalloc_array(m, struct air_type, MAX2(m->num_types, 1));
+         for (unsigned i = 0; i < m->num_types; i++) {
+            m->types[i].id = i;
+            m->types[i].kind = AIR_TYPE_UNKNOWN;
+         }
+         continue;
+      }
+      if (e.id == TYPE_CODE_STRUCT_NAME) {
+         pending_name = air_bs_ops_to_string(m, e.ops, e.num_ops);
+         continue;
+      }
+      if (next >= m->num_types)
+         return fail(r, "more types than NUMENTRY said");
+
+      struct air_type *t = &m->types[next];
+      switch (e.id) {
+      case TYPE_CODE_VOID: t->kind = AIR_TYPE_VOID; break;
+      case TYPE_CODE_HALF: t->kind = AIR_TYPE_HALF; break;
+      case TYPE_CODE_BFLOAT: t->kind = AIR_TYPE_BFLOAT; break;
+      case TYPE_CODE_FLOAT: t->kind = AIR_TYPE_FLOAT; break;
+      case TYPE_CODE_DOUBLE: t->kind = AIR_TYPE_DOUBLE; break;
+      case TYPE_CODE_LABEL: t->kind = AIR_TYPE_LABEL; break;
+      case TYPE_CODE_METADATA: t->kind = AIR_TYPE_METADATA; break;
+      case TYPE_CODE_TOKEN: t->kind = AIR_TYPE_TOKEN; break;
+      case TYPE_CODE_X86_FP80:
+      case TYPE_CODE_FP128:
+      case TYPE_CODE_PPC_FP128:
+      case TYPE_CODE_X86_MMX:
+         t->kind = AIR_TYPE_UNKNOWN;
+         break;
+      case TYPE_CODE_INTEGER:
+         if (e.num_ops < 1)
+            return fail(r, "INTEGER type without a width");
+         t->kind = AIR_TYPE_INT;
+         t->bits = e.ops[0];
+         break;
+      case TYPE_CODE_POINTER:
+         if (e.num_ops < 1)
+            return fail(r, "POINTER type without a pointee");
+         t->kind = AIR_TYPE_POINTER;
+         t->elem = type_by_id(r, e.ops[0]);
+         t->addrspace = e.num_ops > 1 ? e.ops[1] : 0;
+         break;
+      case TYPE_CODE_OPAQUE_POINTER:
+         t->kind = AIR_TYPE_POINTER;
+         t->addrspace = e.num_ops > 0 ? e.ops[0] : 0;
+         break;
+      case TYPE_CODE_ARRAY:
+      case TYPE_CODE_VECTOR:
+         if (e.num_ops < 2)
+            return fail(r, "ARRAY/VECTOR type without a size and element");
+         t->kind = e.id == TYPE_CODE_ARRAY ? AIR_TYPE_ARRAY : AIR_TYPE_VECTOR;
+         t->count = e.ops[0];
+         t->elem = type_by_id(r, e.ops[1]);
+         if (e.id == TYPE_CODE_VECTOR && e.num_ops > 2 && e.ops[2])
+            return fail(r, "scalable vector type");
+         break;
+      case TYPE_CODE_OPAQUE:
+         t->kind = AIR_TYPE_STRUCT;
+         t->opaque = true;
+         t->name = pending_name;
+         pending_name = NULL;
+         break;
+      case TYPE_CODE_STRUCT_ANON:
+      case TYPE_CODE_STRUCT_NAMED:
+         if (e.num_ops < 1)
+            return fail(r, "STRUCT type without the packed flag");
+         t->kind = AIR_TYPE_STRUCT;
+         t->packed = e.ops[0];
+         t->num_members = e.num_ops - 1;
+         t->members = ralloc_array(m, const struct air_type *, MAX2(t->num_members, 1));
+         for (unsigned i = 0; i < t->num_members; i++)
+            t->members[i] = type_by_id(r, e.ops[1 + i]);
+         if (e.id == TYPE_CODE_STRUCT_NAMED) {
+            t->name = pending_name;
+            pending_name = NULL;
+         }
+         break;
+      case TYPE_CODE_FUNCTION:
+         if (e.num_ops < 2)
+            return fail(r, "FUNCTION type without vararg and return");
+         t->kind = AIR_TYPE_FUNCTION;
+         t->vararg = e.ops[0];
+         t->elem = type_by_id(r, e.ops[1]);
+         t->num_members = e.num_ops - 2;
+         t->members = ralloc_array(m, const struct air_type *, MAX2(t->num_members, 1));
+         for (unsigned i = 0; i < t->num_members; i++)
+            t->members[i] = type_by_id(r, e.ops[2 + i]);
+         break;
+      default:
+         return fail(r, "unknown type record %u", e.id);
+      }
+      if (m->error[0])
+         return false;
+      next++;
+   }
+}
+
+/* -- values ------------------------------------------------------------- */
+
+static void
+push_value(struct reader *r, struct air_value *v)
+{
+   if (r->num_values == r->cap_values) {
+      r->cap_values = MAX2(256, r->cap_values * 2);
+      r->values = reralloc(r->m, r->values, struct air_value *, r->cap_values);
+   }
+   v->id = r->num_values;
+   r->values[r->num_values++] = v;
+}
+
+static struct air_value *
+value_by_id(struct reader *r, unsigned id)
+{
+   if (id >= r->num_values || !r->values[id]) {
+      fail(r, "value %u is not defined (%u values)", id, r->num_values);
+      return NULL;
+   }
+   return r->values[id];
+}
+
+static int64_t
+decode_signed(uint64_t v)
+{
+   if ((v & 1) == 0)
+      return (int64_t)(v >> 1);
+   if (v != 1)
+      return -(int64_t)(v >> 1);
+   return INT64_MIN;
+}
+
+static uint64_t
+truncate_to(const struct air_type *t, uint64_t v)
+{
+   const struct air_type *s = air_type_scalar(t);
+   if (s->kind == AIR_TYPE_INT && s->bits < 64)
+      return v & ((1ull << s->bits) - 1);
+   return v;
+}
+
+static struct air_constant *
+new_constant(struct reader *r, const struct air_type *t, enum air_const_kind k)
+{
+   struct air_constant *c = rzalloc(r->m, struct air_constant);
+   c->base.kind = AIR_VALUE_CONSTANT;
+   c->base.type = t;
+   c->ckind = k;
+   push_value(r, &c->base);
+   return c;
+}
+
+static void
+expr_operands(struct reader *r, struct air_constant *c, unsigned n)
+{
+   c->num_operands = n;
+   c->operands = rzalloc_array(r->m, struct air_value *, MAX2(n, 1));
+   c->pending = rzalloc_array(r->m, unsigned, MAX2(n, 1));
+}
+
+static bool
+read_constants_block(struct reader *r)
+{
+   const struct air_type *cur = NULL;
+   unsigned first = r->num_values;
+
+   for (;;) {
+      struct air_bs_entry e = air_bs_next(&r->bs);
+      if (e.kind == AIR_BS_END_BLOCK)
+         break;
+      if (e.kind == AIR_BS_ENTER_BLOCK) {
+         air_bs_skip_block(&r->bs);
+         continue;
+      }
+      if (e.kind != AIR_BS_RECORD)
+         return check_bs(r) && fail(r, "constants block ends early");
+
+      if (e.id == CST_CODE_SETTYPE) {
+         if (e.num_ops < 1 || !(cur = type_by_id(r, e.ops[0])))
+            return fail(r, "SETTYPE without a type");
+         continue;
+      }
+      if (!cur)
+         return fail(r, "constant before SETTYPE");
+
+      struct air_constant *c;
+      switch (e.id) {
+      case CST_CODE_NULL:
+         new_constant(r, cur, AIR_CONST_NULL);
+         break;
+      case CST_CODE_UNDEF:
+         new_constant(r, cur, AIR_CONST_UNDEF);
+         break;
+      case CST_CODE_POISON:
+         new_constant(r, cur, AIR_CONST_POISON);
+         break;
+      case CST_CODE_INTEGER:
+         if (e.num_ops < 1)
+            return fail(r, "INTEGER constant without a value");
+         c = new_constant(r, cur, AIR_CONST_INT);
+         c->u = truncate_to(cur, (uint64_t)decode_signed(e.ops[0]));
+         break;
+      case CST_CODE_WIDE_INTEGER:
+         return fail(r, "integer constant wider than 64 bits");
+      case CST_CODE_FLOAT:
+         if (e.num_ops < 1)
+            return fail(r, "FLOAT constant without a value");
+         if (!air_type_is_float(cur))
+            return fail(r, "FLOAT constant of a non-float type");
+         c = new_constant(r, cur, AIR_CONST_FLOAT);
+         c->u = e.ops[0];
+         break;
+      case CST_CODE_AGGREGATE:
+         c = new_constant(r, cur, AIR_CONST_AGGREGATE);
+         c->num_elems = e.num_ops;
+         c->elems = rzalloc_array(r->m, struct air_value *, MAX2(e.num_ops, 1));
+         c->pending = rzalloc_array(r->m, unsigned, MAX2(e.num_ops, 1));
+         for (unsigned i = 0; i < e.num_ops; i++)
+            c->pending[i] = e.ops[i];
+         break;
+      case CST_CODE_STRING:
+      case CST_CODE_CSTRING:
+      case CST_CODE_DATA: {
+         unsigned n = e.num_ops + (e.id == CST_CODE_CSTRING);
+         c = new_constant(r, cur, AIR_CONST_DATA);
+         c->num_elems = n;
+         c->data = rzalloc_array(r->m, uint64_t, MAX2(n, 1));
+         for (unsigned i = 0; i < e.num_ops; i++)
+            c->data[i] = e.ops[i];
+         break;
+      }
+      case CST_CODE_CE_CAST:
+         if (e.num_ops < 3)
+            return fail(r, "CE_CAST too short");
+         c = new_constant(r, cur, AIR_CONST_EXPR);
+         c->expr_op = AIR_OP_CAST;
+         c->expr_sub = e.ops[0];
+         expr_operands(r, c, 1);
+         c->pending[0] = e.ops[2];
+         break;
+      case CST_CODE_CE_BINOP:
+         if (e.num_ops < 3)
+            return fail(r, "CE_BINOP too short");
+         c = new_constant(r, cur, AIR_CONST_EXPR);
+         c->expr_op = AIR_OP_BINOP;
+         c->expr_sub = e.ops[0];
+         expr_operands(r, c, 2);
+         c->pending[0] = e.ops[1];
+         c->pending[1] = e.ops[2];
+         break;
+      case CST_CODE_CE_UNOP:
+         if (e.num_ops < 2)
+            return fail(r, "CE_UNOP too short");
+         c = new_constant(r, cur, AIR_CONST_EXPR);
+         c->expr_op = AIR_OP_UNOP;
+         c->expr_sub = e.ops[0];
+         expr_operands(r, c, 1);
+         c->pending[0] = e.ops[1];
+         break;
+      case CST_CODE_CE_GEP_OLD:
+      case CST_CODE_CE_INBOUNDS_GEP:
+      case CST_CODE_CE_GEP_WITH_INRANGE_INDEX: {
+         unsigned i = 0;
+         c = new_constant(r, cur, AIR_CONST_EXPR);
+         c->expr_op = AIR_OP_GEP;
+         if (e.id == CST_CODE_CE_GEP_WITH_INRANGE_INDEX || (e.num_ops & 1))
+            c->src_type = type_by_id(r, e.ops[i++]);
+         if (e.id == CST_CODE_CE_GEP_WITH_INRANGE_INDEX)
+            c->inbounds = e.ops[i++] & 1;
+         else
+            c->inbounds = e.id == CST_CODE_CE_INBOUNDS_GEP;
+         if ((e.num_ops - i) & 1)
+            return fail(r, "CE_GEP with an odd operand list");
+         expr_operands(r, c, (e.num_ops - i) / 2);
+         for (unsigned k = 0; i < e.num_ops; i += 2, k++)
+            c->pending[k] = e.ops[i + 1]; /* (type, value) pairs */
+         break;
+      }
+      case CST_CODE_CE_SELECT:
+         if (e.num_ops < 3)
+            return fail(r, "CE_SELECT too short");
+         c = new_constant(r, cur, AIR_CONST_EXPR);
+         c->expr_op = AIR_OP_SELECT;
+         expr_operands(r, c, 3);
+         for (unsigned i = 0; i < 3; i++)
+            c->pending[i] = e.ops[i];
+         break;
+      case CST_CODE_CE_EXTRACTELT:
+         if (e.num_ops < 3)
+            return fail(r, "CE_EXTRACTELT too short");
+         c = new_constant(r, cur, AIR_CONST_EXPR);
+         c->expr_op = AIR_OP_EXTRACTELT;
+         expr_operands(r, c, 2);
+         c->pending[0] = e.ops[1];
+         c->pending[1] = e.ops[e.num_ops == 4 ? 3 : 2];
+         break;
+      case CST_CODE_CE_INSERTELT:
+         if (e.num_ops < 3)
+            return fail(r, "CE_INSERTELT too short");
+         c = new_constant(r, cur, AIR_CONST_EXPR);
+         c->expr_op = AIR_OP_INSERTELT;
+         expr_operands(r, c, 3);
+         c->pending[0] = e.ops[0];
+         c->pending[1] = e.ops[1];
+         c->pending[2] = e.ops[e.num_ops == 4 ? 3 : 2];
+         break;
+      case CST_CODE_CE_SHUFFLEVEC:
+         if (e.num_ops < 3)
+            return fail(r, "CE_SHUFFLEVEC too short");
+         c = new_constant(r, cur, AIR_CONST_EXPR);
+         c->expr_op = AIR_OP_SHUFFLEVEC;
+         expr_operands(r, c, 3);
+         for (unsigned i = 0; i < 3; i++)
+            c->pending[i] = e.ops[i];
+         break;
+      case CST_CODE_CE_CMP:
+         if (e.num_ops < 4)
+            return fail(r, "CE_CMP too short");
+         c = new_constant(r, cur, AIR_CONST_EXPR);
+         c->expr_op = AIR_OP_CMP;
+         c->expr_sub = e.ops[3];
+         expr_operands(r, c, 2);
+         c->pending[0] = e.ops[1];
+         c->pending[1] = e.ops[2];
+         break;
+      default:
+         return fail(r, "unknown constant record %u", e.id);
+      }
+      if (r->m->error[0])
+         return false;
+   }
+
+   /* aggregates and expressions may name constants that come after them */
+   for (unsigned i = first; i < r->num_values; i++) {
+      struct air_constant *c = (struct air_constant *)r->values[i];
+      if (!c->pending)
+         continue;
+      if (c->ckind == AIR_CONST_AGGREGATE) {
+         for (unsigned k = 0; k < c->num_elems; k++)
+            if (!(c->elems[k] = value_by_id(r, c->pending[k])))
+               return false;
+      } else {
+         for (unsigned k = 0; k < c->num_operands; k++)
+            if (!(c->operands[k] = value_by_id(r, c->pending[k])))
+               return false;
+      }
+      c->pending = NULL;
+   }
+   return true;
+}
+
+/* -- metadata ----------------------------------------------------------- */
+
+static struct air_md *
+new_md(struct reader *r, enum air_md_kind k)
+{
+   struct air_md *md = rzalloc(r->m, struct air_md);
+   md->kind = k;
+   md->id = r->num_md;
+   md->function_local = r->cur_fn != NULL;
+   if (r->num_md == r->cap_md) {
+      r->cap_md = MAX2(256, r->cap_md * 2);
+      r->md = reralloc(r->m, r->md, struct air_md *, r->cap_md);
+   }
+   r->md[r->num_md++] = md;
+   return md;
+}
+
+static bool
+read_md_strings(struct reader *r, const struct air_bs_entry *e)
+{
+   if (e->num_ops < 2 || !e->blob)
+      return fail(r, "METADATA_STRINGS without counts or blob");
+   unsigned count = e->ops[0];
+   size_t lengths_size = e->ops[1];
+   if (lengths_size > e->blob_size)
+      return fail(r, "METADATA_STRINGS offsets past the blob");
+
+   /* the lengths are a little bitstream of VBR6 values */
+   struct air_bitstream lens = {
+      .mem_ctx = r->m,
+      .data = e->blob,
+      .size_bits = lengths_size * 8,
+   };
+   const char *chars = (const char *)e->blob + lengths_size;
+   size_t avail = e->blob_size - lengths_size;
+   size_t off = 0;
+   for (unsigned i = 0; i < count; i++) {
+      uint64_t len = 0, shift = 0, chunk;
+      do {
+         if (lens.pos + 6 > lens.size_bits)
+            return fail(r, "METADATA_STRINGS lengths run out");
+         chunk = 0;
+         for (unsigned b = 0; b < 6; b++, lens.pos++)
+            chunk |= (uint64_t)((lens.data[lens.pos >> 3] >> (lens.pos & 7)) & 1) << b;
+         len |= (chunk & 31) << shift;
+         shift += 5;
+      } while (chunk & 32);
+      if (off + len > avail)
+         return fail(r, "METADATA_STRINGS string past the blob");
+      struct air_md *md = new_md(r, AIR_MD_STRING);
+      md->str = chars + off;
+      md->len = len;
+      off += len;
+   }
+   return true;
+}
+
+static bool
+md_other_code(unsigned code)
+{
+   /* records that define one metadata node each and that the frontend does
+    * not look into: locations and the DI* family
+    */
+   return code == METADATA_LOCATION || (code >= 12 && code <= 34) || code == 37 ||
+          code == 40 || code == 41 || code == 44 || code == 45 || code == 47;
+}
+
+static bool
+read_metadata_block(struct reader *r)
+{
+   unsigned first = r->num_md;
+
+   for (;;) {
+      struct air_bs_entry e = air_bs_next(&r->bs);
+      if (e.kind == AIR_BS_END_BLOCK)
+         break;
+      if (e.kind == AIR_BS_ENTER_BLOCK) {
+         air_bs_skip_block(&r->bs);
+         continue;
+      }
+      if (e.kind != AIR_BS_RECORD)
+         return check_bs(r) && fail(r, "metadata block ends early");
+
+      struct air_md *md;
+      switch (e.id) {
+      case METADATA_STRINGS:
+         if (!read_md_strings(r, &e))
+            return false;
+         break;
+      case METADATA_STRING_OLD:
+         md = new_md(r, AIR_MD_STRING);
+         md->str = air_bs_ops_to_string(r->m, e.ops, e.num_ops);
+         md->len = e.num_ops;
+         break;
+      case METADATA_VALUE:
+         if (e.num_ops != 2)
+            return fail(r, "METADATA_VALUE of %u operands", e.num_ops);
+         md = new_md(r, AIR_MD_VALUE);
+         md->value_type = type_by_id(r, e.ops[0]);
+         md->value_id = e.ops[1];
+         break;
+      case METADATA_NODE:
+      case METADATA_DISTINCT_NODE:
+         md = new_md(r, AIR_MD_NODE);
+         md->distinct = e.id == METADATA_DISTINCT_NODE;
+         md->num_ops = e.num_ops;
+         md->ops = rzalloc_array(r->m, struct air_md *, MAX2(e.num_ops, 1));
+         md->pending = rzalloc_array(r->m, unsigned, MAX2(e.num_ops, 1));
+         for (unsigned i = 0; i < e.num_ops; i++)
+            md->pending[i] = e.ops[i]; /* id + 1, 0 for null */
+         break;
+      case METADATA_NAME:
+         r->pending_md_name = air_bs_ops_to_string(r->m, e.ops, e.num_ops);
+         break;
+      case METADATA_NAMED_NODE: {
+         if (!r->pending_md_name)
+            return fail(r, "NAMED_NODE without a NAME");
+         struct air_module *m = r->m;
+         m->named_md = reralloc(m, m->named_md, struct air_named_md, m->num_named_md + 1);
+         struct air_named_md *n = &m->named_md[m->num_named_md++];
+         n->name = r->pending_md_name;
+         r->pending_md_name = NULL;
+         n->num_ops = e.num_ops;
+         n->ops = rzalloc_array(m, struct air_md *, MAX2(e.num_ops, 1));
+         /* resolved below: these ids are plain, not + 1 */
+         for (unsigned i = 0; i < e.num_ops; i++)
+            n->ops[i] = (struct air_md *)(uintptr_t)(e.ops[i] + 1);
+         break;
+      }
+      case METADATA_KIND: {
+         if (e.num_ops < 1)
+            return fail(r, "METADATA_KIND without an id");
+         struct air_module *m = r->m;
+         unsigned id = e.ops[0];
+         if (id >= m->num_md_kinds) {
+            m->md_kind_names = rerzalloc(m, m->md_kind_names, const char *, m->num_md_kinds, id + 1);
+            m->num_md_kinds = id + 1;
+         }
+         m->md_kind_names[id] = air_bs_ops_to_string(m, e.ops + 1, e.num_ops - 1);
+         break;
+      }
+      case METADATA_INDEX_OFFSET:
+      case METADATA_INDEX:
+      case METADATA_GLOBAL_DECL_ATTACHMENT:
+         break; /* for lazy loading and global attachments; nothing AIR needs */
+      case METADATA_OLD_NODE:
+      case METADATA_OLD_FN_NODE:
+      case METADATA_ARG_LIST:
+         return fail(r, "unsupported metadata record %u", e.id);
+      default:
+         if (md_other_code(e.id)) {
+            md = new_md(r, AIR_MD_OTHER);
+            md->code = e.id;
+            break;
+         }
+         return fail(r, "unknown metadata record %u", e.id);
+      }
+      if (r->m->error[0])
+         return false;
+   }
+
+   /* nodes may name later nodes */
+   for (unsigned i = first; i < r->num_md; i++) {
+      struct air_md *md = r->md[i];
+      if (md->kind != AIR_MD_NODE || !md->pending)
+         continue;
+      for (unsigned k = 0; k < md->num_ops; k++) {
+         unsigned id = md->pending[k];
+         if (id == 0)
+            continue;
+         if (id - 1 >= r->num_md)
+            return fail(r, "metadata node names !%u of %u", id - 1, r->num_md);
+         md->ops[k] = r->md[id - 1];
+      }
+      md->pending = NULL;
+   }
+   return true;
+}
+
+/* values named by metadata, once the values exist */
+static bool
+resolve_md_values(struct reader *r, unsigned first)
+{
+   for (unsigned i = first; i < r->num_md; i++) {
+      struct air_md *md = r->md[i];
+      if (md->kind == AIR_MD_VALUE && !md->value)
+         if (!(md->value = value_by_id(r, md->value_id)))
+            return false;
+   }
+   return true;
+}
+
+static bool
+resolve_named_md(struct reader *r)
+{
+   struct air_module *m = r->m;
+   for (unsigned i = 0; i < m->num_named_md; i++) {
+      struct air_named_md *n = &m->named_md[i];
+      for (unsigned k = 0; k < n->num_ops; k++) {
+         uintptr_t id = (uintptr_t)n->ops[k] - 1;
+         if (id >= r->num_md)
+            return fail(r, "named metadata %s names !%u", n->name, (unsigned)id);
+         n->ops[k] = r->md[id];
+      }
+   }
+   return true;
+}
+
+static bool
+read_metadata_kind_block(struct reader *r)
+{
+   for (;;) {
+      struct air_bs_entry e = air_bs_next(&r->bs);
+      if (e.kind == AIR_BS_END_BLOCK)
+         return true;
+      if (e.kind != AIR_BS_RECORD)
+         return check_bs(r) && fail(r, "metadata kind block ends early");
+      if (e.id == METADATA_KIND && e.num_ops >= 1) {
+         struct air_module *m = r->m;
+         unsigned id = e.ops[0];
+         if (id >= m->num_md_kinds) {
+            m->md_kind_names = rerzalloc(m, m->md_kind_names, const char *, m->num_md_kinds, id + 1);
+            m->num_md_kinds = id + 1;
+         }
+         m->md_kind_names[id] = air_bs_ops_to_string(m, e.ops + 1, e.num_ops - 1);
+      }
+   }
+}
+
+/* -- module records ----------------------------------------------------- */
+
+/* Module version 1 (LLVM before 5) has no string table: a GLOBALVAR or FUNCTION
+ * record is the version 2 one without its first two operands (the name's place in
+ * the table), and the names come from the module's own symbol table instead
+ * (read_module_vst). Apple's compiler service still writes version 1 for some of
+ * the MSL it compiles at run time (sokol-samples' debugtext and drawex), so such a
+ * record is read as the version 2 one with a name of no length, named later.
+ */
+static const struct air_bs_entry *
+as_version2(struct reader *r, const struct air_bs_entry *e, struct air_bs_entry *copy)
+{
+   if (r->m->version >= 2)
+      return e;
+   uint64_t *ops = ralloc_array(r->m, uint64_t, e->num_ops + 2);
+   ops[0] = ops[1] = 0;
+   memcpy(ops + 2, e->ops, e->num_ops * sizeof(uint64_t));
+   *copy = *e;
+   copy->ops = ops;
+   copy->num_ops = e->num_ops + 2;
+   return copy;
+}
+
+static bool
+read_globalvar(struct reader *r, const struct air_bs_entry *e1)
+{
+   struct air_module *m = r->m;
+   struct air_bs_entry copy;
+   const struct air_bs_entry *e = as_version2(r, e1, &copy);
+   if (e->num_ops < 8)
+      return fail(r, "GLOBALVAR too short");
+
+   struct air_global *g = rzalloc(m, struct air_global);
+   g->base.kind = AIR_VALUE_GLOBAL;
+   g->strtab_offset = e->ops[0];
+   g->strtab_size = e->ops[1];
+   const struct air_type *t = type_by_id(r, e->ops[2]);
+   if (!t)
+      return false;
+   uint64_t flags = e->ops[3];
+   g->is_const = flags & 1;
+   if (flags & 2) {
+      g->value_type = t;
+      g->addrspace = flags >> 2;
+   } else {
+      if (t->kind != AIR_TYPE_POINTER || !t->elem)
+         return fail(r, "GLOBALVAR of a non-pointer type");
+      g->value_type = t->elem;
+      g->addrspace = t->addrspace;
+   }
+   g->base.type = pointer_to(r, g->value_type, g->addrspace);
+   g->init_id = e->ops[4];
+   g->linkage = e->ops[5];
+   g->align = e->ops[6] ? 1u << (e->ops[6] - 1) : 0;
+   if (e->ops[7]) {
+      if (e->ops[7] - 1 >= m->num_section_names)
+         return fail(r, "GLOBALVAR names section %" PRIu64, e->ops[7] - 1);
+      g->section = m->section_names[e->ops[7] - 1];
+   }
+   if (e->num_ops > 10)
+      g->unnamed_addr = e->ops[10];
+   if (e->num_ops > 11)
+      g->externally_initialized = e->ops[11];
+   if (e->num_ops > 9 && e->ops[9])
+      return fail(r, "thread-local global");
+
+   m->globals = reralloc(m, m->globals, struct air_global *, m->num_globals + 1);
+   m->globals[m->num_globals++] = g;
+   push_value(r, &g->base);
+   return true;
+}
+
+static bool
+read_function_record(struct reader *r, const struct air_bs_entry *e1)
+{
+   struct air_module *m = r->m;
+   struct air_bs_entry copy;
+   const struct air_bs_entry *e = as_version2(r, e1, &copy);
+   if (e->num_ops < 8)
+      return fail(r, "FUNCTION too short");
+
+   struct air_function *f = rzalloc(m, struct air_function);
+   f->base.kind = AIR_VALUE_FUNCTION;
+   f->strtab_offset = e->ops[0];
+   f->strtab_size = e->ops[1];
+   const struct air_type *t = type_by_id(r, e->ops[2]);
+   if (!t)
+      return false;
+   if (t->kind == AIR_TYPE_POINTER && t->elem)
+      t = t->elem;
+   if (t->kind != AIR_TYPE_FUNCTION)
+      return fail(r, "FUNCTION record of a non-function type");
+   f->fn_type = t;
+   unsigned as = e->num_ops > 18 ? e->ops[18] : 0;
+   f->base.type = pointer_to(r, t, as);
+   f->cc = e->ops[3];
+   f->is_declaration = e->ops[4];
+   f->linkage = e->ops[5];
+   f->paramattr = e->ops[6];
+   f->align = e->ops[7] ? 1u << (e->ops[7] - 1) : 0;
+   if (e->ops[8]) {
+      if (e->ops[8] - 1 >= m->num_section_names)
+         return fail(r, "FUNCTION names section %" PRIu64, e->ops[8] - 1);
+      f->section = m->section_names[e->ops[8] - 1];
+   }
+   if (e->num_ops > 11)
+      f->unnamed_addr = e->ops[11];
+   if (e->num_ops > 16 && e->ops[16])
+      return fail(r, "function with a personality");
+
+   f->num_args = t->num_members;
+   f->args = rzalloc_array(m, struct air_value, MAX2(f->num_args, 1));
+   for (unsigned i = 0; i < f->num_args; i++) {
+      f->args[i].kind = AIR_VALUE_ARGUMENT;
+      f->args[i].type = t->members[i];
+   }
+
+   m->functions = reralloc(m, m->functions, struct air_function *, m->num_functions + 1);
+   m->functions[m->num_functions++] = f;
+   push_value(r, &f->base);
+   return true;
+}
+
+/* -- function bodies ---------------------------------------------------- */
+
+struct rec {
+   const struct air_bs_entry *e;
+   unsigned i;
+   bool bad;
+};
+
+static uint64_t
+take(struct rec *rc)
+{
+   if (rc->i >= rc->e->num_ops) {
+      rc->bad = true;
+      return 0;
+   }
+   return rc->e->ops[rc->i++];
+}
+
+static bool
+more(const struct rec *rc)
+{
+   return rc->i < rc->e->num_ops;
+}
+
+/* a relative operand without a type (the type is known from context) */
+static unsigned
+take_value(struct reader *r, struct rec *rc)
+{
+   return (uint32_t)r->num_values - (uint32_t)take(rc);
+}
+
+/* a relative operand that carries its type when it is a forward reference */
+static unsigned
+take_value_type(struct reader *r, struct rec *rc)
+{
+   unsigned id = (uint32_t)r->num_values - (uint32_t)take(rc);
+   if (id >= r->num_values) {
+      const struct air_type *t = type_by_id(r, take(rc));
+      if (id >= r->cap_fwd) {
+         unsigned cap = MAX2(id + 1, MAX2(64, r->cap_fwd * 2));
+         r->fwd = rerzalloc(r->m, r->fwd, const struct air_type *, r->cap_fwd, cap);
+         r->cap_fwd = cap;
+      }
+      r->fwd[id] = t;
+   }
+   return id;
+}
+
+static struct air_inst *
+new_inst(struct reader *r, enum air_opcode op, const struct air_type *type, unsigned num_operands)
+{
+   struct air_inst *in = rzalloc(r->m, struct air_inst);
+   in->base.kind = AIR_VALUE_INSTRUCTION;
+   in->base.type = type;
+   in->op = op;
+   in->num_operands = num_operands;
+   in->operands = rzalloc_array(r->m, struct air_value *, MAX2(num_operands, 1));
+   in->operand_ids = rzalloc_array(r->m, unsigned, MAX2(num_operands, 1));
+   return in;
+}
+
+static const struct air_type *
+type_of_id(struct reader *r, unsigned id)
+{
+   if (id < r->num_values && r->values[id])
+      return r->values[id]->type;
+   if (id < r->cap_fwd && r->fwd[id])
+      return r->fwd[id];
+   fail(r, "operand %u has no type (a forward reference whose record gave none)", id);
+   return NULL;
+}
+
+static unsigned
+decode_align(uint64_t v)
+{
+   unsigned log2 = v & 31;
+   return log2 ? 1u << (log2 - 1) : 0;
+}
+
+static const struct air_type *
+gep_result_type(struct reader *r, const struct air_type *src, const struct air_type *ptr_type,
+                struct air_inst *in, unsigned first_index)
+{
+   /* the result is a pointer in the base's address space; its element type
+    * (for printing typed pointers) is what the indices reach
+    */
+   /* index 0 steps over the pointer; the ones after it go into the type */
+   const struct air_type *t = src;
+   for (unsigned i = first_index + 2; i < in->num_operands && t; i++) {
+      if (t->kind == AIR_TYPE_STRUCT) {
+         unsigned id = in->operand_ids[i];
+         uint64_t n;
+         if (id >= r->num_values || !r->values[id] || !air_const_uint(r->values[id], &n) ||
+             n >= t->num_members)
+            return NULL;
+         t = t->members[n];
+      } else if (t->kind == AIR_TYPE_ARRAY || t->kind == AIR_TYPE_VECTOR) {
+         t = t->elem;
+      } else {
+         return NULL;
+      }
+   }
+   unsigned as = air_type_scalar(ptr_type)->addrspace;
+   if (ptr_type->kind == AIR_TYPE_VECTOR)
+      return NULL; /* vector GEPs: not in AIR */
+   return pointer_to(r, t, as);
+}
+
+static bool
+add_inst(struct reader *r, struct air_block **block, struct air_inst *in)
+{
+   struct air_block *b = *block;
+   if (!b)
+      return fail(r, "instruction after the last block");
+   if (b->num_insts == b->cap_insts) {
+      b->cap_insts = MAX2(16, b->cap_insts * 2);
+      b->insts = reralloc(r->m, b->insts, struct air_inst *, b->cap_insts);
+   }
+   b->insts[b->num_insts++] = in;
+   in->parent = b;
+
+   if (r->num_fn_insts == r->cap_fn_insts) {
+      r->cap_fn_insts = MAX2(64, r->cap_fn_insts * 2);
+      r->fn_insts = reralloc(r->m, r->fn_insts, struct air_inst *, r->cap_fn_insts);
+   }
+   r->fn_insts[r->num_fn_insts++] = in;
+
+   if (in->base.type && in->base.type->kind != AIR_TYPE_VOID)
+      push_value(r, &in->base);
+
+   /* terminators move on to the next block */
+   if (in->op == AIR_OP_RET || in->op == AIR_OP_BR || in->op == AIR_OP_SWITCH ||
+       in->op == AIR_OP_UNREACHABLE) {
+      struct air_function *f = r->cur_fn;
+      unsigned next = b->index + 1;
+      *block = next < f->num_blocks ? &f->blocks[next] : NULL;
+   }
+   return true;
+}
+
+static bool
+read_instruction(struct reader *r, const struct air_bs_entry *e, struct air_block **block)
+{
+   struct air_module *m = r->m;
+   struct rec rc = { .e = e };
+   struct air_inst *in = NULL;
+   unsigned a, b, c;
+
+   switch (e->id) {
+   case FUNC_CODE_INST_BINOP: {
+      a = take_value_type(r, &rc);
+      b = take_value(r, &rc);
+      unsigned opc = take(&rc);
+      const struct air_type *t = type_of_id(r, a);
+      if (!t)
+         return false;
+      in = new_inst(r, AIR_OP_BINOP, t, 2);
+      in->operand_ids[0] = a;
+      in->operand_ids[1] = b;
+      in->sub = opc;
+      if (more(&rc))
+         in->flags = take(&rc);
+      break;
+   }
+   case FUNC_CODE_INST_UNOP: {
+      a = take_value_type(r, &rc);
+      unsigned opc = take(&rc);
+      const struct air_type *t = type_of_id(r, a);
+      if (!t)
+         return false;
+      in = new_inst(r, AIR_OP_UNOP, t, 1);
+      in->operand_ids[0] = a;
+      in->sub = opc;
+      if (more(&rc))
+         in->flags = take(&rc);
+      break;
+   }
+   case FUNC_CODE_INST_CAST: {
+      a = take_value_type(r, &rc);
+      const struct air_type *t = type_by_id(r, take(&rc));
+      unsigned opc = take(&rc);
+      if (!t)
+         return false;
+      in = new_inst(r, AIR_OP_CAST, t, 1);
+      in->operand_ids[0] = a;
+      in->sub = opc;
+      if (more(&rc))
+         in->flags = take(&rc);
+      break;
+   }
+   case FUNC_CODE_INST_GEP: {
+      bool inbounds = take(&rc) & 1;
+      const struct air_type *src = type_by_id(r, take(&rc));
+      unsigned ids[64], n = 0;
+      while (more(&rc) && n < ARRAY_SIZE(ids))
+         ids[n++] = take_value_type(r, &rc);
+      if (!src || n == 0 || more(&rc))
+         return fail(r, "GEP of %u operands", n);
+      const struct air_type *pt = type_of_id(r, ids[0]);
+      if (!pt)
+         return false;
+      in = new_inst(r, AIR_OP_GEP, NULL, n);
+      memcpy(in->operand_ids, ids, n * sizeof(unsigned));
+      in->inbounds = inbounds;
+      in->aux_type = src;
+      in->base.type = gep_result_type(r, src, pt, in, 0);
+      if (!in->base.type)
+         return fail(r, "GEP whose result type cannot be worked out");
+      break;
+   }
+   case FUNC_CODE_INST_SELECT:
+   case FUNC_CODE_INST_VSELECT: {
+      a = take_value_type(r, &rc);
+      b = take_value(r, &rc);
+      c = e->id == FUNC_CODE_INST_VSELECT ? take_value_type(r, &rc) : take_value(r, &rc);
+      const struct air_type *t = type_of_id(r, a);
+      if (!t)
+         return false;
+      in = new_inst(r, AIR_OP_SELECT, t, 3);
+      in->operand_ids[0] = c; /* condition first, like LLVM's operand order */
+      in->operand_ids[1] = a;
+      in->operand_ids[2] = b;
+      if (more(&rc))
+         in->flags = take(&rc);
+      break;
+   }
+   case FUNC_CODE_INST_EXTRACTELT: {
+      a = take_value_type(r, &rc);
+      b = take_value_type(r, &rc);
+      const struct air_type *t = type_of_id(r, a);
+      if (!t)
+         return false;
+      if (t->kind != AIR_TYPE_VECTOR)
+         return fail(r, "extractelement of a non-vector");
+      in = new_inst(r, AIR_OP_EXTRACTELT, t->elem, 2);
+      in->operand_ids[0] = a;
+      in->operand_ids[1] = b;
+      break;
+   }
+   case FUNC_CODE_INST_INSERTELT: {
+      a = take_value_type(r, &rc);
+      b = take_value(r, &rc);
+      c = take_value_type(r, &rc);
+      const struct air_type *t = type_of_id(r, a);
+      if (!t)
+         return false;
+      in = new_inst(r, AIR_OP_INSERTELT, t, 3);
+      in->operand_ids[0] = a;
+      in->operand_ids[1] = b;
+      in->operand_ids[2] = c;
+      break;
+   }
+   case FUNC_CODE_INST_SHUFFLEVEC: {
+      a = take_value_type(r, &rc);
+      b = take_value(r, &rc);
+      c = take_value_type(r, &rc);
+      const struct air_type *t = type_of_id(r, a);
+      const struct air_type *mt = type_of_id(r, c);
+      if (!t || !mt)
+         return false;
+      if (t->kind != AIR_TYPE_VECTOR || mt->kind != AIR_TYPE_VECTOR)
+         return fail(r, "shufflevector of non-vectors");
+      /* the result has the mask's length and the inputs' element */
+      const struct air_type *rt = NULL;
+      for (unsigned i = 0; i < m->num_types; i++) {
+         const struct air_type *x = &m->types[i];
+         if (x->kind == AIR_TYPE_VECTOR && x->elem == t->elem && x->count == mt->count) {
+            rt = x;
+            break;
+         }
+      }
+      if (!rt)
+         return fail(r, "shufflevector result type not in the type table");
+      in = new_inst(r, AIR_OP_SHUFFLEVEC, rt, 3);
+      in->operand_ids[0] = a;
+      in->operand_ids[1] = b;
+      in->operand_ids[2] = c;
+      break;
+   }
+   case FUNC_CODE_INST_CMP:
+   case FUNC_CODE_INST_CMP2: {
+      a = take_value_type(r, &rc);
+      b = take_value(r, &rc);
+      unsigned pred = take(&rc);
+      const struct air_type *t = type_of_id(r, a);
+      if (!t)
+         return false;
+      /* i1, or a vector of i1 as long as the operands */
+      const struct air_type *rt = NULL;
+      for (unsigned i = 0; i < m->num_types; i++) {
+         const struct air_type *x = &m->types[i];
+         if (t->kind == AIR_TYPE_VECTOR) {
+            if (x->kind == AIR_TYPE_VECTOR && x->count == t->count && x->elem->kind == AIR_TYPE_INT &&
+                x->elem->bits == 1) {
+               rt = x;
+               break;
+            }
+         } else if (x->kind == AIR_TYPE_INT && x->bits == 1) {
+            rt = x;
+            break;
+         }
+      }
+      if (!rt)
+         return fail(r, "compare result type not in the type table");
+      in = new_inst(r, AIR_OP_CMP, rt, 2);
+      in->operand_ids[0] = a;
+      in->operand_ids[1] = b;
+      in->sub = pred;
+      if (more(&rc))
+         in->flags = take(&rc);
+      break;
+   }
+   case FUNC_CODE_INST_RET:
+      if (e->num_ops == 0) {
+         in = new_inst(r, AIR_OP_RET, NULL, 0);
+      } else {
+         a = take_value_type(r, &rc);
+         in = new_inst(r, AIR_OP_RET, NULL, 1);
+         in->operand_ids[0] = a;
+      }
+      break;
+   case FUNC_CODE_INST_BR:
+      if (e->num_ops == 1) {
+         in = new_inst(r, AIR_OP_BR, NULL, 0);
+         in->num_targets = 1;
+         in->target_ids = ralloc_array(m, unsigned, 1);
+         in->target_ids[0] = take(&rc);
+      } else if (e->num_ops == 3) {
+         in = new_inst(r, AIR_OP_BR, NULL, 1);
+         in->num_targets = 2;
+         in->target_ids = ralloc_array(m, unsigned, 2);
+         in->target_ids[0] = take(&rc);
+         in->target_ids[1] = take(&rc);
+         in->operand_ids[0] = take_value(r, &rc);
+      } else {
+         return fail(r, "br of %u operands", e->num_ops);
+      }
+      break;
+   case FUNC_CODE_INST_SWITCH: {
+      /* [ type of the condition, condition, default block,
+       *   (case constant, block)* ]
+       *
+       * The condition is a RELATIVE value number and each case constant is an
+       * ABSOLUTE one, because that is what the writer does -- pushValue for
+       * the condition, getValueID for each case value. Reading them the same
+       * way gives the wrong constant for every case in any function that has
+       * more than a handful of values, which is every function here.
+       *
+       * The blocks are block numbers, as br's are, not value numbers.
+       */
+      if (e->num_ops < 3 || (e->num_ops - 3) % 2)
+         return fail(r, "a switch of %u operands", e->num_ops);
+      unsigned ty = take(&rc);
+      /* LLVM 3.0 wrote switches over ranges, with the case count and a bit
+       * width packed into the first operand under this magic instead of a type
+       * id. Nothing Apple's compiler emits uses it, and reading it as a type
+       * would silently take the wrong path, so it is named and refused.
+       */
+      if ((ty >> 16) == 0x4B5)
+         return fail(r, "a switch in LLVM 3.0's range form (SWITCH_INST_MAGIC)");
+      unsigned cond = take_value(r, &rc);
+      unsigned deflt = take(&rc);
+      unsigned n = (e->num_ops - 3) / 2;
+      in = new_inst(r, AIR_OP_SWITCH, NULL, 1 + n);
+      in->num_targets = 1 + n;
+      in->target_ids = ralloc_array(m, unsigned, 1 + n);
+      /* target 0 and operand 0 are the default edge and the condition; the
+       * cases follow, so case k is operand k+1 and target k+1
+       */
+      in->target_ids[0] = deflt;
+      in->operand_ids[0] = cond;
+      for (unsigned k = 0; k < n; k++) {
+         in->operand_ids[1 + k] = take(&rc);
+         in->target_ids[1 + k] = take(&rc);
+      }
+      break;
+   }
+   case FUNC_CODE_INST_UNREACHABLE:
+      in = new_inst(r, AIR_OP_UNREACHABLE, NULL, 0);
+      break;
+   case FUNC_CODE_INST_PHI: {
+      const struct air_type *t = type_by_id(r, take(&rc));
+      if (!t)
+         return false;
+      unsigned n = (e->num_ops - 1) / 2;
+      in = new_inst(r, AIR_OP_PHI, t, n);
+      in->num_targets = n;
+      in->target_ids = ralloc_array(m, unsigned, MAX2(n, 1));
+      for (unsigned i = 0; i < n; i++) {
+         int64_t rel = decode_signed(take(&rc));
+         in->operand_ids[i] = (uint32_t)((int64_t)r->num_values - rel);
+         in->target_ids[i] = take(&rc);
+      }
+      if (more(&rc))
+         in->flags = take(&rc);
+      break;
+   }
+   case FUNC_CODE_INST_ALLOCA: {
+      uint64_t ty = take(&rc), opty = take(&rc), size = take(&rc), align = take(&rc);
+      (void)opty;
+      const struct air_type *t = type_by_id(r, ty);
+      if (!t)
+         return false;
+      bool explicit_type = align & (1u << 6);
+      const struct air_type *allocated = explicit_type ? t : t->elem;
+      if (!allocated)
+         return fail(r, "alloca without an allocated type");
+      unsigned as = more(&rc) ? take(&rc) : 0;
+      in = new_inst(r, AIR_OP_ALLOCA, pointer_to(r, allocated, as), 1);
+      in->aux_type = allocated;
+      in->operand_ids[0] = size; /* absolute, unlike other operands */
+      in->align = ((align & 31) | ((align >> 8) << 5)) ? 1u << (((align & 31) | ((align >> 8) << 5)) - 1) : 0;
+      break;
+   }
+   case FUNC_CODE_INST_LOAD: {
+      a = take_value_type(r, &rc);
+      const struct air_type *t;
+      if (rc.e->num_ops - rc.i == 3) {
+         t = type_by_id(r, take(&rc));
+      } else {
+         const struct air_type *pt = type_of_id(r, a);
+         t = pt ? pt->elem : NULL;
+      }
+      if (!t)
+         return fail(r, "load of unknown type");
+      in = new_inst(r, AIR_OP_LOAD, t, 1);
+      in->operand_ids[0] = a;
+      in->align = decode_align(take(&rc));
+      in->is_volatile = take(&rc);
+      break;
+   }
+   case FUNC_CODE_INST_STORE: {
+      a = take_value_type(r, &rc); /* the pointer */
+      b = take_value_type(r, &rc); /* the value */
+      in = new_inst(r, AIR_OP_STORE, NULL, 2);
+      in->operand_ids[0] = b; /* value first, as LLVM orders them */
+      in->operand_ids[1] = a;
+      in->align = decode_align(take(&rc));
+      in->is_volatile = take(&rc);
+      break;
+   }
+   case FUNC_CODE_INST_EXTRACTVAL: {
+      a = take_value_type(r, &rc);
+      const struct air_type *t = type_of_id(r, a);
+      if (!t)
+         return false;
+      unsigned n = e->num_ops - rc.i;
+      uint32_t *idx = ralloc_array(m, uint32_t, MAX2(n, 1));
+      for (unsigned i = 0; i < n; i++) {
+         idx[i] = take(&rc);
+         if (t->kind == AIR_TYPE_STRUCT && idx[i] < t->num_members)
+            t = t->members[idx[i]];
+         else if (t->kind == AIR_TYPE_ARRAY && idx[i] < t->count)
+            t = t->elem;
+         else
+            return fail(r, "extractvalue index out of the aggregate");
+      }
+      in = new_inst(r, AIR_OP_EXTRACTVAL, t, 1);
+      in->operand_ids[0] = a;
+      in->num_indices = n;
+      in->indices = idx;
+      break;
+   }
+   case FUNC_CODE_INST_INSERTVAL: {
+      a = take_value_type(r, &rc);
+      b = take_value_type(r, &rc);
+      const struct air_type *t = type_of_id(r, a);
+      if (!t)
+         return false;
+      unsigned n = e->num_ops - rc.i;
+      in = new_inst(r, AIR_OP_INSERTVAL, t, 2);
+      in->operand_ids[0] = a;
+      in->operand_ids[1] = b;
+      in->num_indices = n;
+      in->indices = ralloc_array(m, uint32_t, MAX2(n, 1));
+      for (unsigned i = 0; i < n; i++)
+         in->indices[i] = take(&rc);
+      break;
+   }
+   case FUNC_CODE_INST_CALL: {
+      take(&rc); /* paramattrs: an index into PARAMATTR, nothing the translation uses */
+      uint64_t cc = take(&rc);
+      unsigned fmf = 0;
+      if (cc & (1u << CALL_FMF_BIT))
+         fmf = take(&rc);
+      const struct air_type *fty = NULL;
+      if (cc & (1u << CALL_EXPLICIT_TYPE_BIT))
+         fty = type_by_id(r, take(&rc));
+      unsigned callee = take_value_type(r, &rc);
+      if (!fty) {
+         const struct air_type *pt = type_of_id(r, callee);
+         fty = pt ? pt->elem : NULL;
+      }
+      if (!fty || fty->kind != AIR_TYPE_FUNCTION)
+         return fail(r, "call without a function type");
+      unsigned n = fty->num_members;
+      unsigned ids[64];
+      if (n >= ARRAY_SIZE(ids))
+         return fail(r, "call of %u arguments", n);
+      for (unsigned i = 0; i < n; i++) {
+         if (fty->members[i]->kind == AIR_TYPE_LABEL)
+            return fail(r, "call with a label argument");
+         ids[i] = take_value(r, &rc);
+      }
+      unsigned extra = 0;
+      if (fty->vararg) {
+         while (more(&rc) && n + extra < ARRAY_SIZE(ids)) {
+            ids[n + extra] = take_value_type(r, &rc);
+            extra++;
+         }
+      }
+      if (rc.bad || more(&rc))
+         return fail(r, "call record does not match its function type");
+      in = new_inst(r, AIR_OP_CALL, fty->elem, 1 + n + extra);
+      in->operand_ids[0] = callee;
+      memcpy(in->operand_ids + 1, ids, (n + extra) * sizeof(unsigned));
+      in->aux_type = fty;
+      in->tail = cc & (1u << CALL_TAIL_BIT);
+      in->flags = fmf;
+      in->cc = (cc >> CALL_CCONV_SHIFT) & 0x3ff;
+      break;
+   }
+   case FUNC_CODE_INST_FREEZE: {
+      a = take_value_type(r, &rc);
+      const struct air_type *t = type_of_id(r, a);
+      if (!t)
+         return false;
+      in = new_inst(r, AIR_OP_FREEZE, t, 1);
+      in->operand_ids[0] = a;
+      break;
+   }
+   case FUNC_CODE_DEBUG_LOC:
+   case FUNC_CODE_DEBUG_LOC_AGAIN:
+      return true; /* not instructions */
+   case FUNC_CODE_DECLAREBLOCKS:
+      return fail(r, "DECLAREBLOCKS twice");
+   case FUNC_CODE_OPERAND_BUNDLE:
+      return fail(r, "operand bundles");
+   default:
+      return fail(r, "unsupported instruction record %u", e->id);
+   }
+
+   if (rc.bad)
+      return fail(r, "instruction record %u too short", e->id);
+   r->cur_inst_id++;
+   return add_inst(r, block, in);
+}
+
+static bool
+read_attachments(struct reader *r)
+{
+   for (;;) {
+      struct air_bs_entry e = air_bs_next(&r->bs);
+      if (e.kind == AIR_BS_END_BLOCK)
+         return true;
+      if (e.kind != AIR_BS_RECORD)
+         return check_bs(r) && fail(r, "attachment block ends early");
+      if (e.id != METADATA_ATTACHMENT)
+         continue;
+      if (e.num_ops % 2 == 0)
+         continue; /* attachments of the function itself */
+      unsigned inst = e.ops[0];
+      if (inst >= r->num_fn_insts)
+         return fail(r, "attachment to instruction %u of %u", inst, r->num_fn_insts);
+      struct air_inst *in = r->fn_insts[inst];
+      unsigned n = (e.num_ops - 1) / 2;
+      in->attachments = ralloc_array(r->m, __typeof__(*in->attachments), n);
+      in->num_attachments = n;
+      for (unsigned i = 0; i < n; i++) {
+         unsigned id = e.ops[2 + 2 * i];
+         if (id >= r->num_md)
+            return fail(r, "attachment of !%u of %u", id, r->num_md);
+         in->attachments[i].kind = e.ops[1 + 2 * i];
+         in->attachments[i].md = r->md[id];
+      }
+   }
+}
+
+static bool
+read_function_vst(struct reader *r, unsigned first_local)
+{
+   struct air_function *f = r->cur_fn;
+   for (;;) {
+      struct air_bs_entry e = air_bs_next(&r->bs);
+      if (e.kind == AIR_BS_END_BLOCK)
+         return true;
+      if (e.kind != AIR_BS_RECORD)
+         return check_bs(r) && fail(r, "symbol table ends early");
+      if (e.num_ops < 1)
+         continue;
+      const char *name = air_bs_ops_to_string(r->m, e.ops + 1, e.num_ops - 1);
+      if (e.id == VST_CODE_ENTRY) {
+         if (e.ops[0] < first_local)
+            continue;
+         struct air_value *v = value_by_id(r, e.ops[0]);
+         if (!v)
+            return false;
+         v->name = name;
+      } else if (e.id == VST_CODE_BBENTRY) {
+         if (e.ops[0] >= f->num_blocks)
+            return fail(r, "name for block %" PRIu64, e.ops[0]);
+         f->blocks[e.ops[0]].name = name;
+      }
+   }
+}
+
+static struct air_function *
+next_body(struct reader *r)
+{
+   struct air_module *m = r->m;
+   unsigned seen = 0;
+   for (unsigned i = 0; i < m->num_functions; i++) {
+      if (m->functions[i]->is_declaration)
+         continue;
+      if (seen++ == r->num_bodies_read) {
+         r->num_bodies_read++;
+         return m->functions[i];
+      }
+   }
+   return NULL;
+}
+
+static bool
+read_function_block(struct reader *r)
+{
+   struct air_function *f = next_body(r);
+   if (!f)
+      return fail(r, "a function body for no function");
+
+   unsigned module_values = r->num_values;
+   unsigned module_md = r->num_md;
+   r->cur_fn = f;
+   r->cur_inst_id = 0;
+   r->num_fn_insts = 0;
+   if (r->cap_fwd)
+      memset(r->fwd, 0, r->cap_fwd * sizeof(*r->fwd));
+
+   for (unsigned i = 0; i < f->num_args; i++)
+      push_value(r, &f->args[i]);
+   unsigned first_local = module_values;
+
+   struct air_block *block = NULL;
+   for (;;) {
+      struct air_bs_entry e = air_bs_next(&r->bs);
+      if (e.kind == AIR_BS_END_BLOCK)
+         break;
+      if (e.kind == AIR_BS_ENTER_BLOCK) {
+         bool ok;
+         switch (e.id) {
+         case CONSTANTS_BLOCK_ID:
+            air_bs_enter(&r->bs, e.id);
+            ok = read_constants_block(r);
+            break;
+         case METADATA_BLOCK_ID:
+            air_bs_enter(&r->bs, e.id);
+            ok = read_metadata_block(r);
+            break;
+         case METADATA_ATTACHMENT_ID:
+            air_bs_enter(&r->bs, e.id);
+            ok = read_attachments(r);
+            break;
+         case VALUE_SYMTAB_BLOCK_ID:
+            air_bs_enter(&r->bs, e.id);
+            ok = read_function_vst(r, first_local);
+            break;
+         default:
+            ok = air_bs_skip_block(&r->bs); /* USELIST and the like */
+            break;
+         }
+         if (!ok)
+            return false;
+         continue;
+      }
+      if (e.kind != AIR_BS_RECORD)
+         return check_bs(r) && fail(r, "function block ends early");
+
+      if (e.id == FUNC_CODE_DECLAREBLOCKS) {
+         if (e.num_ops < 1 || f->blocks)
+            return fail(r, "bad DECLAREBLOCKS");
+         f->num_blocks = e.ops[0];
+         f->blocks = rzalloc_array(r->m, struct air_block, MAX2(f->num_blocks, 1));
+         for (unsigned i = 0; i < f->num_blocks; i++)
+            f->blocks[i].index = i;
+         block = f->num_blocks ? &f->blocks[0] : NULL;
+         continue;
+      }
+      if (!read_instruction(r, &e, &block))
+         return false;
+   }
+
+   /* operands, now that every value of the function exists */
+   for (unsigned i = 0; i < r->num_fn_insts; i++) {
+      struct air_inst *in = r->fn_insts[i];
+      for (unsigned k = 0; k < in->num_operands; k++) {
+         if (in->op == AIR_OP_CALL && k > 0 && k - 1 < in->aux_type->num_members &&
+             in->aux_type->members[k - 1]->kind == AIR_TYPE_METADATA) {
+            /* a metadata argument: the id is a metadata id */
+            unsigned id = in->operand_ids[k];
+            if (id >= r->num_md)
+               return fail(r, "metadata argument !%u", id);
+            struct air_value *v = rzalloc(r->m, struct air_value);
+            v->kind = AIR_VALUE_METADATA;
+            v->type = in->aux_type->members[k - 1];
+            v->id = id;
+            in->operands[k] = v;
+            continue;
+         }
+         if (!(in->operands[k] = value_by_id(r, in->operand_ids[k])))
+            return fail(r, "instruction %u of %s: operand %u (value %u) undefined", i,
+                        f->base.name ? f->base.name : "?", k, in->operand_ids[k]);
+      }
+      if (in->num_targets) {
+         in->targets = ralloc_array(r->m, struct air_block *, in->num_targets);
+         for (unsigned k = 0; k < in->num_targets; k++) {
+            if (in->target_ids[k] >= f->num_blocks)
+               return fail(r, "branch to block %u of %u", in->target_ids[k], f->num_blocks);
+            in->targets[k] = &f->blocks[in->target_ids[k]];
+         }
+      }
+      in->operand_ids = NULL;
+      in->target_ids = NULL;
+   }
+   for (unsigned i = 0; i < f->num_blocks; i++) {
+      if (f->blocks[i].num_insts == 0)
+         return fail(r, "block %u of a function is empty", i);
+   }
+   if (!resolve_md_values(r, module_md))
+      return false;
+
+   f->num_values = r->num_values - module_values;
+   /* the function's values and metadata are its own: the next one starts over */
+   r->num_values = module_values;
+   r->num_md = module_md;
+   r->cur_fn = NULL;
+   return true;
+}
+
+/* -- the module block --------------------------------------------------- */
+
+/* A version 1 module's symbol table: ENTRY [value id, name...] for a global or a
+ * declaration, FNENTRY [value id, offset of its body, name...] for a function with
+ * a body. Version 2 keeps the same names in the string table and has no use for it.
+ */
+static bool
+read_module_vst(struct reader *r)
+{
+   for (;;) {
+      struct air_bs_entry e = air_bs_next(&r->bs);
+      if (e.kind == AIR_BS_END_BLOCK)
+         return true;
+      if (e.kind != AIR_BS_RECORD)
+         return check_bs(r) && fail(r, "module symbol table ends early");
+      unsigned skip = e.id == VST_CODE_ENTRY ? 1 : e.id == VST_CODE_FNENTRY ? 2 : 0;
+      if (!skip || e.num_ops < skip)
+         continue;
+      struct air_value *v = value_by_id(r, e.ops[0]);
+      if (!v)
+         return false;
+      v->name = air_bs_ops_to_string(r->m, e.ops + skip, e.num_ops - skip);
+   }
+}
+
+static bool
+read_module_block(struct reader *r)
+{
+   struct air_module *m = r->m;
+   bool module_md_resolved = false;
+
+   for (;;) {
+      struct air_bs_entry e = air_bs_next(&r->bs);
+      if (e.kind == AIR_BS_END_BLOCK)
+         break;
+
+      if (e.kind == AIR_BS_ENTER_BLOCK) {
+         bool ok = true;
+         switch (e.id) {
+         case TYPE_BLOCK_ID_NEW:
+            air_bs_enter(&r->bs, e.id);
+            ok = read_type_block(r);
+            break;
+         case CONSTANTS_BLOCK_ID:
+            air_bs_enter(&r->bs, e.id);
+            ok = read_constants_block(r);
+            break;
+         case METADATA_BLOCK_ID:
+            air_bs_enter(&r->bs, e.id);
+            ok = read_metadata_block(r);
+            break;
+         case METADATA_KIND_BLOCK_ID:
+            air_bs_enter(&r->bs, e.id);
+            ok = read_metadata_kind_block(r);
+            break;
+         case FUNCTION_BLOCK_ID:
+            if (!module_md_resolved) {
+               /* module-level values are complete once bodies begin */
+               m->num_module_values = r->num_values;
+               ok = resolve_md_values(r, 0) && resolve_named_md(r);
+               m->num_md = r->num_md;
+               module_md_resolved = true;
+            }
+            air_bs_enter(&r->bs, e.id);
+            ok = ok && read_function_block(r);
+            break;
+         case VALUE_SYMTAB_BLOCK_ID:
+            /* a version 1 module's names (read_module_vst); version 2's are the string table's */
+            if (m->version < 2) {
+               air_bs_enter(&r->bs, e.id);
+               ok = read_module_vst(r);
+            } else {
+               ok = air_bs_skip_block(&r->bs);
+            }
+            break;
+         default:
+            /* attributes, operand bundle tags, sync scopes, use lists: nothing
+             * the translation depends on
+             */
+            ok = air_bs_skip_block(&r->bs);
+            break;
+         }
+         if (!ok)
+            return false;
+         continue;
+      }
+      if (e.kind != AIR_BS_RECORD)
+         return check_bs(r) && fail(r, "module block ends early");
+
+      switch (e.id) {
+      case MODULE_CODE_VERSION:
+         m->version = e.num_ops ? e.ops[0] : 0;
+         break;
+      case MODULE_CODE_TRIPLE:
+         m->triple = air_bs_ops_to_string(m, e.ops, e.num_ops);
+         break;
+      case MODULE_CODE_DATALAYOUT:
+         m->datalayout = air_bs_ops_to_string(m, e.ops, e.num_ops);
+         break;
+      case MODULE_CODE_SOURCE_FILENAME:
+         m->source_filename = air_bs_ops_to_string(m, e.ops, e.num_ops);
+         break;
+      case MODULE_CODE_SECTIONNAME:
+         m->section_names = reralloc(m, m->section_names, const char *, m->num_section_names + 1);
+         m->section_names[m->num_section_names++] = air_bs_ops_to_string(m, e.ops, e.num_ops);
+         break;
+      case MODULE_CODE_GLOBALVAR:
+         if (!read_globalvar(r, &e))
+            return false;
+         break;
+      case MODULE_CODE_FUNCTION:
+         if (!read_function_record(r, &e))
+            return false;
+         break;
+      case MODULE_CODE_VSTOFFSET:
+      case MODULE_CODE_HASH:
+      case MODULE_CODE_GCNAME:
+         break;
+      default:
+         return fail(r, "unsupported module record %u", e.id);
+      }
+   }
+
+   if (!module_md_resolved) {
+      m->num_module_values = r->num_values;
+      if (!resolve_md_values(r, 0) || !resolve_named_md(r))
+         return false;
+      m->num_md = r->num_md;
+   }
+   /* (the arrays may have moved while function bodies grew them) */
+   m->module_values = r->values;
+   m->md = r->md;
+
+   /* global initializers name module-level constants */
+   for (unsigned i = 0; i < m->num_globals; i++) {
+      struct air_global *g = m->globals[i];
+      if (g->init_id && !(g->init = value_by_id(r, g->init_id - 1)))
+         return false;
+   }
+   if (r->num_bodies_read != 0) {
+      unsigned bodies = 0;
+      for (unsigned i = 0; i < m->num_functions; i++)
+         bodies += !m->functions[i]->is_declaration;
+      if (bodies != r->num_bodies_read)
+         return fail(r, "%u function bodies for %u definitions", r->num_bodies_read, bodies);
+   }
+   return true;
+}
+
+static bool
+read_strtab_block(struct reader *r)
+{
+   for (;;) {
+      struct air_bs_entry e = air_bs_next(&r->bs);
+      if (e.kind == AIR_BS_END_BLOCK)
+         return true;
+      if (e.kind != AIR_BS_RECORD)
+         return check_bs(r) && fail(r, "string table ends early");
+      if (e.id == 1 && e.blob) {
+         r->strtab = e.blob;
+         r->strtab_size = e.blob_size;
+      }
+   }
+}
+
+static bool
+read_identification_block(struct reader *r)
+{
+   for (;;) {
+      struct air_bs_entry e = air_bs_next(&r->bs);
+      if (e.kind == AIR_BS_END_BLOCK)
+         return true;
+      if (e.kind != AIR_BS_RECORD)
+         return check_bs(r) && fail(r, "identification block ends early");
+      if (e.id == 1)
+         r->m->identification = air_bs_ops_to_string(r->m, e.ops, e.num_ops);
+   }
+}
+
+static const char *
+strtab_name(struct reader *r, uint64_t off, uint64_t size)
+{
+   if (!r->strtab || off + size > r->strtab_size) {
+      fail(r, "name at %" PRIu64 "+%" PRIu64 " outside the string table", off, size);
+      return NULL;
+   }
+   return ralloc_strndup(r->m, (const char *)r->strtab + off, size);
+}
+
+struct air_module *
+air_module_read(void *mem_ctx, const void *data, size_t size, const char **error)
+{
+   struct air_module *m = rzalloc(mem_ctx, struct air_module);
+   struct reader r = { .m = m };
+   m->mem_ctx = m;
+
+   const uint8_t *p = data;
+   if (size >= 20 && p[0] == 0xde && p[1] == 0xc0 && p[2] == 0x17 && p[3] == 0x0b) {
+      uint32_t off = p[8] | p[9] << 8 | p[10] << 16 | (uint32_t)p[11] << 24;
+      uint32_t len = p[12] | p[13] << 8 | p[14] << 16 | (uint32_t)p[15] << 24;
+      if ((uint64_t)off + len > size) {
+         fail(&r, "bitcode wrapper points past the data");
+         goto out;
+      }
+      p += off;
+      size = len;
+   }
+
+   if (!air_bs_init(&r.bs, m, p, size)) {
+      fail(&r, "%s", r.bs.error);
+      goto out;
+   }
+
+   bool seen_module = false;
+   for (;;) {
+      struct air_bs_entry e = air_bs_next(&r.bs);
+      if (e.kind == AIR_BS_END)
+         break;
+      if (e.kind != AIR_BS_ENTER_BLOCK) {
+         check_bs(&r) || fail(&r, "a record at the top level");
+         goto out;
+      }
+      bool ok;
+      switch (e.id) {
+      case MODULE_BLOCK_ID:
+         if (seen_module) {
+            fail(&r, "two modules in one bitcode file");
+            goto out;
+         }
+         seen_module = true;
+         air_bs_enter(&r.bs, e.id);
+         ok = read_module_block(&r);
+         break;
+      case STRTAB_BLOCK_ID:
+         air_bs_enter(&r.bs, e.id);
+         ok = read_strtab_block(&r);
+         break;
+      case IDENTIFICATION_BLOCK_ID:
+         air_bs_enter(&r.bs, e.id);
+         ok = read_identification_block(&r);
+         break;
+      default:
+         ok = air_bs_skip_block(&r.bs); /* SYMTAB */
+         break;
+      }
+      if (!ok)
+         goto out;
+   }
+   if (!seen_module) {
+      fail(&r, "no module block");
+      goto out;
+   }
+
+   /* the string table comes after the module, so names come last (a version 1
+    * module named them from its symbol table already, read_module_vst)
+    */
+   for (unsigned i = 0; m->version >= 2 && i < m->num_globals; i++)
+      if (!(m->globals[i]->base.name =
+               strtab_name(&r, m->globals[i]->strtab_offset, m->globals[i]->strtab_size)))
+         goto out;
+   for (unsigned i = 0; m->version >= 2 && i < m->num_functions; i++)
+      if (!(m->functions[i]->base.name =
+               strtab_name(&r, m->functions[i]->strtab_offset, m->functions[i]->strtab_size)))
+         goto out;
+
+out:
+   if (m->error[0]) {
+      if (error)
+         *error = ralloc_strdup(mem_ctx, m->error);
+      ralloc_free(m);
+      return NULL;
+   }
+   if (error)
+      *error = NULL;
+   return m;
+}
+
+const struct air_function *
+air_module_find_function(const struct air_module *m, const char *name)
+{
+   for (unsigned i = 0; i < m->num_functions; i++)
+      if (m->functions[i]->base.name && !strcmp(m->functions[i]->base.name, name))
+         return m->functions[i];
+   return NULL;
+}
+
+const char *
+air_md_string(const struct air_md *md)
+{
+   if (!md || md->kind != AIR_MD_STRING)
+      return NULL;
+   /* strings from METADATA_STRINGS point into the blob and are not terminated */
+   return ralloc_strndup((void *)md, md->str, md->len);
+}
diff --git a/src/compiler/air/air_module.h b/src/compiler/air/air_module.h
new file mode 100644
index 0000000..7ea7c95
--- /dev/null
+++ b/src/compiler/air/air_module.h
@@ -0,0 +1,372 @@
+/*
+ * Copyright © 2026 Darwin on redwood contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The part of LLVM IR that AIR uses, read from bitcode into plain C
+ * structures. It is a reader, not an IR library: nothing here is modified
+ * after reading, and only what the 456 modules of iOS 16.5's system
+ * libraries contain (plus a little margin) is understood. Anything else is an
+ * error that names the record, never a silent skip, because a skipped
+ * instruction is a wrong shader.
+ *
+ * air_module_print() writes the module back as LLVM assembly. That output is
+ * the reader's test: llvm-as must accept it, and after llvm-as | llvm-dis it
+ * must equal what llvm-dis prints for the original bitcode.
+ */
+
+#ifndef AIR_MODULE_H
+#define AIR_MODULE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum air_type_kind {
+   AIR_TYPE_VOID,
+   AIR_TYPE_HALF,
+   AIR_TYPE_BFLOAT,
+   AIR_TYPE_FLOAT,
+   AIR_TYPE_DOUBLE,
+   AIR_TYPE_LABEL,
+   AIR_TYPE_METADATA,
+   AIR_TYPE_TOKEN,
+   AIR_TYPE_INT,
+   AIR_TYPE_POINTER,
+   AIR_TYPE_ARRAY,
+   AIR_TYPE_VECTOR,
+   AIR_TYPE_STRUCT,
+   AIR_TYPE_FUNCTION,
+   AIR_TYPE_UNKNOWN, /* x86_fp80 and the like: legal bitcode, never AIR */
+};
+
+struct air_type {
+   enum air_type_kind kind;
+   unsigned id;
+   unsigned bits;                 /* INT */
+   unsigned addrspace;            /* POINTER */
+   const struct air_type *elem;   /* POINTER (NULL: opaque), ARRAY, VECTOR; FUNCTION: return */
+   uint64_t count;                /* ARRAY, VECTOR */
+   unsigned num_members;          /* STRUCT members, FUNCTION parameters */
+   const struct air_type **members;
+   bool packed;                   /* STRUCT */
+   bool opaque;                   /* STRUCT without a body */
+   bool vararg;                   /* FUNCTION */
+   const char *name;              /* named STRUCT */
+};
+
+enum air_value_kind {
+   AIR_VALUE_GLOBAL,
+   AIR_VALUE_FUNCTION,
+   AIR_VALUE_CONSTANT,
+   AIR_VALUE_ARGUMENT,
+   AIR_VALUE_INSTRUCTION,
+   AIR_VALUE_METADATA, /* a metadata operand of a call (llvm.* intrinsics only) */
+};
+
+struct air_value {
+   enum air_value_kind kind;
+   const struct air_type *type;
+   unsigned id;      /* value number: module-wide for globals/constants, per function otherwise */
+   const char *name; /* NULL when the module has none (stripped) */
+};
+
+enum air_const_kind {
+   AIR_CONST_INT,
+   AIR_CONST_FLOAT,
+   AIR_CONST_NULL,      /* zeroinitializer / null */
+   AIR_CONST_UNDEF,
+   AIR_CONST_POISON,
+   AIR_CONST_AGGREGATE, /* struct, array or vector of other constants */
+   AIR_CONST_DATA,      /* array or vector of plain integers/floats, in .data */
+   AIR_CONST_EXPR,      /* a constant expression: .expr_op, .operands */
+};
+
+enum air_opcode {
+   AIR_OP_RET,
+   AIR_OP_BR,
+   AIR_OP_SWITCH,
+   AIR_OP_UNREACHABLE,
+   AIR_OP_BINOP,
+   AIR_OP_UNOP,
+   AIR_OP_CAST,
+   AIR_OP_GEP,
+   AIR_OP_SELECT,
+   AIR_OP_EXTRACTELT,
+   AIR_OP_INSERTELT,
+   AIR_OP_SHUFFLEVEC,
+   AIR_OP_CMP,
+   AIR_OP_PHI,
+   AIR_OP_ALLOCA,
+   AIR_OP_LOAD,
+   AIR_OP_STORE,
+   AIR_OP_CALL,
+   AIR_OP_EXTRACTVAL,
+   AIR_OP_INSERTVAL,
+   AIR_OP_FREEZE,
+   AIR_OP_FENCE,
+   AIR_OP_ATOMICRMW,
+   AIR_OP_CMPXCHG,
+};
+
+/* the bitcode's numbering, which is also the order of LLVM's own enums */
+enum air_binop {
+   AIR_BINOP_ADD, AIR_BINOP_SUB, AIR_BINOP_MUL, AIR_BINOP_UDIV, AIR_BINOP_SDIV,
+   AIR_BINOP_UREM, AIR_BINOP_SREM, AIR_BINOP_SHL, AIR_BINOP_LSHR, AIR_BINOP_ASHR,
+   AIR_BINOP_AND, AIR_BINOP_OR, AIR_BINOP_XOR,
+};
+
+enum air_cast {
+   AIR_CAST_TRUNC, AIR_CAST_ZEXT, AIR_CAST_SEXT, AIR_CAST_FPTOUI, AIR_CAST_FPTOSI,
+   AIR_CAST_UITOFP, AIR_CAST_SITOFP, AIR_CAST_FPTRUNC, AIR_CAST_FPEXT,
+   AIR_CAST_PTRTOINT, AIR_CAST_INTTOPTR, AIR_CAST_BITCAST, AIR_CAST_ADDRSPACECAST,
+};
+
+enum air_pred {
+   AIR_FCMP_FALSE = 0, AIR_FCMP_OEQ, AIR_FCMP_OGT, AIR_FCMP_OGE, AIR_FCMP_OLT,
+   AIR_FCMP_OLE, AIR_FCMP_ONE, AIR_FCMP_ORD, AIR_FCMP_UNO, AIR_FCMP_UEQ,
+   AIR_FCMP_UGT, AIR_FCMP_UGE, AIR_FCMP_ULT, AIR_FCMP_ULE, AIR_FCMP_UNE,
+   AIR_FCMP_TRUE,
+   AIR_ICMP_EQ = 32, AIR_ICMP_NE, AIR_ICMP_UGT, AIR_ICMP_UGE, AIR_ICMP_ULT,
+   AIR_ICMP_ULE, AIR_ICMP_SGT, AIR_ICMP_SGE, AIR_ICMP_SLT, AIR_ICMP_SLE,
+};
+
+/* fast-math flags as the bitcode stores them */
+#define AIR_FMF_UNSAFE_ALGEBRA (1u << 0) /* the old "fast": everything below */
+#define AIR_FMF_NNAN           (1u << 1)
+#define AIR_FMF_NINF           (1u << 2)
+#define AIR_FMF_NSZ            (1u << 3)
+#define AIR_FMF_ARCP           (1u << 4)
+#define AIR_FMF_CONTRACT       (1u << 5)
+#define AIR_FMF_AFN            (1u << 6)
+#define AIR_FMF_REASSOC        (1u << 7)
+
+/* integer flags */
+#define AIR_FLAG_NUW   (1u << 0)
+#define AIR_FLAG_NSW   (1u << 1)
+#define AIR_FLAG_EXACT (1u << 0)
+
+struct air_block;
+struct air_md;
+
+struct air_constant {
+   struct air_value base;
+   enum air_const_kind ckind;
+   uint64_t u;                    /* INT (two's complement, low bits), FLOAT (the bits) */
+   unsigned num_elems;
+   struct air_value **elems;      /* AGGREGATE */
+   uint64_t *data;                /* DATA */
+   /* EXPR */
+   enum air_opcode expr_op;       /* CAST, BINOP, GEP, CMP, SELECT, EXTRACTELT, ... */
+   unsigned expr_sub;             /* the cast/binop opcode or predicate */
+   bool inbounds;
+   const struct air_type *src_type; /* GEP source element type */
+   unsigned num_operands;
+   struct air_value **operands;
+   /* while reading: value numbers not yet resolved */
+   unsigned *pending;
+};
+
+struct air_global {
+   struct air_value base;          /* type: the pointer */
+   const struct air_type *value_type;
+   unsigned addrspace;
+   bool is_const;
+   bool externally_initialized;
+   unsigned linkage;
+   unsigned align;
+   unsigned unnamed_addr;          /* 0 none, 1 unnamed_addr, 2 local_unnamed_addr */
+   const char *section;
+   struct air_value *init;         /* NULL for a declaration */
+   unsigned init_id;               /* while reading: value number + 1, 0 for none */
+   uint64_t strtab_offset, strtab_size;
+};
+
+struct air_inst {
+   struct air_value base;          /* type: the result (void when none) */
+   enum air_opcode op;
+   unsigned sub;                   /* binop/cast/unop opcode, cmp predicate, rmw operation */
+   unsigned flags;                 /* AIR_FLAG_*, AIR_FMF_* */
+   unsigned align;                 /* bytes; 0 when not given */
+   bool is_volatile;
+   bool inbounds;
+   bool tail;
+   unsigned cc;                     /* call: LLVM's calling convention number */
+   const struct air_type *aux_type; /* GEP source type, alloca's allocated type, call's function type */
+   unsigned num_operands;
+   struct air_value **operands;     /* call: callee first, then the arguments */
+   unsigned *operand_ids;           /* while reading */
+   unsigned num_indices;
+   uint32_t *indices;              /* extractvalue/insertvalue */
+   unsigned num_targets;
+   struct air_block **targets;     /* br: dest, or then/else; phi: the incoming blocks */
+   unsigned *target_ids;           /* while reading */
+   struct air_block *parent;
+   unsigned num_attachments;
+   struct { unsigned kind; struct air_md *md; } *attachments;
+};
+
+struct air_block {
+   unsigned index;
+   const char *name;
+   unsigned num_insts, cap_insts;
+   struct air_inst **insts;
+};
+
+struct air_function {
+   struct air_value base;          /* type: pointer to the function type */
+   const struct air_type *fn_type;
+   bool is_declaration;
+   unsigned linkage;
+   unsigned cc;
+   unsigned unnamed_addr;
+   unsigned align;
+   const char *section;
+   unsigned paramattr;             /* index into the module's attribute lists, 0 for none */
+   unsigned num_args;
+   struct air_value *args;
+   unsigned num_blocks;
+   struct air_block *blocks;
+   unsigned num_values;            /* per-function value numbers in use, all kinds */
+   uint64_t strtab_offset, strtab_size;
+};
+
+enum air_md_kind {
+   AIR_MD_STRING,
+   AIR_MD_VALUE,
+   AIR_MD_NODE,
+   AIR_MD_OTHER, /* debug info and other specialized nodes, kept only to keep the numbering */
+};
+
+struct air_md {
+   enum air_md_kind kind;
+   unsigned id;
+   bool distinct;
+   unsigned code;            /* OTHER: the record code */
+   const char *str;          /* STRING (not NUL-safe: see len) */
+   unsigned len;
+   struct air_value *value;  /* VALUE */
+   unsigned num_ops;
+   struct air_md **ops;      /* NODE; NULL operands are null */
+   unsigned *pending;        /* while reading: md ids + 1 */
+   unsigned value_id;        /* while reading */
+   const struct air_type *value_type;
+   bool function_local;
+};
+
+struct air_named_md {
+   const char *name;
+   unsigned num_ops;
+   struct air_md **ops;
+};
+
+struct air_module {
+   void *mem_ctx;
+   unsigned version;               /* MODULE_CODE_VERSION: 2 = relative ids + strtab */
+   const char *identification;
+   const char *triple;
+   const char *datalayout;
+   const char *source_filename;
+
+   unsigned num_types;
+   struct air_type *types;
+
+   unsigned num_globals;
+   struct air_global **globals;
+   unsigned num_functions;
+   struct air_function **functions;
+
+   unsigned num_module_values;     /* globals + functions + module-level constants */
+   struct air_value **module_values;
+
+   unsigned num_md;                /* module-level metadata */
+   struct air_md **md;
+   unsigned num_named_md;
+   struct air_named_md *named_md;
+
+   unsigned num_md_kinds;
+   const char **md_kind_names;     /* indexed by kind id; NULL where none */
+
+   const char **section_names;
+   unsigned num_section_names;
+
+   /* first error, with the record that caused it */
+   char error[256];
+};
+
+/* Reads one module. data may start with the 0x0B17C0DE wrapper or directly
+ * with 'BC' 0xC0DE. Returns NULL and fills *error (when non-NULL, allocated
+ * under mem_ctx) on failure.
+ */
+struct air_module *air_module_read(void *mem_ctx, const void *data, size_t size,
+                                   const char **error);
+
+void air_module_print(const struct air_module *m, FILE *fp);
+
+/* helpers for the translator */
+static inline const struct air_constant *
+air_value_as_constant(const struct air_value *v)
+{
+   return v && v->kind == AIR_VALUE_CONSTANT ? (const struct air_constant *)v : NULL;
+}
+
+static inline const struct air_inst *
+air_value_as_inst(const struct air_value *v)
+{
+   return v && v->kind == AIR_VALUE_INSTRUCTION ? (const struct air_inst *)v : NULL;
+}
+
+/* A constant integer, where zero may be stored as a null/zeroinitializer
+ * rather than as an INTEGER record -- which is how LLVM writes the zero
+ * indices of a getelementptr.
+ */
+static inline bool
+air_const_uint(const struct air_value *v, uint64_t *out)
+{
+   const struct air_constant *c = air_value_as_constant(v);
+   if (!c)
+      return false;
+   if (c->ckind == AIR_CONST_INT) {
+      *out = c->u;
+      return true;
+   }
+   if (c->ckind == AIR_CONST_NULL && v->type->kind == AIR_TYPE_INT) {
+      *out = 0;
+      return true;
+   }
+   return false;
+}
+
+static inline bool
+air_type_is_float(const struct air_type *t)
+{
+   return t->kind == AIR_TYPE_HALF || t->kind == AIR_TYPE_BFLOAT ||
+          t->kind == AIR_TYPE_FLOAT || t->kind == AIR_TYPE_DOUBLE;
+}
+
+/* the scalar of a vector, the type itself otherwise */
+static inline const struct air_type *
+air_type_scalar(const struct air_type *t)
+{
+   return t->kind == AIR_TYPE_VECTOR ? t->elem : t;
+}
+
+unsigned air_type_bit_size(const struct air_type *t); /* scalar bits: i1 -> 1, float -> 32, ptr -> 64 */
+uint64_t air_type_alloc_size(const struct air_module *m, const struct air_type *t);
+unsigned air_type_abi_align(const struct air_module *m, const struct air_type *t);
+uint64_t air_struct_member_offset(const struct air_module *m, const struct air_type *t, unsigned i);
+
+const struct air_function *air_module_find_function(const struct air_module *m, const char *name);
+const char *air_md_string(const struct air_md *md); /* NUL-terminated copy, or NULL when not a string */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* AIR_MODULE_H */
diff --git a/src/compiler/air/air_print.c b/src/compiler/air/air_print.c
new file mode 100644
index 0000000..bc70239
--- /dev/null
+++ b/src/compiler/air/air_print.c
@@ -0,0 +1,912 @@
+/*
+ * Copyright © 2026 Darwin on redwood contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * struct air_module -> LLVM assembly, in the syntax LLVM 22 reads (opaque
+ * pointers). Attributes are not printed; everything else the reader keeps
+ * is. The point is a test of the reader: llvm-as must accept the output,
+ * and llvm-as | llvm-dis of it must equal llvm-dis of the original once
+ * attributes are stripped from both (tools/air/reader-check.sh).
+ */
+
+#include "air_module.h"
+
+#include <inttypes.h>
+#include <string.h>
+
+#include "util/hash_table.h"
+#include "util/macros.h"
+#include "util/ralloc.h"
+
+struct printer {
+   const struct air_module *m;
+   FILE *fp;
+   struct hash_table *md_numbers; /* air_md * -> number + 1 */
+   unsigned num_md_numbers;
+   struct air_md **md_order;
+   unsigned cap_md_order;
+   /* slots of the current function */
+   struct hash_table *slots;      /* air_value * or air_block * -> slot + 1 */
+};
+
+static void print_type(struct printer *p, const struct air_type *t);
+static void print_value(struct printer *p, const struct air_value *v);
+
+static bool
+is_ident_char(char c)
+{
+   return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+          c == '.' || c == '_' || c == '$' || c == '-';
+}
+
+static void
+print_escaped(struct printer *p, const char *s, size_t len)
+{
+   for (size_t i = 0; i < len; i++) {
+      unsigned char c = s[i];
+      if (c >= 0x20 && c < 0x7f && c != '"' && c != '\\')
+         fputc(c, p->fp);
+      else
+         fprintf(p->fp, "\\%02X", c);
+   }
+}
+
+static void
+print_name(struct printer *p, char sigil, const char *name)
+{
+   bool plain = name[0] != 0 && !(name[0] >= '0' && name[0] <= '9');
+   for (const char *c = name; *c && plain; c++)
+      plain = is_ident_char(*c);
+   fputc(sigil, p->fp);
+   if (plain) {
+      fputs(name, p->fp);
+   } else {
+      fputc('"', p->fp);
+      print_escaped(p, name, strlen(name));
+      fputc('"', p->fp);
+   }
+}
+
+static void
+print_type(struct printer *p, const struct air_type *t)
+{
+   FILE *fp = p->fp;
+   switch (t->kind) {
+   case AIR_TYPE_VOID: fputs("void", fp); break;
+   case AIR_TYPE_HALF: fputs("half", fp); break;
+   case AIR_TYPE_BFLOAT: fputs("bfloat", fp); break;
+   case AIR_TYPE_FLOAT: fputs("float", fp); break;
+   case AIR_TYPE_DOUBLE: fputs("double", fp); break;
+   case AIR_TYPE_LABEL: fputs("label", fp); break;
+   case AIR_TYPE_METADATA: fputs("metadata", fp); break;
+   case AIR_TYPE_TOKEN: fputs("token", fp); break;
+   case AIR_TYPE_INT: fprintf(fp, "i%u", t->bits); break;
+   case AIR_TYPE_POINTER:
+      if (t->addrspace)
+         fprintf(fp, "ptr addrspace(%u)", t->addrspace);
+      else
+         fputs("ptr", fp);
+      break;
+   case AIR_TYPE_ARRAY:
+      fprintf(fp, "[%" PRIu64 " x ", t->count);
+      print_type(p, t->elem);
+      fputc(']', fp);
+      break;
+   case AIR_TYPE_VECTOR:
+      fprintf(fp, "<%" PRIu64 " x ", t->count);
+      print_type(p, t->elem);
+      fputc('>', fp);
+      break;
+   case AIR_TYPE_STRUCT:
+      if (t->name) {
+         print_name(p, '%', t->name);
+         break;
+      }
+      fputs(t->packed ? "<{ " : "{ ", fp);
+      for (unsigned i = 0; i < t->num_members; i++) {
+         if (i)
+            fputs(", ", fp);
+         print_type(p, t->members[i]);
+      }
+      fputs(t->num_members ? (t->packed ? " }>" : " }") : (t->packed ? "}>" : "}"), fp);
+      break;
+   case AIR_TYPE_FUNCTION:
+      print_type(p, t->elem);
+      fputs(" (", fp);
+      for (unsigned i = 0; i < t->num_members; i++) {
+         if (i)
+            fputs(", ", fp);
+         print_type(p, t->members[i]);
+      }
+      if (t->vararg)
+         fputs(t->num_members ? ", ..." : "...", fp);
+      fputc(')', fp);
+      break;
+   default:
+      fputs("<unknown type>", fp);
+      break;
+   }
+}
+
+static void
+print_float(struct printer *p, const struct air_type *t, uint64_t bits)
+{
+   switch (t->kind) {
+   case AIR_TYPE_HALF:
+      fprintf(p->fp, "0xH%04" PRIX64, bits & 0xffff);
+      break;
+   case AIR_TYPE_BFLOAT:
+      fprintf(p->fp, "0xR%04" PRIX64, bits & 0xffff);
+      break;
+   case AIR_TYPE_FLOAT: {
+      /* LLVM writes float constants as the double of the same value */
+      uint32_t u = bits;
+      float f;
+      memcpy(&f, &u, 4);
+      double d = f;
+      uint64_t du;
+      memcpy(&du, &d, 8);
+      /* a NaN's payload must survive: shift it into the double's mantissa */
+      if (f != f) {
+         du = ((uint64_t)(u >> 31) << 63) | (0x7ffull << 52) | ((uint64_t)(u & 0x7fffff) << 29);
+      }
+      fprintf(p->fp, "0x%016" PRIX64, du);
+      break;
+   }
+   default:
+      fprintf(p->fp, "0x%016" PRIX64, bits);
+      break;
+   }
+}
+
+static void
+print_int(struct printer *p, const struct air_type *t, uint64_t u)
+{
+   if (t->bits == 1) {
+      fputs(u & 1 ? "true" : "false", p->fp);
+      return;
+   }
+   int64_t s = t->bits >= 64 ? (int64_t)u : (int64_t)(u << (64 - t->bits)) >> (64 - t->bits);
+   fprintf(p->fp, "%" PRId64, s);
+}
+
+static void print_constant(struct printer *p, const struct air_constant *c);
+
+static void
+print_typed(struct printer *p, const struct air_value *v)
+{
+   print_type(p, v->type);
+   fputc(' ', p->fp);
+   print_value(p, v);
+}
+
+static const struct air_type *
+elem_type(const struct air_type *t, unsigned i)
+{
+   if (t->kind == AIR_TYPE_STRUCT)
+      return t->members[i];
+   return t->elem;
+}
+
+static void
+print_constant(struct printer *p, const struct air_constant *c)
+{
+   FILE *fp = p->fp;
+   const struct air_type *t = c->base.type;
+   switch (c->ckind) {
+   case AIR_CONST_INT:
+      if (t->kind == AIR_TYPE_INT)
+         print_int(p, t, c->u);
+      else
+         fputs("<int constant of a non-int type>", fp);
+      break;
+   case AIR_CONST_FLOAT:
+      print_float(p, t, c->u);
+      break;
+   case AIR_CONST_NULL:
+      /* a scalar zero prints as a zero of its type; only aggregates get
+       * LLVM's zeroinitializer
+       */
+      if (t->kind == AIR_TYPE_POINTER)
+         fputs("null", fp);
+      else if (t->kind == AIR_TYPE_INT)
+         print_int(p, t, 0);
+      else if (air_type_is_float(t))
+         print_float(p, t, 0);
+      else
+         fputs("zeroinitializer", fp);
+      break;
+   case AIR_CONST_UNDEF:
+      fputs("undef", fp);
+      break;
+   case AIR_CONST_POISON:
+      fputs("poison", fp);
+      break;
+   case AIR_CONST_AGGREGATE:
+   case AIR_CONST_DATA: {
+      const char *open = t->kind == AIR_TYPE_ARRAY ? "[" : t->kind == AIR_TYPE_VECTOR ? "<" :
+                         t->packed ? "<{ " : "{ ";
+      const char *close = t->kind == AIR_TYPE_ARRAY ? "]" : t->kind == AIR_TYPE_VECTOR ? ">" :
+                          t->packed ? " }>" : " }";
+      fputs(open, fp);
+      for (unsigned i = 0; i < c->num_elems; i++) {
+         if (i)
+            fputs(", ", fp);
+         if (c->ckind == AIR_CONST_AGGREGATE) {
+            print_typed(p, c->elems[i]);
+         } else {
+            const struct air_type *et = elem_type(t, i);
+            print_type(p, et);
+            fputc(' ', fp);
+            if (air_type_is_float(et))
+               print_float(p, et, c->data[i]);
+            else
+               print_int(p, et, c->data[i]);
+         }
+      }
+      fputs(close, fp);
+      break;
+   }
+   case AIR_CONST_EXPR:
+      switch (c->expr_op) {
+      case AIR_OP_CAST: {
+         static const char *names[] = {
+            "trunc", "zext", "sext", "fptoui", "fptosi", "uitofp", "sitofp", "fptrunc",
+            "fpext", "ptrtoint", "inttoptr", "bitcast", "addrspacecast",
+         };
+         const struct air_value *op = c->operands[0];
+         /* with opaque pointers a pointer-to-pointer bitcast is nothing */
+         if (c->expr_sub == AIR_CAST_BITCAST && t->kind == AIR_TYPE_POINTER &&
+             op->type->kind == AIR_TYPE_POINTER && op->type->addrspace == t->addrspace) {
+            print_value(p, op);
+            break;
+         }
+         fprintf(fp, "%s (", c->expr_sub < ARRAY_SIZE(names) ? names[c->expr_sub] : "?cast");
+         print_typed(p, op);
+         fputs(" to ", fp);
+         print_type(p, t);
+         fputc(')', fp);
+         break;
+      }
+      case AIR_OP_GEP:
+         fprintf(fp, "getelementptr %s(", c->inbounds ? "inbounds " : "");
+         print_type(p, c->src_type);
+         for (unsigned i = 0; i < c->num_operands; i++) {
+            fputs(", ", fp);
+            print_typed(p, c->operands[i]);
+         }
+         fputc(')', fp);
+         break;
+      default:
+         fprintf(fp, "<constant expression %u>", c->expr_op);
+         break;
+      }
+      break;
+   }
+}
+
+static void
+print_value(struct printer *p, const struct air_value *v)
+{
+   switch (v->kind) {
+   case AIR_VALUE_GLOBAL:
+   case AIR_VALUE_FUNCTION:
+      print_name(p, '@', v->name ? v->name : "?");
+      return;
+   case AIR_VALUE_CONSTANT:
+      print_constant(p, (const struct air_constant *)v);
+      return;
+   case AIR_VALUE_METADATA:
+      fputs("!{}", p->fp); /* not in AIR; kept printable */
+      return;
+   default: {
+      if (v->name) {
+         print_name(p, '%', v->name);
+         return;
+      }
+      struct hash_entry *e = _mesa_hash_table_search(p->slots, v);
+      if (e)
+         fprintf(p->fp, "%%%u", (unsigned)((uintptr_t)e->data - 1));
+      else
+         fputs("%<no slot>", p->fp);
+      return;
+   }
+   }
+}
+
+/* -- metadata ----------------------------------------------------------- */
+
+static void
+number_md(struct printer *p, struct air_md *md)
+{
+   if (!md || md->kind != AIR_MD_NODE)
+      return;
+   if (_mesa_hash_table_search(p->md_numbers, md))
+      return;
+   _mesa_hash_table_insert(p->md_numbers, md, (void *)(uintptr_t)(++p->num_md_numbers));
+   if (p->num_md_numbers > p->cap_md_order) {
+      p->cap_md_order = MAX2(64, p->cap_md_order * 2);
+      p->md_order = reralloc(NULL, p->md_order, struct air_md *, p->cap_md_order);
+   }
+   p->md_order[p->num_md_numbers - 1] = md;
+   for (unsigned i = 0; i < md->num_ops; i++)
+      number_md(p, md->ops[i]);
+}
+
+static void
+print_md_ref(struct printer *p, const struct air_md *md)
+{
+   if (!md) {
+      fputs("null", p->fp);
+      return;
+   }
+   switch (md->kind) {
+   case AIR_MD_STRING:
+      fputs("!\"", p->fp);
+      print_escaped(p, md->str, md->len);
+      fputc('"', p->fp);
+      break;
+   case AIR_MD_VALUE:
+      print_typed(p, md->value);
+      break;
+   case AIR_MD_NODE: {
+      struct hash_entry *e = _mesa_hash_table_search(p->md_numbers, md);
+      fprintf(p->fp, "!%u", e ? (unsigned)((uintptr_t)e->data - 1) : ~0u);
+      break;
+   }
+   default:
+      fputs("!{}", p->fp);
+      break;
+   }
+}
+
+static void
+print_md_node(struct printer *p, const struct air_md *md)
+{
+   fputs(md->distinct ? "distinct !{" : "!{", p->fp);
+   for (unsigned i = 0; i < md->num_ops; i++) {
+      if (i)
+         fputs(", ", p->fp);
+      print_md_ref(p, md->ops[i]);
+   }
+   fputc('}', p->fp);
+}
+
+/* -- instructions ------------------------------------------------------- */
+
+static void
+print_fmf(struct printer *p, unsigned f)
+{
+   if ((f & AIR_FMF_UNSAFE_ALGEBRA) ||
+       (f & 0xfe) == 0xfe) {
+      fputs("fast ", p->fp);
+      return;
+   }
+   static const struct { unsigned bit; const char *name; } flags[] = {
+      { AIR_FMF_REASSOC, "reassoc" }, { AIR_FMF_NNAN, "nnan" }, { AIR_FMF_NINF, "ninf" },
+      { AIR_FMF_NSZ, "nsz" }, { AIR_FMF_ARCP, "arcp" }, { AIR_FMF_CONTRACT, "contract" },
+      { AIR_FMF_AFN, "afn" },
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(flags); i++)
+      if (f & flags[i].bit)
+         fprintf(p->fp, "%s ", flags[i].name);
+}
+
+/* "label %x" after a branch, a bare "%x" inside a phi */
+static void
+print_block_ref_as(struct printer *p, const struct air_block *b, bool with_label)
+{
+   if (with_label)
+      fputs("label ", p->fp);
+   if (b->name) {
+      print_name(p, '%', b->name);
+      return;
+   }
+   struct hash_entry *e = _mesa_hash_table_search(p->slots, b);
+   fprintf(p->fp, "%%%u", e ? (unsigned)((uintptr_t)e->data - 1) : ~0u);
+}
+
+static void
+print_block_ref(struct printer *p, const struct air_block *b)
+{
+   print_block_ref_as(p, b, true);
+}
+
+static void
+print_inst(struct printer *p, const struct air_inst *in)
+{
+   FILE *fp = p->fp;
+   const struct air_type *t = in->base.type;
+   fputs("  ", fp);
+   if (t && t->kind != AIR_TYPE_VOID) {
+      print_value(p, &in->base);
+      fputs(" = ", fp);
+   }
+
+   switch (in->op) {
+   case AIR_OP_BINOP: {
+      static const char *iname[] = { "add", "sub", "mul", "udiv", "sdiv", "urem", "srem",
+                                     "shl", "lshr", "ashr", "and", "or", "xor" };
+      bool fp_op = air_type_is_float(air_type_scalar(t));
+      const char *name = in->sub < ARRAY_SIZE(iname) ? iname[in->sub] : "?binop";
+      if (fp_op) {
+         static const char *fname[] = { "fadd", "fsub", "fmul", NULL, "fdiv", NULL, "frem" };
+         name = in->sub < ARRAY_SIZE(fname) && fname[in->sub] ? fname[in->sub] : "?fbinop";
+      }
+      fprintf(fp, "%s ", name);
+      if (fp_op) {
+         print_fmf(p, in->flags);
+      } else if (in->sub == AIR_BINOP_ADD || in->sub == AIR_BINOP_SUB ||
+                 in->sub == AIR_BINOP_MUL || in->sub == AIR_BINOP_SHL) {
+         if (in->flags & AIR_FLAG_NUW)
+            fputs("nuw ", fp);
+         if (in->flags & AIR_FLAG_NSW)
+            fputs("nsw ", fp);
+      } else if (in->sub == AIR_BINOP_UDIV || in->sub == AIR_BINOP_SDIV ||
+                 in->sub == AIR_BINOP_LSHR || in->sub == AIR_BINOP_ASHR) {
+         if (in->flags & AIR_FLAG_EXACT)
+            fputs("exact ", fp);
+      } else if (in->sub == AIR_BINOP_OR && (in->flags & 1)) {
+         fputs("disjoint ", fp);
+      }
+      print_typed(p, in->operands[0]);
+      fputs(", ", fp);
+      print_value(p, in->operands[1]);
+      break;
+   }
+   case AIR_OP_UNOP:
+      fputs("fneg ", fp);
+      print_fmf(p, in->flags);
+      print_typed(p, in->operands[0]);
+      break;
+   case AIR_OP_CAST: {
+      static const char *names[] = {
+         "trunc", "zext", "sext", "fptoui", "fptosi", "uitofp", "sitofp", "fptrunc",
+         "fpext", "ptrtoint", "inttoptr", "bitcast", "addrspacecast",
+      };
+      fprintf(fp, "%s ", in->sub < ARRAY_SIZE(names) ? names[in->sub] : "?cast");
+      if (in->sub == AIR_CAST_ZEXT && (in->flags & 1))
+         fputs("nneg ", fp);
+      print_typed(p, in->operands[0]);
+      fputs(" to ", fp);
+      print_type(p, t);
+      break;
+   }
+   case AIR_OP_GEP:
+      fprintf(fp, "getelementptr %s", in->inbounds ? "inbounds " : "");
+      print_type(p, in->aux_type);
+      for (unsigned i = 0; i < in->num_operands; i++) {
+         fputs(", ", fp);
+         print_typed(p, in->operands[i]);
+      }
+      break;
+   case AIR_OP_SELECT:
+      fputs("select ", fp);
+      print_fmf(p, in->flags);
+      print_typed(p, in->operands[0]);
+      fputs(", ", fp);
+      print_typed(p, in->operands[1]);
+      fputs(", ", fp);
+      print_typed(p, in->operands[2]);
+      break;
+   case AIR_OP_EXTRACTELT:
+      fputs("extractelement ", fp);
+      print_typed(p, in->operands[0]);
+      fputs(", ", fp);
+      print_typed(p, in->operands[1]);
+      break;
+   case AIR_OP_INSERTELT:
+      fputs("insertelement ", fp);
+      for (unsigned i = 0; i < 3; i++) {
+         if (i)
+            fputs(", ", fp);
+         print_typed(p, in->operands[i]);
+      }
+      break;
+   case AIR_OP_SHUFFLEVEC:
+      fputs("shufflevector ", fp);
+      for (unsigned i = 0; i < 3; i++) {
+         if (i)
+            fputs(", ", fp);
+         print_typed(p, in->operands[i]);
+      }
+      break;
+   case AIR_OP_CMP: {
+      static const char *fpred[] = { "false", "oeq", "ogt", "oge", "olt", "ole", "one", "ord",
+                                     "uno", "ueq", "ugt", "uge", "ult", "ule", "une", "true" };
+      static const char *ipred[] = { "eq", "ne", "ugt", "uge", "ult", "ule", "sgt", "sge",
+                                     "slt", "sle" };
+      if (in->sub < 16) {
+         fprintf(fp, "fcmp ");
+         print_fmf(p, in->flags);
+         fprintf(fp, "%s ", fpred[in->sub]);
+      } else if (in->sub >= 32 && in->sub < 42) {
+         fprintf(fp, "icmp %s ", ipred[in->sub - 32]);
+      } else {
+         fprintf(fp, "?cmp%u ", in->sub);
+      }
+      print_typed(p, in->operands[0]);
+      fputs(", ", fp);
+      print_value(p, in->operands[1]);
+      break;
+   }
+   case AIR_OP_PHI:
+      fputs("phi ", fp);
+      if (air_type_is_float(air_type_scalar(t)))
+         print_fmf(p, in->flags);
+      print_type(p, t);
+      for (unsigned i = 0; i < in->num_operands; i++) {
+         fputs(i ? ", [ " : " [ ", fp);
+         print_value(p, in->operands[i]);
+         fputs(", ", fp);
+         print_block_ref_as(p, in->targets[i], false);
+         fputs(" ]", fp);
+      }
+      break;
+   case AIR_OP_ALLOCA: {
+      fputs("alloca ", fp);
+      print_type(p, in->aux_type);
+      const struct air_constant *n = air_value_as_constant(in->operands[0]);
+      if (!n || n->ckind != AIR_CONST_INT || n->u != 1) {
+         fputs(", ", fp);
+         print_typed(p, in->operands[0]);
+      }
+      if (in->align)
+         fprintf(fp, ", align %u", in->align);
+      if (t->addrspace)
+         fprintf(fp, ", addrspace(%u)", t->addrspace);
+      break;
+   }
+   case AIR_OP_LOAD:
+      fprintf(fp, "load %s", in->is_volatile ? "volatile " : "");
+      print_type(p, t);
+      fputs(", ", fp);
+      print_typed(p, in->operands[0]);
+      if (in->align)
+         fprintf(fp, ", align %u", in->align);
+      break;
+   case AIR_OP_STORE:
+      fprintf(fp, "store %s", in->is_volatile ? "volatile " : "");
+      print_typed(p, in->operands[0]);
+      fputs(", ", fp);
+      print_typed(p, in->operands[1]);
+      if (in->align)
+         fprintf(fp, ", align %u", in->align);
+      break;
+   case AIR_OP_CALL: {
+      fputs(in->tail ? "tail call " : "call ", fp);
+      print_fmf(p, in->flags);
+      /* LLVM's CallingConv::ID, of which AIR uses only C and fastcc */
+      if (in->cc == 8)
+         fputs("fastcc ", fp);
+      else if (in->cc)
+         fprintf(fp, "cc%u ", in->cc);
+      const struct air_type *fty = in->aux_type;
+      if (fty->vararg)
+         print_type(p, fty);
+      else
+         print_type(p, fty->elem);
+      fputc(' ', fp);
+      print_value(p, in->operands[0]);
+      fputc('(', fp);
+      for (unsigned i = 1; i < in->num_operands; i++) {
+         if (i > 1)
+            fputs(", ", fp);
+         print_typed(p, in->operands[i]);
+      }
+      fputc(')', fp);
+      break;
+   }
+   case AIR_OP_EXTRACTVAL:
+      fputs("extractvalue ", fp);
+      print_typed(p, in->operands[0]);
+      for (unsigned i = 0; i < in->num_indices; i++)
+         fprintf(fp, ", %u", in->indices[i]);
+      break;
+   case AIR_OP_INSERTVAL:
+      fputs("insertvalue ", fp);
+      print_typed(p, in->operands[0]);
+      fputs(", ", fp);
+      print_typed(p, in->operands[1]);
+      for (unsigned i = 0; i < in->num_indices; i++)
+         fprintf(fp, ", %u", in->indices[i]);
+      break;
+   case AIR_OP_FREEZE:
+      fputs("freeze ", fp);
+      print_typed(p, in->operands[0]);
+      break;
+   case AIR_OP_RET:
+      if (in->num_operands) {
+         fputs("ret ", fp);
+         print_typed(p, in->operands[0]);
+      } else {
+         fputs("ret void", fp);
+      }
+      break;
+   case AIR_OP_BR:
+      fputs("br ", fp);
+      if (in->num_targets == 1) {
+         print_block_ref(p, in->targets[0]);
+      } else {
+         print_typed(p, in->operands[0]);
+         fputs(", ", fp);
+         print_block_ref(p, in->targets[0]);
+         fputs(", ", fp);
+         print_block_ref(p, in->targets[1]);
+      }
+      break;
+   case AIR_OP_SWITCH:
+      fputs("switch ", fp);
+      print_typed(p, in->operands[0]);
+      fputs(", ", fp);
+      print_block_ref(p, in->targets[0]);
+      fputs(" [", fp);
+      for (unsigned k = 1; k < in->num_targets; k++) {
+         fputs("\n    ", fp);
+         print_typed(p, in->operands[k]);
+         fputs(", ", fp);
+         print_block_ref(p, in->targets[k]);
+      }
+      fputs("\n  ]", fp);
+      break;
+   case AIR_OP_UNREACHABLE:
+      fputs("unreachable", fp);
+      break;
+   default:
+      fprintf(fp, "<opcode %u>", in->op);
+      break;
+   }
+
+   for (unsigned i = 0; i < in->num_attachments; i++) {
+      unsigned k = in->attachments[i].kind;
+      const char *kind = k < p->m->num_md_kinds && p->m->md_kind_names[k] ? p->m->md_kind_names[k] : "?";
+      fputs(", ", fp);
+      print_name(p, '!', kind);
+      fputc(' ', fp);
+      print_md_ref(p, in->attachments[i].md);
+   }
+   fputc('\n', fp);
+}
+
+static const char *
+linkage_name(unsigned l)
+{
+   switch (l) {
+   case 0: case 5: case 6: case 15: return "";
+   case 2: return "appending ";
+   case 3: return "internal ";
+   case 7: return "extern_weak ";
+   case 8: return "common ";
+   case 9: case 13: case 14: return "private ";
+   case 12: return "available_externally ";
+   case 1: case 16: return "weak ";
+   case 10: case 17: return "weak_odr ";
+   case 4: case 18: return "linkonce ";
+   case 11: case 19: return "linkonce_odr ";
+   default: return "?linkage ";
+   }
+}
+
+static const char *
+cc_name(unsigned cc)
+{
+   /* LLVM's CallingConv::ID; AIR uses only C (0) and fastcc (8) */
+   switch (cc) {
+   case 0: return "";
+   case 8: return "fastcc ";
+   case 9: return "coldcc ";
+   default: return NULL;
+   }
+}
+
+static const char *
+unnamed_addr_name(unsigned u)
+{
+   return u == 1 ? "unnamed_addr " : u == 2 ? "local_unnamed_addr " : "";
+}
+
+static void
+print_function(struct printer *p, const struct air_function *f)
+{
+   FILE *fp = p->fp;
+   const struct air_type *fty = f->fn_type;
+
+   if (f->is_declaration) {
+      fprintf(fp, "declare %s", f->linkage == 7 ? "extern_weak " : "");
+      if (cc_name(f->cc))
+         fputs(cc_name(f->cc), fp);
+      else
+         fprintf(fp, "cc%u ", f->cc);
+      print_type(p, fty->elem);
+      fputc(' ', fp);
+      print_name(p, '@', f->base.name);
+      fputc('(', fp);
+      for (unsigned i = 0; i < fty->num_members; i++) {
+         if (i)
+            fputs(", ", fp);
+         print_type(p, fty->members[i]);
+      }
+      if (fty->vararg)
+         fputs(fty->num_members ? ", ..." : "...", fp);
+      fputc(')', fp);
+      if (f->unnamed_addr)
+         fprintf(fp, " %s", f->unnamed_addr == 1 ? "unnamed_addr" : "local_unnamed_addr");
+      if (f->align)
+         fprintf(fp, " align %u", f->align);
+      fputs("\n\n", fp);
+      return;
+   }
+
+   p->slots = _mesa_pointer_hash_table_create(NULL);
+   unsigned slot = 0;
+   for (unsigned i = 0; i < f->num_args; i++)
+      if (!f->args[i].name)
+         _mesa_hash_table_insert(p->slots, &f->args[i], (void *)(uintptr_t)(++slot));
+   for (unsigned b = 0; b < f->num_blocks; b++) {
+      const struct air_block *blk = &f->blocks[b];
+      if (!blk->name)
+         _mesa_hash_table_insert(p->slots, blk, (void *)(uintptr_t)(++slot));
+      for (unsigned i = 0; i < blk->num_insts; i++) {
+         const struct air_inst *in = blk->insts[i];
+         if (in->base.type && in->base.type->kind != AIR_TYPE_VOID && !in->base.name)
+            _mesa_hash_table_insert(p->slots, in, (void *)(uintptr_t)(++slot));
+      }
+   }
+
+   fprintf(fp, "define %s", linkage_name(f->linkage));
+   if (cc_name(f->cc))
+      fputs(cc_name(f->cc), fp);
+   else
+      fprintf(fp, "cc%u ", f->cc);
+   print_type(p, fty->elem);
+   fputc(' ', fp);
+   print_name(p, '@', f->base.name);
+   fputc('(', fp);
+   for (unsigned i = 0; i < f->num_args; i++) {
+      if (i)
+         fputs(", ", fp);
+      print_typed(p, &f->args[i]);
+   }
+   fputc(')', fp);
+   /* after the argument list, where the syntax puts it */
+   if (f->unnamed_addr)
+      fprintf(fp, " %s", f->unnamed_addr == 1 ? "unnamed_addr" : "local_unnamed_addr");
+   if (f->align)
+      fprintf(fp, " align %u", f->align);
+   if (f->section) {
+      fputs(" section \"", fp);
+      print_escaped(p, f->section, strlen(f->section));
+      fputc('"', fp);
+   }
+   fputs(" {\n", fp);
+   for (unsigned b = 0; b < f->num_blocks; b++) {
+      const struct air_block *blk = &f->blocks[b];
+      if (b > 0 || blk->name) {
+         if (b > 0)
+            fputc('\n', fp);
+         if (blk->name) {
+            /* a label is a name without its sigil */
+            print_name(p, '%', blk->name);
+            fputs(":\n", fp);
+         } else {
+            struct hash_entry *e = _mesa_hash_table_search(p->slots, blk);
+            fprintf(fp, "%u:\n", (unsigned)((uintptr_t)e->data - 1));
+         }
+      }
+      for (unsigned i = 0; i < blk->num_insts; i++)
+         print_inst(p, blk->insts[i]);
+   }
+   fputs("}\n\n", fp);
+   _mesa_hash_table_destroy(p->slots, NULL);
+   p->slots = NULL;
+}
+
+void
+air_module_print(const struct air_module *m, FILE *fp)
+{
+   struct printer p = {
+      .m = m,
+      .fp = fp,
+      .md_numbers = _mesa_pointer_hash_table_create(NULL),
+   };
+
+   if (m->source_filename) {
+      fputs("source_filename = \"", fp);
+      print_escaped(&p, m->source_filename, strlen(m->source_filename));
+      fputs("\"\n", fp);
+   }
+   if (m->datalayout)
+      fprintf(fp, "target datalayout = \"%s\"\n", m->datalayout);
+   if (m->triple)
+      fprintf(fp, "target triple = \"%s\"\n", m->triple);
+   fputc('\n', fp);
+
+   for (unsigned i = 0; i < m->num_types; i++) {
+      const struct air_type *t = &m->types[i];
+      if (t->kind != AIR_TYPE_STRUCT || !t->name)
+         continue;
+      print_name(&p, '%', t->name);
+      fputs(" = type ", fp);
+      if (t->opaque) {
+         fputs("opaque\n", fp);
+         continue;
+      }
+      struct air_type anon = *t;
+      anon.name = NULL;
+      print_type(&p, &anon);
+      fputc('\n', fp);
+   }
+   fputc('\n', fp);
+
+   /* metadata numbers: the module's first, then what instructions attach */
+   for (unsigned i = 0; i < m->num_named_md; i++)
+      for (unsigned k = 0; k < m->named_md[i].num_ops; k++)
+         number_md(&p, m->named_md[i].ops[k]);
+   for (unsigned i = 0; i < m->num_md; i++)
+      number_md(&p, m->md[i]);
+   for (unsigned f = 0; f < m->num_functions; f++) {
+      const struct air_function *fn = m->functions[f];
+      for (unsigned b = 0; b < fn->num_blocks; b++)
+         for (unsigned i = 0; i < fn->blocks[b].num_insts; i++) {
+            const struct air_inst *in = fn->blocks[b].insts[i];
+            for (unsigned a = 0; a < in->num_attachments; a++)
+               number_md(&p, in->attachments[a].md);
+         }
+   }
+
+   for (unsigned i = 0; i < m->num_globals; i++) {
+      const struct air_global *g = m->globals[i];
+      print_name(&p, '@', g->base.name);
+      fputs(" = ", fp);
+      if (!g->init && (g->linkage == 0 || g->linkage == 5 || g->linkage == 6 || g->linkage == 15))
+         fputs("external ", fp);
+      else
+         fputs(linkage_name(g->linkage), fp);
+      fputs(unnamed_addr_name(g->unnamed_addr), fp);
+      if (g->addrspace)
+         fprintf(fp, "addrspace(%u) ", g->addrspace);
+      if (g->externally_initialized)
+         fputs("externally_initialized ", fp);
+      fputs(g->is_const ? "constant " : "global ", fp);
+      print_type(&p, g->value_type);
+      if (g->init) {
+         fputc(' ', fp);
+         print_value(&p, g->init);
+      }
+      if (g->section) {
+         fputs(", section \"", fp);
+         print_escaped(&p, g->section, strlen(g->section));
+         fputc('"', fp);
+      }
+      if (g->align)
+         fprintf(fp, ", align %u", g->align);
+      fputc('\n', fp);
+   }
+   fputc('\n', fp);
+
+   for (unsigned i = 0; i < m->num_functions; i++)
+      print_function(&p, m->functions[i]);
+
+   for (unsigned i = 0; i < m->num_named_md; i++) {
+      const struct air_named_md *n = &m->named_md[i];
+      print_name(&p, '!', n->name);
+      fputs(" = !{", fp);
+      for (unsigned k = 0; k < n->num_ops; k++) {
+         if (k)
+            fputs(", ", fp);
+         print_md_ref(&p, n->ops[k]);
+      }
+      fputs("}\n", fp);
+   }
+   fputc('\n', fp);
+   for (unsigned i = 0; i < p.num_md_numbers; i++) {
+      fprintf(fp, "!%u = ", i);
+      print_md_node(&p, p.md_order[i]);
+      fputc('\n', fp);
+   }
+
+   _mesa_hash_table_destroy(p.md_numbers, NULL);
+   ralloc_free(p.md_order);
+}
diff --git a/src/compiler/air/air_private.h b/src/compiler/air/air_private.h
new file mode 100644
index 0000000..1ebb930
--- /dev/null
+++ b/src/compiler/air/air_private.h
@@ -0,0 +1,316 @@
+/*
+ * Copyright © 2026 Darwin on redwood contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Shared between air_to_nir.c and air_intrinsics.c. */
+
+#ifndef AIR_PRIVATE_H
+#define AIR_PRIVATE_H
+
+#include "air_module.h"
+#include "nir_air.h"
+
+#include "nir.h"
+#include "nir_builder.h"
+
+/* Where a pointer points. AIR's address spaces say which kind of memory;
+ * which buffer, and the byte offset into it, the translator tracks itself
+ * (docs/air.md section 3): no pointer in the corpus is ever stored to
+ * memory or cast to an integer, so a pointer never has to become a number.
+ */
+enum air_ptr_class {
+   AIR_PTR_NONE,
+   AIR_PTR_UBO,           /* a constant buffer: .binding is its index */
+   AIR_PTR_SSBO,          /* a device buffer */
+   AIR_PTR_SHARED,        /* threadgroup memory */
+   AIR_PTR_SCRATCH,       /* an alloca, or a program-scope variable */
+   AIR_PTR_CONSTANT_DATA, /* a constant global: nir->constant_data */
+   AIR_PTR_FUNCTION_CONSTANT, /* a function constant: .binding is its index */
+   AIR_PTR_TEXTURE,       /* a texture handle; offset unused */
+   AIR_PTR_SAMPLER,       /* a sampler handle */
+
+   /* An ARGUMENT BUFFER (`air.indirect_buffer`): .binding is the set's number
+    * in air_ctx.argbufs and .offset the byte offset into it. Nothing is ever
+    * loaded from such a pointer as a value -- a load through it RESOLVES to
+    * the member that byte offset names (argbuf_load), which is the whole of
+    * why argument buffers need no addresses here.
+    */
+   AIR_PTR_ARGBUF,
+
+   /* A LOCAL, OR A READ-ONLY GLOBAL, THAT HOLDS A POINTER -- kept as a
+    * translation-time slot and not as memory, because a pointer in this
+    * frontend is a resolution and has no bytes to put anywhere. .binding is
+    * the slot's number in air_ctx.slots, and a slot holds a whole air_val, so
+    * what comes back out of one may itself be a texture or a sampler.
+    *
+    * Only a whole load or store at offset 0 reaches a slot. That is not a
+    * simplification: the two shapes this exists for are `alloca ptr
+    * addrspace(2)` followed by a store of a sampler argument, and
+    * `constant %"struct.metal::sampler" { ptr addrspace(2) @__air_sampler_state }`
+    * read through a getelementptr whose every index is zero -- and offset 0 of
+    * a struct is offset 0 of its first member, transitively, which is the only
+    * byte arithmetic a tree of values can answer. Anything else is refused by
+    * name rather than resolved to whichever member the offset happened to land
+    * on (air_to_nir.c, slot_at_zero).
+    */
+   AIR_PTR_SLOT,
+};
+
+struct air_ptr {
+   enum air_ptr_class class;
+   unsigned binding;
+   bool is_image;                    /* a texture the shader writes: an image, not a view */
+   nir_def *offset;                  /* bytes, 32-bit; NULL means zero */
+   const struct air_type *pointee;   /* for sizes, and for loads without a type */
+};
+
+enum air_val_kind {
+   AIR_VAL_NONE,
+   AIR_VAL_SSA,   /* a scalar or vector */
+   AIR_VAL_AGG,   /* a struct or array, as a tree of values */
+   AIR_VAL_PTR,
+
+   /* A POINTER as a value rather than a resolution. air_ptr is *(where, byte
+    * offset)* decided while translating, which is what lets this frontend emit
+    * load_ubo at Metal's own index with no descriptor indirection; a pointer
+    * CHOSEN at run time has no such resolution, so the choice itself is kept
+    * and made where the pointer is used. A pointer STORED to memory is the
+    * other half of the same problem and has no form here at all -- see
+    * docs/air.md section 3 for what that costs.
+    */
+
+   /* `select i1 %c, ptr %a, ptr %b`: .def is the condition and .elems[0..1]
+    * are the two pointers. A LOAD through it loads BOTH and selects the
+    * values, which is the only form NIR has; that is why it leaves a note.
+    */
+   AIR_VAL_PTR_SELECT,
+};
+
+struct air_val {
+   enum air_val_kind kind;
+   nir_def *def;
+   struct air_ptr ptr;
+   unsigned num_elems;
+   struct air_val **elems;
+};
+
+/* One member of an argument buffer, as `air.struct_type_info` declares it and
+ * the module's own struct type confirms it.
+ *
+ * Keyed on `offset` and not on the member number, which is what makes the
+ * three shapes SPIRV-Cross emits one case: a buffer member is the pointer
+ * itself, while a texture or sampler member is a one-field
+ * `metal::texture2d` / `metal::sampler` wrapper whose field sits at byte 0 of
+ * it -- so the extra `getelementptr` into the wrapper adds nothing to the
+ * offset and resolves by the same lookup (docs/air.md section 8.2).
+ */
+struct air_argbuf_member {
+   uint64_t offset;        /* bytes from the start of the set: the KEY */
+   enum air_resource_kind kind;
+   unsigned metal_id;      /* the member's own air.location_index: Metal's [[id(n)]] */
+   unsigned index;         /* the flat per-kind index this frontend allocated */
+
+   /* A buffer member: 1 device, 2 constant. The metadata does not say -- not
+    * one of the 82 048 members of Resident Evil 4's 7 857 argument buffers
+    * carries `air.address_space` -- so this comes from the module's own struct
+    * type, and every load through the member checks the pointer it loads
+    * against it (argbuf_load). 0 for a texture or a sampler.
+    */
+   unsigned addrspace;
+   bool read, write;
+   const char *name, *type_name;
+   const struct air_md *node;   /* the member's own air.indirect_argument descriptor */
+};
+
+struct air_argbuf {
+   unsigned metal_index;   /* the SET's own Metal [[buffer(n)]] */
+   unsigned size;          /* air.buffer_size: eight bytes per member */
+   unsigned param;         /* the entry point's parameter the set arrives as */
+   const char *name, *type_name;
+   unsigned num_members;
+   struct air_argbuf_member *members;
+};
+
+struct air_ctx {
+   void *mem_ctx;
+   const struct air_module *m;
+   const struct air_function *fn;
+   nir_shader *nir;
+   nir_builder b;
+
+   const struct air_to_nir_options *options;
+   struct air_shader_info *info;
+
+   /* translated values, keyed on const struct air_value * */
+   struct hash_table *values;
+   /* air_block * -> nir_block * */
+   struct hash_table *blocks;
+   /* a cursor in each block, before its terminator, where phi stores go */
+   struct hash_table *phi_cursors;
+   /* phi -> nir register decl */
+   struct hash_table *phi_regs;
+   /* Where this function's constants are built: the top of its entry block,
+    * which dominates every use of them. air_get caches a constant the first
+    * time it is asked for, so the def has to be somewhere every later block
+    * can see; built at the cursor of the first use, a constant shared by a
+    * branch and the block after it is a non-dominating use, and nir_repair_ssa
+    * turns that into undef on the path that misses the branch.
+    */
+   nir_cursor const_cursor;
+   /* set while a constant is being built there, so that the elements of an
+    * aggregate constant -- which come through air_get too -- keep appending
+    * after it instead of each restoring the cursor to where the aggregate
+    * itself will go, which put a vec before the components it reads */
+   bool in_const;
+
+   /* A call of another function in the module becomes a nir_call, and
+    * nir_inline_functions folds it in afterwards. These two carry the state
+    * that needs: the functions already translated, so a callee shared by two
+    * call sites is translated once, and -- while a callee is being
+    * translated -- the deref its `ret` has to store through, since a NIR call
+    * returns nothing and the convention is an out-parameter at index 0.
+    * ret_deref is NULL while the entry point is being translated, which is how
+    * emit_return tells the two apart.
+    */
+   struct hash_table *fns;
+   nir_deref_instr *ret_deref;
+
+   /* ... and, for a callee whose return type is a STRUCT, one out-parameter per
+    * member instead of one for the whole value: a NIR function parameter
+    * carries a number, and a struct is a tree of values in this translator and
+    * never a NIR value at all. ret_fields is indexed by the AIR member number
+    * and is NULL for a member that is not a number -- the `[8 x i8]` tail
+    * padding that Metal's own vertex-output structs carry, which takes no
+    * parameter because nothing may read or write it. num_ret_fields is
+    * non-zero only while such a callee is being translated, and that is how
+    * emit_return tells this case from the scalar one.
+    */
+   nir_deref_instr **ret_fields;
+   unsigned num_ret_fields;
+
+   /* What each module global resolves to, decided once (plan_globals) and
+    * turned into a value in whichever function needs it (materialise_globals).
+    * The two are separate because the deciding half has side effects that must
+    * happen once -- it appends inline samplers to info->resources and lays out
+    * shared and scratch memory -- while the making half emits an nir_def for
+    * the byte offset, and a def belongs to the impl that created it. Copying
+    * the entry point's values into a callee instead left the callee using the
+    * caller's defs, which is a cross-function def/use: nir_repair_ssa then
+    * asks the wrong function for its dominance metadata and asserts.
+    */
+   struct air_global_plan {
+      enum air_ptr_class class;
+      unsigned binding;
+      unsigned offset;      /* bytes, when has_offset */
+      bool has_offset;
+      bool skip;            /* llvm.* lists, and anything that failed */
+
+      /* A PROGRAM-SCOPE VARIABLE THAT IS A VALUE, not memory. Set by
+       * plan_global_folding for a scalar integer global that the module only
+       * ever loads and stores WHOLE, whose single store is in its
+       * air.static_init constructor, and whose address never escapes. `known`
+       * and `bits` are then filled when that store is translated and the value
+       * turns out to be a constant -- which it is when it came from a function
+       * constant -- and every later load answers with the constant instead of
+       * a load_scratch. The scratch slot is still allocated and still written:
+       * the fold is an answer on top of memory that is there, not a promise
+       * that nothing reads it (air_to_nir.c, AIR_OP_LOAD).
+       */
+      bool fold;
+      bool known;
+      uint64_t bits;
+      unsigned bit_size;
+   } *global_plan;
+
+   /* The translation-time slots: locals and read-only globals that hold a
+    * POINTER. Grown as allocas are met; the read-only globals reserve theirs
+    * in plan_globals, before any body is translated, and materialise_globals
+    * fills each one from the global's initialiser in whatever builder is
+    * asking -- the same rule the offsets follow, and for the same reason.
+    */
+   struct air_slot {
+      struct air_val *val;
+      const struct air_type *type;      /* what a whole load of it yields */
+      const struct air_value *init;     /* a read-only global's initialiser, or NULL */
+   } *slots;
+   unsigned num_slots;
+
+   /* The reserved texture slot the null texture lives in, or -1 before anything
+    * has asked for one. Allocated once per shader and shared by every
+    * air.get_null_texture_* call in it, because a module with fifteen of them
+    * (fixed_frag_lph_cph) wants one zero texture and not fifteen.
+    */
+   int null_texture_index;
+
+   /* what the entry point's parameters are */
+   unsigned num_params;
+   struct air_val **params;
+
+   /* the argument buffers the entry point declares, in the order its input
+    * metadata lists them, which is the order their members are numbered in */
+   unsigned num_argbufs;
+   struct air_argbuf *argbufs;
+
+   /* outputs, in the order of the returned struct's fields */
+   unsigned num_outputs;
+   struct {
+      unsigned location;      /* gl_varying_slot or gl_frag_result */
+      unsigned index;         /* dual-source index */
+      nir_variable *var;
+   } *outputs;
+
+   unsigned scratch_size;
+   unsigned shared_size;
+   unsigned tg_param_plus1;   /* the [[threadgroup(0)]] argument's parameter + 1; 0 none */
+
+   /* module-scope variables, by their air_global */
+   struct hash_table *globals;
+
+   char error[256];
+};
+
+bool air_error(struct air_ctx *c, const char *fmt, ...) PRINTFLIKE(2, 3);
+
+/* value bookkeeping */
+struct air_val *air_val_ssa(struct air_ctx *c, nir_def *def);
+struct air_val *air_val_ptr(struct air_ctx *c, struct air_ptr ptr);
+struct air_val *air_get(struct air_ctx *c, const struct air_value *v);
+void air_set(struct air_ctx *c, const struct air_value *v, struct air_val *val);
+
+/* an SSA value, with aggregates and pointers refused */
+nir_def *air_get_ssa(struct air_ctx *c, const struct air_value *v);
+
+/* the NIR type of an AIR type: bit size and components */
+unsigned air_nir_bit_size(struct air_ctx *c, const struct air_type *t);
+unsigned air_nir_components(const struct air_type *t);
+
+/* Records that the shader was translated with a caveat: what it asked for and
+ * what was done instead (air_shader_info.notes). Not an error -- translation
+ * continues -- and not a warning about our own code: it is for a thing the
+ * hardware or this frontend cannot do exactly, where doing something else is
+ * still correct. Refusing is air_error; passing over it in silence is the one
+ * option this is here to remove.
+ */
+void air_note(struct air_ctx *c, const char *fmt, ...) PRINTFLIKE(2, 3);
+
+/* memory, by the pointer's class */
+/* The reserved texture slot a null texture lives in, allocated on the first
+ * air.get_null_texture_* of a shader and shared by the rest of them. Negative
+ * when it does not fit, with the reason already in c->error. Across the file
+ * boundary because the interface half decides it and the INTRINSIC half asks
+ * (air_intrinsics.c).
+ */
+int air_null_texture_slot(struct air_ctx *c);
+
+nir_def *air_load_ptr(struct air_ctx *c, struct air_ptr ptr, const struct air_type *type,
+                      unsigned align);
+bool air_store_ptr(struct air_ctx *c, struct air_ptr ptr, nir_def *value, unsigned align);
+struct air_ptr air_ptr_add(struct air_ctx *c, struct air_ptr ptr, nir_def *bytes);
+
+/* air.* and llvm.* calls; the result is set on the instruction by the callee */
+bool air_translate_call(struct air_ctx *c, const struct air_inst *in, const char *name);
+/* a call of a function defined in this module, folded in by nir_inline_functions */
+bool air_call_in_module(struct air_ctx *c, const struct air_inst *in, const char *name);
+
+#endif /* AIR_PRIVATE_H */
diff --git a/src/compiler/air/air_run.c b/src/compiler/air/air_run.c
new file mode 100644
index 0000000..46af530
--- /dev/null
+++ b/src/compiler/air/air_run.c
@@ -0,0 +1,2685 @@
+/*
+ * Copyright © 2026 Darwin on redwood contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * air_run: draw with a Metal shader and read the pixels back.
+ *
+ * This is the half of M1 that compiling cannot give. The shader comes out of a
+ * .metallib, through air_to_nir, into a Gallium pipe_shader_state as
+ * PIPE_SHADER_IR_NIR -- which both drivers of interest accept natively: ir3
+ * is a NIR compiler, and softpipe takes NIR through nir_to_tgsi. One quad is
+ * drawn into a 32-bit-float render target and one pixel is printed, so the
+ * result is a number and not a picture.
+ *
+ * On this machine the screen is softpipe, so the whole path can be run with no
+ * GPU at all. On the phone the same source wants the freedreno screen that
+ * tools/mesa/freedreno-darwin.patch already creates inside the port's Mesa
+ * (osmesa_create_gpu_screen), and nothing else about it changes.
+ *
+ * usage: air_run FILE[.metallib] [FUNCTION]
+ *        air_run --library FILE.metallib FUNCTION      one air.visible function, wrapped
+ *        air_run --stitch "f(in0); g(n0)" FILE.metallib   a graph of them, stitched
+ */
+
+#include <stdio.h>
+#include <ctype.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "nir.h"
+#include "nir_builder.h"
+#include "nir_air.h"
+#include "air_module.h"
+
+#include "pipe/p_context.h"
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_shader_tokens.h"
+#include "pipe/p_state.h"
+#include "target-helpers/inline_sw_helper.h"
+#include "null/null_sw_winsys.h"
+#ifdef GALLIUM_FREEDRENO
+#include "freedreno/drm/freedreno_drm_public.h"
+#include "util/driconf.h"
+#include "util/xmlconfig.h"
+#include <xf86drm.h>
+#endif
+#include "util/format/u_format.h"
+#include "util/half_float.h"
+#include "util/u_inlines.h"
+#include "util/u_sampler.h"
+#include "util/u_debug.h"
+#include "util/u_memory.h"
+
+#ifdef __APPLE__
+#include <mach-o/dyld.h>
+#include <signal.h>
+/* <sys/ucontext.h>, not <ucontext.h>: the latter refuses to be included
+ * without _XOPEN_SOURCE on the iOS SDK, and userland/src/inject.c takes the
+ * same route for the same reason.
+ */
+#include <sys/ucontext.h>
+#endif
+
+#define WIDTH 4
+#define HEIGHT 4
+
+/* The texture bound for every sampled texture the shader declares: four by
+ * four, 32-bit floats, each texel a number that says which texel it is. The
+ * sampler is nearest with no mip filter and clamped addressing, and the
+ * coordinate the vertex shader hands over is the centre of texel (1, 1), so
+ * a correct sample is an exact equality and not a tolerance -- no filtering
+ * weights, no wrap arithmetic, nothing to round.
+ *
+ * This verifies the texture operations whose sampler the API chooses (nine
+ * modules of the corpus) and those that take no sampler at all (twenty-nine,
+ * which fetch by integer coordinate). It cannot verify the two whose sampler
+ * the shader declares itself: that needs Metal's 64-bit sampler word decoded,
+ * which it is not.
+ */
+#define TEX_SIZE 4
+#define TEX_X 1
+#define TEX_Y 1
+
+/* Slot is in the value on purpose. Binding one texture to every slot makes a
+ * shader that reads the wrong slot return the right texel, which is a test
+ * passing for the wrong reason -- the third time that shape of mistake has
+ * turned up here, after the 2D texture bound for a 3D sampler and the colour
+ * attachment nothing stored to. Looked for deliberately this time rather than
+ * tripped over: slot n adds a thousand times n, so a misbinding is visible.
+ */
+static void
+texel_value(unsigned slot, unsigned x, unsigned y, unsigned z, float out[4])
+{
+   out[0] = 100.0f + x + 1000.0f * slot;
+   out[1] = 200.0f + y;
+   out[2] = 300.0f + x + y + z;
+   out[3] = 400.0f;
+}
+
+#ifdef __APPLE__
+/*
+ * A program that dies on this port leaves nothing behind: the kernel says
+ * "Failed to send exception EXC_CORPSE_NOTIFY" and that is the end of it. So
+ * print the fault before dying. These two functions are userland/src/inject.c's
+ * say_the_fault()/watch_for_faults() (branch sileo2, 6683521), with the slide
+ * taken from this program's own image rather than from the shared cache, since
+ * the pc of interest is in air_run or in libOSMesa and not in iOS.
+ */
+static void
+say_the_fault(int signal_number, siginfo_t *info, void *context_in)
+{
+   ucontext_t *context = context_in;
+   uintptr_t slide = (uintptr_t)_dyld_get_image_vmaddr_slide(0);
+   uintptr_t pc = 0, lr = 0, fp = 0;
+
+   if (context != NULL && context->uc_mcontext != NULL) {
+      pc = (uintptr_t)context->uc_mcontext->__ss.__pc;
+      lr = (uintptr_t)context->uc_mcontext->__ss.__lr;
+      fp = (uintptr_t)context->uc_mcontext->__ss.__fp;
+   }
+   /* who called, by the frame pointers: on arm64 each frame holds the previous
+    * at [fp] and its return address at [fp + 8]
+    */
+   char frames[8 * 20 + 1] = "";
+   size_t used = 0;
+   for (unsigned i = 0; i < 8 && fp != 0 && (fp & 7) == 0; i++) {
+      uintptr_t next = ((uintptr_t *)fp)[0], ret = ((uintptr_t *)fp)[1];
+      if (ret == 0)
+         break;
+      used += (size_t)snprintf(frames + used, sizeof(frames) - used, " %#lx", ret - slide);
+      fp = next > fp ? next : 0;   /* the chain only ever goes up the stack */
+   }
+   fprintf(stderr, "air_run: signal %d at %p, pc %#lx, lr %#lx, called from%s (unslid)\n",
+           signal_number, info != NULL ? info->si_addr : NULL, pc - slide, lr - slide,
+           frames);
+   fflush(stderr);
+   signal(signal_number, SIG_DFL);
+   raise(signal_number);
+}
+
+static void
+watch_for_faults(void)
+{
+   struct sigaction action;
+
+   memset(&action, 0, sizeof(action));
+   action.sa_sigaction = say_the_fault;
+   action.sa_flags = SA_SIGINFO | SA_RESETHAND;
+   sigaction(SIGSEGV, &action, NULL);
+   sigaction(SIGBUS, &action, NULL);
+}
+#else
+static void watch_for_faults(void) {}
+#endif
+
+/* set by --library: the fill below is then floats, for the reason given there */
+static bool library_fill = false;
+
+/* set by --stitch: a function-stitching graph, as air_stitch.c reads it */
+static const char *stitch_text = NULL;
+
+/* set by --zero: every buffer the shader reads is zeroed instead of patterned.
+ *
+ * For the 14 kernels whose loops leave on a count or a sentinel read out of a
+ * buffer, the pattern is not an input at all -- the loop never ends and the GPU
+ * runs forever (docs/air.md section 5, tools/air/kstruct.py). Zeros are a
+ * degenerate input but a *defined* one: a count of zero means the loop runs no
+ * times, so the kernel reaches its end and the hardware answers. What that
+ * proves is that the translated shader runs on the Adreno without hanging; it
+ * proves nothing about what the kernel computes, and the harness says so rather
+ * than printing the zeros as a result.
+ */
+static bool zero_fill = false;
+
+/* set by --ones: every byte is 0xff.
+ *
+ * The other half of the same idea. A loop that counts up to a value from a
+ * buffer ends at once when that value is zero; a loop that walks until it meets
+ * a sentinel -- MetalFaceMask's span tables leave on -1 -- never meets it in a
+ * buffer of zeros, and ends at once in a buffer of 0xff. Neither fill is an
+ * input the kernel was written for, and between them they let most of these
+ * kernels reach their end instead of running forever. Which of the two a kernel
+ * terminates under is itself a fact about its shape.
+ */
+static bool ones_fill = false;
+
+/* The argument buffer of a wrapped library function holds floats, not the byte
+ * pattern.
+ *
+ * Every one of these functions is compiled with no-nans-fp-math and
+ * no-infs-fp-math: the module promises its inputs are finite. Arbitrary bytes
+ * are mostly not -- they are infinities, NaNs and denormals -- so the inputs
+ * would land outside the contract the shader was compiled under, where
+ * 0 * inf may legally be either NaN or inf and a disagreement means nothing.
+ * One case did disagree exactly there (folded NaN, softpipe +inf) and said
+ * nothing about either side.
+ *
+ * Word w is ((w * 13) % 29 - 14) / 4: finite, exactly representable in
+ * binary32, and different for 29 words running -- so a harness that mixed up
+ * two slots, or two lanes of one slot, would get a different answer. cpuref.py
+ * fills the same words.
+ */
+static uint8_t
+library_byte(unsigned i)
+{
+   float f = (float)((int)((i / 4 * 13) % 29) - 14) / 4.0f;
+   uint32_t u;
+   memcpy(&u, &f, sizeof(u));
+   return (u >> (8 * (i % 4))) & 0xff;
+}
+
+/* the pattern cpuref.py and air2nir --eval fill their buffers with, so that
+ * all three agree on what the shader was given
+ */
+static uint8_t
+pattern_byte(unsigned i)
+{
+   if (zero_fill)
+      return 0;
+   if (ones_fill)
+      return 0xff;
+   return library_fill ? library_byte(i) : (i * 7 + 13) & 0xff;
+}
+
+/* --buffer N@OFF=HEX puts those bytes into buffer N at that offset, over
+ * whatever fill the rest of it keeps.
+ *
+ * It exists because the kernels that never finish do not need a whole buffer
+ * chosen for them: they need a span table in one slot and a row index in
+ * another, and the value their exit test compares against is a field or two
+ * (tools/air/kinput.py works out which, and prints these arguments). A file is
+ * one fill for every buffer, so it cannot say "this slot and not that one".
+ * Offsets are decimal so that a job line stays readable; init.c splits a line
+ * on blanks and knows no variables, so each kernel has to be one line.
+ */
+struct buffer_patch {
+   unsigned index;
+   unsigned off;
+   unsigned len;
+   uint8_t *bytes;
+};
+static struct buffer_patch patches[64];
+static unsigned num_patches;
+
+/* Parses "N@OFF=HEX". Returns false when the argument is not that shape, so
+ * that --buffer keeps meaning a file name and a typo is not read as one.
+ */
+static bool
+add_buffer_patch(const char *spec)
+{
+   char *end;
+   unsigned long index = strtoul(spec, &end, 10);
+   if (end == spec || *end != '@')
+      return false;
+   const char *p = end + 1;
+   unsigned long off = strtoul(p, &end, 10);
+   if (end == p || *end != '=')
+      return false;
+
+   const char *hex = end + 1;
+   size_t n = strlen(hex);
+   if (!n || n % 2)
+      return false;
+   for (size_t i = 0; i < n; i++)
+      if (!isxdigit((unsigned char)hex[i]))
+         return false;
+
+   if (num_patches == ARRAY_SIZE(patches)) {
+      fprintf(stderr, "air_run: more than %zu --buffer patches\n", ARRAY_SIZE(patches));
+      exit(2);
+   }
+   struct buffer_patch *q = &patches[num_patches++];
+   q->index = index;
+   q->off = off;
+   q->len = n / 2;
+   q->bytes = malloc(q->len);
+   for (unsigned i = 0; i < q->len; i++) {
+      char byte[3] = { hex[2 * i], hex[2 * i + 1], 0 };
+      q->bytes[i] = strtoul(byte, NULL, 16);
+   }
+   return true;
+}
+
+/* Writes the patches for one buffer and returns how many bytes they wrote.
+ *
+ * A patch that does not fit is refused out loud rather than clipped: these
+ * bytes are what makes a loop end, and a kernel that silently did not get its
+ * sentinel hangs the GPU, which the next boot pays for.
+ */
+static unsigned
+apply_buffer_patches(unsigned index, uint8_t *bits, unsigned bytes)
+{
+   unsigned written = 0;
+   for (unsigned i = 0; i < num_patches; i++) {
+      const struct buffer_patch *q = &patches[i];
+      if (q->index != index)
+         continue;
+      if (q->off + q->len > bytes) {
+         printf("air_run: --buffer %u@%u= is %u bytes past the end of this %u-byte "
+                "buffer and was NOT written\n", q->index, q->off,
+                q->off + q->len - bytes, bytes);
+         continue;
+      }
+      memcpy(bits + q->off, q->bytes, q->len);
+      written += q->len;
+   }
+   return written;
+}
+
+/* Fill a buffer the shader is about to read.
+ *
+ * AIR_RUN_BUFFER=FILE puts that file's bytes there instead of the pattern,
+ * which is what lets a test choose the arguments an operation is called on.
+ * The reason it has to be a buffer and not a constant in the shader: ir3
+ * folds, so a shader that computes air.fast_round(0.5) from an immediate is
+ * answered by the compiler and the Adreno never runs the instruction -- the
+ * test would pass without the hardware having been asked. A value loaded from
+ * a buffer cannot be folded, and the harness knows what it put there.
+ *
+ * Returns how many bytes came from the file, so the caller can say so rather
+ * than claim a fill it did not do. A file shorter than the buffer leaves the
+ * rest as the pattern.
+ */
+static unsigned
+fill_buffer(unsigned index, uint8_t *bits, unsigned bytes)
+{
+   for (unsigned k = 0; k < bytes; k++)
+      bits[k] = pattern_byte(k);
+
+   unsigned patched = apply_buffer_patches(index, bits, bytes);
+   if (patched)
+      printf("air_run: buffer at index %u, %u of its %u bytes from --buffer %u@...\n",
+             index, patched, bytes, index);
+
+   const char *path = getenv("AIR_RUN_BUFFER");
+   if (!path || !*path)
+      return 0;
+
+   FILE *f = fopen(path, "rb");
+   if (!f) {
+      fprintf(stderr, "air_run: AIR_RUN_BUFFER=%s: %s\n", path, strerror(errno));
+      return 0;
+   }
+   size_t got = fread(bits, 1, bytes, f);
+   fclose(f);
+   /* the file is the coarser statement -- one fill for every buffer -- so the
+    * per-slot patches go on top of it and not under it
+    */
+   apply_buffer_patches(index, bits, bytes);
+   return got;
+}
+
+/* A vertex shader for the quad: it takes the position as attribute 0 and
+ * passes it through. Written here rather than translated, because what is
+ * under test is the fragment shader; when the .metallib has a vertex shader of
+ * its own that is a separate run.
+ */
+static nir_shader *
+quad_vertex_shader(const nir_shader_compiler_options *options, unsigned num_varyings)
+{
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_VERTEX, options, "quad");
+   nir_variable *in = nir_variable_create(b.shader, nir_var_shader_in,
+                                          glsl_vec4_type(), "pos_in");
+   in->data.location = VERT_ATTRIB_GENERIC0;
+   in->data.driver_location = 0;
+   nir_variable *out = nir_variable_create(b.shader, nir_var_shader_out,
+                                           glsl_vec4_type(), "pos_out");
+   out->data.location = VARYING_SLOT_POS;
+   out->data.driver_location = 0;
+   nir_store_var(&b, out, nir_load_var(&b, in), 0xf);
+
+   /* One constant coordinate per varying the fragment shader reads: the
+    * centre of texel (TEX_X, TEX_Y), so every fragment samples the same
+    * texel and the expected value is a single known one.
+    */
+   float c = (TEX_X + 0.5f) / TEX_SIZE;
+   float d = (TEX_Y + 0.5f) / TEX_SIZE;
+   for (unsigned i = 0; i < num_varyings; i++) {
+      nir_variable *v = nir_variable_create(b.shader, nir_var_shader_out,
+                                            glsl_vec4_type(), "varying");
+      v->data.location = VARYING_SLOT_VAR0 + i;
+      v->data.driver_location = 1 + i;
+      v->data.interpolation = INTERP_MODE_SMOOTH;
+      nir_store_var(&b, v, nir_imm_vec4(&b, c, d, c, 1.0f), 0xf);
+   }
+   b.shader->num_inputs = 1;
+   b.shader->num_outputs = 1 + num_varyings;
+   return b.shader;
+}
+
+/* What a Gallium driver expects of a shader it is handed: NIR's own system
+ * values lowered to the hardware's, and I/O as intrinsics rather than
+ * variables. The same three passes are in tools/mesa/air-ir3.patch; when a
+ * fourth place needs them they should become one function of the frontend.
+ */
+static int
+type_size_vec4(const struct glsl_type *type, bool bindless)
+{
+   return glsl_count_attribute_slots(type, false);
+}
+
+static void
+finalize_for_gallium(nir_shader *nir, struct pipe_screen *screen)
+{
+   /* Does this screen's own backend lower I/O from the variables? softpipe's
+    * does -- its shader state is built by nir_to_tgsi, which calls nir_lower_io
+    * with this very mask and this very flag -- and ir3's does not.
+    *
+    * Gated on the screen's NAME, as the scratch block at the end of this
+    * function is and for the same reason: there is no pipe cap that says "this
+    * driver lowers I/O itself". PIPE_SHADER_CAP_SUPPORTED_IRS cannot stand in
+    * for one, because freedreno advertises TGSI too (through tgsi_to_nir, which
+    * is the other direction), and get_compiler_options returns a
+    * nir_shader_compiler_options with no field for it. So the name is what
+    * there is, and naming it is honest where inferring it from a cap that means
+    * something else would not be.
+    */
+   const bool backend_lowers_io =
+      screen->get_name && !strcmp(screen->get_name(screen), "softpipe");
+
+   /* A fragment shader's [[position]]: the frontend hands it over as a system-value
+    * variable, because that is the one form both of these drivers can be served from
+    * (the long version is beside air.position in air_to_nir.c). freedreno sets
+    * pipe_caps.fs_position_is_sysval and wants the intrinsic; softpipe does not set it
+    * and reads (0,0,0,0) from the intrinsic, because nothing fills TGSI's system values
+    * for a fragment shader. For such a screen the variable becomes an input varying
+    * here -- and then needs a driver_location, which nothing else would give it.
+    */
+   if (nir->info.stage == MESA_SHADER_FRAGMENT && !screen->caps.fs_position_is_sysval) {
+      static const struct nir_lower_sysvals_to_varyings_options pos_opts = {
+         .frag_coord = true,
+      };
+      if (nir_lower_sysvals_to_varyings(nir, &pos_opts)) {
+         nir_foreach_shader_in_variable(var, nir)
+            if (var->data.location == VARYING_SLOT_POS)
+               var->data.driver_location = nir->num_inputs++;
+      }
+   }
+   NIR_PASS(_, nir, nir_lower_system_values);
+   /* An options struct of all-false and not NULL, which are not the same thing
+    * here and the difference is a trap. nir_lower_system_values *introduces*
+    * load_base_workgroup_id when it lowers SYSTEM_VALUE_WORKGROUP_ID, and the
+    * only thing that removes it again is
+    *
+    *     if (options && !options->has_base_workgroup_id)
+    *        return nir_imm_zero(...);
+    *
+    * so NULL reads as "the driver has base workgroup ids" -- the opposite of
+    * what a harness wants -- and the intrinsic survives into the backend. With
+    * softpipe that is an assertion in nir_to_tgsi rather than a message, and it
+    * stopped every kernel that asks for its workgroup id. Zero is also the
+    * right answer here: this dispatches one workgroup from the origin.
+    */
+   static const nir_lower_compute_system_values_options cs_options = { 0 };
+   NIR_PASS(_, nir, nir_lower_compute_system_values, &cs_options);
+   /*
+    * nir_lower_io_use_interpolated_input_intrinsics, and WITHOUT it every varying
+    * was FLAT on the Adreno while softpipe interpolated it. Mesa's own comment on the
+    * flag says exactly why: without it nir_lower_io "generates regular load_input
+    * intrinsics and interpolation information must be inferred from the list of input
+    * nir_variables" -- and the two consumers infer it from different places.
+    * nir_to_tgsi declares each FS input from its variable's data.interpolation (SMOOTH,
+    * as the frontend sets it), so softpipe was right by accident; ir3's setup_input
+    * does `so->inputs[n].flat = !coord` and only builds `coord` for
+    * load_interpolated_input, so a plain load_input is flat, full stop.
+    *
+    * What that cost: the one draw in this project whose varying actually varies --
+    * Apple's texturedVertex2D handing a texcoord to texturedFragment2D* -- read the
+    * provoking vertex's texcoord at every fragment on the phone, and the picture looked
+    * VERTICALLY FLIPPED for three boots (docs/metal.md 10.26, 10.32). It is not flipped.
+    * The quad's pixel (0,0) sits in the triangle whose last vertex carries uv (0,1), so
+    * flat shading hands it texel (0,3) -- `100 203 303 400`, bit for bit the number the
+    * device printed, and reproduced here on softpipe by forcing INTERP_MODE_FLAT.
+    *
+    * Why nothing caught it: the 255 fragment shaders compared pixel by pixel are drawn
+    * over the generated vertex stage, which gives every vertex the SAME texcoord -- flat
+    * and smooth are identical over a constant. And ir3_compiler, the tool the corpus's
+    * "compiles through ir3" column comes from, passes this flag already
+    * (tools/mesa/air-ir3.patch): the tool was lowering correctly while the two harnesses
+    * that actually draw were not.
+    *
+    * ... and it is skipped entirely for a backend that lowers I/O itself, which
+    * is what made this harness unable to draw a fragment shader that reads a
+    * varying. nir_to_tgsi lowers I/O a SECOND time, from the variables, with
+    * the same mask, the same flag and a type_size that is type_size_vec4 word
+    * for word -- and it opens with
+    * nir_remove_dead_variables(nir_var_shader_in). Lowering here first leaves a
+    * shader whose inputs are intrinsics and whose input variables are held up
+    * by nothing but the orphaned deref_var instructions nir_lower_io does not
+    * delete; the scratch block below then runs nir_opt_dce, those go, ntt
+    * deletes the variables, and ntt_setup_inputs sizes input_index_map by the
+    * driver_locations of the variables that are left -- none. The
+    * load_interpolated_input this pass already emitted then swizzles a
+    * TGSI_FILE_NULL register and tgsi_ureg asserts, before any format, texture
+    * or sampler is reached.
+    *
+    * That abort was read as softpipe's limit in two places (pixfmtcheck's 30
+    * SAMPLED cases, metalcheck's draw sweep) and it is this file's. Counted:
+    * 134 of the corpus's 400 fragment entry points have an input variable on
+    * this screen -- 125 read a [[stage_in]] varying and nine read only
+    * [[position]], which the block above turns into one -- and 87 of them are
+    * QuartzCore's, the library every pixel of the screen is drawn with. Two of
+    * the 134 drew before this and both drew the WRONG pixel: the register
+    * ntt swizzled was whatever the heap held under a zero-length
+    * input_index_map, so the abort was the loud outcome and not the only one.
+    * air_metal.c runs the same passes without the dce and draws those shaders
+    * through the same softpipe, which is what said the limit was not softpipe's.
+    *
+    * Not lowering is preferred over keeping the derefs alive past the dce
+    * because it leaves ONE lowering of I/O in the pipeline instead of one and a
+    * half: ntt also runs nir_lower_indirect_derefs(nir_var_shader_in) before it
+    * lowers, which is a no-op on a shader whose derefs are already gone and is
+    * there because ureg splits input declarations to elements.
+    */
+   if (!backend_lowers_io)
+      NIR_PASS(_, nir, nir_lower_io, nir_var_shader_in | nir_var_shader_out,
+               type_size_vec4, nir_lower_io_use_interpolated_input_intrinsics);
+
+   /* SCRATCH, for a screen that has none.
+    *
+    * An `alloca` becomes load_scratch and store_scratch, which ir3 compiles
+    * and nir_to_tgsi has no case for at all: softpipe printed
+    * "Unknown intrinsic: @store_scratch" and then asserted inside ureg_swizzle
+    * on the undefined register it had made nothing for.
+    *
+    * WHAT IT ACTUALLY UNLOCKS, measured and not assumed: tools/air/callptr.ll,
+    * which is the whole reason it is here -- a shader with an alloca in it and
+    * nothing else nir_to_tgsi lacks, so LLVM on this machine and this draw can
+    * be compared and they agree on all four lanes. It does NOT make Apple's own
+    * RenderBox modules draw here: all fourteen of the ones that hand a shape
+    * function a `ptr` still refuse on softpipe, now for a reason that has
+    * nothing to do with scratch (`u2u32` from 16 bits asserts `src_64` in
+    * ntt_emit_alu, and these shaders are full of halves). The scratch is off
+    * the list of reasons; the list is not empty.
+    *
+    * nir_lower_scratch_to_var puts the whole scratch space back into one local
+    * variable, which nir_lower_vars_to_ssa then turns into ordinary values.
+    * That is sound exactly where this harness runs it: one invocation per
+    * fragment, no addresses taken across a call (nir_inline_functions has
+    * already folded every callee in), and nothing else reading the space.
+    *
+    * Gated on the screen by NAME and not run unconditionally, because the
+    * point of this harness is to put the SAME NIR through two drivers: doing
+    * it for ir3 as well would mean the Adreno column measured a shader with
+    * the scratch lowered away, which is not the shader the phone runs. There
+    * is no pipe cap that says "this driver has no scratch", so the name is
+    * what there is, and it is named here rather than guessed at from a cap
+    * that means something else.
+    *
+    * The nir_opt_dce at the end of this block is the pass that used to orphan
+    * every [[stage_in]] variable, and it is kept: with I/O left unlowered above
+    * for exactly the screens this block runs on, a load_deref still references
+    * each one, so there is nothing dead to remove. That is a coupling between
+    * two gates that test the same screen for different reasons, and the thing
+    * that would notice it coming apart is a test rather than a comment --
+    * tools/air/pixfmtcheck.py's last case draws one of Apple's varying-reading
+    * shaders and fails if the abort comes back.
+    */
+   if (screen->get_name && !strcmp(screen->get_name(screen), "softpipe")) {
+      NIR_PASS(_, nir, nir_lower_scratch_to_var);
+      NIR_PASS(_, nir, nir_split_var_copies);
+      NIR_PASS(_, nir, nir_lower_var_copies);
+      NIR_PASS(_, nir, nir_lower_vars_to_ssa);
+      NIR_PASS(_, nir, nir_opt_dce);
+   }
+}
+
+/* -- compute ---------------------------------------------------------------
+ *
+ * A kernel writes through pointers instead of returning anything, so what is
+ * read back is a device buffer. Two rules decide whether that readback is
+ * evidence, and both come from the same mistake made three times with
+ * textures: a test can pass for the wrong reason, and the way to stop it is
+ * to make every input distinguishable so any confusion gives a wrong number
+ * rather than the right one.
+ *
+ *   - the grid is more than one thread, and every element of the output is
+ *     printed, not just the first. With one thread, or one element looked at,
+ *     a wrong workgroup index or a wrong global id reads correct.
+ *   - the input buffers vary with position (the same (i * 7 + 13) & 0xff
+ *     pattern), so a thread reading the wrong offset produces a wrong value
+ *     and not a plausible one.
+ *
+ * A kernel of Apple's that uses atomics and produces sensible numbers here is
+ * evidence that it ran and no evidence about atomicity: a sum written by
+ * threads that never raced looks exactly like a sum written by threads that
+ * did. The kernel that can tell them apart is written for the purpose rather
+ * than Apple's -- tools/air/atomiccheck.py, which makes each thread report the
+ * value its own fetch_add returned, so the sixteen of them must be 0..15 with
+ * nothing repeated whatever order the threads ran in. Even that is only
+ * evidence of atomicity where the threads really do run at once, which here
+ * they need not.
+ */
+#define GRID 4
+
+/* The threadgroup this harness dispatches. 4x4x1 by default, because a grid with more than
+ * one thread in two dimensions is what makes a wrong index show, and --block X,Y,Z because
+ * some kernels are written for a particular one and say so in their own code: both fbs_pcg_*
+ * kernels end with `if (tid == 0)` summing 128 entries of a threadgroup array, which is a
+ * 128x1x1 reduction. Under 4x4x1 four threads have tid == 0 -- Metal's scalar
+ * thread_position_in_threadgroup is the x component, not the flattened index -- so four of
+ * them run the whole reduction over the four entries this shape writes, and the word they
+ * add up is a property of the dispatch rather than of the kernel (docs/air.md section 5).
+ */
+static unsigned block[3] = { GRID, GRID, 1 };
+
+#define MAX_IMG 16
+
+/* The shape of each image a kernel touches, read off the intrinsics the
+ * frontend emitted rather than off the Metal type name.
+ *
+ * air.read_texture_* and air.write_texture_* become nir_image_load and
+ * nir_image_store (air_intrinsics.c), not texture instructions, so they want
+ * PIPE_BIND_SHADER_IMAGE and set_shader_images and not a sampler view -- which
+ * is why the draw path's texture code cannot simply be reused here.
+ *
+ * Per binding and not one format for the kernel: BlitLumaKernel_Unorm reads a
+ * uint image and writes a half one, so a single format would be right for one
+ * of its two images and quietly wrong for the other. The binding is src[0] and
+ * the frontend always emits it as an immediate, so it can be read here.
+ */
+static void
+image_shapes(nir_shader *cs, enum pipe_format fmt[MAX_IMG], bool isf[MAX_IMG],
+             enum glsl_sampler_dim dim[MAX_IMG], bool seen[MAX_IMG], unsigned *num)
+{
+   nir_foreach_function_impl(impl, cs) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+            nir_alu_type t;
+            if (in->intrinsic == nir_intrinsic_image_load)
+               t = nir_intrinsic_dest_type(in);
+            else if (in->intrinsic == nir_intrinsic_image_store)
+               t = nir_intrinsic_src_type(in);
+            else
+               continue;
+            if (!nir_src_is_const(in->src[0]))
+               continue;   /* a computed binding; refused by the caller's count */
+            unsigned b = nir_src_as_uint(in->src[0]);
+            if (b >= MAX_IMG || seen[b])
+               continue;
+            /* The WIDTH as well as the base type.
+             *
+             * A 32-bit format for a 16-bit store is not a conversion, it is a
+             * descriptor that disagrees with the instruction: ir3 emits
+             * `stib.b.typed.2d.u16.4` from air.write_texture_2d.v4f16 and the
+             * image it is given says 32 bits per component. MetalFaceMask_DrawSpans
+             * is that case -- it declares texture2d<half, write> -- and it is the
+             * kernel whose dispatch took a whole boot with it in
+             * logs/070755-run.log, printing its bindings and then nothing at all.
+             * 22 kernels of the corpus emit a narrow typed image store, so this is
+             * not one shader's accident. GL has no 16-bit image store, which is why
+             * neither Mesa nor this harness had met it; the draw path already picks
+             * the narrow format when a fragment shader returns halves.
+             */
+            unsigned bits = nir_alu_type_get_type_size(t);
+
+            switch (nir_alu_type_get_base_type(t)) {
+            case nir_type_int:
+               fmt[b] = bits == 16 ? PIPE_FORMAT_R16G16B16A16_SINT
+                      : bits == 8  ? PIPE_FORMAT_R8G8B8A8_SINT
+                                   : PIPE_FORMAT_R32G32B32A32_SINT;
+               isf[b] = false;
+               break;
+            case nir_type_uint:
+               fmt[b] = bits == 16 ? PIPE_FORMAT_R16G16B16A16_UINT
+                      : bits == 8  ? PIPE_FORMAT_R8G8B8A8_UINT
+                                   : PIPE_FORMAT_R32G32B32A32_UINT;
+               isf[b] = false;
+               break;
+            default:
+               fmt[b] = bits == 16 ? PIPE_FORMAT_R16G16B16A16_FLOAT
+                                   : PIPE_FORMAT_R32G32B32A32_FLOAT;
+               isf[b] = true;
+               break;
+            }
+            dim[b] = nir_intrinsic_image_dim(in);
+            seen[b] = true;
+            *num = MAX2(*num, b + 1);
+         }
+      }
+   }
+}
+
+/* The same, for the read-only textures a kernel fetches from. A texture is an
+ * AIR_RESOURCE_IMAGE only when it is written (air_to_nir.c): a read-only one
+ * stays a texture and Metal's read() on it becomes a txf, a texture fetch, so
+ * it needs a sampler view even inside a compute shader. BlitKernel_Unorm has
+ * one of each -- a txf from its source and an image_store to its destination --
+ * and binding only the image left the fetch reading nothing.
+ */
+static void
+texture_shapes(nir_shader *cs, enum pipe_format fmt[MAX_IMG], bool isf[MAX_IMG],
+               enum glsl_sampler_dim dim[MAX_IMG], bool seen[MAX_IMG], unsigned *num)
+{
+   nir_foreach_function_impl(impl, cs) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_tex)
+               continue;
+            nir_tex_instr *t = nir_instr_as_tex(instr);
+            unsigned b = t->texture_index;
+            if (b >= MAX_IMG || seen[b])
+               continue;
+            switch (nir_alu_type_get_base_type(t->dest_type)) {
+            case nir_type_int:
+               fmt[b] = PIPE_FORMAT_R32G32B32A32_SINT; isf[b] = false; break;
+            case nir_type_uint:
+               fmt[b] = PIPE_FORMAT_R32G32B32A32_UINT; isf[b] = false; break;
+            default:
+               fmt[b] = PIPE_FORMAT_R32G32B32A32_FLOAT; isf[b] = true; break;
+            }
+            dim[b] = t->sampler_dim;
+            seen[b] = true;
+            *num = MAX2(*num, b + 1);
+         }
+      }
+   }
+}
+
+/* Wait for the work to finish, and say so when it does not.
+ *
+ * This matters more than it looks. On 20 October a dispatch hung the GPU --
+ * our own driver said "gpu: no answer: submission 2 is the last, the core has
+ * done 1" -- and every dispatch for the rest of that boot was accepted,
+ * returned, and did nothing. air_run did not wait on a fence, so it printed
+ * the buffer it had filled itself as though the GPU had answered: a page of
+ * numbers that were a statement about the harness and not about the shader.
+ * 21 of the 47 kernels of one run were vacuous that way before anyone noticed
+ * (docs/air.md section 5).
+ *
+ * The hang itself turned out to be this harness too: the kernels that did it
+ * loop until a buffer value they were never given, and the fill is a byte
+ * pattern. So the message below leads with that rather than with the GPU.
+ *
+ * So the fence is waited on with a timeout, and a timeout is reported as
+ * loudly as a crash. A dispatch nobody waited for is not a measurement.
+ */
+static bool
+finish_or_say_why(struct pipe_screen *screen, struct pipe_context *pipe, const char *what)
+{
+   struct pipe_fence_handle *fence = NULL;
+   pipe->flush(pipe, &fence, 0);
+   if (!fence) {
+      printf("air_run: the driver gave no fence for the %s, so nothing here waited for "
+             "the GPU and the numbers below may be the fill\n", what);
+      return true;
+   }
+   bool done = screen->fence_finish(screen, NULL, fence, 2000000000ull); /* 2 s */
+   screen->fence_reference(screen, &fence, NULL);
+   if (!done)
+      printf("air_run: THE GPU DID NOT FINISH the %s within two seconds. Everything below is "
+             "what this harness wrote, not what the shader computed. The likeliest reason is "
+             "this harness: a kernel whose buffers carry counts, indices or sentinels is being "
+             "given (i * 7 + 13) & 0xff, and a loop that leaves on a value it was never given "
+             "does not leave at all -- both kernels measured this way turned out to be exactly "
+             "that (docs/air.md section 5). And one timeout wedges this GPU for the rest of the "
+             "boot, so every later run in it is vacuous too.\n", what);
+   return done;
+}
+
+/* What a shader's own sampler says, in one line. Printed rather than assumed:
+ * the ten modules of the corpus that carry one have no reference to be checked
+ * against, so the only thing a reader can verify is that the harness bound
+ * what the word says.
+ */
+static void
+print_own_sampler(unsigned slot, const struct air_sampler_state *a, bool compares)
+{
+   static const char *const addr[] = { "clamp_to_zero", "clamp_to_edge", "repeat",
+                                       "mirrored_repeat", "clamp_to_border" };
+   static const char *const filt[] = { "nearest", "linear", "bicubic" };
+   static const char *const mip[] = { "none", "nearest", "linear" };
+   /* Metal's compare_func, in its own order: `none` at 0 and `never` at 8, which is
+    * the value Apple's default carries (docs/air.md 3.3).
+    */
+   static const char *const cmp[] = { "none", "less", "less_equal", "greater",
+                                      "greater_equal", "equal", "not_equal", "always",
+                                      "never" };
+   printf("air_run: sampler %u is the shader's own: %s/%s filtering, mip %s, %s "
+          "addressing, %s coordinates, compare_func::%s%s\n", slot,
+          filt[a->mag_filter % ARRAY_SIZE(filt)], filt[a->min_filter % ARRAY_SIZE(filt)],
+          mip[a->mip_filter % ARRAY_SIZE(mip)],
+          addr[a->address[0] % ARRAY_SIZE(addr)],
+          a->pixel_coord ? "pixel" : "normalized",
+          a->compare_func < ARRAY_SIZE(cmp) ? cmp[a->compare_func] : "?",
+          compares ? " APPLIED (a shadow sample reads this slot)"
+                   : " not read (nothing samples this slot with a comparison)");
+}
+
+/*
+ * THE PACKED 16-BIT PROBE: one known word, both directions, on whatever screen this is.
+ *
+ * air_metal.c has to decide which pipe_format each of Metal's four packed 16-bit names
+ * means, and that decision has two halves. Which Metal name goes with which Gallium name
+ * is Apple's convention and only Apple's own compositor can settle it. Where the fields
+ * of a given GALLIUM name actually land is a fact about the driver and the hardware, and
+ * that is what this measures -- on the Adreno, which is the only place it matters and
+ * the one place `air_metal_test --pixel-formats` cannot run, because that program is not
+ * on the device and air_run is.
+ *
+ * TWO FLAGS AND NOT ONE, because a round trip measures nothing. Sampling a packed
+ * texture and rendering into a packed target of the same format is unpack then pack with
+ * the same layout, which is the identity whatever that layout is: it would catch a read
+ * path disagreeing with a write path and could never catch both being wrong together.
+ * So the two directions are separate runs with a known value at the end that is NOT
+ * packed:
+ *
+ *   --packed16 FORMAT 0xWORD   every texel of the bound texture is that 16-bit word,
+ *                              with one field set; the target is the ordinary float one,
+ *                              so the four numbers printed say which CHANNEL the field
+ *                              became. The SAMPLED direction.
+ *   --packed16-rt FORMAT       the colour target is that packed format and the shader
+ *                              supplies the colour, so the word printed says which FIELD
+ *                              each channel became. The WRITTEN direction, and it wants
+ *                              a module whose output is a constant -- four floats could
+ *                              not show it, because they would have come back out
+ *                              through the same unpacking the write used.
+ *
+ * FORMAT is one of the eight Gallium names the two readings of Metal's four can mean. A
+ * name and not a number, so the job line says which layout it is asking about and a
+ * reader needs nothing else.
+ */
+static const struct { const char *name; enum pipe_format fmt; } packed16_names[] = {
+   { "R5G6B5_UNORM",   PIPE_FORMAT_R5G6B5_UNORM },
+   { "B5G6R5_UNORM",   PIPE_FORMAT_B5G6R5_UNORM },
+   { "A1R5G5B5_UNORM", PIPE_FORMAT_A1R5G5B5_UNORM },
+   { "A1B5G5R5_UNORM", PIPE_FORMAT_A1B5G5R5_UNORM },
+   { "R5G5B5A1_UNORM", PIPE_FORMAT_R5G5B5A1_UNORM },
+   { "B5G5R5A1_UNORM", PIPE_FORMAT_B5G5R5A1_UNORM },
+   { "A4R4G4B4_UNORM", PIPE_FORMAT_A4R4G4B4_UNORM },
+   { "A4B4G4R4_UNORM", PIPE_FORMAT_A4B4G4R4_UNORM },
+   /* the control, and the census is why it is here: the window server makes a
+    * BGRA8 texture of exactly the shape it makes the packed one
+    */
+   { "B8G8R8A8_UNORM", PIPE_FORMAT_B8G8R8A8_UNORM },
+};
+static enum pipe_format packed16_fmt = PIPE_FORMAT_NONE;   /* the sampled texture */
+static enum pipe_format packed16_rt = PIPE_FORMAT_NONE;    /* ... or the colour target */
+static enum pipe_format miplevel_fmt = PIPE_FORMAT_NONE;   /* ... or a mip pyramid */
+/*
+ * --clear: what a framebuffer fetch will read, PER RENDER TARGET.
+ *
+ * Softpipe's TGSI interpreter has no FBFETCH at all, so the only driver here that
+ * can answer a fetch is the one on the phone -- and there, a fetch in a single
+ * draw reads what the clear put down. Chosen numbers turn that into a
+ * measurement: a shader that hands the fetch back must return the clear, and
+ * zero is then distinguishable from a fetch that read nothing.
+ *
+ * Per target and not one colour for all of them, because the question that
+ * matters is WHICH ATTACHMENT was read. The window server's own passes carry two
+ * colour attachments and mask one of them off entirely; a fetch that read the
+ * other one would be invisible if both held the same numbers.
+ */
+#define MAX_CLEARS 8
+static bool halftex;
+static union pipe_color_union clear_colour[MAX_CLEARS];
+static unsigned clear_count;
+static bool clear_given;
+static const char *packed16_name;
+static unsigned packed16_word;
+
+/*
+ * THE MIP PYRAMID, at the shape the window server actually asks for.
+ *
+ * The texture census of a whole boot (userland/src/redwoodmetal.m's texture line)
+ * found exactly ONE packed texture in the entire system: MTLPixelFormatBGR5A1Unorm,
+ * 2D, shaderRead|renderTarget, TEN MIP LEVELS, 776x24. Nothing else packed is ever
+ * created -- not formats 40, 41 or 42, and SpringBoard asks for none at all. So a
+ * probe on a single-level 4x4 texture is a probe of something the system does not
+ * have, and a mip chain is where a two-byte format differs most from the
+ * four-byte one everything else uses.
+ *
+ * AND THE SAME CENSUS CARRIES ITS OWN CONTROL: a format 80 (BGRA8Unorm) texture of
+ * the IDENTICAL shape -- type 2, usage 0x5, mips 10, 776x24. One logical object in
+ * two formats. Run through this probe, BGRA8 is the line that says whether a
+ * 776x24 pyramid works at all on this GPU, so a failure confined to the packed
+ * formats cannot be blamed on the shape, the usage, the level count or the
+ * harness.
+ *
+ * THE LEVEL IS IN THE VALUE, which is this harness's rule everywhere else: level L
+ * is filled with a texel whose four channels are the binary code of L + 1, each
+ * channel either all-ones or all-zeros. Three things follow. A sample that read
+ * the wrong level names the level it actually read, rather than merely
+ * disagreeing. Every expectation is exactly 0.0 or exactly 1.0 whatever the field
+ * widths are -- a 5-bit field at 9/31 would not be, and an expectation needing a
+ * tolerance cannot tell a near miss from a hit. And L + 1 RATHER THAN L, so that
+ * no level's code is zero: with L the first level would read 0 0 0 0, which is
+ * also what an unwritten level and an untouched allocation read, and the one
+ * outcome this is built to catch would have been indistinguishable from the
+ * healthy one.
+ */
+/*
+ * --halftex: a 256x1 RGBA16Float lookup table, written as RAW HALF BIT PATTERNS.
+ *
+ * CoreAnimation's gradient shader -- axial_shading_frag_lpf, 47 NIR instructions
+ * and one air.sample_texture_2d -- does nothing but sample a table of this exact
+ * shape and write the result, and the census found it: format 115, 2D, 256x1,
+ * shaderRead only, so the 256 entries are built on the CPU and uploaded. That
+ * upload path's half conversion has never been measured here.
+ *
+ * THE WORDS ARE CHOSEN AS INTEGERS AND WRITTEN AS INTEGERS, with no float-to-half
+ * conversion anywhere in this program, because a test that samples a table it
+ * also converted would pass with both halves wrong. The expectation is decoded
+ * from the same integers by a different implementation of binary16 on the host,
+ * so the two sides share nothing but the bit patterns.
+ *
+ * Texel i carries four patterns chosen to span what binary16 can be and nothing
+ * it cannot:
+ *
+ *   r  (i << 7) & 0x7bff   a NORMAL of rising exponent; masked so the exponent
+ *                          never reaches 31, which would be an infinity or a NaN
+ *   g  r | 0x8000          the same magnitude NEGATIVE, so a sign dropped shows
+ *   b  i                   a DENORMAL for every i, and exactly zero at i = 0
+ *   a  0x3c00              exactly 1.0, so one channel is a constant a wrong
+ *                          channel order cannot hide in
+ */
+#define HALFTEX_W 256
+
+static void
+halftex_texel(unsigned i, uint16_t out[4])
+{
+   out[0] = (uint16_t)((i << 7) & 0x7bff);
+   out[1] = (uint16_t)(out[0] | 0x8000);
+   out[2] = (uint16_t)i;
+   out[3] = 0x3c00;
+}
+
+#define MIPTEX_W 776
+#define MIPTEX_H 24
+#define MIPTEX_LEVELS 10
+
+static void
+miplevel_texel(unsigned level, float out[4])
+{
+   for (unsigned c = 0; c < 4; c++)
+      out[c] = ((level + 1) >> c) & 1 ? 1.0f : 0.0f;
+}
+
+static enum pipe_format
+packed16_by_name(const char *want, const char **name)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(packed16_names); i++)
+      if (!strcmp(want, packed16_names[i].name)) {
+         *name = packed16_names[i].name;
+         return packed16_names[i].fmt;
+      }
+   fprintf(stderr, "air_run: --packed16 wants one of these names:");
+   for (unsigned i = 0; i < ARRAY_SIZE(packed16_names); i++)
+      fprintf(stderr, " %s", packed16_names[i].name);
+   fprintf(stderr, "\n");
+   return PIPE_FORMAT_NONE;
+}
+
+/* The depth texel a shadow sample reads, which is the only pattern that fits.
+ *
+ * A depth format is normalised to [0, 1] and this harness's colour pattern starts at
+ * 100, so the two cannot be the same rule. (x + TEX_SIZE*y) / 16 gives sixteen
+ * distinct values over a 4x4 texture, every one exactly representable in binary32 and
+ * every one a different answer -- so a comparison that read the wrong texel answers
+ * differently, and a reference landing between two of them is exact on both sides.
+ * tools/air/sampcheck.py computes its expectations from this same expression.
+ */
+static float
+depth_texel_value(unsigned x, unsigned y)
+{
+   return (float)(x + TEX_SIZE * y) / 16.0f;
+}
+
+/* Which sampler slots a shadow texture instruction reads, out of the translated
+ * shader itself.
+ *
+ * Metal decides AT THE SAMPLE CALL that a comparison happens: sample() and
+ * sample_compare() are two instructions over one sampler, and the sampler word
+ * only says WHICH comparison. Gallium decides it in the sampler state, through
+ * pipe_sampler_state.compare_mode, and softpipe compares on every sample of a
+ * sampler that has it set (sp_tex_sample.c: `if (compare_mode != NONE)
+ * sample_compare(...)`). So switching it on for a slot a plain sample() reads
+ * would turn every texel into a 0 or a 1, and leaving it off for a slot a
+ * sample_compare() reads would return the texel instead of the comparison.
+ * Exactly these slots, and the shader is the only thing that knows which.
+ *
+ * On the Adreno the same two lines mean something slightly different and the
+ * answer is the same: a6xx has no compare-enable bit at all, only
+ * A6XX_TEX_SAMP_1_COMPARE_FUNC, which fd6_sampler_state_create writes only when
+ * compare_mode is set -- and the hardware reads it only for the shadow form of
+ * the sample instruction, which ir3 selects from nir_tex_instr::is_shadow
+ * (IR3_INSTR_S). So the field has to be programmed for these slots, and
+ * programming it for the others would be harmless there and wrong here.
+ */
+static void
+compare_sampled_slots(nir_shader *s, bool *slot, unsigned count)
+{
+   nir_foreach_function_impl(impl, s) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_tex)
+               continue;
+            nir_tex_instr *t = nir_instr_as_tex(instr);
+            if (t->is_shadow && t->sampler_index < count)
+               slot[t->sampler_index] = true;
+         }
+      }
+   }
+}
+
+/* A comparison through a sampler whose own word says `compare_func::none`,
+ * refused by name and in the same words air_metal.c's bind_stage refuses it.
+ *
+ * MTLCompareFunction has eight values and no "not configured", so `none` --
+ * value 0 of the shader word's nine -- has no API spelling and arrives at a
+ * driver as Never, which is MTLSamplerDescriptor's own default and is right for
+ * the plain sample that is all either can do. A COMPARISON is where the two
+ * part company: AGX keeps its NONE and its NEVER apart (AGXCompilerCore's
+ * _AGCCompareFunction), and what it does differently is not readable from here.
+ * Answering such a sample as `never` would be a harness quietly agreeing with
+ * itself where the library this is a reference for says no.
+ */
+static bool
+compare_without_a_function(const struct air_shader_info *info,
+                           const bool *compare_slot, unsigned count,
+                           const char *name)
+{
+   for (unsigned i = 0; i < info->num_resources; i++) {
+      const struct air_resource *r = &info->resources[i];
+      if (r->kind != AIR_RESOURCE_SAMPLER || !r->inline_sampler)
+         continue;
+      if (r->index >= count || !compare_slot[r->index])
+         continue;
+      if (r->sampler.compare_func != 0)
+         continue;
+      fprintf(stderr, "air_run: %s samples sampler %u with a comparison and its own "
+                      "word says compare_func::none, which is not one of "
+                      "MTLCompareFunction's eight: a sampler that was not made to "
+                      "compare\n", name, r->index);
+      return true;
+   }
+   return false;
+}
+
+/* The sampler state a shader declared for itself, as Gallium wants it.
+ *
+ * Metal's clamp_to_zero is a wrap mode and not a border colour: outside the
+ * texture it reads transparent black, in every channel including alpha, and
+ * the border colour is not configurable for it. Gallium has no such mode, so
+ * it becomes CLAMP_TO_BORDER with a zero border -- which is the same thing and
+ * is worth writing down, because the obvious reading of that enum value is
+ * clamp_to_border with a default border, and one of Apple's own binaries
+ * prints it that way (nir_air.h).
+ *
+ * Fields with no Gallium equivalent, or none this harness can honour, are left
+ * at the default and named by the caller rather than silently dropped:
+ * bicubic filtering and the reduction mode AGX itself does not read.
+ *
+ * The comparison function is honoured, and only for the slots a shadow
+ * instruction reads -- `compares`, from compare_sampled_slots above. Its own
+ * enumeration is not MTLCompareFunction's and not Gallium's: in the word 0 is
+ * `none` and `never` is 8, which is the value Apple's own default carries, so
+ * every `constexpr sampler` that names no compare_func arrives here with 8 and
+ * must mean no comparison rather than an unknown one.
+ */
+static struct pipe_sampler_state
+sampler_from_air(const struct air_sampler_state *a, bool compares)
+{
+   static const unsigned wrap[] = {
+      [AIR_SAMPLER_CLAMP_TO_ZERO] = PIPE_TEX_WRAP_CLAMP_TO_BORDER,
+      [AIR_SAMPLER_CLAMP_TO_EDGE] = PIPE_TEX_WRAP_CLAMP_TO_EDGE,
+      [AIR_SAMPLER_REPEAT] = PIPE_TEX_WRAP_REPEAT,
+      [AIR_SAMPLER_MIRRORED_REPEAT] = PIPE_TEX_WRAP_MIRROR_REPEAT,
+      [AIR_SAMPLER_CLAMP_TO_BORDER] = PIPE_TEX_WRAP_CLAMP_TO_BORDER,
+   };
+   static const unsigned filt[] = {
+      [AIR_SAMPLER_NEAREST] = PIPE_TEX_FILTER_NEAREST,
+      [AIR_SAMPLER_LINEAR] = PIPE_TEX_FILTER_LINEAR,
+      [AIR_SAMPLER_BICUBIC] = PIPE_TEX_FILTER_LINEAR,
+   };
+   static const unsigned mip[] = {
+      [AIR_SAMPLER_MIP_NONE] = PIPE_TEX_MIPFILTER_NONE,
+      [AIR_SAMPLER_MIP_NEAREST] = PIPE_TEX_MIPFILTER_NEAREST,
+      [AIR_SAMPLER_MIP_LINEAR] = PIPE_TEX_MIPFILTER_LINEAR,
+   };
+   struct pipe_sampler_state st = {
+      .wrap_s = wrap[a->address[0] % ARRAY_SIZE(wrap)],
+      .wrap_t = wrap[a->address[1] % ARRAY_SIZE(wrap)],
+      .wrap_r = wrap[a->address[2] % ARRAY_SIZE(wrap)],
+      .mag_img_filter = filt[a->mag_filter % ARRAY_SIZE(filt)],
+      .min_img_filter = filt[a->min_filter % ARRAY_SIZE(filt)],
+      .min_mip_filter = mip[a->mip_filter % ARRAY_SIZE(mip)],
+      .unnormalized_coords = a->pixel_coord,
+      .max_anisotropy = a->max_anisotropy > 1 ? a->max_anisotropy : 0,
+      .min_lod = _mesa_half_to_float(a->lod_min),
+      .max_lod = _mesa_half_to_float(a->lod_max),
+   };
+   /* The comparison, where the shader asked for one. The table is the one in
+    * air_metal.c's sampler_state_from_air -- MTLCompareFunction and
+    * PIPE_FUNC_x run in the same order, so one table serves both -- and it is
+    * written out here rather than cast because 2 `less_equal` would arrive as
+    * PIPE_FUNC_EQUAL and 3 `greater` as PIPE_FUNC_LEQUAL, which is the
+    * opposite comparison and still a picture.
+    */
+   if (compares) {
+      static const unsigned func[] = {
+         [0] = PIPE_FUNC_NEVER,     /* none: no MTLCompareFunction has a name for it */
+         [1] = PIPE_FUNC_LESS,      /* less */
+         [2] = PIPE_FUNC_LEQUAL,    /* less_equal */
+         [3] = PIPE_FUNC_GREATER,   /* greater */
+         [4] = PIPE_FUNC_GEQUAL,    /* greater_equal */
+         [5] = PIPE_FUNC_EQUAL,     /* equal */
+         [6] = PIPE_FUNC_NOTEQUAL,  /* not_equal */
+         [7] = PIPE_FUNC_ALWAYS,    /* always */
+         [8] = PIPE_FUNC_NEVER,     /* never */
+      };
+      st.compare_mode = PIPE_TEX_COMPARE_R_TO_TEXTURE;
+      st.compare_func = func[a->compare_func % ARRAY_SIZE(func)];
+   }
+
+   /* Metal's border_color: 0 transparent black, 1 opaque black, 2 opaque white.
+    * clamp_to_zero does not read it -- it is transparent black by definition.
+    */
+   if (a->address[0] == AIR_SAMPLER_CLAMP_TO_BORDER ||
+       a->address[1] == AIR_SAMPLER_CLAMP_TO_BORDER ||
+       a->address[2] == AIR_SAMPLER_CLAMP_TO_BORDER) {
+      float v = a->border_color == 2 ? 1.0f : 0.0f;
+      st.border_color.f[0] = st.border_color.f[1] = st.border_color.f[2] = v;
+      st.border_color.f[3] = a->border_color == 0 ? 0.0f : 1.0f;
+   }
+   return st;
+}
+
+/* The state for sampler slot `idx`: the shader's own if it declared one there,
+ * and this harness's nearest/clamp-to-edge otherwise -- which is what the API
+ * would have bound and what every measurement before inline samplers were
+ * decoded was made with.
+ */
+static struct pipe_sampler_state
+sampler_for_slot(const struct air_shader_info *info, unsigned idx, bool unnormalized,
+                 bool compares, const struct air_sampler_state **from_shader)
+{
+   for (unsigned i = 0; i < info->num_resources; i++) {
+      const struct air_resource *r = &info->resources[i];
+      if (r->kind == AIR_RESOURCE_SAMPLER && r->inline_sampler && r->index == idx) {
+         if (from_shader)
+            *from_shader = &r->sampler;
+         return sampler_from_air(&r->sampler, compares);
+      }
+   }
+   if (from_shader)
+      *from_shader = NULL;
+   /* The API's sampler, and a comparison only if the shader asked for one.
+    * MTLSamplerDescriptor's own compareFunction defaults to Never, so this is
+    * the API's default sampler said completely rather than left out.
+    */
+   return (struct pipe_sampler_state){
+      .wrap_s = PIPE_TEX_WRAP_CLAMP_TO_EDGE,
+      .wrap_t = PIPE_TEX_WRAP_CLAMP_TO_EDGE,
+      .wrap_r = PIPE_TEX_WRAP_CLAMP_TO_EDGE,
+      .min_img_filter = PIPE_TEX_FILTER_NEAREST,
+      .mag_img_filter = PIPE_TEX_FILTER_NEAREST,
+      .min_mip_filter = PIPE_TEX_MIPFILTER_NONE,
+      .unnormalized_coords = unnormalized,
+      .compare_mode = compares ? PIPE_TEX_COMPARE_R_TO_TEXTURE
+                               : PIPE_TEX_COMPARE_NONE,
+      .compare_func = PIPE_FUNC_NEVER,
+   };
+}
+
+static int
+dispatch_kernel(struct pipe_screen *screen, const struct air_shader_info *info,
+                nir_shader *cs, const char *name, const char *how)
+{
+   /* Metal's threadgroup size is a dispatch argument, not a shader constant,
+    * so the frontend leaves it variable (docs/air.md section 7.4) and whoever
+    * dispatches has to fix it. air_run is that whoever. It is not optional:
+    * softpipe reads the block size from TGSI_PROPERTY_CS_FIXED_BLOCK_*, and
+    * with a variable size those are zero, so it runs ZERO threads and the
+    * output buffer comes back exactly as it went in. That looked like a
+    * kernel that did nothing, and was only visible because the buffer was
+    * filled with a distinctive pattern -- had it been zeroed, a kernel named
+    * InitMinMax writing zeros would have been indistinguishable from this.
+    */
+   cs->info.workgroup_size[0] = block[0];
+   cs->info.workgroup_size[1] = block[1];
+   cs->info.workgroup_size[2] = block[2];
+   cs->info.workgroup_size_variable = false;
+
+   finalize_for_gallium(cs, screen);
+   struct pipe_context *pipe = screen->context_create(screen, NULL, 0);
+   if (!pipe) {
+      fprintf(stderr, "air_run: no context for a kernel\n");
+      return 1;
+   }
+   printf("air_run: %s on %s (%s), as a compute kernel\n", name,
+          screen->get_name(screen), how);
+
+   /* every buffer the kernel declares; the device ones are what it writes */
+   struct pipe_resource *bufs[32] = { 0 };
+   /* The bytes this harness wrote, kept until the readback. The dump used to
+    * recompute them from pattern_byte(), which --buffer N@OFF=HEX makes a lie:
+    * a patched word looked changed by the kernel. Keeping the fill is also the
+    * only way to say which words a kernel touched when it touches them past
+    * the sixteen the dump prints -- and that is exactly what a prediction out
+    * of tools/air/kinput.py has to be compared against.
+    */
+   uint8_t *before[32] = { 0 };
+   unsigned sizes[32] = { 0 };
+   bool writable[32] = { false };
+   bool img_read[MAX_IMG] = { false }, img_write[MAX_IMG] = { false };
+   unsigned num_img = 0;
+   bool tex_used[MAX_IMG] = { false };
+   unsigned num_tex = 0;
+   unsigned num_ssbo = 0, num_written = 0;
+   for (unsigned i = 0; i < info->num_resources; i++) {
+      const struct air_resource *r = &info->resources[i];
+      unsigned bytes = r->size ? r->size : 4096;
+      if (r->index >= ARRAY_SIZE(bufs))
+         continue;
+      uint8_t *bits = calloc(1, bytes);
+      bool kept = false;
+      unsigned from_file = fill_buffer(r->index, bits, bytes);
+      if (from_file)
+         printf("air_run: buffer at index %u, %u bytes, %u of them from "
+                "AIR_RUN_BUFFER\n", r->index, bytes, from_file);
+
+      if (r->kind == AIR_RESOURCE_CONSTANT_BUFFER) {
+         /* A transform matrix filled with the byte pattern sends every sample
+          * somewhere arbitrary, so what the shader computes says nothing about
+          * what it is for. The identity is the one distinguished value a matrix
+          * has, and the resource says it is one: air.arg_type_name is Apple's
+          * own ("float4x4"), carried through from the module's metadata. Any
+          * other constant buffer keeps the pattern -- this is the only place
+          * the harness pretends to know what a buffer means, and it says so.
+          */
+         if (r->type_name && !strncmp(r->type_name, "float4x4", 8) && bytes >= 64) {
+            float *m = (float *)bits;
+            memset(m, 0, 64);
+            m[0] = m[5] = m[10] = m[15] = 1.0f;
+            printf("air_run: constant buffer %u is a %s, so it holds the identity and "
+                   "not the fill\n", r->index, r->type_name);
+         }
+         struct pipe_resource *b = pipe_buffer_create(screen, PIPE_BIND_CONSTANT_BUFFER,
+                                                      PIPE_USAGE_DEFAULT, bytes);
+         pipe_buffer_write(pipe, b, 0, bytes, bits);
+         pipe->set_constant_buffer(pipe, PIPE_SHADER_COMPUTE, r->index, false,
+                                   &(struct pipe_constant_buffer){
+                                      .buffer = b, .buffer_size = bytes });
+      } else if (r->kind == AIR_RESOURCE_DEVICE_BUFFER) {
+         bufs[r->index] = pipe_buffer_create(screen, PIPE_BIND_SHADER_BUFFER,
+                                             PIPE_USAGE_STAGING, bytes);
+         pipe_buffer_write(pipe, bufs[r->index], 0, bytes, bits);
+         sizes[r->index] = bytes;
+         before[r->index] = bits;
+         kept = true;
+         writable[r->index] = r->write;
+         num_ssbo = MAX2(num_ssbo, r->index + 1);
+         num_written += r->write ? 1 : 0;
+      } else if (r->kind == AIR_RESOURCE_IMAGE) {
+         if (r->index >= MAX_IMG) {
+            free(bits);
+            fprintf(stderr, "air_run: %s binds an image at %u, past the %u this harness "
+                            "keeps room for\n", name, r->index, MAX_IMG);
+            return 1;
+         }
+         img_read[r->index] = r->read;
+         img_write[r->index] = r->write;
+         num_img = MAX2(num_img, r->index + 1);
+      } else if (r->kind == AIR_RESOURCE_TEXTURE) {
+         if (r->index >= MAX_IMG) {
+            free(bits);
+            fprintf(stderr, "air_run: %s binds a texture at %u, past the %u this harness "
+                            "keeps room for\n", name, r->index, MAX_IMG);
+            return 1;
+         }
+         tex_used[r->index] = true;
+         num_tex = MAX2(num_tex, r->index + 1);
+      }
+      if (!kept)
+         free(bits);
+   }
+   unsigned num_img_written = 0;
+   for (unsigned i = 0; i < num_img; i++)
+      num_img_written += img_write[i] ? 1 : 0;
+   if (!num_written && !num_img_written) {
+      fprintf(stderr, "air_run: %s writes no device buffer and no image, so a dispatch "
+                      "would leave nothing to read back\n", name);
+      return 1;
+   }
+
+   struct pipe_shader_buffer sb[32] = { 0 };
+   unsigned mask = 0;
+   for (unsigned i = 0; i < num_ssbo; i++) {
+      sb[i].buffer = bufs[i];
+      sb[i].buffer_size = sizes[i];
+      if (writable[i])
+         mask |= 1u << i;
+   }
+   pipe->set_shader_buffers(pipe, PIPE_SHADER_COMPUTE, 0, num_ssbo, sb, mask);
+
+   /* The images, one resource each, with the format the kernel's own intrinsics
+    * declare. A readable one is filled with the same texel pattern the draw
+    * path uses -- texel (x,y,z) of slot n is (100+x+1000n, 200+y, 300+x+y+z,
+    * 400) -- so that a kernel reading the wrong slot or the wrong texel cannot
+    * come back with the right answer. A write-only one is left as the pattern
+    * bytes so that a kernel which writes nothing is distinguishable from one
+    * that writes zeros.
+    */
+   enum pipe_format ifmt[MAX_IMG];
+   bool iisf[MAX_IMG];
+   enum glsl_sampler_dim idim[MAX_IMG];
+   bool iseen[MAX_IMG] = { false };
+   unsigned nshape = 0;
+   for (unsigned i = 0; i < MAX_IMG; i++) {
+      ifmt[i] = PIPE_FORMAT_R32G32B32A32_FLOAT;
+      iisf[i] = true;
+      idim[i] = GLSL_SAMPLER_DIM_2D;
+   }
+   image_shapes(cs, ifmt, iisf, idim, iseen, &nshape);
+   struct pipe_resource *imgs[MAX_IMG] = { 0 };
+   struct pipe_image_view ivs[MAX_IMG] = { 0 };
+   for (unsigned i = 0; i < num_img; i++) {
+      if (idim[i] != GLSL_SAMPLER_DIM_2D && idim[i] != GLSL_SAMPLER_DIM_3D) {
+         fprintf(stderr, "air_run: %s uses an image of a kind this harness does not bind "
+                         "(dim %u at %u)\n", name, idim[i], i);
+         return 1;
+      }
+      unsigned depth = idim[i] == GLSL_SAMPLER_DIM_3D ? TEX_SIZE : 1;
+      struct pipe_resource itempl = {
+         .target = idim[i] == GLSL_SAMPLER_DIM_3D ? PIPE_TEXTURE_3D : PIPE_TEXTURE_2D,
+         .format = ifmt[i],
+         .width0 = TEX_SIZE, .height0 = TEX_SIZE, .depth0 = depth, .array_size = 1,
+         .bind = PIPE_BIND_SHADER_IMAGE | PIPE_BIND_SAMPLER_VIEW,
+      };
+      imgs[i] = screen->resource_create(screen, &itempl);
+      if (!imgs[i]) {
+         fprintf(stderr, "air_run: the driver would not make image %u (%s)\n", i,
+                 util_format_short_name(ifmt[i]));
+         return 1;
+      }
+      float texels[TEX_SIZE * TEX_SIZE * TEX_SIZE * 4];
+      int32_t itexels[TEX_SIZE * TEX_SIZE * TEX_SIZE * 4];
+      for (unsigned z = 0; z < depth; z++)
+         for (unsigned y = 0; y < TEX_SIZE; y++)
+            for (unsigned x = 0; x < TEX_SIZE; x++) {
+               unsigned k = ((z * TEX_SIZE + y) * TEX_SIZE + x) * 4;
+               texel_value(i, x, y, z, &texels[k]);
+               for (unsigned c = 0; c < 4; c++)
+                  itexels[k + c] = (int32_t)texels[k + c];
+            }
+      struct pipe_box box = { .width = TEX_SIZE, .height = TEX_SIZE, .depth = depth };
+      pipe->texture_subdata(pipe, imgs[i], 0, PIPE_MAP_WRITE, &box,
+                            iisf[i] ? (const void *)texels : (const void *)itexels,
+                            TEX_SIZE * 4 * sizeof(float),
+                            TEX_SIZE * TEX_SIZE * 4 * sizeof(float));
+      ivs[i] = (struct pipe_image_view){
+         .resource = imgs[i],
+         .format = ifmt[i],
+         .access = (img_read[i] ? PIPE_IMAGE_ACCESS_READ : 0) |
+                   (img_write[i] ? PIPE_IMAGE_ACCESS_WRITE : 0),
+         .shader_access = (img_read[i] ? PIPE_IMAGE_ACCESS_READ : 0) |
+                          (img_write[i] ? PIPE_IMAGE_ACCESS_WRITE : 0),
+         .u.tex.level = 0, .u.tex.first_layer = 0,
+         .u.tex.last_layer = depth - 1,
+      };
+   }
+   if (num_img)
+      pipe->set_shader_images(pipe, PIPE_SHADER_COMPUTE, 0, num_img, 0, ivs);
+
+   /* and the read-only textures, as sampler views with the same texel pattern */
+   enum pipe_format tfmt[MAX_IMG];
+   bool tisf[MAX_IMG];
+   enum glsl_sampler_dim tdim[MAX_IMG];
+   bool tseen[MAX_IMG] = { false };
+   unsigned ntshape = 0;
+   for (unsigned i = 0; i < MAX_IMG; i++) {
+      tfmt[i] = PIPE_FORMAT_R32G32B32A32_FLOAT;
+      tisf[i] = true;
+      tdim[i] = GLSL_SAMPLER_DIM_2D;
+   }
+   texture_shapes(cs, tfmt, tisf, tdim, tseen, &ntshape);
+   struct pipe_resource *texes[MAX_IMG] = { 0 };
+   struct pipe_sampler_view *views[MAX_IMG] = { 0 };
+   void *csampler = NULL;
+   for (unsigned i = 0; i < num_tex; i++) {
+      if (!tex_used[i])
+         continue;
+      if (tdim[i] != GLSL_SAMPLER_DIM_2D && tdim[i] != GLSL_SAMPLER_DIM_3D) {
+         fprintf(stderr, "air_run: %s fetches a texture of a kind this harness does not "
+                         "bind (dim %u at %u)\n", name, tdim[i], i);
+         return 1;
+      }
+      unsigned depth = tdim[i] == GLSL_SAMPLER_DIM_3D ? TEX_SIZE : 1;
+      struct pipe_resource ttempl = {
+         .target = tdim[i] == GLSL_SAMPLER_DIM_3D ? PIPE_TEXTURE_3D : PIPE_TEXTURE_2D,
+         .format = tfmt[i],
+         .width0 = TEX_SIZE, .height0 = TEX_SIZE, .depth0 = depth, .array_size = 1,
+         .bind = PIPE_BIND_SAMPLER_VIEW,
+      };
+      texes[i] = screen->resource_create(screen, &ttempl);
+      if (!texes[i]) {
+         fprintf(stderr, "air_run: the driver would not make texture %u (%s)\n", i,
+                 util_format_short_name(tfmt[i]));
+         return 1;
+      }
+      float texels[TEX_SIZE * TEX_SIZE * TEX_SIZE * 4];
+      int32_t itexels[TEX_SIZE * TEX_SIZE * TEX_SIZE * 4];
+      for (unsigned z = 0; z < depth; z++)
+         for (unsigned y = 0; y < TEX_SIZE; y++)
+            for (unsigned x = 0; x < TEX_SIZE; x++) {
+               unsigned k = ((z * TEX_SIZE + y) * TEX_SIZE + x) * 4;
+               texel_value(i, x, y, z, &texels[k]);
+               for (unsigned c = 0; c < 4; c++)
+                  itexels[k + c] = (int32_t)texels[k + c];
+            }
+      struct pipe_box tbox = { .width = TEX_SIZE, .height = TEX_SIZE, .depth = depth };
+      pipe->texture_subdata(pipe, texes[i], 0, PIPE_MAP_WRITE, &tbox,
+                            tisf[i] ? (const void *)texels : (const void *)itexels,
+                            TEX_SIZE * 4 * sizeof(float),
+                            TEX_SIZE * TEX_SIZE * 4 * sizeof(float));
+      struct pipe_sampler_view vtempl = { 0 };
+      u_sampler_view_default_template(&vtempl, texes[i], texes[i]->format);
+      views[i] = pipe->create_sampler_view(pipe, texes[i], &vtempl);
+   }
+   if (num_tex) {
+      /* one entry per texture, not the address of one pointer. bind_sampler_states
+       * reads num_tex pointers from what it is given, so passing &csampler made
+       * the driver take whatever followed that single variable on the stack and
+       * store it as samplers[1..]; fd6_texture_state then dereferenced those for
+       * ->seqno and died at a wild address. It only showed with two or more
+       * textures, which is why 22 kernels bound images here without trouble and
+       * four did not. The draw path below always did this correctly.
+       *
+       * One state per slot, and not one shared: a slot's sampler is whatever
+       * that slot declares, and a shader may mix its own with the API's.
+       */
+      void *csamplers[MAX_IMG] = { 0 };
+      bool compare_slot[MAX_IMG] = { 0 };
+      compare_sampled_slots(cs, compare_slot, MAX_IMG);
+      if (compare_without_a_function(info, compare_slot, MAX_IMG, name))
+         return 1;
+      for (unsigned i = 0; i < num_tex && i < MAX_IMG; i++) {
+         const struct air_sampler_state *own = NULL;
+         struct pipe_sampler_state st = sampler_for_slot(info, i, true,
+                                                         compare_slot[i], &own);
+         csamplers[i] = pipe->create_sampler_state(pipe, &st);
+         csampler = csamplers[i];
+         if (own)
+            print_own_sampler(i, own, compare_slot[i]);
+      }
+      pipe->bind_sampler_states(pipe, PIPE_SHADER_COMPUTE, 0, num_tex, csamplers);
+      pipe->set_sampler_views(pipe, PIPE_SHADER_COMPUTE, 0, num_tex, 0, false, views);
+   }
+
+   void *cso = pipe->create_compute_state(pipe, &(struct pipe_compute_state){
+      .ir_type = PIPE_SHADER_IR_NIR, .prog = cs,
+      .static_shared_mem = cs->info.shared_size });
+   if (!cso) {
+      fprintf(stderr, "air_run: the driver would not make a compute state of it\n");
+      return 1;
+   }
+   pipe->bind_compute_state(pipe, cso);
+
+   /* more than one thread, and the whole grid, so that a wrong index shows */
+   struct pipe_grid_info grid = {
+      .work_dim = 3,
+      .block = { block[0], block[1], block[2] },
+      .grid = { 1, 1, 1 },
+   };
+   printf("air_run: dispatching %ux%ux%u threads in one workgroup; %u device buffer%s bound, "
+          "%u of them written, filled with %s\n",
+          block[0], block[1], block[2], num_ssbo, num_ssbo == 1 ? "" : "s", num_written,
+          zero_fill ? "ZEROS (--zero: a degenerate input, see docs/air.md section 5)"
+                    : ones_fill ? "0xff BYTES (--ones: a degenerate input)"
+                    : library_fill ? "the floats ((w * 13) % 29 - 14) / 4"
+                                   : "(i * 7 + 13) & 0xff");
+   if (num_img || num_tex)
+      printf("air_run: %u image%s bound (%u written) and %u texture%s, %ux%u, texel (x,y,z) of "
+             "slot n = (100+x+1000n, 200+y, 300+x+y+z, 400)\n", num_img,
+             num_img == 1 ? "" : "s", num_img_written, num_tex, num_tex == 1 ? "" : "s",
+             TEX_SIZE, TEX_SIZE);
+   pipe->launch_grid(pipe, &grid);
+   bool finished = finish_or_say_why(screen, pipe, "dispatch");
+
+   for (unsigned i = 0; i < num_ssbo; i++) {
+      if (!writable[i])
+         continue;
+      struct pipe_transfer *xfer;
+      uint32_t *p = pipe_buffer_map(pipe, bufs[i], PIPE_MAP_READ, &xfer);
+      if (!p) {
+         fprintf(stderr, "air_run: device buffer %u could not be read back\n", i);
+         return 1;
+      }
+      unsigned words = MIN2(sizes[i] / 4, block[0] * block[1] * block[2]);
+      printf("air_run: device buffer %u after the dispatch, first %u words:\n", i, words);
+      for (unsigned w = 0; w < words; w++)
+         printf("  [%2u] %11u  0x%08x\n", w, p[w], p[w]);
+
+      /* A buffer the shader writes that comes back bit-identical to the fill
+       * is not a result, and the only thing worse than no number is a number
+       * that looks like one.
+       *
+       * This is not hypothetical and not rare. On the phone, a boot survives
+       * about two dozen dispatches that bind textures or images; after that
+       * every dispatch still "succeeds", every readback still prints, and
+       * nothing the GPU writes is ever visible again -- measured on
+       * 20 October (logs/182513-run.log: writes land for the 13th, 15th and
+       * 23rd kernel of the run and for nothing after it, while the same
+       * kernels and four probe kernels all write correctly in a short run,
+       * logs/182805-run.log). The same boot later refuses an allocation
+       * outright with "bo_allocate: alloc failed". So the words below can be
+       * a statement about how long the run had been going rather than about
+       * the shader, and whoever reads them has to be told which.
+       */
+      /* and then every word of the whole buffer that differs from what went in,
+       * capped so that a kernel which rewrites all 1024 of them does not push
+       * the rest of a run out of the boot log (the loader keeps the first
+       * 256 KB and the last 1 MB and drops the middle).
+       */
+      unsigned changed = 0, shown = 0;
+      const uint32_t *was = (const uint32_t *)before[i];
+      for (unsigned w = 0; was && w < sizes[i] / 4; w++) {
+         if (p[w] == was[w])
+            continue;
+         changed++;
+         if (shown < 24) {
+            printf("  changed [%4u] 0x%08x -> 0x%08x\n", w, was[w], p[w]);
+            shown++;
+         }
+      }
+      if (was && changed)
+         printf("air_run: device buffer %u: %u of its %u words differ from what this "
+                "harness wrote%s\n", i, changed, sizes[i] / 4,
+                shown < changed ? " (the first 24 are above)" : "");
+      else if (was)
+         printf("air_run: device buffer %u came back bit-identical to the fill, so this "
+                "dispatch wrote nothing visible. Either the shader writes elsewhere, or "
+                "the GPU has stopped making writes visible -- which it does after a few "
+                "dozen dispatches in one boot (docs/air.md section 4).\n", i);
+      pipe_buffer_unmap(pipe, xfer);
+   }
+
+   if (!finished) {
+      fprintf(stderr, "air_run: %s: the dispatch did not finish, so no number here is "
+                      "evidence\n", name);
+      return 1;
+   }
+
+   /* and every image the kernel wrote: without this a dispatch that writes only
+    * an image -- which is most of the corpus's kernels -- would have nothing to
+    * read back, and air_run would have reported a successful run of something
+    * it had not looked at.
+    */
+   for (unsigned i = 0; i < num_img; i++) {
+      if (!img_write[i])
+         continue;
+      struct pipe_transfer *xfer;
+      unsigned depth = idim[i] == GLSL_SAMPLER_DIM_3D ? TEX_SIZE : 1;
+      void *pix = pipe->texture_map(pipe, imgs[i], 0, PIPE_MAP_READ,
+                                    &(struct pipe_box){ .width = TEX_SIZE,
+                                                        .height = TEX_SIZE,
+                                                        .depth = depth }, &xfer);
+      if (!pix) {
+         fprintf(stderr, "air_run: image %u could not be read back\n", i);
+         return 1;
+      }
+      printf("air_run: image %u after the dispatch, texels (0,0) and (1,1):\n", i);
+      for (unsigned t = 0; t < 2; t++) {
+         unsigned x = t, y = t;
+         for (unsigned c = 0; c < 4; c++) {
+            unsigned k = (y * (xfer->stride / (4 * sizeof(float))) + x) * 4 + c;
+            if (iisf[i])
+               printf("  (%u,%u)[%u] %.9g\n", x, y, c, (double)((float *)pix)[k]);
+            else
+               printf("  (%u,%u)[%u] %11d\n", x, y, c, ((int32_t *)pix)[k]);
+         }
+      }
+      pipe->texture_unmap(pipe, xfer);
+   }
+
+   pipe->destroy(pipe);
+   screen->destroy(screen);
+   return 0;
+}
+
+/* -- function constant values ---------------------------------------------
+ *
+ * --fc INDEX=VALUE supplies one function constant, and it exists because
+ * nothing in this tree ever supplied one. air_module_function_constants()
+ * registers every constant a module declares with its index and leaves
+ * air_constant_value.bits at zero, so air.is_function_constant_defined folds
+ * to true and every load yields zero -- for a constant whose global is an
+ * `externally_initialized ... undef` in section "air.fc_initializer" there is
+ * no default to fall back on, and zero is then not a default but a value this
+ * compiler invented. 34 of RenderBox's 47 modules declare such a constant and
+ * 25 of them derive their resource interface and their control flow from it in
+ * an "air.static_init" constructor, so zero picks one arbitrary specialization
+ * out of a state machine and the picture cannot say which.
+ *
+ * An index the module does not declare is refused rather than ignored: an
+ * option that silently sets nothing would make every run agree with every
+ * other one for the wrong reason.
+ */
+/* 64 and not 32, which is the number the corpus asks for rather than a round
+ * one: fixed_frag_lph_cph and fixed_frag_lph_cpf declare 58 function constants
+ * each, so the old array could not carry one pipeline's worth of them and the
+ * refusal was "more than 32 function constants" -- on the module this matters
+ * for most. The same bound is RW_MAX_CONSTANTS in air_metal.h, raised to 64
+ * for the same reason.
+ */
+static struct {
+   unsigned index;
+   uint64_t bits;
+} fc_set[64];
+static unsigned num_fc_set;
+
+static bool
+apply_fc_values(struct air_constant_value *fc, unsigned num_fc)
+{
+   for (unsigned i = 0; i < num_fc_set; i++) {
+      unsigned j;
+      for (j = 0; j < num_fc; j++) {
+         if (fc[j].index == fc_set[i].index) {
+            fc[j].bits = fc_set[i].bits;
+            fc[j].supplied = true;
+            printf("air_run: function constant %u = 0x%llx\n", fc_set[i].index,
+                   (unsigned long long)fc_set[i].bits);
+            break;
+         }
+      }
+      if (j == num_fc) {
+         fprintf(stderr, "air_run: this module declares no function constant %u"
+                         " (it declares %u)\n", fc_set[i].index, num_fc);
+         return false;
+      }
+   }
+   return true;
+}
+
+int
+main(int argc, char **argv)
+{
+   /* --disasm: ask ir3 to print the Adreno instructions it generates. The
+    * screen's name proves fd_screen_create won; it does not prove that the
+    * shader itself went through ir3 rather than some later software path, and
+    * the four floats look identical either way. ir3's own disassembly in the
+    * log is the positive proof. IR3_SHADER_DEBUG is read once, at compiler
+    * creation, so it has to be set before the screen is made.
+    */
+   bool want_disasm = false;
+   /* --library runs an air.visible library function through the generated
+    * wrapper (nir_air.h): there is nothing to dispatch otherwise, so these 135
+    * modules were never run at all.
+    */
+   bool want_library = false;
+   /* --buffer FILE is AIR_RUN_BUFFER as an argument, and it exists because the
+    * device has no shell to set one with. iOS 16.5's own root carries no sh at
+    * all -- /bin holds df and ps -- and the job list that runs this is read by
+    * our init, which splits a line on blanks and has no notion of a variable
+    * (userland/src/init.c, run_command). So a generated suite whose every
+    * module reads its own bytes could not be run on the phone until this
+    * option existed: with it each module is one ordinary job line.
+    */
+   while (argc > 1 && argv[1][0] == '-') {
+      if (!strcmp(argv[1], "--disasm")) {
+         want_disasm = true;
+         setenv("IR3_SHADER_DEBUG", "disasm", 1);
+         argv++;
+         argc--;
+      } else if (!strcmp(argv[1], "--zero")) {
+         zero_fill = true;
+         argv++;
+         argc--;
+      } else if (!strcmp(argv[1], "--ones")) {
+         ones_fill = true;
+         argv++;
+         argc--;
+      } else if (!strcmp(argv[1], "--packed16") && argc > 3) {
+         packed16_fmt = packed16_by_name(argv[2], &packed16_name);
+         if (packed16_fmt == PIPE_FORMAT_NONE)
+            return 2;
+         packed16_word = (unsigned)strtoul(argv[3], NULL, 0) & 0xffff;
+         argv += 3;
+         argc -= 3;
+      } else if (!strcmp(argv[1], "--clear") && argc > 2) {
+         /* R,G,B,A for target 0, then ':' and four more for target 1, and so on.
+          * A colon and not a semicolon: these reach the phone as job lines, and
+          * the init that reads them splits on blanks and promises nothing about
+          * shell syntax -- a separator that a shell WOULD have meant something by
+          * is one nobody can be sure about by reading the line.
+          */
+         const char *spec = argv[2];
+         clear_count = 0;
+         while (spec && *spec && clear_count < MAX_CLEARS) {
+            float c[4] = { 0, 0, 0, 0 };
+            if (sscanf(spec, "%f,%f,%f,%f", &c[0], &c[1], &c[2], &c[3]) != 4) {
+               fprintf(stderr, "air_run: --clear wants R,G,B,A per target, ':' between "
+                               "targets\n");
+               return 2;
+            }
+            for (unsigned i = 0; i < 4; i++)
+               clear_colour[clear_count].f[i] = c[i];
+            clear_count++;
+            const char *sep = strchr(spec, ':');
+            spec = sep ? sep + 1 : NULL;
+         }
+         clear_given = true;
+         argv += 2;
+         argc -= 2;
+      } else if (!strcmp(argv[1], "--halftex")) {
+         halftex = true;
+         argv++;
+         argc--;
+      } else if (!strcmp(argv[1], "--miplevels") && argc > 2) {
+         miplevel_fmt = packed16_by_name(argv[2], &packed16_name);
+         if (miplevel_fmt == PIPE_FORMAT_NONE)
+            return 2;
+         argv += 2;
+         argc -= 2;
+      } else if (!strcmp(argv[1], "--packed16-rt") && argc > 2) {
+         packed16_rt = packed16_by_name(argv[2], &packed16_name);
+         if (packed16_rt == PIPE_FORMAT_NONE)
+            return 2;
+         argv += 2;
+         argc -= 2;
+      } else if (!strcmp(argv[1], "--library")) {
+         want_library = library_fill = true;
+         argv++;
+         argc--;
+      } else if (!strcmp(argv[1], "--stitch") && argc > 2) {
+         /* A graph of air.visible functions, dispatched as one kernel. The
+          * argument buffer is filled the wrapper's way for the same reason the
+          * stitched entry point reads the wrapper's slots: a one-node graph
+          * then has to write exactly what --library writes for that function.
+          */
+         stitch_text = argv[2];
+         library_fill = true;
+         argv += 2;
+         argc -= 2;
+      } else if (!strcmp(argv[1], "--block") && argc > 2) {
+         unsigned x = 0, y = 0, z = 0;
+
+         if (sscanf(argv[2], "%u,%u,%u", &x, &y, &z) != 3 || !x || !y || !z) {
+            fprintf(stderr, "air_run: --block wants X,Y,Z and all three above zero\n");
+            return 2;
+         }
+         block[0] = x, block[1] = y, block[2] = z;
+         argv += 2;
+         argc -= 2;
+      } else if (!strcmp(argv[1], "--fc") && argc > 2) {
+         unsigned idx = 0;
+         uint64_t val = 0;
+
+         if (sscanf(argv[2], "%u=0x%llx", &idx, (unsigned long long *)&val) != 2 &&
+             sscanf(argv[2], "%u=%llu", &idx, (unsigned long long *)&val) != 2) {
+            fprintf(stderr, "air_run: --fc wants INDEX=VALUE, decimal or 0x\n");
+            return 2;
+         }
+         if (num_fc_set >= ARRAY_SIZE(fc_set)) {
+            fprintf(stderr, "air_run: more than %u function constants\n",
+                    (unsigned)ARRAY_SIZE(fc_set));
+            return 2;
+         }
+         fc_set[num_fc_set].index = idx;
+         fc_set[num_fc_set].bits = val;
+         num_fc_set++;
+         argv += 2;
+         argc -= 2;
+      } else if (!strcmp(argv[1], "--buffer") && argc > 2) {
+         if (!add_buffer_patch(argv[2]))
+            setenv("AIR_RUN_BUFFER", argv[2], 1);
+         argv += 2;
+         argc -= 2;
+      } else {
+         break;
+      }
+   }
+   if (argc < 2) {
+      fprintf(stderr, "usage: air_run [--disasm] [--library] [--block X,Y,Z] "
+                      "[--buffer FILE | --buffer N@OFF=HEX] "
+                      "[--fc INDEX=VALUE] "
+                      "[--zero | --ones] FILE[.metallib] [FUNCTION]\n");
+      return 2;
+   }
+
+   watch_for_faults();
+   glsl_type_singleton_init_or_ref();
+   void *ctx = ralloc_context(NULL);
+
+   /* the module */
+   FILE *f = fopen(argv[1], "rb");
+   if (!f) {
+      perror(argv[1]);
+      return 1;
+   }
+   fseek(f, 0, SEEK_END);
+   size_t size = ftell(f);
+   fseek(f, 0, SEEK_SET);
+   void *data = ralloc_size(ctx, size);
+   if (fread(data, 1, size, f) != size) {
+      fprintf(stderr, "air_run: short read of %s\n", argv[1]);
+      return 1;
+   }
+   fclose(f);
+
+   const void *bitcode = data;
+   size_t bitcode_size = size;
+   const char *want = argc > 2 ? argv[2] : NULL;
+   const char *name = argv[1];
+
+   /* A stitched graph is still handed to air_to_nir as one module plus the
+    * graph, and that module is the OUTPUT node's: its own visible function is
+    * one node like any other.
+    */
+   const struct air_stitch_graph *graph = NULL;
+   struct air_stitch_function *stitch_fns = NULL;
+   unsigned num_stitch_fns = 0;
+   if (stitch_text) {
+      char why[256] = { 0 };
+      graph = air_stitch_parse(ctx, stitch_text, why, sizeof(why));
+      if (graph)
+         num_stitch_fns = air_stitch_functions_of(ctx, graph, data, size, &stitch_fns,
+                                                  why, sizeof(why));
+      if (!graph || !num_stitch_fns) {
+         fprintf(stderr, "air_run: --stitch: %s\n", why[0] ? why : "no functions");
+         return 2;
+      }
+      want = graph->nodes[graph->output_node].function;
+   }
+
+   if (size >= 4 && !memcmp(data, "MTLB", 4)) {
+      struct air_metallib lib;
+      const char *err;
+      if (!air_metallib_parse(ctx, data, size, &lib, &err)) {
+         fprintf(stderr, "air_run: %s: %s\n", argv[1], err);
+         return 1;
+      }
+      unsigned pick = lib.num_functions;
+      for (unsigned i = 0; i < lib.num_functions; i++) {
+         if (!want || !strcmp(want, lib.functions[i].name)) {
+            pick = i;
+            break;
+         }
+      }
+      if (pick == lib.num_functions) {
+         fprintf(stderr, "air_run: no function %s\n", want ? want : "(any)");
+         return 1;
+      }
+      bitcode = lib.functions[pick].bitcode;
+      bitcode_size = lib.functions[pick].bitcode_size;
+      name = lib.functions[pick].name;
+   }
+
+   /* The screen: the GPU's where the kernel has one to drive, softpipe
+    * otherwise. The same source therefore runs on this machine (no msm
+    * device, so it falls back and draws in software) and on the phone, where
+    * it opens the Adreno exactly as the port's own Mesa does
+    * (osmesa_create_gpu_screen in tools/mesa/freedreno-darwin.patch).
+    * AIR_RUN_SOFTWARE=1 forces software even where a GPU is present.
+    */
+   struct pipe_screen *screen = NULL;
+   const char *how = "software";
+#ifdef GALLIUM_FREEDRENO
+   if (!debug_get_bool_option("AIR_RUN_SOFTWARE", false)) {
+      int fd = drmOpenWithType("msm", NULL, DRM_NODE_RENDER);
+      if (fd >= 0) {
+         /* The driver option cache has to be real, not a zeroed struct:
+          * fd_screen_create passes it straight to driParseConfigFiles, which
+          * dereferences it. A zeroed one died at address 0x10 on the phone --
+          * the first thing this program ever did on a machine that has a GPU,
+          * and invisible on any machine that has not. This is the sequence
+          * osmesa_create_gpu_screen() uses in tools/mesa/freedreno-darwin.patch,
+          * which is the one CoreAnimation goes through on this device daily.
+          */
+         static const driOptionDescription freedreno_options[] = {
+#include "freedreno/driinfo_freedreno.h"
+         };
+         static driOptionCache info, cache;
