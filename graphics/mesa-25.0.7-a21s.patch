    if (mmap_offset < 0)
       return MAP_FAILED;
 
+#ifdef __APPLE__
+   /* (Darwin on redwood: a buffer is the user client's memory of the type that is its handle,
+    * mapped whole; the caller asked for the part that starts at bo_offset) */
+   (void)mmap_offset;
