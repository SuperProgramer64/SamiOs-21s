diff --git a/xnu/files/osfmk/arm64/gic_v2_irq.h b/xnu/files/osfmk/arm64/gic_v2_irq.h
new file mode 100644
index 0000000..4dd3f03
--- /dev/null
+++ b/xnu/files/osfmk/arm64/gic_v2_irq.h
@@ -0,0 +1,284 @@
+/*
