+ assert(!hakios_emmc_log_window(12216320,7944192,20160512,3092480,20283392,8192,25000000,64*1024*1024));
+ assert(!hakios_emmc_log_window(UINT64_MAX-10,50,0,0,0,8192,UINT64_MAX,100));
