diff --git a/drivers/input/hakios.exykeys.c b/drivers/input/hakios.exykeys.c
new file mode 100644
index 0000000..080ef21
--- /dev/null
+++ b/drivers/input/hakios.exykeys.c
@@ -0,0 +1,169 @@
+/*
+ * The volume keys of the Samsung Galaxy A21s (Exynos 850) as button records for /dev/hakios-touch
+ * (sys/hakios.input.h). Only with boot-arg buttons=3 (hakios.buttons.c hands over to this).
+ *
+ * Both keys are plain pins of the SoC's "alive" pin controller (pinctrl@11850000), as the phone's
+ * own device tree has them for gpio_keys: volume down GPA1[0], volume up GPA0[7], pulled up, the
+ * key pulls the pin low. The power key is not a pin: it is the S2MPU12 PMIC's, behind ACPM, and
+ * is not here yet.
+ *
+ * THIS DRIVER ONLY READS: the pins' data register, and their configuration register to check them
+ * before it believes them (input, or external interrupt: what Android's gpio_keys leaves). Nothing
+ * is written to the pin controller.
+ *
+ * A thread looks at both 60 times a second; a key has changed when two looks in a row say so, and
+ * a key that reads as held before it has ever been seen released is not believed.
+ *
+ * Bank layout (each bank 0x20: CON +0x0, 4 bits a pin; DAT +0x4, 1 bit a pin): Linux's
+ * drivers/pinctrl/samsung/pinctrl-exynos-arm64.c, exynos850_pin_banks0 (read, not copied).
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.input.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void IOSleep(unsigned int milliseconds);
+
+#define ALIVE_PINCTRL   0x11850000ULL
+#define BANK_GPA0       0x000
+#define BANK_GPA1       0x020
+#define GP_CON          0x0
+#define GP_DAT          0x4
+#define CON_INPUT       0x0
+#define CON_EINT        0xf
+
+static vm_offset_t pins;
+
+static struct key {
+	const char *name;
+	uint32_t    bank, pin;
+	uint32_t    record;         /* HAKIOS_BUTTON_* */
+	bool        usable;         /* its pin is set up as a key's */
+	bool        live;           /* seen released once */
+	bool        down;
+	int         last;           /* the previous look: 1 held, 0 not, -1 none yet */
+	uint32_t    presses;
+} keys[] = {
+	{ .name = "volume up",   .bank = BANK_GPA0, .pin = 7, .record = HAKIOS_BUTTON_VOLUME_UP,   .last = -1 },
+	{ .name = "volume down", .bank = BANK_GPA1, .pin = 0, .record = HAKIOS_BUTTON_VOLUME_DOWN, .last = -1 },
+};
+
+static inline uint32_t
+rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(pins + off);
+}
+
+static void
+key_look(struct key *k)
+{
+	int held = !((rd(k->bank + GP_DAT) >> k->pin) & 1);     /* active low */
+
+	if (held != k->last) {                  /* the first of two looks */
+		k->last = held;
+		return;
+	}
+	if (!k->live) {
+		if (!held) {
+			k->live = true;
+			printf("exykeys: %s is released now: believed from here on\n", k->name);
+		}
+		return;
+	}
+	if (held == k->down) {
+		return;
+	}
+	k->down = held;
+	if (held) {
+		k->presses++;
+	}
+	printf("exykeys: %s %s (%u presses)\n", k->name, held ? "PRESSED" : "released", k->presses);
+	hakios_touch_post(held ? HAKIOS_BUTTON_DOWN : HAKIOS_BUTTON_UP, k->record, 0, 0);
+}
+
+/*
+ * The way out of a run that keeps its log: volume up and volume down held together for 3 s. A
+ * forced restart with the buttons (volume down + power) is a cold reset and the kernel's log in RAM
+ * is lost with it (2026-11-05: the run at 12:20). This instead makes the loader's watchdog
+ * (cluster 0, armed by exyloader, fed by hakios.dwmmc.c) fire at once: a warm reset, the RAM kept,
+ * and the next boot hands this run's log to Android as after any run. Each finished line of the
+ * log is in RAM already (loader_return.c); a journaled /private/var is whole at its next mount.
+ */
+#define WDT_CL0         0x10050000ULL
+#define WTCON           0x00
+#define WTDAT           0x04
+#define WTCNT           0x08
+#define WTCON_ENABLE    (1u << 5)
+#define WTCON_RESET     (1u << 0)
+#define BOTH_HELD_LOOKS (3 * 60)        /* 3 s of looks, 60 a second */
+
+static void
+both_keys_way_out(void)
+{
+	vm_offset_t wdt = ml_io_map(WDT_CL0, 0x1000);
+	uint32_t con = *(volatile uint32_t *)(wdt + WTCON);
+
+	printf("exykeys: volume up + volume down held for 3 s: a warm reset through the watchdog now, "
+	    "the log is kept (WTCON %#x)\n", con);
+	IOSleep(100);
+	if (!(con & WTCON_ENABLE) || !(con & WTCON_RESET)) {
+		printf("exykeys: the watchdog is not armed to reset (WTCON %#x): nothing done\n", con);
+		return;
+	}
+	/* reload value and counter both 1: whoever feeds it next only reloads 1 again */
+	*(volatile uint32_t *)(wdt + WTDAT) = 1;
+	*(volatile uint32_t *)(wdt + WTCNT) = 1;
+	__builtin_arm_dsb(0xf);
+	IOSleep(2000);
+	printf("exykeys: the watchdog did not reset the phone\n");
+}
+
+static void
+exykeys_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	unsigned n = 0, both = 0;
+
+	for (;;) {
+		for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
+			if (keys[i].usable) {
+				key_look(&keys[i]);
+			}
+		}
+		both = (keys[0].usable && keys[1].usable && keys[0].down && keys[1].down) ? both + 1 : 0;
+		if (both == BOTH_HELD_LOOKS) {
+			both_keys_way_out();
+		}
+		if (++n % (60 * 60) == 0) {     /* once a minute: the log's start may be lost */
+			printf("exykeys: up %u, down %u presses so far\n", keys[0].presses, keys[1].presses);
+		}
+		IOSleep(16);
+	}
+}
+
+void
+hakios_exykeys_init(void)
+{
+	unsigned usable = 0;
+	thread_t thread;
+
+	pins = ml_io_map(ALIVE_PINCTRL, 0x1000);
+	for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
+		struct key *k = &keys[i];
+		uint32_t con = (rd(k->bank + GP_CON) >> (k->pin * 4)) & 0xf;
+		uint32_t dat = (rd(k->bank + GP_DAT) >> k->pin) & 1;
+
+		k->usable = con == CON_INPUT || con == CON_EINT;
+		printf("exykeys: %s: GP%s[%u] CON %#x DAT %u: %s\n", k->name, k->bank == BANK_GPA0 ? "A0" : "A1",
+		    k->pin, con, dat, k->usable ? (dat ? "an input, not held" : "an input, reads held") :
+		    "NOT set up as an input: left alone");
+		usable += k->usable;
+	}
+	if (usable && kernel_thread_start(exykeys_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("exykeys: watching %u keys, 60 times a second\n", usable);
+	}
+}
diff --git a/drivers/input/hakios.exyusb.c b/drivers/input/hakios.exyusb.c
new file mode 100644
index 0000000..a5657df
--- /dev/null
+++ b/drivers/input/hakios.exyusb.c
@@ -0,0 +1,974 @@
+/*
+ * HakiOS: USB device mode on the Galaxy A21s (Exynos 850): CDC-ECM networking and the kernel's log
+ * streamed live to the PC (UDP 192.168.7.1:5140), so a run can be watched without waiting for pstore.
+ *
+ * Imported, with the author's permission, from the ios-a135f port (Galaxy A13, the same Exynos 850):
+ * Schoosh / simpleXNU (https://github.com/simpleXNU/ios-a135f), with the A21s adaptation by
+ * Bruhboy666dev; their bsd/dev/a135f_usb.c after patches 0019, 0020 and 0022. Changes for HakiOS,
+ * and only these: no A135F board guard; OFF unless boot-arg a135f_usb=1 (PHY only) or 2 (the gadget
+ * and the live log) -- theirs defaulted to 2; started from hakios_input_init(); the log positions
+ * are the kernel's loader_log (osfmk/arm64/loader_return.c, a135f_log_position/a135f_log_copy).
+ *
+ * On the Mac: never have the cable in while the phone reboots (S-Boot's USB modem makes macOS's
+ * AppleUSBACMData panic when it goes away); plug it in once XNU runs, unplug it before the run ends.
+ * The original description follows.
+ */
+/*
+ * Galaxy A13 (Exynos850) USB device mode: CDC-ECM networking + live log.
+ *
+ * Hardware: Synopsys DWC3 (USB 2.0 only, high-speed) at 0x13600000 behind the
+ * Samsung "USBDRD" glue, UTMI PHY at 0x135d0000 (phy-exynos5-usbdrd.c,
+ * exynos850_usbdrd_utmi_init), PHY power isolation in the PMU (0x11860000 +
+ * 0x704), clock gates in CMU_HSI (0x13400000). Nothing guarantees the
+ * bootloader left the PHY running, so this driver
+ *   1. opens the CMU_HSI USB gates (the USER muxes stay as the bootloader set them),
+ *   2. releases the PMU PHY isolation,
+ *   3. runs the UTMI PHY init (26 MHz reference, VBUS-valid forced since no
+ *      Type-C/charger switch driver exists),
+ *   4. only then touches the DWC3 registers (an access to a gated block hangs).
+ * The gadget code below (EP0, CDC-ECM, UDP log stream) is generic DWC3.
+ * The USB supplies (vdd10/vdd33 in the Linux dts) are fixed rails the pre-xnu bootloader has already
+ * enabled; xnu has no regulator code and never switches them.
+ * boot-arg a135f_usb: 0 off, 1 bring up the PHY and report state, 2 (default) also start the gadget.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <kern/locks.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/kpi_socket.h>
+#include <sys/sockio.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/ethernet.h>
+#include <net/if_ether.h>
+#include <net/ether_if_module.h>
+#include <net/kpi_interface.h>
+#include <net/kpi_protocol.h>
+#include <netinet/in.h>
+#include <net/if_media.h>
+#include <net/dlil.h>
+#include <sys/kern_event.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void a135f_usb_probe(void);
+static void a135f_usb_gadget_start(vm_offset_t dwc);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+
+#define CMU_HSI_PA              0x13400000u
+#define CMU_HSI_SIZE            0x8000u
+#define CMU_GATE_EN             (1u << 21)
+#define PMU_PA                  0x11860000u
+#define PMU_USBDRD_PHY_CONTROL  0x704
+#define PHY_ENABLE              (1u << 0)
+#define USBDRD_PHY_PA           0x135d0000u
+#define USBDRD_PHY_SIZE         0x100u
+#define DWC3_PA                 0x13600000u
+#define DWC3_SIZE               0x10000u
+
+/* CMU_HSI gates, from clk-exynos850.c (bit 21 enables) */
+static const struct { const char *name; uint32_t off; } hsi_usb_gates[] = {
+	{ "usb_rtc", 0x2008 }, { "usb_ref", 0x200c }, { "usb_phy_ref", 0x2010 },
+	{ "usb_phy_aclk", 0x203c }, { "usb_bus_early", 0x2040 },
+};
+
+/* EXYNOS850_DRD_* PHY registers */
+#define DRD_LINKCTRL    0x04
+#define   LINKCTRL_FORCE_QACT           (1u << 8)
+#define   LINKCTRL_BUS_FILTER_BYPASS    (0xfu << 4)
+#define DRD_LINKPORT    0x08
+#define   LINKPORT_HOST_NUM_U3          (0xfu << 16)
+#define DRD_CLKRST      0x20
+#define   CLKRST_PHY20_SW_POR           (1u << 13)
+#define   CLKRST_PHY20_SW_POR_SEL       (1u << 12)
+#define   CLKRST_PHY_SW_RST             (1u << 3)
+#define   CLKRST_PHY_RESET_SEL          (1u << 2)
+#define   CLKRST_PORT_RST               (1u << 1)
+#define DRD_SSPPLLCTL   0x30
+#define   SSPPLLCTL_FSEL_MASK           7u
+#define   SSPPLLCTL_FSEL_26MHZ          6u
+#define DRD_UTMI        0x50
+#define   UTMI_FORCE_VBUSVALID          (1u << 5)
+#define   UTMI_FORCE_BVALID             (1u << 4)
+#define   UTMI_DP_PULLDOWN              (1u << 3)
+#define   UTMI_DM_PULLDOWN              (1u << 2)
+#define   UTMI_FORCE_SUSPEND            (1u << 1)
+#define   UTMI_FORCE_SLEEP              (1u << 0)
+#define DRD_HSP         0x54
+#define   HSP_FSV_OUT_EN                (1u << 24)
+#define   HSP_VBUSVLDEXTSEL             (1u << 13)
+#define   HSP_VBUSVLDEXT                (1u << 12)
+#define   HSP_EN_UTMISUSPEND            (1u << 9)
+#define   HSP_COMMONONN                 (1u << 8)
+#define DRD_HSP_TEST    0x5c
+#define   HSP_TEST_SIDDQ                (1u << 24)
+
+static uint32_t
+usb_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+usb_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* exynos850_usbdrd_utmi_init() with a 26 MHz reference and no Type-C switch */
+static void
+usb_phy_init(vm_offset_t phy)
+{
+	uint32_t reg, ss_ports;
+
+	usb_wr(phy, DRD_LINKCTRL, usb_rd(phy, DRD_LINKCTRL) | LINKCTRL_FORCE_QACT);
+	ss_ports = (usb_rd(phy, DRD_LINKPORT) & LINKPORT_HOST_NUM_U3) >> 16;
+
+	reg = usb_rd(phy, DRD_CLKRST);
+	if (ss_ports) {
+		reg |= CLKRST_PHY20_SW_POR | CLKRST_PHY20_SW_POR_SEL | CLKRST_PHY_RESET_SEL;
+	}
+	usb_wr(phy, DRD_CLKRST, reg | CLKRST_PHY_SW_RST);
+
+	reg = usb_rd(phy, DRD_UTMI);
+	reg &= ~(UTMI_FORCE_SUSPEND | UTMI_FORCE_SLEEP | UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN);
+	usb_wr(phy, DRD_UTMI, reg);
+	usb_wr(phy, DRD_HSP, usb_rd(phy, DRD_HSP) | HSP_EN_UTMISUSPEND | HSP_COMMONONN);
+	usb_wr(phy, DRD_LINKCTRL, usb_rd(phy, DRD_LINKCTRL) | LINKCTRL_BUS_FILTER_BYPASS);
+
+	/* no Type-C/charger driver: force VBUS valid and B-session valid */
+	usb_wr(phy, DRD_UTMI, usb_rd(phy, DRD_UTMI) | UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID);
+	usb_wr(phy, DRD_HSP, usb_rd(phy, DRD_HSP) | HSP_VBUSVLDEXT | HSP_VBUSVLDEXTSEL);
+
+	reg = usb_rd(phy, DRD_SSPPLLCTL) & ~SSPPLLCTL_FSEL_MASK;
+	usb_wr(phy, DRD_SSPPLLCTL, reg | SSPPLLCTL_FSEL_26MHZ);
+	usb_wr(phy, DRD_HSP_TEST, usb_rd(phy, DRD_HSP_TEST) & ~HSP_TEST_SIDDQ);
+
+	delay(10);
+	reg = usb_rd(phy, DRD_CLKRST);
+	if (ss_ports) {
+		reg |= CLKRST_PHY20_SW_POR_SEL;
+		reg &= ~CLKRST_PHY20_SW_POR;
+	}
+	reg &= ~(CLKRST_PHY_SW_RST | CLKRST_PORT_RST);
+	usb_wr(phy, DRD_CLKRST, reg);
+	delay(75);
+
+	usb_wr(phy, DRD_HSP, usb_rd(phy, DRD_HSP) & ~HSP_FSV_OUT_EN);
+}
+
+void
+a135f_usb_probe(void)
+{
+	int enabled = 0;        /* HakiOS: off unless asked for (theirs: 2) */
+
+	PE_parse_boot_argn("a135f_usb", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	vm_offset_t cmu = ml_io_map(CMU_HSI_PA, CMU_HSI_SIZE);
+	vm_offset_t pmu = ml_io_map(PMU_PA, 0x1000);
+	vm_offset_t phy = ml_io_map(USBDRD_PHY_PA, USBDRD_PHY_SIZE);
+	vm_offset_t dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (!cmu || !pmu || !phy || !dwc) {
+		printf("A135F USB: MMIO mapping failed\n");
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(hsi_usb_gates) / sizeof(hsi_usb_gates[0]); i++) {
+		usb_wr(cmu, hsi_usb_gates[i].off, usb_rd(cmu, hsi_usb_gates[i].off) | CMU_GATE_EN);
+	}
+	delay(10);
+	usb_wr(pmu, PMU_USBDRD_PHY_CONTROL, usb_rd(pmu, PMU_USBDRD_PHY_CONTROL) | PHY_ENABLE);
+	usb_phy_init(phy);
+	printf("A135F USB: PHY up (UTMI 0x%08x HSP 0x%08x CLKRST 0x%08x)\n",
+	    usb_rd(phy, DRD_UTMI), usb_rd(phy, DRD_HSP), usb_rd(phy, DRD_CLKRST));
+	printf("A135F USB: DWC3 GSNPSID 0x%08x GCTL 0x%08x GSTS 0x%08x GUSB2PHYCFG 0x%08x\n",
+	    usb_rd(dwc, 0xc120), usb_rd(dwc, 0xc110), usb_rd(dwc, 0xc118), usb_rd(dwc, 0xc200));
+	printf("A135F USB: DWC3 DCFG 0x%08x DCTL 0x%08x DSTS 0x%08x GHWPARAMS0 0x%08x\n",
+	    usb_rd(dwc, 0xc700), usb_rd(dwc, 0xc704), usb_rd(dwc, 0xc70c), usb_rd(dwc, 0xc140));
+	if (enabled >= 2) {
+		a135f_usb_gadget_start(dwc);
+	}
+}
+
+/*
+ * Step 2: USB device mode with only the default control endpoint, enough
+ * for the host to enumerate the phone (boot-arg a135f_usb=2, the
+ * default): soft reset, an event buffer in our memory, endpoint 0, run. Events are polled from a kernel
+ * thread (no interrupt), like the eMMC driver. DMA is not cache coherent
+ * (no dma-coherent in the Exynos850 dtsi): buffers are cleaned/invalidated.
+ * Register layout and the control-transfer state machine follow the
+ * Synopsys DWC3 databook as used by Linux drivers/usb/dwc3 (gadget.c,
+ * ep0.c).
+ */
+#define GCTL            0xc110
+#define GEVNTADRLO      0xc400
+#define GEVNTADRHI      0xc404
+#define GEVNTSIZ        0xc408
+#define GEVNTCOUNT      0xc40c
+#define DCFG            0xc700
+#define DCTL            0xc704
+#define DEVTEN          0xc708
+#define DSTS            0xc70c
+#define DALEPENA        0xc720
+#define DEPCMDPAR2(n)   (0xc800 + 0x10 * (n))
+#define DEPCMDPAR1(n)   (0xc804 + 0x10 * (n))
+#define DEPCMDPAR0(n)   (0xc808 + 0x10 * (n))
+#define DEPCMD(n)       (0xc80c + 0x10 * (n))
+
+
+#define DCTL_RUN_STOP   (1u << 31)
+#define DCTL_CSFTRST    (1u << 30)
+#define DSTS_DEVCTRLHLT (1u << 22)
+
+#define DEPCMD_SETEPCONFIG      1
+#define DEPCMD_SETTRANSFRESOURCE 2
+#define DEPCMD_SETSTALL         4
+#define DEPCMD_STARTTRANSFER    6
+#define DEPCMD_DEPSTARTCFG      9
+#define DEPCMD_CMDACT           (1u << 10)
+
+#define TRB_HWO         (1u << 0)
+#define TRB_LST         (1u << 1)
+#define TRB_ISP_IMI     (1u << 10)
+#define TRB_IOC         (1u << 11)
+#define TRBCTL_SETUP    (2u << 4)
+#define TRBCTL_STATUS2  (3u << 4)
+#define TRBCTL_STATUS3  (4u << 4)
+#define TRBCTL_DATA     (5u << 4)
+
+/* DMA area layout */
+#define UD_EVT          0x0000          /* event buffer, 4 KiB */
+#define UD_EVT_SIZE     0x1000
+#define UD_TRB_OUT      0x1000          /* ep0 OUT TRB */
+#define UD_TRB_IN       0x1010          /* ep0 IN TRB */
+#define UD_TRB_RX       0x1020          /* ep1 OUT (bulk, host -> phone) */
+#define UD_TRB_TX       0x1030          /* ep1 IN (bulk, phone -> host) */
+#define UD_TRB_INT      0x1050          /* ep2 IN (interrupt, notifications) */
+#define UD_SETUP        0x1040          /* 8-byte setup packet */
+#define UD_DATA         0x1100          /* ep0 data stage, 512 bytes */
+#define UD_NOTIFY       0x1300          /* 16-byte notification */
+#define UD_RX           0x2000          /* one received frame */
+#define UD_TX           0x2800          /* one frame to send */
+#define UD_FRAME_MAX    0x800
+#define UD_SIZE         0x4000
+
+/* Physical endpoints: 2n = OUT, 2n+1 = IN */
+#define EP_RX           2               /* 0x01 bulk OUT */
+#define EP_TX           3               /* 0x81 bulk IN */
+#define EP_INT          5               /* 0x82 interrupt IN */
+#define TRBCTL_NORMAL   (1u << 4)
+
+#define UD_TXQ          32
+
+static struct {
+	vm_offset_t dwc;
+	vm_offset_t dma;
+	uint64_t    dma_pa;
+	uint32_t    evt_pos;
+	int         sleep_chan;
+	enum { EP0_SETUP, EP0_DATA, EP0_WAIT_STATUS2, EP0_WAIT_STATUS3, EP0_STATUS } state;
+	bool        data_in;        /* data stage direction */
+	uint32_t    events;
+	bool        configured;
+	uint8_t     data_alt;       /* data interface alternate setting */
+	/* network */
+	ifnet_t     ifp;
+	lck_mtx_t  *lock;           /* TX ring and TX endpoint */
+	mbuf_t      txq[UD_TXQ];
+	unsigned    txq_head, txq_count;
+	bool        tx_busy;
+	uint64_t    rx_frames, tx_frames;
+} ud;
+
+static inline void
+dwc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ud.dwc + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+dwc_rd(uint32_t off)
+{
+	return usb_rd(ud.dwc, off);
+}
+
+static void
+ud_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(ud.dma_pa + off), len, TRUE);
+}
+
+static void
+ud_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ud.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	dwc_wr(DEPCMDPAR0(ep), p0);
+	dwc_wr(DEPCMDPAR1(ep), p1);
+	dwc_wr(DEPCMDPAR2(ep), p2);
+	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t v = dwc_rd(DEPCMD(ep));
+		if (!(v & DEPCMD_CMDACT)) {
+			uint32_t status = (v >> 12) & 0xf;
+			if (status) {
+				printf("A135F USB: ep%u cmd 0x%x status %u\n", ep, cmd & 0xf, status);
+				return -1;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	printf("A135F USB: ep%u cmd 0x%x timeout\n", ep, cmd & 0xf);
+	return -1;
+}
+
+/* One TRB (at DMA offset trb) on physical endpoint ep. */
+static void
+ud_start_trb(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
+	uint64_t bpa = ud.dma_pa + buf;
+
+	t[0] = (uint32_t)bpa;
+	t[1] = (uint32_t)(bpa >> 32);
+	t[2] = len;
+	t[3] = ctl | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
+	ud_sync(trb, 16);
+	if (len) {
+		ud_sync(buf, len);
+	}
+	uint64_t tpa = ud.dma_pa + trb;
+	ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+}
+
+static void
+ud_start(unsigned ep, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	ud_start_trb(ep, ep ? UD_TRB_IN : UD_TRB_OUT, buf, len, ctl);
+}
+
+static void
+ud_start_setup(void)
+{
+	ud.state = EP0_SETUP;
+	ud_start(0, UD_SETUP, 8, TRBCTL_SETUP);
+}
+
+static void
+ud_stall(void)
+{
+	ud_epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
+	ud_start_setup();
+}
+
+/*
+ * USB descriptors: a CDC-ECM (Ethernet) function, which Linux (cdc_ether)
+ * and macOS drive without extra drivers. VID 0x1209 / PID 0x0001 =
+ * pid.codes test ID, not a product.
+ */
+static const uint8_t ud_dev_desc[18] = {
+	18, 1, 0x00, 0x02, 0x02, 0x00, 0x00, 64,
+	0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+static const uint8_t ud_cfg_desc[80] = {
+	9, 2, 80, 0, 2, 1, 0, 0x80, 250,                /* config: 2 interfaces, 500 mA */
+	9, 4, 0, 0, 1, 0x02, 0x06, 0x00, 0,             /* comm interface 0: CDC ECM, 1 endpoint */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 */
+	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
+	13, 0x24, 0x0f, 4, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* ethernet: MAC string 4, max segment 1514 */
+	7, 5, 0x82, 0x03, 16, 0, 9,                     /* ep 0x82 interrupt IN, 16 bytes, 2^(9-1) uframes */
+	9, 4, 1, 0, 0, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 0: no endpoints */
+	9, 4, 1, 1, 2, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 1: two bulk endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
+};
+/* The host side's MAC (ECM iMACAddress); the phone's own is ..:02 */
+static const char *const ud_strings[] = {
+	NULL, "ios-a135f", "A135F iOS (USB Ethernet)", "0001", "02005E77EE01",
+};
+static const uint8_t ud_phone_mac[ETHER_ADDR_LEN] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x02 };
+
+static uint32_t
+ud_string(unsigned idx, uint8_t *out)
+{
+	if (idx == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;   /* en-US */
+		return 4;
+	}
+	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0])) {
+		return 0;
+	}
+	const char *str = ud_strings[idx];
+	uint32_t n = 2;
+	for (; *str && n < 126; str++) {
+		out[n++] = (uint8_t)*str;
+		out[n++] = 0;
+	}
+	out[0] = (uint8_t)n;
+	out[1] = 3;
+	return n;
+}
+
+static void ud_rx_arm(void);
+static void ud_tx_kick_locked(void);
+static void ud_link_event(bool up);
+
+/* NETWORK_CONNECTION notification: the host brings its link up on it. */
+static void
+ud_notify_connected(void)
+{
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	n[0] = 0xa1; n[1] = 0x00;       /* NETWORK_CONNECTION */
+	n[2] = 1; n[3] = 0;             /* connected */
+	n[4] = 0; n[5] = 0;             /* interface 0 */
+	n[6] = 0; n[7] = 0;
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 8, TRBCTL_NORMAL);
+}
+
+/* SET_CONFIGURATION(1): bulk IN/OUT and the interrupt endpoint. */
+static void
+ud_configure(void)
+{
+	if (ud.configured) {
+		return;
+	}
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG | (2u << 16), 0, 0, 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3), (1u << 8) | ((uint32_t)EP_RX << 25), 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3) | (1u << 17), (1u << 8) | ((uint32_t)EP_TX << 25), 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETEPCONFIG, (3u << 1) | (16u << 3) | (2u << 17),
+	    (1u << 8) | (8u << 16) | ((uint32_t)EP_INT << 25), 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("A135F USB: data endpoints setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | (1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT));
+	ud.configured = true;
+	ud_rx_arm();
+	printf("A135F USB: ECM endpoints configured\n");
+}
+
+static void
+ud_setup(void)
+{
+	const uint8_t *st = (const uint8_t *)(ud.dma + UD_SETUP);
+	uint8_t *data = (uint8_t *)(ud.dma + UD_DATA);
+	uint8_t type = st[0], req = st[1];
+	uint16_t value = (uint16_t)(st[2] | st[3] << 8);
+	uint16_t index = (uint16_t)(st[4] | st[5] << 8);
+	uint16_t length = (uint16_t)(st[6] | st[7] << 8);
+	uint32_t n = 0;
+	bool ok = true;
+
+	printf("A135F USB: setup %02x %02x %04x %04x len %u\n", type, req, value, index, length);
+	ud.data_in = (type & 0x80) != 0;
+	if ((type & 0x60) == 0x20) {    /* class request (e.g. SET_ETHERNET_PACKET_FILTER) */
+		ok = (length == 0);
+	} else if ((type & 0x60) != 0) {
+		ok = false;
+	} else if (req == 6) {          /* GET_DESCRIPTOR */
+		switch (value >> 8) {
+		case 1: memcpy(data, ud_dev_desc, sizeof(ud_dev_desc)); n = sizeof(ud_dev_desc); break;
+		case 2: memcpy(data, ud_cfg_desc, sizeof(ud_cfg_desc)); n = sizeof(ud_cfg_desc); break;
+		case 3: n = ud_string(value & 0xff, data); ok = n != 0; break;
+		default: ok = false; break;
+		}
+	} else if (req == 5) {          /* SET_ADDRESS: takes effect now (DWC3 handles the timing) */
+		uint32_t dcfg = dwc_rd(DCFG) & ~(0x7fu << 3);
+		dwc_wr(DCFG, dcfg | ((uint32_t)(value & 0x7f) << 3));
+		printf("A135F USB: address %u\n", value & 0x7f);
+	} else if (req == 9) {          /* SET_CONFIGURATION */
+		if (value == 1) {
+			ud_configure();
+		}
+		printf("A135F USB: configured (%u)\n", value);
+	} else if (req == 8) {          /* GET_CONFIGURATION */
+		data[0] = ud.configured ? 1 : 0; n = 1;
+	} else if (req == 0) {          /* GET_STATUS */
+		data[0] = 0; data[1] = 0; n = 2;
+	} else if (req == 11) {         /* SET_INTERFACE */
+		if (index == 1) {
+			ud.data_alt = (uint8_t)value;
+			if (value == 1 && ud.configured) {
+				ud_notify_connected();
+				ud_link_event(true);
+			}
+		}
+	} else if (req == 10) {         /* GET_INTERFACE */
+		data[0] = index == 1 ? ud.data_alt : 0; n = 1;
+	} else if (req == 1 || req == 3) { /* CLEAR/SET_FEATURE (halt, remote wakeup) */
+	} else {
+		ok = false;
+	}
+	if (!ok) {
+		ud_stall();
+		return;
+	}
+	if (length == 0) {
+		ud.state = EP0_WAIT_STATUS2;    /* status stage on XferNotReady */
+		return;
+	}
+	ud.state = EP0_DATA;
+	if (ud.data_in) {
+		if (n > length) {
+			n = length;
+		}
+		ud_start(1, UD_DATA, n, TRBCTL_DATA);
+	} else {
+		ud_start(0, UD_DATA, 64, TRBCTL_DATA);  /* OUT data is not used here */
+	}
+}
+
+/* ---- network interface (ue0) ---- */
+
+static void
+ud_rx_arm(void)
+{
+	ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, UD_FRAME_MAX, TRBCTL_NORMAL);
+}
+
+static void
+ud_rx_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	ud_sync(UD_TRB_RX, 16);
+	uint32_t len = UD_FRAME_MAX - (t[2] & 0xffffff);
+	ud_sync(UD_RX, UD_FRAME_MAX);
+	if (ud.ifp != NULL && len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN) {
+		/*
+		 * One mbuf with a 2 KiB cluster holds any frame. (mbuf_allocpacket
+		 * may return a first mbuf of length 0: stripping the header from
+		 * it panicked "Failed mbuf validity check: len -14".)
+		 */
+		mbuf_t m = NULL;
+		if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    (mbuf_flags(m) & MBUF_EXT) && mbuf_maxlen(m) >= len) {
+			struct ifnet_stat_increment_param stats = {};
+			memcpy(mbuf_data(m), (const void *)(ud.dma + UD_RX), len);
+			mbuf_setlen(m, len);
+			mbuf_pkthdr_setlen(m, len);
+			void *frame_header = mbuf_data(m);
+			mbuf_pkthdr_setrcvif(m, ud.ifp);
+			mbuf_pkthdr_setheader(m, frame_header);
+			mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+			(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+			stats.packets_in = 1;
+			stats.bytes_in = len;
+			ud.rx_frames++;
+			ifnet_input(ud.ifp, m, &stats);
+		} else if (m != NULL) {
+			mbuf_freem(m);
+		}
+	}
+	ud_rx_arm();
+}
+
+/* Start the next queued frame if the IN endpoint is idle. ud.lock held. */
+static void
+ud_tx_kick_locked(void)
+{
+	while (!ud.tx_busy && ud.txq_count > 0 && ud.configured) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		size_t len = mbuf_pkthdr_len(m);
+		if (len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+			mbuf_freem(m);
+			continue;
+		}
+		mbuf_copydata(m, 0, len, (void *)(ud.dma + UD_TX));
+		mbuf_freem(m);
+		/* A frame of a multiple of 512 bytes would need a zero-length
+		 * packet to end it; one pad byte does the same (IP ignores it). */
+		if ((len % 512) == 0) {
+			((uint8_t *)(ud.dma + UD_TX))[len++] = 0;
+		}
+		ud.tx_busy = true;
+		ud.tx_frames++;
+		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, (uint32_t)len, TRBCTL_NORMAL);
+	}
+}
+
+static errno_t
+ud_if_output(ifnet_t ifp, mbuf_t m)
+{
+	lck_mtx_lock(ud.lock);
+	if (ud.txq_count == UD_TXQ || !ud.configured) {
+		lck_mtx_unlock(ud.lock);
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	ifnet_stat_increment_out(ifp, 1, mbuf_pkthdr_len(m), 0);
+	ud.txq[(ud.txq_head + ud.txq_count) % UD_TXQ] = m;
+	ud.txq_count++;
+	ud_tx_kick_locked();
+	lck_mtx_unlock(ud.lock);
+	return 0;
+}
+
+/*
+ * Link state for configd (KernelEventMonitor reads SIOCGIFMEDIA and the
+ * KEV_DL_LINK_ON/OFF events; IPMonitor does not route through a service
+ * whose interface has no active link).
+ */
+static void
+ud_link_event(bool up)
+{
+	if (ud.ifp != NULL) {
+		dlil_post_msg(ud.ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
+	}
+}
+
+static errno_t
+ud_if_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		struct ifmediareq *ifmr = (struct ifmediareq *)data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ?
+		    ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
+		int media = IFM_ETHER | IFM_AUTO;
+		ifmr->ifm_current = media;
+		ifmr->ifm_active = ud.configured ? (IFM_ETHER | IFM_1000_T | IFM_FDX) : media;
+		ifmr->ifm_mask = 0;
+		ifmr->ifm_status = IFM_AVALID | (ud.configured ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && ifmr->ifm_count > 0) {
+			ifmr->ifm_count = 1;
+			return copyout(&media, list, sizeof(media));
+		}
+		ifmr->ifm_count = 1;
+		return 0;
+	}
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+ud_if_detach(ifnet_t ifp __unused)
+{
+}
+
+/* ue0, 192.168.7.2/24 (the host side is 192.168.7.1). */
+static void
+ud_if_create(void)
+{
+	struct ifnet_init_eparams init;
+	static lck_grp_t *grp;
+
+	grp = lck_grp_alloc_init("a135f_usb", LCK_GRP_ATTR_NULL);
+	ud.lock = lck_mtx_alloc_init(grp, LCK_ATTR_NULL);
+
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "a135f-usb-ecm";
+	init.uniqueid_len = sizeof("a135f-usb-ecm") - 1;
+	init.name = "ue";
+	init.unit = 0;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = ud_if_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = ud_if_ioctl;
+	init.detach = ud_if_detach;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+	if (ifnet_allocate_extended(&init, &ud.ifp) != 0) {
+		printf("A135F USB: ifnet_allocate failed\n");
+		ud.ifp = NULL;
+		return;
+	}
+	ifnet_set_addrlen(ud.ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(ud.ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(ud.ifp, ETHERMTU);
+	ifnet_set_baudrate(ud.ifp, 480000000);
+	ifnet_set_flags(ud.ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(ud.ifp, NULL) != 0) {
+		printf("A135F USB: ifnet_attach failed\n");
+		ud.ifp = NULL;
+		return;
+	}
+	ifnet_set_lladdr(ud.ifp, ud_phone_mac, ETHER_ADDR_LEN);
+
+	errno_t err = proto_plumb(PF_INET, ud.ifp);
+	socket_t so = NULL;
+	if (err == 0) {
+		err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	}
+	if (err == 0) {
+		struct ifaliasreq ifra;
+		bzero(&ifra, sizeof(ifra));
+		snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "ue0");
+		struct sockaddr_in *a = (struct sockaddr_in *)&ifra.ifra_addr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a80702);         /* 192.168.7.2 */
+		a = (struct sockaddr_in *)&ifra.ifra_mask;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xffffff00);
+		a = (struct sockaddr_in *)&ifra.ifra_broadaddr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a807ff);
+		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+		sock_close(so);
+	}
+	ifnet_set_flags(ud.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	printf("A135F USB: ue0 192.168.7.2/24 %s (err %d)\n", err ? "NOT configured" : "up", err);
+}
+
+static void
+ud_event(uint32_t ev)
+{
+	if (ev & 1) {                   /* device event */
+		uint32_t type = (ev >> 8) & 0xf;
+		if (type == 1) {        /* USB reset */
+			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+			printf("A135F USB: bus reset\n");
+		} else if (type == 2) { /* connect done */
+			uint32_t speed = dwc_rd(DSTS) & 7;
+			/* ep0 max packet: 64 at high/full speed (modify action) */
+			ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (0u << 25), 0);
+			ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (1u << 25), 0);
+			printf("A135F USB: connected, speed %u\n", speed);
+		} else if (type == 0) {
+			printf("A135F USB: disconnect\n");
+		}
+		return;
+	}
+	unsigned ep = (ev >> 1) & 0x1f;
+	unsigned type = (ev >> 6) & 0xf;
+	unsigned status = (ev >> 12) & 0xf;
+
+	if (ep == EP_RX && type == 1) {
+		ud_rx_done();
+		return;
+	}
+	if (ep == EP_TX && type == 1) {
+		lck_mtx_lock(ud.lock);
+		ud.tx_busy = false;
+		ud_tx_kick_locked();
+		lck_mtx_unlock(ud.lock);
+		return;
+	}
+	if (ep > 1) {
+		return;
+	}
+	/*
+	 * Control transfer state machine (Linux dwc3 ep0.c): SETUP completes ->
+	 * request handled; the data stage (if any) is started right away; the
+	 * status stage is started when the controller reports XferNotReady
+	 * with status "control status"; its completion re-arms SETUP.
+	 */
+	if (type == 1) {                /* XferComplete */
+		switch (ud.state) {
+		case EP0_SETUP:
+			ud_sync(UD_SETUP, 8);
+			ud_setup();
+			break;
+		case EP0_DATA:
+			ud.state = EP0_WAIT_STATUS3;
+			break;
+		case EP0_STATUS:
+			ud_start_setup();
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+	if (type == 3 && status == 2) { /* XferNotReady, control status phase */
+		if (ud.state == EP0_WAIT_STATUS2 || ud.state == EP0_WAIT_STATUS3) {
+			uint32_t ctl = ud.state == EP0_WAIT_STATUS3 ? TRBCTL_STATUS3 : TRBCTL_STATUS2;
+			ud.state = EP0_STATUS;
+			ud_start(ep, UD_DATA, 0, ctl);
+		}
+	}
+}
+
+static void
+ud_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t ticks = 0;
+	for (;;) {
+		uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+		if (count) {
+			ud_sync(UD_EVT, UD_EVT_SIZE);
+			for (uint32_t done = 0; done < count; done += 4) {
+				uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+				ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+				if (ud.events++ < 200) {
+					printf("A135F USB: event 0x%08x\n", ev);
+				}
+				ud_event(ev);
+			}
+			dwc_wr(GEVNTCOUNT, count);
+		}
+		if ((++ticks % 30000) == 0) {
+			printf("A135F USB: ue0 rx %llu tx %llu frames\n", ud.rx_frames, ud.tx_frames);
+		}
+		ud_sleep_ms(1);
+	}
+}
+
+/*
+ * Live console log over USB Ethernet: every 100 ms the new bytes of the
+ * console ring (bsd/dev/a135f_mmc.c) go as UDP datagrams to
+ * 192.168.7.1:5140 (on the PC: nc -ukl 5140). Starts with the last 64 KiB
+ * so the boot is included. Nothing here may print (it would feed itself).
+ * Boot-arg a135f_usblog=0 disables it.
+ */
+extern uint32_t a135f_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t a135f_log_position(void);
+
+static void
+ud_log_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char chunk[1400];
+	socket_t so = NULL;
+	struct sockaddr_in to;
+	uint64_t pos = a135f_log_position();
+
+	pos = pos > 65536 ? pos - 65536 : 0;
+	bzero(&to, sizeof(to));
+	to.sin_len = sizeof(to);
+	to.sin_family = AF_INET;
+	to.sin_port = htons(5140);
+	to.sin_addr.s_addr = htonl(0xc0a80701);         /* 192.168.7.1 */
+	for (;;) {
+		ud_sleep_ms(100);
+		if (!ud.configured) {
+			continue;
+		}
+		if (so == NULL && sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+			so = NULL;
+			continue;
+		}
+		uint32_t n;
+		while ((n = a135f_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
+			struct iovec iov = { .iov_base = chunk, .iov_len = n };
+			struct msghdr msg = {
+				.msg_name = &to, .msg_namelen = sizeof(to),
+				.msg_iov = &iov, .msg_iovlen = 1,
+			};
+			size_t sent = 0;
+			if (sock_send(so, &msg, 0, &sent) != 0) {
+				break;          /* no route/ARP yet: retry later */
+			}
+		}
+	}
+}
+
+static void
+a135f_usb_gadget_start(vm_offset_t dwc)
+{
+	thread_t thread;
+
+	ud.dwc = dwc;
+	if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("A135F USB: no DMA memory\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)ud.dma);
+	if (!pn) {
+		return;
+	}
+	ud.dma_pa = ptoa_64(pn);
+	ud_if_create();
+
+	/* Device controller soft reset (the PHY was brought up by a135f_usb_probe()). */
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	int i;
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		delay(1000);
+	}
+	printf("A135F USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
+	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return;
+	}
+
+	/* Device role (GCTL.PRTCAPDIR = 2), as dwc3_set_prtcap(DEVICE) */
+	dwc_wr(GCTL, (dwc_rd(GCTL) & ~(3u << 12)) | (2u << 12));
+	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
+	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
+	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
+	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
+	ud.evt_pos = 0;
+
+	/* High speed, address 0 */
+	uint32_t dcfg = dwc_rd(DCFG) & ~(7u | (0x7fu << 3));
+	dwc_wr(DCFG, dcfg | 0);
+	/* Events: disconnect, USB reset, connect done */
+	dwc_wr(DEVTEN, 0x7);
+
+	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
+	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
+	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("A135F USB: endpoint 0 setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, 0x3);
+	ud_start_setup();
+
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	printf("A135F USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n", dwc_rd(DSTS), i, ud.dma_pa);
+	if (kernel_thread_start(ud_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	int livelog = 1;
+	PE_parse_boot_argn("a135f_usblog", &livelog, sizeof(livelog));
+	if (livelog && ud.ifp != NULL && kernel_thread_start(ud_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
