+   Method m=class_getClassMethod(cls,sel);
+   IMP orig=m?method_getImplementation(m):NULL;
+   const char *types=m?method_getTypeEncoding(m):NULL;
+   if(orig && (uintptr_t)orig-slide==0x1b23beca0UL && types && !strcmp(types,"B24@0:8@16")) {
