+}
+static id native_device_logical_screen_class(id self, SEL selector) {
+ (void)self;(void)selector;
+ if(!wallpaper_said) {
+  wallpaper_said=1;
+  say("hakios: native wallpaper: logical screen class 360w-800h@2x -> 375w-812h@3x~iphone\n");
+ }
