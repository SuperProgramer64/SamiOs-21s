+static inline unsigned
+le2_to_uint(const uint8_t *s)
+{
+	return (unsigned)s[0] | ((unsigned)s[1] << 8);
+}
+
+static inline unsigned
+le4_to_uint(const uint8_t *s)
+{
+	return (unsigned)s[0] | ((unsigned)s[1] << 8) | ((unsigned)s[2] << 16) | ((unsigned)s[3] << 24);
+}
