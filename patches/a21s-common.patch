+ reset(0);length=37;assert(ovt_tcm_get_app_info()==-EINVAL);
+ reset(0);payload[32]=payload[33]=0;assert(ovt_tcm_get_app_info()==-EINVAL);
+ reset(1);touch_probe_mode=0;assert(!ovt_tcm_get_app_info() && calls==1);
+}
+'''.replace('BODY',s[a:b])
